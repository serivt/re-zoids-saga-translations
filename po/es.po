msgctxt "dialogue/387/0x3"
msgid "dialogue/387/0x3"
msgstr "Recepcionista\nPor fin llega el combate\npor el título de campeón.\nSu rival es el\nTeam Blood."

msgctxt "dialogue/387/0x50"
msgid "dialogue/387/0x50"
msgstr "Recepcionista\nEn esta batalla Zoid se\nadmiten como máximo\n3 Zoids, y no se pueden\nusar objetos."

msgctxt "dialogue/387/0xa1"
msgid "dialogue/387/0xa1"
msgstr "Recepcionista\n¿Desean combatir en la\nbatalla Zoid?"

msgctxt "dialogue/387/0xd9"
msgid "dialogue/387/0xd9"
msgstr "Recepcionista\nParticipación confirmada.\nAdelante, pasen a la\narena."

msgctxt "dialogue/387/0x121"
msgid "dialogue/387/0x121"
msgstr "Recepcionista\nVuelvan cuando estén\nlistos para la batalla\nZoid."

msgctxt "dialogue/388/0xc"
msgid "dialogue/388/0xc"
msgstr "Leena\nPor fin hemos llegado\nhasta aquí."

msgctxt "dialogue/388/0x3c"
msgid "dialogue/388/0x3c"
msgstr "Regina\nGracias por todo, Leena."

msgctxt "dialogue/388/0x70"
msgid "dialogue/388/0x70"
msgstr "Leena\n¡Qué dices! ¡Ya me darás\nlas gracias cuando\nganemos!"

msgctxt "dialogue/388/0xb5"
msgid "dialogue/388/0xb5"
msgstr "Regina\n¡Sí, vamos a hacerlos\npapilla!"

msgctxt "dialogue/388/0xf9"
msgid "dialogue/388/0xf9"
msgstr "Leena\n¡Por supuesto!"

msgctxt "dialogue/389/0xc"
msgid "dialogue/389/0xc"
msgstr "Jack\n¡Eso es...!"

msgctxt "dialogue/389/0x32"
msgid "dialogue/389/0x32"
msgstr "Regina\n¿¡El Trinity Liger!?\n¿Qué hace aquí?"

msgctxt "dialogue/389/0x7d"
msgid "dialogue/389/0x7d"
msgstr "Blood\nEs el premio del combate\npor el título."

msgctxt "dialogue/390/0xc"
msgid "dialogue/390/0xc"
msgstr "Blood\nTeam Blitz... Así que\nerais vosotros..."

msgctxt "dialogue/390/0x5b"
msgid "dialogue/390/0x5b"
msgstr "Jack\nAsí que era usted, Blood."

msgctxt "dialogue/390/0x89"
msgid "dialogue/390/0x89"
msgstr "Jack\nLa desaparición de Zoids.\nTambién es obra suya,\n¿verdad?"

msgctxt "dialogue/390/0xc9"
msgid "dialogue/390/0xc9"
msgstr "Blood\nMuy perspicaz."

msgctxt "dialogue/390/0xdf"
msgid "dialogue/390/0xdf"
msgstr "Blood\nPero llegáis tarde. Ya he\nenviado todos los Zoids\ndesaparecidos al\nEmperador."

msgctxt "dialogue/390/0x132"
msgid "dialogue/390/0x132"
msgstr "Blood\nVuestros esfuerzos no han\nservido de nada."

msgctxt "dialogue/390/0x174"
msgid "dialogue/390/0x174"
msgstr "Blood\n¡Y ese Trinity Liger\ntambién será mío!"

msgctxt "dialogue/390/0x1c0"
msgid "dialogue/390/0x1c0"
msgstr "{name}\n......"

msgctxt "dialogue/390/0x1e1"
msgid "dialogue/390/0x1e1"
msgstr "Regina\n¡Aunque así sea! ¡Vamos a\nderrotarte igualmente!"

msgctxt "dialogue/390/0x236"
msgid "dialogue/390/0x236"
msgstr "Blood\n¿Seréis capaces de\nvencerme?"

msgctxt "dialogue/390/0x26a"
msgid "dialogue/390/0x26a"
msgstr "Blood\n¡A mí, el campeón!"

msgctxt "dialogue/390/0x2a2"
msgid "dialogue/390/0x2a2"
msgstr "Gold Judgeman\n¡Preparad el campo de\nbatalla!"

msgctxt "dialogue/390/0x2dc"
msgid "dialogue/390/0x2dc"
msgstr "Gold Judgeman\nTeam Blitz contra\nTeam Blood"

msgctxt "dialogue/390/0x320"
msgid "dialogue/390/0x320"
msgstr "Gold Judgeman\nModo de batalla: 5-3-5"

msgctxt "dialogue/390/0x354"
msgid "dialogue/390/0x354"
msgstr "Gold Judgeman\n¡Listos... a luchar!"

msgctxt "dialogue/391/0xc"
msgid "dialogue/391/0xc"
msgstr "Blood\n¡Tsk! ¡Hasta aquí he\nllegado!"

msgctxt "dialogue/392/0xc"
msgid "dialogue/392/0xc"
msgstr "Blood\n¡{name}! ¡No dejaré que\nte quedes el Trinity\nLiger!"

msgctxt "dialogue/392/0x51"
msgid "dialogue/392/0x51"
msgstr "{name}\n......"

msgctxt "dialogue/393/0xc"
msgid "dialogue/393/0xc"
msgstr "Blood\nSi no puede ser mío,\n¡lo destruiré!"

msgctxt "dialogue/394/0xc"
msgid "dialogue/394/0xc"
msgstr "Regina\n¡Espera! ¡Cobarde!"

msgctxt "dialogue/394/0x48"
msgid "dialogue/394/0x48"
msgstr "Blood\nVolveremos a vernos,\n{name}."

msgctxt "dialogue/395/0xc"
msgid "dialogue/395/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/395/0x2d"
msgid "dialogue/395/0x2d"
msgstr "Regina\n¡No! ¡Hasta el Trinity\nLiger...!"

msgctxt "dialogue/395/0x72"
msgid "dialogue/395/0x72"
msgstr "Regina\n¡...! ¿Qué...?"

msgctxt "dialogue/395/0x9c"
msgid "dialogue/395/0x9c"
msgstr "Arth\n¿Qué pasa?"

msgctxt "dialogue/395/0xc0"
msgid "dialogue/395/0xc0"
msgstr "Regina\nEl Trinity Liger...\nsigue vivo."

msgctxt "dialogue/395/0x102"
msgid "dialogue/395/0x102"
msgstr "Jack\nImposible, lo destrozó\npor completo... Ya veo,\n¿su núcleo Zoid sigue\nintacto?"

msgctxt "dialogue/395/0x151"
msgid "dialogue/395/0x151"
msgstr "Regina\n¡Sí, el Trinity Liger\nestá vivo!"

msgctxt "dialogue/395/0x193"
msgid "dialogue/395/0x193"
msgstr "Jack\nLlevémoslo con el Dr. T.\nQuizá él pueda hacer\nalgo."

msgctxt "dialogue/395/0x1f9"
msgid "dialogue/395/0x1f9"
msgstr "{name}\n......"

msgctxt "dialogue/396/0xc"
msgid "dialogue/396/0xc"
msgstr "Dr. Tros\nHa sido muy divertido."

msgctxt "dialogue/396/0x3e"
msgid "dialogue/396/0x3e"
msgstr "Jamie\nPero es una lástima."

msgctxt "dialogue/396/0x6c"
msgid "dialogue/396/0x6c"
msgstr "Jack\nSí... Pero..."

msgctxt "dialogue/396/0x9c"
msgid "dialogue/396/0x9c"
msgstr "Arth\nAún habrá ocasiones."

msgctxt "dialogue/396/0xc8"
msgid "dialogue/396/0xc8"
msgstr "Leon\nSí, es verdad."

msgctxt "dialogue/396/0xf0"
msgid "dialogue/396/0xf0"
msgstr "Bit\n¡Ha sido una batalla\ngenial! ¡La próxima vez\nluchamos tú y yo!"

msgctxt "dialogue/396/0x14a"
msgid "dialogue/396/0x14a"
msgstr "{name}\n......"

msgctxt "dialogue/396/0x16b"
msgid "dialogue/396/0x16b"
msgstr "Leena\n¡Regina! ¡Mucho ánimo!"

msgctxt "dialogue/396/0x1a1"
msgid "dialogue/396/0x1a1"
msgstr "Regina\nSí. Tú también, Leena."

msgctxt "dialogue/396/0x1cd"
msgid "dialogue/396/0x1cd"
msgstr "Leena\n¡Y ánimo también con\n{name}!"

msgctxt "dialogue/396/0x20d"
msgid "dialogue/396/0x20d"
msgstr "Regina\n¡¿Pe-pero qué dices\naquí, delante de todos?!"

msgctxt "dialogue/396/0x25d"
msgid "dialogue/396/0x25d"
msgstr "{name}\n......"

msgctxt "dialogue/396/0x27e"
msgid "dialogue/396/0x27e"
msgstr "Regina\n¡N-no es nada, {name}!"

msgctxt "dialogue/396/0x2ad"
msgid "dialogue/396/0x2ad"
msgstr "Regina\n¡Vamos, Jack, Arth,\nnos ponemos en marcha!"

msgctxt "dialogue/396/0x2f4"
msgid "dialogue/396/0x2f4"
msgstr "Arth\nSí."

msgctxt "dialogue/396/0x312"
msgid "dialogue/396/0x312"
msgstr "Jack\nDe acuerdo."

msgctxt "dialogue/397/0xc"
msgid "dialogue/397/0xc"
msgstr "Blood\nYa he vuelto."

msgctxt "dialogue/397/0x3a"
msgid "dialogue/397/0x3a"
msgstr "Emperador\nBuen trabajo."

msgctxt "dialogue/397/0x58"
msgid "dialogue/397/0x58"
msgstr "Blood\n¡Sí, señor! Los datos\nreunidos ya deberían\nobrar en su poder."

msgctxt "dialogue/397/0xb3"
msgid "dialogue/397/0xb3"
msgstr "Emperador\nSí. Opis me ha informado.\nSon datos muy\ninteresantes."

msgctxt "dialogue/397/0x116"
msgid "dialogue/397/0x116"
msgstr "Blood\nSe lo agradezco."

msgctxt "dialogue/397/0x146"
msgid "dialogue/397/0x146"
msgstr "Opis\nAunque al final {name}\ny los suyos te tomaron\nla delantera. Ji, ji, ji."

msgctxt "dialogue/397/0x194"
msgid "dialogue/397/0x194"
msgstr "Blood\nLa misión era reunir\ndatos de los Zoids, no\nacabar con {name} y\nlos suyos."

msgctxt "dialogue/397/0x1f0"
msgid "dialogue/397/0x1f0"
msgstr "Opis\nJi, ji, ji. Veo que se te\nda mejor la lengua que\nmanejar Zoids."

msgctxt "dialogue/397/0x23f"
msgid "dialogue/397/0x23f"
msgstr "Blood\nMe halagas. Es todo\nun honor."

msgctxt "dialogue/397/0x26d"
msgid "dialogue/397/0x26d"
msgstr "Blood\n¿No es eso mucho mejor\nque un amplificador de\nRare Hertz inútil?"

msgctxt "dialogue/397/0x2c8"
msgid "dialogue/397/0x2c8"
msgstr "Opis\n¡M-maldito!"

msgctxt "dialogue/397/0x2f4"
msgid "dialogue/397/0x2f4"
msgstr "Emperador\n¡Basta!"

msgctxt "dialogue/397/0x30a"
msgid "dialogue/397/0x30a"
msgstr "Emperador\nBlood, Opis, buen\ntrabajo. Podéis\nretiraros."

msgctxt "dialogue/397/0x353"
msgid "dialogue/397/0x353"
msgstr "Blood\n¡Sí, señor!"

msgctxt "dialogue/397/0x375"
msgid "dialogue/397/0x375"
msgstr "Opis\n¡P-pero...!"

msgctxt "dialogue/397/0x39d"
msgid "dialogue/397/0x39d"
msgstr "Emperador\nHe dicho que os retiréis."

msgctxt "dialogue/397/0x3c7"
msgid "dialogue/397/0x3c7"
msgstr "Opis\nTsk... Entendido."

msgctxt "dialogue/398/0xc"
msgid "dialogue/398/0xc"
msgstr "Emperador\nGale."

msgctxt "dialogue/398/0x2a"
msgid "dialogue/398/0x2a"
msgstr "Gale\nSeñor."

msgctxt "dialogue/398/0x46"
msgid "dialogue/398/0x46"
msgstr "Emperador\n¿Cómo va la mejora de\nnuestros Zoids?"

msgctxt "dialogue/398/0x82"
msgid "dialogue/398/0x82"
msgstr "Gale\nCon los datos de combate\nde esta vez y de la\nanterior, ya tenemos\nalgo encaminado."

msgctxt "dialogue/398/0xe3"
msgid "dialogue/398/0xe3"
msgstr "Emperador\nAlgo encaminado...\n¿Qué falta?"

msgctxt "dialogue/398/0x11a"
msgid "dialogue/398/0x11a"
msgstr "Gale\nTenemos datos de sobra\ndel combate cuerpo a\ncuerpo. Pero falta\npotencia de fuego."

msgctxt "dialogue/398/0x16f"
msgid "dialogue/398/0x16f"
msgstr "Emperador\nPotencia de fuego...\nPues hay uno que nos\nviene de perlas."

msgctxt "dialogue/398/0x1a8"
msgid "dialogue/398/0x1a8"
msgstr "Emperador\n¡Un Zoid equipado con\nun cañón de partículas\ncargadas!"

msgctxt "dialogue/398/0x1f5"
msgid "dialogue/398/0x1f5"
msgstr "Gale\nEl Death Saurer...\nPero esa máquina..."

msgctxt "dialogue/398/0x236"
msgid "dialogue/398/0x236"
msgstr "Emperador\n¡No importa! ¡Datos!\n¡Reúne esos datos, Gale!"

msgctxt "dialogue/398/0x273"
msgid "dialogue/398/0x273"
msgstr "Emperador\n¡Que {name} y los\nsuyos sean pasto de las\npartículas cargadas!"

msgctxt "dialogue/398/0x29d"
msgid "dialogue/398/0x29d"
msgstr "Emperador\n¡No, todo aquel que se\natreva a desafiarme!"

msgctxt "dialogue/398/0x2c7"
msgid "dialogue/398/0x2c7"
msgstr "Emperador\n¡Eso es! ¡Death Saurer!\n¡Oh, Death Saurer!"

msgctxt "dialogue/398/0x308"
msgid "dialogue/398/0x308"
msgstr "Emperador\n¡Gale! ¡Reúne ahora mismo\nlos datos del Death\nSaurer! ¡¡Ve!!"

msgctxt "dialogue/398/0x361"
msgid "dialogue/398/0x361"
msgstr "Gale\n...... Sí, señor."

msgctxt "dialogue/399/0xc"
msgid "dialogue/399/0xc"
msgstr "Emperador\nJe, je, je, je...\n¡¡Ja, ja, ja, ja, ja!!"

msgctxt "dialogue/400/0x3"
msgid "dialogue/400/0x3"
msgstr "Soldado del Reino 1\n¡...! ¡Vibración\nespaciotemporal! Han\nusado el dispositivo de\ntransporte del castillo."

msgctxt "dialogue/400/0x54"
msgid "dialogue/400/0x54"
msgstr "Soldado del Reino 2\n¿Qué? ¡Otra vez!"

msgctxt "dialogue/400/0x74"
msgid "dialogue/400/0x74"
msgstr "Soldado del Reino 1\n¡Avisa ya al príncipe y\nlos demás!"

msgctxt "dialogue/400/0x9c"
msgid "dialogue/400/0x9c"
msgstr "Soldado del Reino 2\nMalditos... ¿Qué estarán\ntramando ahora?"

msgctxt "dialogue/401/0xc"
msgid "dialogue/401/0xc"
msgstr "Jack\nPríncipe, han detectado\nuna vibración\nespaciotemporal."

msgctxt "dialogue/401/0x49"
msgid "dialogue/401/0x49"
msgstr "{name}\n......"

msgctxt "dialogue/401/0x6a"
msgid "dialogue/401/0x6a"
msgstr "Regina\n¿¡Otra vez!? ¿Y seguimos\nsin saber dónde es?"

msgctxt "dialogue/401/0xac"
msgid "dialogue/401/0xac"
msgstr "Arth\nNo."

msgctxt "dialogue/401/0xca"
msgid "dialogue/401/0xca"
msgstr "Regina\nLo que pensaba...\n¡¿Eh?! ¡¿Lo sabéis?!"

msgctxt "dialogue/401/0x10e"
msgid "dialogue/401/0x10e"
msgstr "{name}\n......"

msgctxt "dialogue/401/0x12f"
msgid "dialogue/401/0x12f"
msgstr "Jack\nDespués de tantas veces,\nya le vamos cogiendo\nel truco."

msgctxt "dialogue/401/0x17a"
msgid "dialogue/401/0x17a"
msgstr "Regina\nEntonces, ¿adónde\nhan ido?"

msgctxt "dialogue/401/0x1aa"
msgid "dialogue/401/0x1aa"
msgstr "Jack\nParece que a territorio\nimperial de finales de\nla guerra anterior."

msgctxt "dialogue/401/0x1e7"
msgid "dialogue/401/0x1e7"
msgstr "Jack\n¡En cuanto estemos\nlistos, iremos tras\nellos!"

msgctxt "dialogue/402/0xc"
msgid "dialogue/402/0xc"
msgstr "Jack\n¿Todo listo, príncipe?\nEntonces, en marcha."

msgctxt "dialogue/403/0xc"
msgid "dialogue/403/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/403/0x2d"
msgid "dialogue/403/0x2d"
msgstr "Regina\n...¿Dónde estamos?"

msgctxt "dialogue/403/0x57"
msgid "dialogue/403/0x57"
msgstr "Jack\nCerca del castillo de\nMiletos, palacio de\nrecreo del Imperio.\nVayamos hacia allí."

msgctxt "dialogue/403/0xb8"
msgid "dialogue/403/0xb8"
msgstr "Regina\nSí. No sabemos qué busca\nel enemigo...\nReunamos información."

msgctxt "dialogue/404/0xc"
msgid "dialogue/404/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/404/0x2d"
msgid "dialogue/404/0x2d"
msgstr "Regina\nSe nota que es el\nImperio. ¡Qué ambiente!"

msgctxt "dialogue/404/0x7c"
msgid "dialogue/404/0x7c"
msgstr "Jack\nEs verdad."

msgctxt "dialogue/404/0x96"
msgid "dialogue/404/0x96"
msgstr "Jack\nAunque más bien parece\nque están de fiesta..."

msgctxt "dialogue/404/0xe7"
msgid "dialogue/404/0xe7"
msgstr "Arth\nReunamos información."

msgctxt "dialogue/405/0x3"
msgid "dialogue/405/0x3"
msgstr "Vecino\n¿Que a qué viene tanto\njaleo? ¿De qué pueblo\nhabéis salido?"

msgctxt "dialogue/405/0x3c"
msgid "dialogue/405/0x3c"
msgstr "Vecino\nVa a celebrarse la\ncoronación del príncipe\nheredero Rudolph. Por\neso estamos de fiesta."

msgctxt "dialogue/406/0x3"
msgid "dialogue/406/0x3"
msgstr "Vecino\nSu Alteza Rudolph acaba\nde cumplir diez años.\nLo que le espera..."

msgctxt "dialogue/406/0x4e"
msgid "dialogue/406/0x4e"
msgstr "Vecino\nPero Prozen, como\nregente, seguro que le\ndará todo su apoyo."

msgctxt "dialogue/407/0x3"
msgid "dialogue/407/0x3"
msgstr "Vecino\nLa prosperidad actual\ndel Imperio se la\ndebemos al difunto\nemperador Zeppelin II."

msgctxt "dialogue/407/0x4e"
msgid "dialogue/407/0x4e"
msgstr "Vecino\nSeguro que Su Alteza\nRudolph mantendrá esta\nprosperidad."

msgctxt "dialogue/408/0x3"
msgid "dialogue/408/0x3"
msgstr "Vecino\nDicen que Su Alteza\nRudolph es muy bondadoso.\nOjalá acabe la guerra\ny llegue la paz."

msgctxt "dialogue/409/0x3"
msgid "dialogue/409/0x3"
msgstr "Vecino\nDicen que estuvimos a un\npaso de tomar la capital\nde la República."

msgctxt "dialogue/409/0x4a"
msgid "dialogue/409/0x4a"
msgstr "Vecino\nSi la República caía,\nel continente habría\nsido del Imperio..."

msgctxt "dialogue/410/0xc"
msgid "dialogue/410/0xc"
msgstr "Arth\n¡! Eh, es el barbudo."

msgctxt "dialogue/410/0x40"
msgid "dialogue/410/0x40"
msgstr "Regina\n¿¡El barbudo!?\n¡No puede ser!"

msgctxt "dialogue/410/0x70"
msgid "dialogue/410/0x70"
msgstr "Jack\n¡¡Instructor Gale!!"

msgctxt "dialogue/411/0xc"
msgid "dialogue/411/0xc"
msgstr "Jack\n¡.........!"

msgctxt "dialogue/411/0x3c"
msgid "dialogue/411/0x3c"
msgstr "Jack\n¡Instructor Gale!"

msgctxt "dialogue/411/0x66"
msgid "dialogue/411/0x66"
msgstr "Gale\nJack..."

msgctxt "dialogue/411/0x90"
msgid "dialogue/411/0x90"
msgstr "Jack\n...¿Qué estaba\nmirando...?"

msgctxt "dialogue/411/0xce"
msgid "dialogue/411/0xce"
msgstr "Gale\n......"

msgctxt "dialogue/411/0xf4"
msgid "dialogue/411/0xf4"
msgstr "Jack\n...¿Cómo está su hija?\n¿Está bien la pequeña\nJulia...?"

msgctxt "dialogue/411/0x147"
msgid "dialogue/411/0x147"
msgstr "Gale\n¡...!"

msgctxt "dialogue/411/0x163"
msgid "dialogue/411/0x163"
msgstr "Jack\n¿¡...!? No me diga que\na Julia le ha pasado\nalgo..."

msgctxt "dialogue/411/0x1ae"
msgid "dialogue/411/0x1ae"
msgstr "Gale\n...¡¡Eso no es asunto\ntuyo!!"

msgctxt "dialogue/411/0x1e8"
msgid "dialogue/411/0x1e8"
msgstr "Jack\n¡¡Instructor Gale!!"

msgctxt "dialogue/411/0x214"
msgid "dialogue/411/0x214"
msgstr "Gale\n...... Por hoy basta.\nYa nos veremos..."

msgctxt "dialogue/412/0xc"
msgid "dialogue/412/0xc"
msgstr "Jack\n¡Espere!"

msgctxt "dialogue/412/0x38"
msgid "dialogue/412/0x38"
msgstr "Arth\nVamos tras él."

msgctxt "dialogue/413/0xc"
msgid "dialogue/413/0xc"
msgstr "Regina\n¿Dónde estamos...?"

msgctxt "dialogue/413/0x36"
msgid "dialogue/413/0x36"
msgstr "Jack\nEs el castillo de\nMiletos, palacio de\nrecreo del Imperio. Pero\n¿qué hace él aquí?"

msgctxt "dialogue/413/0x91"
msgid "dialogue/413/0x91"
msgstr "Arth\nYa haremos cábalas luego.\nVamos tras él."

msgctxt "dialogue/413/0xc2"
msgid "dialogue/413/0xc2"
msgstr "{name}\n......"

msgctxt "dialogue/413/0xe3"
msgid "dialogue/413/0xe3"
msgstr "Jack\n...Tienes razón.\n¡Vamos!"

msgctxt "dialogue/414/0xc"
msgid "dialogue/414/0xc"
msgstr "Rosso\n¡Uoh!"

msgctxt "dialogue/414/0x2e"
msgid "dialogue/414/0x2e"
msgstr "Viola\n¡Rosso!"

msgctxt "dialogue/414/0x56"
msgid "dialogue/414/0x56"
msgstr "Rudolph\n¡Bah, insolente!"

msgctxt "dialogue/414/0x78"
msgid "dialogue/414/0x78"
msgstr "Rudolph\n¿Osas ultrajarme sabiendo\nque soy Rudolph Gerhardt\nZeppelin III?"

msgctxt "dialogue/414/0xdd"
msgid "dialogue/414/0xdd"
msgstr "Rosso\nLo sé muy bien, Alteza."

msgctxt "dialogue/414/0x111"
msgid "dialogue/414/0x111"
msgstr "Viola\n¡Vosotros!"

msgctxt "dialogue/414/0x13d"
msgid "dialogue/414/0x13d"
msgstr "Jack\nVosotros sois..."

msgctxt "dialogue/414/0x16b"
msgid "dialogue/414/0x16b"
msgstr "Arth\nLa banda de ladrones\nDesert Alcobaleno."

msgctxt "dialogue/414/0x1a3"
msgid "dialogue/414/0x1a3"
msgstr "Rosso\nEs un honor que os\nacordéis de nosotros."

msgctxt "dialogue/414/0x1d7"
msgid "dialogue/414/0x1d7"
msgstr "Rudolph\n¡Suéltame! ¡¿Es que no\nme vas a soltar?!"

msgctxt "dialogue/414/0x20b"
msgid "dialogue/414/0x20b"
msgstr "Jack\n¿Quién es ese chico?\n¡No será...!"

msgctxt "dialogue/415/0xc"
msgid "dialogue/415/0xc"
msgstr "Rudolph\n......"

msgctxt "dialogue/415/0x34"
msgid "dialogue/415/0x34"
msgstr "Rosso\n¡Tsk! ¿Esos imperiales\nquieren matarnos con\nRudolph y todo?"

msgctxt "dialogue/416/0xc"
msgid "dialogue/416/0xc"
msgstr "Viola\n¡Rosso! ¡Ahora que\npodemos!"

msgctxt "dialogue/416/0x44"
msgid "dialogue/416/0x44"
msgstr "Rosso\nSí.\n¡Si se tercia, ya nos\nveremos!"

msgctxt "dialogue/417/0xc"
msgid "dialogue/417/0xc"
msgstr "Regina\n¡E-esperad!"

msgctxt "dialogue/417/0x3a"
msgid "dialogue/417/0x3a"
msgstr "Jack\n¡Regina! Esto es\npeligroso. ¡Retirémonos\npor ahora!"

msgctxt "dialogue/418/0xc"
msgid "dialogue/418/0xc"
msgstr "Regina\nOye, Jack. El niño que\nse llevaban esos\nladrones..."

msgctxt "dialogue/418/0x5d"
msgid "dialogue/418/0x5d"
msgstr "Jack\nSí, seguramente era el\npríncipe heredero\nRudolph."

msgctxt "dialogue/418/0x9e"
msgid "dialogue/418/0x9e"
msgstr "{name}\n......"

msgctxt "dialogue/418/0xbf"
msgid "dialogue/418/0xbf"
msgstr "Regina\nPero ¿por qué ellos?\n¿No son simples ladrones?"

msgctxt "dialogue/418/0x108"
msgid "dialogue/418/0x108"
msgstr "Jack\nNo lo sé. Pero..."

msgctxt "dialogue/418/0x13e"
msgid "dialogue/418/0x13e"
msgstr "Arth\nAlguien mueve los hilos."

msgctxt "dialogue/418/0x16a"
msgid "dialogue/418/0x16a"
msgstr "Arth\nEl Imperio no es tan\nidiota como para dejar\nque unos ladrones\nsecuestren al heredero."

msgctxt "dialogue/418/0x1cd"
msgid "dialogue/418/0x1cd"
msgstr "Regina\nEntonces, ¿es Gale...?"

msgctxt "dialogue/418/0x201"
msgid "dialogue/418/0x201"
msgstr "Jack\n...Seguramente."

msgctxt "dialogue/418/0x238"
msgid "dialogue/418/0x238"
msgstr "{name}\n......"

msgctxt "dialogue/418/0x259"
msgid "dialogue/418/0x259"
msgstr "Jack\nEstoy bien, Alteza...\nAhora lo importante es\nrescatar a Su Alteza\nRudolph."

msgctxt "dialogue/418/0x2b2"
msgid "dialogue/418/0x2b2"
msgstr "Arth\n¿Avisamos al ejército\nimperial?"

msgctxt "dialogue/418/0x2e0"
msgid "dialogue/418/0x2e0"
msgstr "Jack\nNo. Esos soldados\nimperiales dispararon\naun estando allí el\npríncipe."

msgctxt "dialogue/418/0x32d"
msgid "dialogue/418/0x32d"
msgstr "Jack\nNo tengo pruebas, pero..."

msgctxt "dialogue/418/0x35d"
msgid "dialogue/418/0x35d"
msgstr "Arth\nO sea, que el Imperio no\nestá tan unido."

msgctxt "dialogue/418/0x397"
msgid "dialogue/418/0x397"
msgstr "Jack\nEso parece."

msgctxt "dialogue/418/0x3af"
msgid "dialogue/418/0x3af"
msgstr "Jack\nY también me preocupa\nque el instruc... que\nGale esté metido."

msgctxt "dialogue/418/0x3f4"
msgid "dialogue/418/0x3f4"
msgstr "Jack\nLo más sensato es que\nactuemos por nuestra\ncuenta."

msgctxt "dialogue/418/0x43b"
msgid "dialogue/418/0x43b"
msgstr "Regina\nPero ¿adónde habrán ido?"

msgctxt "dialogue/418/0x479"
msgid "dialogue/418/0x479"
msgstr "Jack\nSeguramente a la meseta\nde Galil."

msgctxt "dialogue/418/0x4b0"
msgid "dialogue/418/0x4b0"
msgstr "{name}\n......"

msgctxt "dialogue/418/0x4d1"
msgid "dialogue/418/0x4d1"
msgstr "Regina\n¿Por qué?"

msgctxt "dialogue/418/0x4f3"
msgid "dialogue/418/0x4f3"
msgstr "Jack\nAl norte está el\ndesierto, pero huir con\nun niño por allí sería\ndifícil."

msgctxt "dialogue/418/0x538"
msgid "dialogue/418/0x538"
msgstr "Jack\nNo hay dónde ponerse a\ncubierto."

msgctxt "dialogue/418/0x56a"
msgid "dialogue/418/0x56a"
msgstr "Jack\nDesde el aire los\nverían enseguida."

msgctxt "dialogue/418/0x59e"
msgid "dialogue/418/0x59e"
msgstr "Jack\nAl este, la sierra de\nIselina es el frente con\nla República. Habrá\nmuchas tropas imperiales."

msgctxt "dialogue/418/0x605"
msgid "dialogue/418/0x605"
msgstr "Arth\nPor descarte, la meseta\nde Galil. Sí que parece\nhaber sitios donde\nesconderse."

msgctxt "dialogue/418/0x664"
msgid "dialogue/418/0x664"
msgstr "Regina\nEntonces, vayamos de\nmomento a la meseta\nde Galil."

msgctxt "dialogue/418/0x6ad"
msgid "dialogue/418/0x6ad"
msgstr "Jack\nBien. La meseta de Galil\nestá al noreste de aquí."

msgctxt "dialogue/418/0x6ec"
msgid "dialogue/418/0x6ec"
msgstr "Jack\nQuizá hayan parado en\nalgún pueblo. Allí\npodríamos averiguar algo."

msgctxt "dialogue/418/0x751"
msgid "dialogue/418/0x751"
msgstr "Arth\nVamos."

msgctxt "dialogue/419/0x3"
msgid "dialogue/419/0x3"
msgstr "Soldado imperial\n¡Viva el Imperio! ¡Gloria\na Su Excelencia Prozen!"

msgctxt "dialogue/420/0x3"
msgid "dialogue/420/0x3"
msgstr "Soldado imperial\nLa taberna de ahí es\nfamosa por su buen vino."

msgctxt "dialogue/421/0x3"
msgid "dialogue/421/0x3"
msgstr "Vecino\n¿Un barbudo? Pues no,\nno he visto a ninguno."

msgctxt "dialogue/422/0x3"
msgid "dialogue/422/0x3"
msgstr "Vecino\nEsto es Hagen City, la\nciudad más rica del\nImperio."

msgctxt "dialogue/423/0x3"
msgid "dialogue/423/0x3"
msgstr "Vecino\n¿Conocéis las ruinas de\nGalil? Son unas ruinas\nantiguas de la meseta\nde Galil."

msgctxt "dialogue/424/0x3"
msgid "dialogue/424/0x3"
msgstr "Vecino\nQué mono es Su Alteza\nRudolph, ¿verdad?"

msgctxt "dialogue/425/0x3"
msgid "dialogue/425/0x3"
msgstr "Vecino\nAnoche vi un Zoid que no\nhabía visto nunca. ¡Tenía\nuna cara que daba tanto\nmiedo como mamá enfadada!"

msgctxt "dialogue/426/0x3"
msgid "dialogue/426/0x3"
msgstr "Vecino\nOjalá tuviera un hermano\nmayor como el señor\nRudolph..."

msgctxt "dialogue/427/0xc"
msgid "dialogue/427/0xc"
msgstr "Stinger\nVaya, vaya, no os había\nvisto nunca por aquí.\n¿Qué os trae a esta\nciudad?"

msgctxt "dialogue/427/0x6b"
msgid "dialogue/427/0x6b"
msgstr "Jack\nE-esto... ¿Y usted es...?"

msgctxt "dialogue/427/0x97"
msgid "dialogue/427/0x97"
msgstr "Stinger\n¿Yo? ¡Eso da igual,\nquerido! Prefiero que me\nhables de ti..."

msgctxt "dialogue/427/0x102"
msgid "dialogue/427/0x102"
msgstr "Jack\nN-no, solo estamos\nbuscando a alguien..."

msgctxt "dialogue/427/0x13e"
msgid "dialogue/427/0x13e"
msgstr "Stinger\n¡Oh! ¿A alguien? ¿Y a\nquién buscáis?"

msgctxt "dialogue/427/0x186"
msgid "dialogue/427/0x186"
msgstr "Regina\nA un hombre y una mujer\ncon un niño..."

msgctxt "dialogue/427/0x1c4"
msgid "dialogue/427/0x1c4"
msgstr "Stinger\n¡No te lo he preguntado\na ti! ¡Qué mujer más\nentrometida!"

msgctxt "dialogue/427/0x215"
msgid "dialogue/427/0x215"
msgstr "Regina\n¿¡C-cómo dices!?"

msgctxt "dialogue/427/0x245"
msgid "dialogue/427/0x245"
msgstr "Jack\nRegina... Disculpe.\nEstamos buscando a una\npareja con un niño..."

msgctxt "dialogue/427/0x29e"
msgid "dialogue/427/0x29e"
msgstr "Jack\nPuede que vayan con un\nhombre con barba."

msgctxt "dialogue/427/0x2e7"
msgid "dialogue/427/0x2e7"
msgstr "Stinger\nMmm, una pareja con un\nniño... No me suena."

msgctxt "dialogue/427/0x33a"
msgid "dialogue/427/0x33a"
msgstr "Jack\nEntiendo... Muchas\ngracias."

msgctxt "dialogue/427/0x37a"
msgid "dialogue/427/0x37a"
msgstr "Stinger\nAy, quedaos un ratito\nmás, hombre..."

msgctxt "dialogue/427/0x3c9"
msgid "dialogue/427/0x3c9"
msgstr "Jack\n¡N-no, tenemos prisa!\n¡Hasta luego!"

msgctxt "dialogue/428/0xc"
msgid "dialogue/428/0xc"
msgstr "Stinger\nNos volveremos a ver...\nMmm, ji, ji, ji..."

msgctxt "dialogue/429/0xc"
msgid "dialogue/429/0xc"
msgstr "Stinger\nUf... Lo de siempre."

msgctxt "dialogue/429/0x39"
msgid "dialogue/429/0x39"
msgstr "Tabernero\n¿Qué te pasa, Stinger?\n¿Y tu coquetería de\nsiempre?"

msgctxt "dialogue/429/0x7e"
msgid "dialogue/429/0x7e"
msgstr "Tabernero\n¿Te la has dejado por\nahí? Toma, lo de siempre."

msgctxt "dialogue/429/0xd5"
msgid "dialogue/429/0xd5"
msgstr "Stinger\nAaah, esto resucita a\ncualquiera. ¡Qué gente\nmás horrible!"

msgctxt "dialogue/429/0x11e"
msgid "dialogue/429/0x11e"
msgstr "Stinger\n¡Y eso que yo quería\nsolucionarlo hablando!"

msgctxt "dialogue/429/0x16b"
msgid "dialogue/429/0x16b"
msgstr "Regina\nIncreíble. ¿A eso lo\nllamas hablar?"

msgctxt "dialogue/430/0xc"
msgid "dialogue/430/0xc"
msgstr "Stinger\n¡Ah! ¿Q-qué hacéis\nvosotros aquí?"

msgctxt "dialogue/430/0x57"
msgid "dialogue/430/0x57"
msgstr "Arth\nTe estábamos esperando."

msgctxt "dialogue/430/0x85"
msgid "dialogue/430/0x85"
msgstr "Stinger\n¡Ay! ¡E-esto no quedará\nasí!"

msgctxt "dialogue/431/0xc"
msgid "dialogue/431/0xc"
msgstr "Jack\nArth... Tampoco hacía\nfalta llegar a tanto..."

msgctxt "dialogue/431/0x53"
msgid "dialogue/431/0x53"
msgstr "Arth\nLe servirá de lección."

msgctxt "dialogue/432/0xc"
msgid "dialogue/432/0xc"
msgstr "Arth\n¿Enemigos?"

msgctxt "dialogue/433/0xc"
msgid "dialogue/433/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/433/0x2d"
msgid "dialogue/433/0x2d"
msgstr "Jack\nEste humo... ¿¡Es gas\nvenenoso!?"

msgctxt "dialogue/433/0x63"
msgid "dialogue/433/0x63"
msgstr "Jack\n¡Regina! ¡Llévate al\npríncipe y huid de aquí!"

msgctxt "dialogue/433/0xb8"
msgid "dialogue/433/0xb8"
msgstr "Regina\n¡Entendido!"

msgctxt "dialogue/434/0xc"
msgid "dialogue/434/0xc"
msgstr "Stinger\nVaya, vaya, no os será\ntan fácil escapar."

msgctxt "dialogue/434/0x50"
msgid "dialogue/434/0x50"
msgstr "Jack\nCof, cof... ¿Q-quién es\nusted?"

msgctxt "dialogue/434/0x88"
msgid "dialogue/434/0x88"
msgstr "Stinger\nSoy Stinger,\ncazarrecompensas."

msgctxt "dialogue/434/0xbe"
msgid "dialogue/434/0xbe"
msgstr "Stinger\nNo quiero mataros ni\nnada. ¡Solo quiero que me\ncontéis una cosita!"

msgctxt "dialogue/434/0x117"
msgid "dialogue/434/0x117"
msgstr "Stinger\nVosotros también buscáis\na Su Alteza Rudolph,\n¿verdad? Quiero que me\ncontéis lo que sabéis."

msgctxt "dialogue/434/0x17e"
msgid "dialogue/434/0x17e"
msgstr "Regina\nCof, cof... ¿Y por eso\nhaces todo esto?"

msgctxt "dialogue/434/0x1be"
msgid "dialogue/434/0x1be"
msgstr "Stinger\nAy, ¿acaso me lo\nhabríais contado por las\nbuenas?"

msgctxt "dialogue/434/0x1f6"
msgid "dialogue/434/0x1f6"
msgstr "Stinger\nVenga, venga, daos prisa,\nque el gas se os va a\nextender por todo el\ncuerpo."

msgctxt "dialogue/434/0x23b"
msgid "dialogue/434/0x23b"
msgstr "Stinger\nAunque tranquilos, que no\nes mortal. Solo os dejará\nel cuerpo entumecido un\nratito."

msgctxt "dialogue/434/0x292"
msgid "dialogue/434/0x292"
msgstr "Stinger\nAunque por mí, podría\nseguir torturándoos así\nun rato más..."

msgctxt "dialogue/434/0x2e3"
msgid "dialogue/434/0x2e3"
msgstr "Arth\n¡Déjate de tonterías!"

msgctxt "dialogue/434/0x30b"
msgid "dialogue/434/0x30b"
msgstr "Stinger\nLo sabía, vais a luchar.\n¡Así me divierto más!"

msgctxt "dialogue/434/0x352"
msgid "dialogue/434/0x352"
msgstr "Stinger\n¡Saboread bien la fuerza\ndel Stinger Special!"

msgctxt "dialogue/435/0xc"
msgid "dialogue/435/0xc"
msgstr "Regina\nPríncipe, ¿está bien?"

msgctxt "dialogue/435/0x3f"
msgid "dialogue/435/0x3f"
msgstr "{name}\n......"

msgctxt "dialogue/435/0x60"
msgid "dialogue/435/0x60"
msgstr "Jack\nPuede que aún tenga el\ncuerpo entumecido, pero\nse pondrá bien."

msgctxt "dialogue/435/0xaf"
msgid "dialogue/435/0xaf"
msgstr "Arth\n¿Te fías de lo que dijo?"

msgctxt "dialogue/435/0xdf"
msgid "dialogue/435/0xdf"
msgstr "Jack\nNo es eso..."

msgctxt "dialogue/435/0xff"
msgid "dialogue/435/0xff"
msgstr "Jack\nPero, si hubiera querido\nmatarnos, habría usado un\ngas más potente."

msgctxt "dialogue/435/0x160"
msgid "dialogue/435/0x160"
msgstr "Regina\n¡Aun así, no me parece\nnada bien!"

msgctxt "dialogue/435/0x1a0"
msgid "dialogue/435/0x1a0"
msgstr "Jack\nVamos, vamos. Descansemos\nun poco antes de partir."

msgctxt "dialogue/436/0xc"
msgid "dialogue/436/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/436/0x2d"
msgid "dialogue/436/0x2d"
msgstr "Regina\n¿Un Iron Kong?"

msgctxt "dialogue/436/0x59"
msgid "dialogue/436/0x59"
msgstr "Jack\nParece que lo han\ndestruido hace poco."

msgctxt "dialogue/436/0x95"
msgid "dialogue/436/0x95"
msgstr "Arth\n......"

msgctxt "dialogue/436/0xbc"
msgid "dialogue/436/0xbc"
msgstr "{name}\n......"

msgctxt "dialogue/436/0xdd"
msgid "dialogue/436/0xdd"
msgstr "Regina\n¿Qué pasa, Arth?"

msgctxt "dialogue/436/0x10d"
msgid "dialogue/436/0x10d"
msgstr "Arth\nEste Iron Kong... ¿cómo\ncrees que lo destruyeron?"

msgctxt "dialogue/436/0x158"
msgid "dialogue/436/0x158"
msgstr "Regina\n¿Eh? ¿Cómo lo\ndestruyeron?"

msgctxt "dialogue/436/0x184"
msgid "dialogue/436/0x184"
msgstr "Jack\nCierto. Hay marcas de\ncombate cuerpo a cuerpo\naquí y allá, pero el\ngolpe mortal..."

msgctxt "dialogue/436/0x1db"
msgid "dialogue/436/0x1db"
msgstr "Jack\nNo sabría decir qué\nataque recibió."

msgctxt "dialogue/436/0x21d"
msgid "dialogue/436/0x21d"
msgstr "Regina\n¿Y dices que más adelante\nhay un enemigo tan\nmisterioso?"

msgctxt "dialogue/436/0x273"
msgid "dialogue/436/0x273"
msgstr "{name}\n......"

msgctxt "dialogue/436/0x294"
msgid "dialogue/436/0x294"
msgstr "Arth\nNo lo sé. Pero toda\nprecaución es poca."

msgctxt "dialogue/437/0xc"
msgid "dialogue/437/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/437/0x2d"
msgid "dialogue/437/0x2d"
msgstr "Regina\n¿Gente? ...¡Son ellos!"

msgctxt "dialogue/437/0x63"
msgid "dialogue/437/0x63"
msgstr "Jack\nParece la banda de\nladrones. Pero ¿dónde\nestá Su Alteza Rudolph?"

msgctxt "dialogue/437/0xb0"
msgid "dialogue/437/0xb0"
msgstr "Arth\nSe lo preguntaremos."

msgctxt "dialogue/438/0xc"
msgid "dialogue/438/0xc"
msgstr "Rosso\n¿Vosotros otra vez? Está\nclaro que el destino nos\nune."

msgctxt "dialogue/438/0x4e"
msgid "dialogue/438/0x4e"
msgstr "Jack\n¿Cómo se han herido? ¿Y\ndónde está Su Alteza\nRudolph?"

msgctxt "dialogue/438/0x9b"
msgid "dialogue/438/0x9b"
msgstr "Rosso\nUna pregunta cada vez,\nsi no te importa."

msgctxt "dialogue/438/0xd3"
msgid "dialogue/438/0xd3"
msgstr "Regina\nPrimero, las heridas. Tú\npareces estar bien, pero\nella lo está pasando\nmal."

msgctxt "dialogue/438/0x134"
msgid "dialogue/438/0x134"
msgstr "Viola\n...Ugh... ¡No quiero\nvuestra compasión! ¡Ay!"

msgctxt "dialogue/438/0x17f"
msgid "dialogue/438/0x17f"
msgstr "Rosso\n¡No te esfuerces, Viola!"

msgctxt "dialogue/438/0x1b3"
msgid "dialogue/438/0x1b3"
msgstr "Jack\nPrimero curemos esas\nheridas."

msgctxt "dialogue/438/0x1e4"
msgid "dialogue/438/0x1e4"
msgstr "{name}\n......"

msgctxt "dialogue/439/0xc"
msgid "dialogue/439/0xc"
msgstr "Rosso\n...Gracias."

msgctxt "dialogue/439/0x34"
msgid "dialogue/439/0x34"
msgstr "Arth\n¿Qué ha pasado?"

msgctxt "dialogue/439/0x5a"
msgid "dialogue/439/0x5a"
msgstr "Rosso\n...¿Por dónde empiezo...?"

msgctxt "dialogue/439/0x94"
msgid "dialogue/439/0x94"
msgstr "Jack\nPrimero, cuéntennos cómo\nse hirieron."

msgctxt "dialogue/439/0xd4"
msgid "dialogue/439/0xd4"
msgstr "Rosso\n¿Visteis un Iron Kong en\nla entrada de las ruinas?"

msgctxt "dialogue/439/0x114"
msgid "dialogue/439/0x114"
msgstr "Jack\n¿Un Iron Kong? ¿El que\nestaba destruido?"

msgctxt "dialogue/439/0x152"
msgid "dialogue/439/0x152"
msgstr "Rosso\nEso es. Íbamos montados\nen él."

msgctxt "dialogue/439/0x180"
msgid "dialogue/439/0x180"
msgstr "Rosso\nRudolph se había perdido\ny lo estábamos buscando\npor la zona."

msgctxt "dialogue/439/0x1c5"
msgid "dialogue/439/0x1c5"
msgstr "Arth\n¿Perdido? ¿No será que se\nos escapó?"

msgctxt "dialogue/439/0x203"
msgid "dialogue/439/0x203"
msgstr "Viola\n¡No es eso! Rudolph se\nperdió, y él lo buscaba\ndesesperado..."

msgctxt "dialogue/439/0x25a"
msgid "dialogue/439/0x25a"
msgstr "Rosso\nDéjalo, Viola. Pueden\npensar lo que quieran."

msgctxt "dialogue/439/0x299"
msgid "dialogue/439/0x299"
msgstr "Rosso\nRudolph estaba con Van y\nlos suyos. Y ese tipo los\natacó."

msgctxt "dialogue/439/0x2ea"
msgid "dialogue/439/0x2ea"
msgstr "Regina\n¿Van? Entonces, Su Alteza\nRudolph está con Van y\nlos demás."

msgctxt "dialogue/439/0x33d"
msgid "dialogue/439/0x33d"
msgstr "Rosso\nSí, eso creo."

msgctxt "dialogue/439/0x36e"
msgid "dialogue/439/0x36e"
msgstr "{name}\n......"

msgctxt "dialogue/439/0x38f"
msgid "dialogue/439/0x38f"
msgstr "Jack\nYa veo. Ya sabemos qué\nha sido de Su Alteza\nRudolph. Pero ¿quién es\nese tipo?"

msgctxt "dialogue/439/0x3e6"
msgid "dialogue/439/0x3e6"
msgstr "Rosso\nNo sé quién era. Era un\nZoid que no había visto\nnunca. Increíblemente\nfuerte."

msgctxt "dialogue/439/0x431"
msgid "dialogue/439/0x431"
msgstr "Rosso\nPero lo que está claro es\nque quería matar a\nRudolph."

msgctxt "dialogue/439/0x47a"
msgid "dialogue/439/0x47a"
msgstr "Viola\nPor eso dejamos a Rudolph\ncon Van y los demás. No\nhabríamos podido ganar..."

msgctxt "dialogue/439/0x4df"
msgid "dialogue/439/0x4df"
msgstr "Regina\n¿Quieren matar a Su\nAlteza Rudolph? ¿Quién?"

msgctxt "dialogue/439/0x51b"
msgid "dialogue/439/0x51b"
msgstr "Rosso\nEl regente, Gunter\nProzen."

msgctxt "dialogue/439/0x547"
msgid "dialogue/439/0x547"
msgstr "Rosso\nPara hacerse con el\nImperio, Rudolph le\nestorbaba."

msgctxt "dialogue/439/0x592"
msgid "dialogue/439/0x592"
msgstr "Viola\nPor eso nosotros\nprotegíamos a Rudolph..."

msgctxt "dialogue/439/0x5d0"
msgid "dialogue/439/0x5d0"
msgstr "Regina\n¿No lo habíais\nsecuestrado vosotros?"

msgctxt "dialogue/439/0x60e"
msgid "dialogue/439/0x60e"
msgstr "Viola\nEs cierto que nosotros\nsecuestramos a Rudolph."

msgctxt "dialogue/439/0x642"
msgid "dialogue/439/0x642"
msgstr "Viola\nPero a la vez querían\nmatarlo. Por eso\nnosotros..."

msgctxt "dialogue/439/0x6a1"
msgid "dialogue/439/0x6a1"
msgstr "Rosso\nCreedlo o no, es cosa\nvuestra. Juzgad como\nqueráis."

msgctxt "dialogue/439/0x6f7"
msgid "dialogue/439/0x6f7"
msgstr "¿Te crees lo que ha\ncontado Rosso?"

msgctxt "dialogue/440/0xc"
msgid "dialogue/440/0xc"
msgstr "Jack\nPríncipe..."

msgctxt "dialogue/440/0x33"
msgid "dialogue/440/0x33"
msgstr "{name}\n......"

msgctxt "dialogue/440/0x54"
msgid "dialogue/440/0x54"
msgstr "Jack\nLes creo."

msgctxt "dialogue/440/0x6e"
msgid "dialogue/440/0x6e"
msgstr "Jack\nResultaron heridos para\nque Su Alteza Rudolph\npudiera escapar con Van\ny los demás."

msgctxt "dialogue/440/0xc5"
msgid "dialogue/440/0xc5"
msgstr "Jack\nLes creo. Creo en\nustedes."

msgctxt "dialogue/440/0xfd"
msgid "dialogue/440/0xfd"
msgstr "Rosso\n...Ya veo. Gracias."

msgctxt "dialogue/440/0x12d"
msgid "dialogue/440/0x12d"
msgstr "Jack\nY déjenme hacerles otra\npregunta. ¿Conocen a un\nhombre llamado Gale?"

msgctxt "dialogue/440/0x188"
msgid "dialogue/440/0x188"
msgstr "Rosso\n¿Gale? ¿Quién es ese?"

msgctxt "dialogue/440/0x1b4"
msgid "dialogue/440/0x1b4"
msgstr "Jack\nNo, es que pensábamos que\nera quien estaba detrás\nde ustedes..."

msgctxt "dialogue/440/0x1fe"
msgid "dialogue/440/0x1fe"
msgstr "Rosso\nJe. Fuimos de las fuerzas\nespeciales del ejército\nimperial. Para secuestrar\na Rudolph nos bastamos\nsolos."

msgctxt "dialogue/440/0x261"
msgid "dialogue/440/0x261"
msgstr "Viola\nPor cierto... no sé si\nsería ese tal Gale,\npero..."

msgctxt "dialogue/440/0x2bc"
msgid "dialogue/440/0x2bc"
msgstr "Rosso\n¿Qué pasa, Viola?"

msgctxt "dialogue/440/0x2e8"
msgid "dialogue/440/0x2e8"
msgstr "Viola\nVi un Gojulas que se\ndirigía a estas ruinas."

msgctxt "dialogue/440/0x333"
msgid "dialogue/440/0x333"
msgstr "Arth\n¿Un Gojulas?"

msgctxt "dialogue/440/0x359"
msgid "dialogue/440/0x359"
msgstr "Regina\n¿Qué significará?"

msgctxt "dialogue/440/0x389"
msgid "dialogue/440/0x389"
msgstr "Jack\nPuede que al fondo de\nestas ruinas haya algo\nque interese a Gale."

msgctxt "dialogue/440/0x3da"
msgid "dialogue/440/0x3da"
msgstr "Jack\nPríncipe, vamos a verlo."

msgctxt "dialogue/440/0x403"
msgid "dialogue/440/0x403"
msgstr "¡Rosso y Viola se han\nunido al grupo!"

msgctxt "dialogue/441/0xc"
msgid "dialogue/441/0xc"
msgstr "Jack\nPríncipe..."

msgctxt "dialogue/441/0x33"
msgid "dialogue/441/0x33"
msgstr "{name}\n......"

msgctxt "dialogue/441/0x54"
msgid "dialogue/441/0x54"
msgstr "Jack\nCuesta creerlo."

msgctxt "dialogue/441/0x74"
msgid "dialogue/441/0x74"
msgstr "Jack\nEs cierto que parece que\nquerían matar a Su Alteza\nRudolph, pero..."

msgctxt "dialogue/441/0xbb"
msgid "dialogue/441/0xbb"
msgstr "Jack\nEso no cambia que\nustedes lo secuestraron."

msgctxt "dialogue/441/0x114"
msgid "dialogue/441/0x114"
msgstr "Viola\n¡Pero...!"

msgctxt "dialogue/441/0x13a"
msgid "dialogue/441/0x13a"
msgstr "Rosso\n¡Basta, Viola! Es lo\nnormal que lo piensen."

msgctxt "dialogue/441/0x173"
msgid "dialogue/441/0x173"
msgstr "Rosso\nGracias por todo."

msgctxt "dialogue/441/0x19b"
msgid "dialogue/441/0x19b"
msgstr "Viola\nRosso..."

msgctxt "dialogue/442/0xc"
msgid "dialogue/442/0xc"
msgstr "Rosso\nPor curarme las heridas,\nos voy a contar algo."

msgctxt "dialogue/442/0x49"
msgid "dialogue/442/0x49"
msgstr "Rosso\nInvestigad el fondo de\nestas ruinas. Puede que\ndescubráis algo curioso."

msgctxt "dialogue/442/0x96"
msgid "dialogue/442/0x96"
msgstr "Jack\n¿El fondo de las ruinas?\nPríncipe, vayamos a ver."

msgctxt "dialogue/443/0xc"
msgid "dialogue/443/0xc"
msgstr "Arth\nLlegamos tarde."

msgctxt "dialogue/443/0x36"
msgid "dialogue/443/0x36"
msgstr "Jack\nSí. Pero ¿qué demonios\nhabía aquí?"

msgctxt "dialogue/443/0x72"
msgid "dialogue/443/0x72"
msgstr "Arth\nNi idea."

msgctxt "dialogue/443/0x93"
msgid "dialogue/443/0x93"
msgstr "{name}\n......"

msgctxt "dialogue/443/0xb4"
msgid "dialogue/443/0xb4"
msgstr "Jack\nJa, ja. Es verdad."

msgctxt "dialogue/443/0xe2"
msgid "dialogue/443/0xe2"
msgstr "Regina\n¿Esto también es obra\nde Gale?"

msgctxt "dialogue/443/0x112"
msgid "dialogue/443/0x112"
msgstr "Jack\n...No lo sé. Parece\ndemasiado grande para\nllevárselo una sola\npersona."

msgctxt "dialogue/443/0x16b"
msgid "dialogue/443/0x16b"
msgstr "Jack\nEn cualquier caso, aquí\nya no queda nada."

msgctxt "dialogue/443/0x1b4"
msgid "dialogue/443/0x1b4"
msgstr "Regina\nEs verdad. Salgamos de\nlas ruinas por ahora."

msgctxt "dialogue/444/0xc"
msgid "dialogue/444/0xc"
msgstr "Arth\n¿Un combate? Está cerca."

msgctxt "dialogue/444/0x34"
msgid "dialogue/444/0x34"
msgstr "Regina\n¿Serán Van y los demás?\n¿O Gale?"

msgctxt "dialogue/444/0x70"
msgid "dialogue/444/0x70"
msgstr "Jack\nNo lo sé. ¡En cualquier\ncaso, vamos a ver!"

msgctxt "dialogue/445/0xc"
msgid "dialogue/445/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/445/0x2d"
msgid "dialogue/445/0x2d"
msgstr "Regina\n¿Un Command Wolf? ¿Qué\nhace aquí una unidad de\nla República?"

msgctxt "dialogue/445/0x7e"
msgid "dialogue/445/0x7e"
msgstr "Arth\n...¿Quién ha sido?\n¿Un rayo? No, no es\neso..."

msgctxt "dialogue/445/0xc1"
msgid "dialogue/445/0xc1"
msgstr "Jack\nParece un arma mucho\nmás potente que un\nrayo..."

msgctxt "dialogue/445/0x102"
msgid "dialogue/445/0x102"
msgstr "Jack\nPero antes busquemos\nsupervivientes."

msgctxt "dialogue/446/0xc"
msgid "dialogue/446/0xc"
msgstr "Regina\n¿Estás bien?"

msgctxt "dialogue/446/0x27"
msgid "dialogue/446/0x27"
msgstr "Agente de inteligencia\nS-sí, más o menos...\n¿Quiénes sois?"

msgctxt "dialogue/446/0x69"
msgid "dialogue/446/0x69"
msgstr "Arth\nPasábamos por aquí."

msgctxt "dialogue/446/0x86"
msgid "dialogue/446/0x86"
msgstr "Agente de inteligencia\nPasabais por aquí...\nPues vais muy armados\npara estar de paso."

msgctxt "dialogue/446/0xd5"
msgid "dialogue/446/0xd5"
msgstr "Jack\n¿Qué ha pasado? ¿Quién\nera el enemigo...?"

msgctxt "dialogue/446/0x109"
msgid "dialogue/446/0x109"
msgstr "Agente de inteligencia\nFue en un abrir y cerrar\nde ojos."

msgctxt "dialogue/446/0x12b"
msgid "dialogue/446/0x12b"
msgstr "Agente de inteligencia\nUn Zoid solitario se nos\nechó encima y nos atacó\nsin mediar palabra."

msgctxt "dialogue/446/0x17a"
msgid "dialogue/446/0x17a"
msgstr "Agente de inteligencia\nNunca había visto un Zoid\nasí. No sale en las\ntablas de identificación.\nPuede que sea un nuevo\nmodelo imperial."

msgctxt "dialogue/446/0x1df"
msgid "dialogue/446/0x1df"
msgstr "Arth\n¿Qué armas llevaba?"

msgctxt "dialogue/446/0x20c"
msgid "dialogue/446/0x20c"
msgstr "Agente de inteligencia\nNo lo sé. Era como si el\npropio Zoid se\nconvirtiera en un cañón\ny nos disparara."

msgctxt "dialogue/446/0x255"
msgid "dialogue/446/0x255"
msgstr "Agente de inteligencia\nNunca había visto un arma\ntan potente... No, un\nenemigo tan aterrador."

msgctxt "dialogue/446/0x2ac"
msgid "dialogue/446/0x2ac"
msgstr "Agente de inteligencia\nAdemás, llevaba un\norganoide negro. Puede\nque fuera ese Raven del\nque tanto se habla."

msgctxt "dialogue/446/0x30f"
msgid "dialogue/446/0x30f"
msgstr "Arth\nRaven..."

msgctxt "dialogue/446/0x337"
msgid "dialogue/446/0x337"
msgstr "Regina\nEse piloto tan fuerte\ncon el que luchamos\nantes..."

msgctxt "dialogue/446/0x37b"
msgid "dialogue/446/0x37b"
msgstr "Jack\nPero antes pilotaba un\nSaber Tiger."

msgctxt "dialogue/446/0x3bc"
msgid "dialogue/446/0x3bc"
msgstr "Jack\n¿Habrá cambiado de Zoid?"

msgctxt "dialogue/447/0xc"
msgid "dialogue/447/0xc"
msgstr "Rosso\nEl Zoid que nos atacó\nseguramente era ese."

msgctxt "dialogue/447/0x47"
msgid "dialogue/447/0x47"
msgstr "Rosso\nEstoy seguro de que Van\nlo llamó Raven."

msgctxt "dialogue/447/0x80"
msgid "dialogue/447/0x80"
msgstr "Agente de inteligencia\n¿Van? ¿El chico del\nShield Liger azul?\nEntonces, ¿el Dr. D\ntambién...?"

msgctxt "dialogue/447/0xe9"
msgid "dialogue/447/0xe9"
msgstr "Regina\nSí, conocemos a ambos,\npero..."

msgctxt "dialogue/447/0x116"
msgid "dialogue/447/0x116"
msgstr "Agente de inteligencia\nMenos mal."

msgctxt "dialogue/447/0x136"
msgid "dialogue/447/0x136"
msgstr "Agente de inteligencia\nLo cierto es que íbamos\na llevar a la República\nlos planos de un nuevo\nZoid volador imperial."

msgctxt "dialogue/447/0x191"
msgid "dialogue/447/0x191"
msgstr "Agente de inteligencia\nSi conocéis al Dr. D,\nsois de fiar. ¿Podríais\nayudarme a llevar esto\na la República?"

msgctxt "dialogue/447/0x1fb"
msgid "dialogue/447/0x1fb"
msgstr "{name}\n......"

msgctxt "dialogue/447/0x21c"
msgid "dialogue/447/0x21c"
msgstr "Jack\nPero nosotros también\ntenemos cosas que..."

msgctxt "dialogue/447/0x254"
msgid "dialogue/447/0x254"
msgstr "Rosso\nIremos nosotros. La\nRepública queda al otro\nlado del monte Iselina,\n¿verdad?"

msgctxt "dialogue/447/0x299"
msgid "dialogue/447/0x299"
msgstr "Rosso\nJusto íbamos hacia el\nmonte Iselina."

msgctxt "dialogue/447/0x2e8"
msgid "dialogue/447/0x2e8"
msgstr "Viola\nRosso, ¿seguro?"

msgctxt "dialogue/447/0x316"
msgid "dialogue/447/0x316"
msgstr "Rosso\nSí, no pasa nada. Hace\ntiempo que quería ir al\nmonte Iselina."

msgctxt "dialogue/447/0x375"
msgid "dialogue/447/0x375"
msgstr "Viola\n......Rosso."

msgctxt "dialogue/447/0x39c"
msgid "dialogue/447/0x39c"
msgstr "Agente de inteligencia\nEstupendo, gracias.\nEntonces, pongámonos en\nmarcha."

msgctxt "dialogue/447/0x3e3"
msgid "dialogue/447/0x3e3"
msgstr "Rosso\nAdiós. Gracias por todo."

msgctxt "dialogue/447/0x413"
msgid "dialogue/447/0x413"
msgstr "Jack\n...Sí. Tengan cuidado."

msgctxt "dialogue/448/0xc"
msgid "dialogue/448/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/448/0x2d"
msgid "dialogue/448/0x2d"
msgstr "Regina\n...Se han ido."

msgctxt "dialogue/448/0x5f"
msgid "dialogue/448/0x5f"
msgstr "Arth\nSí, pero ya nos veremos\nalgún día."

msgctxt "dialogue/449/0x3"
msgid "dialogue/449/0x3"
msgstr "Agente de inteligencia\n¡Ah! ¡Aaah!\n¡E-es él! ¡Ha vuelto!"

msgctxt "dialogue/450/0xc"
msgid "dialogue/450/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/450/0x2d"
msgid "dialogue/450/0x2d"
msgstr "Regina\n¿Qué? ¿Qué está pasando?"

msgctxt "dialogue/450/0x5f"
msgid "dialogue/450/0x5f"
msgstr "Jack\n¡No lo sé! Pero podría\nser Raven."

msgctxt "dialogue/450/0xaa"
msgid "dialogue/450/0xaa"
msgstr "Arth\n¡Vamos!"

msgctxt "dialogue/451/0xc"
msgid "dialogue/451/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/451/0x2d"
msgid "dialogue/451/0x2d"
msgstr "Regina\n¡¿Q-qué es eso?!"

msgctxt "dialogue/451/0x59"
msgid "dialogue/451/0x59"
msgstr "Jack\n¡Es Van! ¿Entonces el\notro es Raven?"

msgctxt "dialogue/451/0x9b"
msgid "dialogue/451/0x9b"
msgstr "Raven\nDeja que te presente\nformalmente a mi Zoid.\nEl Genosaurer."

msgctxt "dialogue/451/0xea"
msgid "dialogue/451/0xea"
msgstr "Van\n¿Genosaurer...?"

msgctxt "dialogue/451/0x118"
msgid "dialogue/451/0x118"
msgstr "Raven\nLa verdad es que has\nluchado bien contra mí...\nTe felicito."

msgctxt "dialogue/451/0x15b"
msgid "dialogue/451/0x15b"
msgstr "Raven\nPero hoy se acaba todo.\nLucha, Van. ¡Lucha\ncontra mí!"

msgctxt "dialogue/451/0x1a6"
msgid "dialogue/451/0x1a6"
msgstr "Van\n¡Maldita sea! Perdóname,\nFiona... ¡Voy a luchar!"

msgctxt "dialogue/452/0xc"
msgid "dialogue/452/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/452/0x2d"
msgid "dialogue/452/0x2d"
msgstr "Jack\nEs fuerte... Qué fuerza\ntan increíble..."

msgctxt "dialogue/452/0x65"
msgid "dialogue/452/0x65"
msgstr "Regina\n¿Qué es esto? ¡Esto no es\nun combate! ¡Está jugando\ncon él hasta matarlo!"

msgctxt "dialogue/452/0xbe"
msgid "dialogue/452/0xbe"
msgstr "Arth\n......¡Maldita sea!"

msgctxt "dialogue/452/0xea"
msgid "dialogue/452/0xea"
msgstr "Dr. D\nSerá insensato... ¡Con\nlo que le insistí en que\nno luchara!"

msgctxt "dialogue/452/0x137"
msgid "dialogue/452/0x137"
msgstr "Fiona\n...¡Van!"

msgctxt "dialogue/452/0x161"
msgid "dialogue/452/0x161"
msgstr "Van\n¡N-no pienso perder!"

msgctxt "dialogue/452/0x18f"
msgid "dialogue/452/0x18f"
msgstr "Raven\nHmpf. Forcejeos inútiles."

msgctxt "dialogue/452/0x1bb"
msgid "dialogue/452/0x1bb"
msgstr "Van\n¡Allá voooooy!"

msgctxt "dialogue/452/0x1e9"
msgid "dialogue/452/0x1e9"
msgstr "Raven\nJe... Se acabó."

msgctxt "dialogue/452/0x213"
msgid "dialogue/452/0x213"
msgstr "Dr. D\n¡No! ¡Huye, Van!"

msgctxt "dialogue/452/0x247"
msgid "dialogue/452/0x247"
msgstr "Fiona\n¡Aah!"

msgctxt "dialogue/453/0xc"
msgid "dialogue/453/0xc"
msgstr "Raven\nAdiós."

msgctxt "dialogue/454/0xc"
msgid "dialogue/454/0xc"
msgstr "Fiona\n¡Vaaaaan!"

msgctxt "dialogue/455/0xc"
msgid "dialogue/455/0xc"
msgstr "Dr. D\nVaya, sois vosotros.\n¡Cuánto tiempo!"

msgctxt "dialogue/455/0x50"
msgid "dialogue/455/0x50"
msgstr "Jack\nDr. D, cuánto tiempo.\nEsto... ¿Y Van?"

msgctxt "dialogue/455/0xa2"
msgid "dialogue/455/0xa2"
msgstr "{name}\n......"

msgctxt "dialogue/455/0xc3"
msgid "dialogue/455/0xc3"
msgstr "Dr. D\nNo os preocupéis por él.\nAhora ha ido a rescatar\na Su Alteza Rudolph."

msgctxt "dialogue/455/0x122"
msgid "dialogue/455/0x122"
msgstr "Regina\n...¿Estará bien?"

msgctxt "dialogue/455/0x156"
msgid "dialogue/455/0x156"
msgstr "Dr. D\n¡Bah! Van ha echado a\nandar."

msgctxt "dialogue/455/0x182"
msgid "dialogue/455/0x182"
msgstr "Dr. D\nLo pasará mal, pero es la\nprueba de que ha decidido\nhacer frente a ese dolor."

msgctxt "dialogue/455/0x1c9"
msgid "dialogue/455/0x1c9"
msgstr "Dr. D\nQuedarse parado no\nresuelve nada."

msgctxt "dialogue/455/0x201"
msgid "dialogue/455/0x201"
msgstr "Dr. D\nY no os preocupéis por el\nShield Liger. Aunque ha\nquedado muy maltrecho..."

msgctxt "dialogue/455/0x256"
msgid "dialogue/455/0x256"
msgstr "Dr. D\nHa llegado la hora de que\nobtenga un nuevo poder."

msgctxt "dialogue/455/0x296"
msgid "dialogue/455/0x296"
msgstr "Regina\n...Un nuevo poder..."

msgctxt "dialogue/455/0x2c7"
msgid "dialogue/455/0x2c7"
msgstr "{name}\n......"

msgctxt "dialogue/455/0x2e8"
msgid "dialogue/455/0x2e8"
msgstr "Dr. D\nPor cierto, quería\npediros un favor."

msgctxt "dialogue/455/0x332"
msgid "dialogue/455/0x332"
msgstr "{name}\n......"

msgctxt "dialogue/455/0x353"
msgid "dialogue/455/0x353"
msgstr "Dr. D\nEn la zona montañosa al\nsureste de aquí hay un\nlaboratorio secreto del\nImperio."

msgctxt "dialogue/455/0x3a4"
msgid "dialogue/455/0x3a4"
msgstr "Dr. D\nQuiero que le echéis un\nvistazo."

msgctxt "dialogue/455/0x3e2"
msgid "dialogue/455/0x3e2"
msgstr "Jack\n¿Al laboratorio del\nImperio?"

msgctxt "dialogue/455/0x40e"
msgid "dialogue/455/0x40e"
msgstr "Arth\nNo es asunto nuestro."

msgctxt "dialogue/455/0x440"
msgid "dialogue/455/0x440"
msgstr "Dr. D\nVamos, escuchadme hasta\nel final."

msgctxt "dialogue/455/0x468"
msgid "dialogue/455/0x468"
msgstr "Dr. D\nDicen que últimamente\nun barbudo desconocido\nentra y sale de allí."

msgctxt "dialogue/455/0x4c3"
msgid "dialogue/455/0x4c3"
msgstr "Jack\n¡Doctor...! ¿Quién es\nusted en realidad...?"

msgctxt "dialogue/455/0x501"
msgid "dialogue/455/0x501"
msgstr "Dr. D\nJo, jo, jo. Los años no\npasan en balde."

msgctxt "dialogue/455/0x54c"
msgid "dialogue/455/0x54c"
msgstr "Arth\n......"

msgctxt "dialogue/455/0x572"
msgid "dialogue/455/0x572"
msgstr "Fiona\n...Por favor...\nhaced caso al Dr. D."

msgctxt "dialogue/455/0x5bb"
msgid "dialogue/455/0x5bb"
msgstr "Jack\n.........¿Príncipe?"

msgctxt "dialogue/455/0x5f0"
msgid "dialogue/455/0x5f0"
msgstr "{name}\n......"

msgctxt "dialogue/455/0x611"
msgid "dialogue/455/0x611"
msgstr "Jack\nEntendido. Aceptamos el\nencargo."

msgctxt "dialogue/455/0x64b"
msgid "dialogue/455/0x64b"
msgstr "Dr. D\n¡Bien! Os lo agradezco."

msgctxt "dialogue/455/0x67b"
msgid "dialogue/455/0x67b"
msgstr "Jack\nDele recuerdos a Van y\na los demás. Vámonos."

msgctxt "dialogue/455/0x6ca"
msgid "dialogue/455/0x6ca"
msgstr "Arth\n...Sí."

msgctxt "dialogue/455/0x6ee"
msgid "dialogue/455/0x6ee"
msgstr "Regina\nEntendido."

msgctxt "dialogue/456/0xc"
msgid "dialogue/456/0xc"
msgstr "Jack\nPor lo visto, hay un\nlaboratorio en la zona\nde montaña, pero..."

msgctxt "dialogue/456/0x5d"
msgid "dialogue/456/0x5d"
msgstr "Regina\nTenemos muy poca\ninformación. Vamos a\nreunir un poco más."

msgctxt "dialogue/456/0x9a"
msgid "dialogue/456/0x9a"
msgstr "Regina\nA lo mejor hasta\naveriguamos algo sobre\nGale."

msgctxt "dialogue/456/0xeb"
msgid "dialogue/456/0xeb"
msgstr "Arth\nCierto. Por una vez\ndices algo sensato."

msgctxt "dialogue/456/0x123"
msgid "dialogue/456/0x123"
msgstr "Regina\n¡¿Cómo dices?!"

msgctxt "dialogue/456/0x14f"
msgid "dialogue/456/0x14f"
msgstr "Jack\nVamos, vamos. En todo\ncaso, reunamos\ninformación."

msgctxt "dialogue/457/0x3"
msgid "dialogue/457/0x3"
msgstr "Aldeano\n¿Eh? ¡En Gray Colony no\nhay más que árboles!\n¡Aquí no hay nada!"

msgctxt "dialogue/457/0x52"
msgid "dialogue/457/0x52"
msgstr "Aldeano\nAh, bueno, lo que sí hay\nes el castillo del\nregente Prozen."

msgctxt "dialogue/458/0x3"
msgid "dialogue/458/0x3"
msgstr "Aldeano\nÚltimamente, por la noche\nse alza una columna de\nluz en lo hondo del\nbosque."

msgctxt "dialogue/458/0x42"
msgid "dialogue/458/0x42"
msgstr "Aldeano\nDicen que después queda\ntodo lleno de árboles\nquemados. ¡Qué miedo!"

msgctxt "dialogue/459/0x3"
msgid "dialogue/459/0x3"
msgstr "Aldeano\n¿Te has enterado? ¡Dicen\nque hace poco vieron\nZoids de la República!"

msgctxt "dialogue/459/0x52"
msgid "dialogue/459/0x52"
msgstr "Aldeano\n¿Habrá otra guerra...?\n¡Qué angustia!"

msgctxt "dialogue/459/0x87"
msgid "dialogue/459/0x87"
msgstr "Aldeano\nPero, como cerca de aquí\nestá la mansión del\nregente Prozen, estamos\ntranquilos."

msgctxt "dialogue/459/0xd6"
msgid "dialogue/459/0xd6"
msgstr "Vecino\nSeguro que el señor\nProzen nos protegerá."

msgctxt "dialogue/460/0x3"
msgid "dialogue/460/0x3"
msgstr "Aldeano\nEscucha lo que vi el\notro día."

msgctxt "dialogue/460/0x27"
msgid "dialogue/460/0x27"
msgstr "Aldeano\nIban hacia el fondo de\nlas montañas un Gojulas\ny un Zoid que no había\nvisto nunca."

msgctxt "dialogue/460/0x76"
msgid "dialogue/460/0x76"
msgstr "Aldeano\nPor ahí no se pueden\ncruzar las montañas,\nni siquiera con un Zoid."

msgctxt "dialogue/460/0xc5"
msgid "dialogue/460/0xc5"
msgstr "Aldeano\n¿Irían a la mansión\ndel señor Prozen?"

msgctxt "dialogue/461/0xc"
msgid "dialogue/461/0xc"
msgstr "Regina\n...¿Qué es esto?"

msgctxt "dialogue/461/0x36"
msgid "dialogue/461/0x36"
msgstr "Jack\n...Parece una instalación\nmilitar. ¿No sería mejor\nno acercarnos a la\nligera?"

msgctxt "dialogue/462/0xc"
msgid "dialogue/462/0xc"
msgstr "Regina\n¿Será aquí?"

msgctxt "dialogue/462/0x34"
msgid "dialogue/462/0x34"
msgstr "Jack\nSeguramente es el\nlaboratorio secreto del\nque habló el Dr. D."

msgctxt "dialogue/462/0x83"
msgid "dialogue/462/0x83"
msgstr "Arth\nNo será fácil entrar..."

msgctxt "dialogue/462/0xbb"
msgid "dialogue/462/0xbb"
msgstr "Jack\nPríncipe, procure que no\nle vean los guardias."

msgctxt "dialogue/462/0xf8"
msgid "dialogue/462/0xf8"
msgstr "Jack\nSi los guardias nos\ndescubren, tendremos que\nvolver a entrar desde\nel principio."

msgctxt "dialogue/462/0x13b"
msgid "dialogue/462/0x13b"
msgstr "Jack\n¿Listo? Entonces,\nvamos."

msgctxt "dialogue/463/0xc"
msgid "dialogue/463/0xc"
msgstr "Regina\n¡Maldición! ¡Nos han\ndescubierto!"

msgctxt "dialogue/463/0x3e"
msgid "dialogue/463/0x3e"
msgstr "Jack\nNo hay más remedio.\nVolvamos a empezar."

msgctxt "dialogue/464/0xc"
msgid "dialogue/464/0xc"
msgstr "Regina\n¿Qué... es esto? Es como\nsi algo hubiera\narrasado el lugar."

msgctxt "dialogue/464/0x57"
msgid "dialogue/464/0x57"
msgstr "Jack\n...Es verdad... Parece\nuna torre de\nmantenimiento de Zoids,\npero..."

msgctxt "dialogue/464/0xb0"
msgid "dialogue/464/0xb0"
msgstr "Arth\nEs demasiado grande.\nDobla a un Gojulas."

msgctxt "dialogue/464/0xec"
msgid "dialogue/464/0xec"
msgstr "Jack\nSí. Pero si de verdad es\nuna torre de\nmantenimiento, ¿qué\nclase de Zoid...?"

msgctxt "dialogue/464/0x14b"
msgid "dialogue/464/0x14b"
msgstr "Arth\n¡Escondeos!"

msgctxt "dialogue/465/0x3"
msgid "dialogue/465/0x3"
msgstr "Científico\n¡Hiii! ¡S-socorro!"

msgctxt "dialogue/465/0x33"
msgid "dialogue/465/0x33"
msgstr "Jack\nGuarde silencio. Si no\nopone resistencia, no le\nharemos daño. ¿Entendido?"

msgctxt "dialogue/465/0x87"
msgid "dialogue/465/0x87"
msgstr "Científico\nS-s-sí, sí, entendido."

msgctxt "dialogue/465/0xb5"
msgid "dialogue/465/0xb5"
msgstr "Jack\nGracias. ¿Qué se\ninvestigaba aquí?"

msgctxt "dialogue/465/0xf5"
msgid "dialogue/465/0xf5"
msgstr "Científico\nE-eso es..."

msgctxt "dialogue/465/0x11f"
msgid "dialogue/465/0x11f"
msgstr "Regina\nMás te vale hablar por\nlas buenas. Este tipo es\ntan malo como parece."

msgctxt "dialogue/465/0x17e"
msgid "dialogue/465/0x17e"
msgstr "Arth\nAsí es, soy malo.\nHabla de una vez."

msgctxt "dialogue/465/0x1b1"
msgid "dialogue/465/0x1b1"
msgstr "Científico\nL-las, l-las, r-ru, ru,\nruinas antiguas, de,\nde, de..."

msgctxt "dialogue/465/0x206"
msgid "dialogue/465/0x206"
msgstr "Jack\n¿Ruinas antiguas? ¿Las\nruinas de Galil?"

msgctxt "dialogue/465/0x23d"
msgid "dialogue/465/0x23d"
msgstr "Científico\n¡Sí! Creo que hacían\nexperimentos para revivir\nun núcleo Zoid hallado\nen las ruinas de Galil."

msgctxt "dialogue/465/0x2a2"
msgid "dialogue/465/0x2a2"
msgstr "Arth\n¿Crees?"

msgctxt "dialogue/465/0x2bb"
msgid "dialogue/465/0x2bb"
msgstr "Científico\n¡A los investigadores de\nbajo nivel como yo no nos\ncuentan nada! ¡Es verdad!\n¡Créanme!"

msgctxt "dialogue/465/0x316"
msgid "dialogue/465/0x316"
msgstr "Científico\n¡Así que no sé en qué\nconsistía el experimento!\n¡Es la verdad!"

msgctxt "dialogue/465/0x35b"
msgid "dialogue/465/0x35b"
msgstr "Científico\n¡Yo solo modificaba los\ngenes de núcleos Zoid\nextraídos de Zoids!"

msgctxt "dialogue/465/0x3bc"
msgid "dialogue/465/0x3bc"
msgstr "Jack\nNo me interesa lo que\nusted investigara."

msgctxt "dialogue/465/0x3fd"
msgid "dialogue/465/0x3fd"
msgstr "Jack\n...Está bien. ¿Y dónde\nestá ahora el Zoid del\nexperimento?"

msgctxt "dialogue/465/0x447"
msgid "dialogue/465/0x447"
msgstr "Científico\nHace poco se descontroló\ny lo trasladaron al\nlaboratorio de Hagen\nCity, que está mejor\nequipado."

msgctxt "dialogue/465/0x49c"
msgid "dialogue/465/0x49c"
msgstr "Científico\nAsí que aquí ya no queda\nnada. Es todo lo que sé."

msgctxt "dialogue/465/0x4e7"
msgid "dialogue/465/0x4e7"
msgstr "Científico\n¡Por favor, se lo ruego!\n¡Llévenme con ustedes!"

msgctxt "dialogue/465/0x519"
msgid "dialogue/465/0x519"
msgstr "Científico\nSi descubren que he\nrevelado el secreto,\nProzen me... ¡Prozen me\nmatará!"

msgctxt "dialogue/465/0x574"
msgid "dialogue/465/0x574"
msgstr "Científico\n¡P-por favor! ¡Llévenme\ncon ust...! ¡Aagh!"

msgctxt "dialogue/466/0xc"
msgid "dialogue/466/0xc"
msgstr "Arth\nAsume tus propias\nresponsabilidades."

msgctxt "dialogue/466/0x42"
msgid "dialogue/466/0x42"
msgstr "Regina\nEn general no apruebo lo\nque haces, pero esta vez\nte lo paso."

msgctxt "dialogue/466/0xa1"
msgid "dialogue/466/0xa1"
msgstr "Arth\nEs un honor coincidir\ncontigo."

msgctxt "dialogue/466/0xd3"
msgid "dialogue/466/0xd3"
msgstr "Jack\nEn fin, aquí ya no\ntenemos nada que hacer."

msgctxt "dialogue/466/0x109"
msgid "dialogue/466/0x109"
msgstr "Jack\nVayamos al laboratorio\nde Hagen City."

msgctxt "dialogue/467/0xc"
msgid "dialogue/467/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/467/0x2d"
msgid "dialogue/467/0x2d"
msgstr "Regina\n¡¿Eso es...?! ¿Un\nGenosaurer? ¡¿Raven?!"

msgctxt "dialogue/467/0x72"
msgid "dialogue/467/0x72"
msgstr "Jack\nY su rival parece ser\nGale... ¿Qué está\npasando?"

msgctxt "dialogue/467/0xbf"
msgid "dialogue/467/0xbf"
msgstr "Raven\n¿Adónde vas?"

msgctxt "dialogue/467/0xed"
msgid "dialogue/467/0xed"
msgstr "Gale\n......"

msgctxt "dialogue/467/0x113"
msgid "dialogue/467/0x113"
msgstr "Raven\nLo que llevas son datos\nsecretos, ¿verdad? Aunque\na mí no me interesan."

msgctxt "dialogue/467/0x16c"
msgid "dialogue/467/0x16c"
msgstr "Raven\nLo único que me interesa\nes luchar, Gale. Vamos,\nlucha conmigo. ¡Hazme\ndisfrutar!"

msgctxt "dialogue/467/0x1d1"
msgid "dialogue/467/0x1d1"
msgstr "Gale\n...Pobre hombre."

msgctxt "dialogue/467/0x201"
msgid "dialogue/467/0x201"
msgstr "Raven\n¡...! ¿A qué te refieres?"

msgctxt "dialogue/467/0x22f"
msgid "dialogue/467/0x22f"
msgstr "Gale\nEres fuerte, sí. Pero\n¿para qué? ¿Qué harás\ncon esa fuerza?"

msgctxt "dialogue/467/0x28a"
msgid "dialogue/467/0x28a"
msgstr "Raven\n¡Cállate! ¡Siempre me\nhas caído mal!"

msgctxt "dialogue/467/0x2d3"
msgid "dialogue/467/0x2d3"
msgstr "Raven\n¡Aquí mismo vas a ser\npasto de mi cañón de\npartículas cargadas!"

msgctxt "dialogue/467/0x320"
msgid "dialogue/467/0x320"
msgstr "Jack\n¡Gale!"

msgctxt "dialogue/468/0xc"
msgid "dialogue/468/0xc"
msgstr "Raven\n¡...! ¡¿Quién anda ahí?!"

msgctxt "dialogue/469/0xc"
msgid "dialogue/469/0xc"
msgstr "Gale\n¡Jack! ¡Ven al\nlaboratorio de Hagen\nCity!"

msgctxt "dialogue/470/0xc"
msgid "dialogue/470/0xc"
msgstr "Raven\n¡Tsk! ¡Maldita sea!\n¡No te escaparás, Gale!"

msgctxt "dialogue/471/0xc"
msgid "dialogue/471/0xc"
msgstr "Regina\n¿Qué? ¿Se pelean entre\nellos?"

msgctxt "dialogue/471/0x38"
msgid "dialogue/471/0x38"
msgstr "Jack\nNo lo sé. ¿Qué demonios\nestá pasando...?"

msgctxt "dialogue/471/0x84"
msgid "dialogue/471/0x84"
msgstr "{name}\n......"

msgctxt "dialogue/472/0xc"
msgid "dialogue/472/0xc"
msgstr "Arth\nMás vale que vayamos\ndeprisa al laboratorio\nde Hagen City."

msgctxt "dialogue/473/0x3"
msgid "dialogue/473/0x3"
msgstr "Militar imperial\n¡A partir de aquí se\nprohíbe el paso a los\nciviles!"

msgctxt "dialogue/474/0xc"
msgid "dialogue/474/0xc"
msgstr "Regina\n¿Esto es el instituto de\ninvestigación Zoid? Está\nmuy poco vigilado."

msgctxt "dialogue/474/0x4c"
msgid "dialogue/474/0x4c"
msgstr "Jack\nSeguramente es un\nengaño. Pero no hay\ntiempo que perder."

msgctxt "dialogue/474/0x9b"
msgid "dialogue/474/0x9b"
msgstr "Jack\n¡Entremos por la fuerza!"

msgctxt "dialogue/474/0xcb"
msgid "dialogue/474/0xcb"
msgstr "Arth\n¿Por qué tanta prisa?"

msgctxt "dialogue/474/0xf5"
msgid "dialogue/474/0xf5"
msgstr "Jack\n¡No tengo ninguna prisa!"

msgctxt "dialogue/474/0x12b"
msgid "dialogue/474/0x12b"
msgstr "Jack\n¡...! P-perdón."

msgctxt "dialogue/474/0x159"
msgid "dialogue/474/0x159"
msgstr "Arth\nOlvídalo. Bueno, pues\nentremos por la fuerza."

msgctxt "dialogue/474/0x1a3"
msgid "dialogue/474/0x1a3"
msgstr "{name}\n......"

msgctxt "dialogue/474/0x1c4"
msgid "dialogue/474/0x1c4"
msgstr "Regina\nVamos, Jack."

msgctxt "dialogue/474/0x1f4"
msgid "dialogue/474/0x1f4"
msgstr "Jack\n...Príncipe, amigos...\n¡Sí, vamos!"

msgctxt "dialogue/475/0xc"
msgid "dialogue/475/0xc"
msgstr "Prozen\nVaya, ¿ya habéis llegado\nhasta aquí?"

msgctxt "dialogue/475/0x4f"
msgid "dialogue/475/0x4f"
msgstr "{name}\n......"

msgctxt "dialogue/475/0x70"
msgid "dialogue/475/0x70"
msgstr "Jack\n¿Quién es usted?"

msgctxt "dialogue/475/0x96"
msgid "dialogue/475/0x96"
msgstr "Prozen\nEncantado de conoceros.\nSoy Gunther Prozen."

msgctxt "dialogue/475/0xdb"
msgid "dialogue/475/0xdb"
msgstr "Prozen\nEl próximo emperador\ndel Imperio Guylos."

msgctxt "dialogue/475/0x105"
msgid "dialogue/475/0x105"
msgstr "Prozen\nGale me ha hablado de\nvosotros. Unas moscas\nque estorban nuestros\nplanes."

msgctxt "dialogue/475/0x15c"
msgid "dialogue/475/0x15c"
msgstr "Prozen\nAunque Gale también me\nha robado los datos de\nmi Death Saurer, así que\nes otra mosca."

msgctxt "dialogue/475/0x1c7"
msgid "dialogue/475/0x1c7"
msgstr "Arth\n¿Death Saurer?"

msgctxt "dialogue/475/0x1ef"
msgid "dialogue/475/0x1ef"
msgstr "Prozen\n¡Así es! ¡Os presento al\nsímbolo de mi poder, el\nDeath Saurer!"

msgctxt "dialogue/476/0xc"
msgid "dialogue/476/0xc"
msgstr "Prozen\nAunque este no es más que\nun prototipo que usa el\nnúcleo Zoid de un\nGenosaurer..."

msgctxt "dialogue/476/0x6b"
msgid "dialogue/476/0x6b"
msgstr "Prozen\nPero para vosotros\nbastará con este\nprototipo."

msgctxt "dialogue/477/0xc"
msgid "dialogue/477/0xc"
msgstr "Prozen\nY ahora, si me\ndisculpáis... Debo\ncelebrar mi coronación\nen la capital imperial."

msgctxt "dialogue/477/0x63"
msgid "dialogue/477/0x63"
msgstr "Prozen\nDisfrutad con calma del\npoder del Death Saurer."

msgctxt "dialogue/477/0xa8"
msgid "dialogue/477/0xa8"
msgstr "Prozen\nQueridas moscas...\n¡Ja, ja, ja, ja, ja!"

msgctxt "dialogue/478/0xc"
msgid "dialogue/478/0xc"
msgstr "Jack\n¡Qué sabrá alguien\ncegado por el poder!"

msgctxt "dialogue/478/0x46"
msgid "dialogue/478/0x46"
msgstr "Arth\nLos cegados por el poder\nsiempre son así. Y\ntenemos uno bien cerca,\n¿no?"

msgctxt "dialogue/478/0x9f"
msgid "dialogue/478/0x9f"
msgstr "Regina\nEl que se ha instalado en\nel castillo de Arcadia."

msgctxt "dialogue/478/0xcf"
msgid "dialogue/478/0xcf"
msgstr "Regina\n{name}, ¡vamos a\ndemostrarle que no\nperderemos contra un\ntipo así!"

msgctxt "dialogue/478/0x126"
msgid "dialogue/478/0x126"
msgstr "{name}\n......"

msgctxt "dialogue/479/0xc"
msgid "dialogue/479/0xc"
msgstr "Arth\n¿Lo hemos logrado?"

msgctxt "dialogue/479/0x30"
msgid "dialogue/479/0x30"
msgstr "Regina\n¡Lo hemos derrotado!"

msgctxt "dialogue/479/0x59"
msgid "dialogue/479/0x59"
msgstr "{name}\n......"

msgctxt "dialogue/480/0xc"
msgid "dialogue/480/0xc"
msgstr "Jack\n¡Gale!"

msgctxt "dialogue/480/0x32"
msgid "dialogue/480/0x32"
msgstr "Gale\nHabéis ganado. Pero no\nera más que una máquina\ninacabada. El verdadero\nDeath Saurer es muy\ndistinto."

msgctxt "dialogue/480/0x93"
msgid "dialogue/480/0x93"
msgstr "Jack\n...Gale, ¿quién eres\ntú en realidad...?"

msgctxt "dialogue/480/0xd0"
msgid "dialogue/480/0xd0"
msgstr "Gale\nVeamos si tenéis poder\nsuficiente para desafiar\na mi emperador... Yo\nmismo os pondré a prueba."

msgctxt "dialogue/480/0x131"
msgid "dialogue/480/0x131"
msgstr "Jack\n¡E-espera, por favor!"

msgctxt "dialogue/480/0x161"
msgid "dialogue/480/0x161"
msgstr "Arth\nEs inútil, Jack."

msgctxt "dialogue/480/0x18b"
msgid "dialogue/480/0x18b"
msgstr "Regina\nEso, Jack. Si este tipo\nnos quiere poner a\nprueba... ¡pues a\nluchar!"

msgctxt "dialogue/480/0x1ef"
msgid "dialogue/480/0x1ef"
msgstr "{name}\n......"

msgctxt "dialogue/481/0xc"
msgid "dialogue/481/0xc"
msgstr "Van\n¡Un momento!"

msgctxt "dialogue/481/0x36"
msgid "dialogue/481/0x36"
msgstr "Irvine\nNo os olvidéis de\nnosotros."

msgctxt "dialogue/481/0x6b"
msgid "dialogue/481/0x6b"
msgstr "¡Van e Irvine se han\nunido al grupo!"

msgctxt "dialogue/481/0x9c"
msgid "dialogue/481/0x9c"
msgstr "Jack\n¡Van! Y también..."

msgctxt "dialogue/481/0xcc"
msgid "dialogue/481/0xcc"
msgstr "Arth\nEl de la mala cara."

msgctxt "dialogue/481/0xf6"
msgid "dialogue/481/0xf6"
msgstr "Irvine\nContigo sí que tengo\nque ajustar cuentas\nalgún día, ¿eh?"

msgctxt "dialogue/481/0x151"
msgid "dialogue/481/0x151"
msgstr "Arth\nHmph. Cuando quieras."

msgctxt "dialogue/481/0x17d"
msgid "dialogue/481/0x17d"
msgstr "Regina\n¡Arth, basta ya!\nPor cierto, Van.\n¿Y ese Zoid?"

msgctxt "dialogue/481/0x1cc"
msgid "dialogue/481/0x1cc"
msgstr "Van\n¡Mi nuevo compañero,\nel Blade Liger!"

msgctxt "dialogue/481/0x20a"
msgid "dialogue/481/0x20a"
msgstr "Regina\n¿El Shield Liger se ha\nconvertido en el Blade\nLiger?"

msgctxt "dialogue/481/0x24c"
msgid "dialogue/481/0x24c"
msgstr "Gale\n¿Ha revivido gracias al\npoder del organoide...?"

msgctxt "dialogue/481/0x28a"
msgid "dialogue/481/0x28a"
msgstr "Van\n¡Oye, abuelo! ¿Cómo es\nque lo sabes?"

msgctxt "dialogue/481/0x2ba"
msgid "dialogue/481/0x2ba"
msgstr "Van\n¡Eso es! ¡Revivió gracias\na Zeke y a Fiona!"

msgctxt "dialogue/481/0x305"
msgid "dialogue/481/0x305"
msgstr "Gale\nYa veo. Así que era\neso..."

msgctxt "dialogue/481/0x33d"
msgid "dialogue/481/0x33d"
msgstr "Irvine\n¿Qué vas a hacer, abuelo?\nSeis contra uno es\ndemasiado, ¿no crees?"

msgctxt "dialogue/481/0x394"
msgid "dialogue/481/0x394"
msgstr "Jack\n¡Es verdad! ¡Retírese,\npor favor!"

msgctxt "dialogue/481/0x3d2"
msgid "dialogue/481/0x3d2"
msgstr "Gale\nEs una buena desventaja."

msgctxt "dialogue/481/0x3f4"
msgid "dialogue/481/0x3f4"
msgstr "Gale\n¡Si os cuesta tanto\nvencerme a mí, nunca\ncumpliréis vuestra gran\nambición!"

msgctxt "dialogue/481/0x43b"
msgid "dialogue/481/0x43b"
msgstr "Gale\n¡Allá voy!"

msgctxt "dialogue/482/0xc"
msgid "dialogue/482/0xc"
msgstr "Gale\nNnngh...\n¡Has mejorado todavía\nmás, Jack!"

msgctxt "dialogue/482/0x55"
msgid "dialogue/482/0x55"
msgstr "Jack\nHa perdido. Ríndase,\npor favor."

msgctxt "dialogue/482/0x93"
msgid "dialogue/482/0x93"
msgstr "Gale\nJe, je. No tan deprisa."

msgctxt "dialogue/482/0xb3"
msgid "dialogue/482/0xb3"
msgstr "Gale\nIgual que vosotros tenéis\nuna misión, yo también\ntengo algo que hacer."

msgctxt "dialogue/482/0x102"
msgid "dialogue/482/0x102"
msgstr "Gale\nLos datos que reuní del\nDeath Saurer ya están en\nmanos de Su Majestad."

msgctxt "dialogue/482/0x14f"
msgid "dialogue/482/0x14f"
msgstr "Gale\nSu deseo es crear el\nZoid más poderoso."

msgctxt "dialogue/482/0x185"
msgid "dialogue/482/0x185"
msgstr "Gale\nY, por supuesto, usará\nlos datos del Death\nSaurer."

msgctxt "dialogue/482/0x1b7"
msgid "dialogue/482/0x1b7"
msgstr "Gale\nNo sé cuánto le servirá\nel Death Saurer contra el\nque luchamos, pero algo\nde utilidad tendrá."

msgctxt "dialogue/482/0x21c"
msgid "dialogue/482/0x21c"
msgstr "Jack\n...Gale, ¿quién es\nusted en realidad...?"

msgctxt "dialogue/482/0x258"
msgid "dialogue/482/0x258"
msgstr "Gale\nSe acabó la charla.\nHasta la próxima, Jack."

msgctxt "dialogue/483/0xc"
msgid "dialogue/483/0xc"
msgstr "Van\nOye, oye, se nos ha\nescapado. ¿Seguro que\nno pasa nada?"

msgctxt "dialogue/483/0x4a"
msgid "dialogue/483/0x4a"
msgstr "Irvine\nEllos tienen sus propios\nasuntos. ¡Vámonos, Van!"

msgctxt "dialogue/483/0x9b"
msgid "dialogue/483/0x9b"
msgstr "Van\n¿Adónde vamos, Irvine?"

msgctxt "dialogue/483/0xd1"
msgid "dialogue/483/0xd1"
msgstr "Irvine\nNosotros tenemos que\nhacer lo nuestro.\n¿No íbamos a llevar a\nRudolph a la capital?"

msgctxt "dialogue/484/0xc"
msgid "dialogue/484/0xc"
msgstr "Van\n¡Eh! ¡Espera, Irvine!\n¡Adiós! ¡Ya nos veremos!"

msgctxt "dialogue/485/0xc"
msgid "dialogue/485/0xc"
msgstr "Jack\n...Gale..."

msgctxt "dialogue/485/0x3a"
msgid "dialogue/485/0x3a"
msgstr "Regina\n¿Qué estará tramando ese\ntal Gale?"

msgctxt "dialogue/485/0x7c"
msgid "dialogue/485/0x7c"
msgstr "Arth\nNi idea. Empecemos por\nlo que sí sabemos."

msgctxt "dialogue/485/0xbc"
msgid "dialogue/485/0xbc"
msgstr "Jack\n...Tienes razón.\nPríncipe, ¿volvemos?"

msgctxt "dialogue/485/0x101"
msgid "dialogue/485/0x101"
msgstr "{name}\n......"

msgctxt "dialogue/727/0xc"
msgid "dialogue/727/0xc"
msgstr "Dr. D\nEstoy calculando la\nposición. ¿Podéis seguir\nluchando un poco más...?"

msgctxt "dialogue/728/0xc"
msgid "dialogue/728/0xc"
msgstr "Dr. D\nDestruid los dispositivos\nauxiliares que rodean el\nfuerte Kronos, al norte."

msgctxt "dialogue/729/0xc"
msgid "dialogue/729/0xc"
msgstr "Dr. D\nEl núcleo del amplificador\nestá en el hangar\nsubterráneo del fuerte\nKronos. ¡Destruidlo!"

msgctxt "dialogue/730/0xc"
msgid "dialogue/730/0xc"
msgstr "Dr. D\nPrimero id al arsenal\nsubterráneo detrás de esta\nfortaleza y traed el\nláser."

msgctxt "dialogue/731/0xc"
msgid "dialogue/731/0xc"
msgstr "Dr. D\nDestruid la roca del fondo\ndel volcán. Es el último\nrecurso. ¡¡Contamos con\nvosotros!!"

msgctxt "dialogue/756/0x3"
msgid "dialogue/756/0x3"
msgstr "Roman\n...¡Ah, es verdad!\n¡Le enseñaré esta táctica!"

msgctxt "dialogue/757/0x3"
msgid "dialogue/757/0x3"
msgstr "Roman\n...¡Oh, eso es! ¡Le\nenseñaré esta táctica!"

msgctxt "dialogue/758/0x3"
msgid "dialogue/758/0x3"
msgstr "Roman\n...¡Ah, sí, eso es! ¡Le\nenseñaré esta táctica!"

msgctxt "dialogue/759/0x3"
msgid "dialogue/759/0x3"
msgstr "Roman\n...¡Ah, sí, eso es!\n¡Le enseñaré esta\ntáctica!"

msgctxt "dialogue/761/0x3"
msgid "dialogue/761/0x3"
msgstr "Vecino\n¡Bienvenidos! Vaya, los\nniños no pueden entrar en\nla taberna, aunque vengan\ncon sus padres."

msgctxt "dialogue/762/0x3"
msgid "dialogue/762/0x3"
msgstr "Vecino\nPlantamos cara al Imperio,\npero su poder es muy\nsuperior. Si hay guerra,\nabandonarán esta zona."

msgctxt "dialogue/763/0x3"
msgid "dialogue/763/0x3"
msgstr "Vecino\nEsto es la frontera entre\nHelic y el Imperio Guylos.\nPero ahora hay tregua, así\nque se vive tranquilo."

msgctxt "dialogue/765/0x3"
msgid "dialogue/765/0x3"
msgstr "Vecino\nEsto siempre ha sido zona\nde Rare Hertz. De joven,\nlos Zoids se desbocaban\na cada rato."

msgctxt "dialogue/766/0x3"
msgid "dialogue/766/0x3"
msgstr "Vecino\n¿Has visto aquel volcán?\nEs Mount Ossa. Allí está\nla fortaleza de la\nRepública."

msgctxt "dialogue/767/0x3"
msgid "dialogue/767/0x3"
msgstr "Vecino\nEl Rare Hertz es una onda\nmisteriosa que enloquece\na los Zoids. Aunque ahora\nel Pulse Guard la frena."

msgctxt "dialogue/768/0x3"
msgid "dialogue/768/0x3"
msgstr "Vecino\nEl desierto del sur es\nzona de Rare Hertz. El\nPulse Guard no protege del\ntodo. No te acerques."

msgctxt "dialogue/769/0x3"
msgid "dialogue/769/0x3"
msgstr "Vecino\nMount Ossa es la última\ndefensa de la República.\nSi cae, la capital queda\na un paso."

msgctxt "dialogue/770/0x3"
msgid "dialogue/770/0x3"
msgstr "Vecino\nNo hay pueblo como este..."

msgctxt "dialogue/771/0x3"
msgid "dialogue/771/0x3"
msgstr "Vecino\nMount Ossa es un volcán\nactivo; aún entra en\nerupción de vez en cuando.\nDe noche es precioso."

msgctxt "dialogue/772/0x3"
msgid "dialogue/772/0x3"
msgstr "Vecino\n¿Sois viajeros, jóvenes?\nEste pueblo no tiene nada,\npero descansad a gusto."

msgctxt "dialogue/773/0x3"
msgid "dialogue/773/0x3"
msgstr "Vecino\nDicen que hubo refriegas\npor Red River... ¿Volverá\na empezar la guerra...?"

msgctxt "dialogue/774/0x3"
msgid "dialogue/774/0x3"
msgstr "Piloto de Zoids\nBah, la República y el\nImperio vuelven a darse\nde tiros y aquí están\ntodos tan tranquilos."

msgctxt "dialogue/776/0x3"
msgid "dialogue/776/0x3"
msgstr "Vecino\n¡Dicen que el príncipe\n{name} ha reunido al\nejército del Reino para\nalzarse!"

msgctxt "dialogue/777/0x3"
msgid "dialogue/777/0x3"
msgstr "Vecino\n¡Dicen que el príncipe\n{name} ha reunido al\nejército del Reino para\nalzarse!"

msgctxt "dialogue/778/0x3"
msgid "dialogue/778/0x3"
msgstr "Vecino\nDicen que el príncipe\n{name} está a salvo.\nOjalá el rey y la reina\ntambién lo estén."

msgctxt "dialogue/779/0x3"
msgid "dialogue/779/0x3"
msgstr "Vecino\nDicen que el príncipe\n{name} está a salvo.\nOjalá el rey y la reina\ntambién lo estén."

msgctxt "dialogue/780/0x3"
msgid "dialogue/780/0x3"
msgstr "Vecino\nDicen que el príncipe\n{name} se ha alzado\ncontra el Emperador. ¡Qué valor!"

msgctxt "dialogue/781/0x3"
msgid "dialogue/781/0x3"
msgstr "Vecino\nDicen que el príncipe\n{name} se ha alzado\ncontra el ejército del\nEmperador. ¡Qué pasada!"

msgctxt "dialogue/782/0x3"
msgid "dialogue/782/0x3"
msgstr "Vecino\nEl príncipe {name} ha\nformado un ejército. ¿Será\neste pueblo un campo de\nbatalla...?"

msgctxt "dialogue/783/0x3"
msgid "dialogue/783/0x3"
msgstr "Vecino\nDicen que el príncipe\n{name} ha formado el\nejército del Reino.\n¿Acabará este pueblo\nsiendo un campo de\nbatalla?..."

msgctxt "dialogue/784/0x3"
msgid "dialogue/784/0x3"
msgstr "Niño\n¡Yo también lucharé con\nel príncipe {name}!"

msgctxt "dialogue/785/0x3"
msgid "dialogue/785/0x3"
msgstr "Niño\n¡Yo también lucharé con\nel príncipe {name}!"

msgctxt "dialogue/786/0x3"
msgid "dialogue/786/0x3"
msgstr "Niña\nMi papá era soldado en el\ncastillo, pero no vuelve a\ncasa. ¡Ojalá vuelva\npronto!"

msgctxt "dialogue/787/0x3"
msgid "dialogue/787/0x3"
msgstr "Niña\nMi papá era soldado en el\ncastillo, pero no vuelve\na casa. ¡Ojalá vuelva\npronto!"

msgctxt "dialogue/788/0x3"
msgid "dialogue/788/0x3"
msgstr "Tabernero\n¡El príncipe {name} se ha\nalzado! ¡Hoy invita la\ncasa! ¡¡Bebed cuanto\nqueráis!!"

msgctxt "dialogue/789/0x3"
msgid "dialogue/789/0x3"
msgstr "Tabernero\nDicen que el príncipe\n{name} se ha alzado.\n¡Hoy invita la casa!\n¡Bebed todo lo que\nqueráis!"

msgctxt "dialogue/790/0x3"
msgid "dialogue/790/0x3"
msgstr "Roman\n¡Príncipe {name}! ¡Ya me\nhe enterado! Este viejo\nle apoyará desde la\nsombra."

msgctxt "dialogue/791/0x3"
msgid "dialogue/791/0x3"
msgstr "Roman\n¡Príncipe {name}! ¡Ya\nme he enterado! Este\nviejo le apoyará desde\nlas sombras."

msgctxt "dialogue/792/0x3"
msgid "dialogue/792/0x3"
msgstr "Piloto de Zoids\n¡Dicen que el príncipe de\nArcadia ha formado un\nejército! Y siendo un\nniño... ¡Qué mérito!"

msgctxt "dialogue/793/0x3"
msgid "dialogue/793/0x3"
msgstr "Piloto de Zoids\n¡Dicen que el príncipe\nde Arcadia ha formado el\nejército del Reino! Y eso\nque es un niño. ¡Qué\nmérito!"

msgctxt "dialogue/794/0x3"
msgid "dialogue/794/0x3"
msgstr "Vecino\n¡Venga, me alistaré en\nel ejército del Reino!\nAsí las chicas se\nvolverán locas por mí."

msgctxt "dialogue/795/0x3"
msgid "dialogue/795/0x3"
msgstr "Vecino\n¡Venga, me alistaré en\nel ejército del Reino!\nAsí las chicas se\nvolverán locas por mí."

msgctxt "dialogue/796/0x3"
msgid "dialogue/796/0x3"
msgstr "Soldado imperial\nDicen que están atacando\nuna tras otra las bases\nde la frontera. Ahora\nque había paz... Qué\nfastidio."

msgctxt "dialogue/797/0x3"
msgid "dialogue/797/0x3"
msgstr "Soldado imperial\nDesde que Su Majestad\nRudolph subió al trono,\nla guerra ha terminado.\nAhora estamos ociosos...\n¡pero se agradece!"

msgctxt "dialogue/798/0x3"
msgid "dialogue/798/0x3"
msgstr "Vecino\nSu Majestad Rudolph es\nmuy joven, pero tiene un\ngran sentido del deber.\n¡A su edad aún querrá\njugar!"

msgctxt "dialogue/799/0x3"
msgid "dialogue/799/0x3"
msgstr "Vecino\nDesde que Su Majestad\nRudolph subió al trono,\nel Imperio Guylos ha\ncambiado. Para bien,\nclaro. ¡Qué buena es la\npaz!"

msgctxt "dialogue/800/0x3"
msgid "dialogue/800/0x3"
msgstr "Vecino\nCon que la guerra haya\nacabado y mis hijos\nhayan vuelto a salvo, yo\nya me doy por contenta."

msgctxt "dialogue/801/0x3"
msgid "dialogue/801/0x3"
msgstr "Vecino\n¡La Guardian Force, la\nunidad especial que\nprotege la paz! ¡Cómo\nmola! ¿Y si me alisto?"

msgctxt "dialogue/802/0x3"
msgid "dialogue/802/0x3"
msgstr "Vecino\nEste es un pueblo de la\nfrontera, pero Guygalos,\nla capital, es una gran\nciudad. ¡Ay, quiero ir\naunque sea una vez!"

msgctxt "dialogue/803/0x3"
msgid "dialogue/803/0x3"
msgstr "Vecino\n¡Nuestro Imperio Guylos\nprosperará más y más! Al\nfin y al cabo, el\nEmperador es el gran\nRudolph."

msgctxt "dialogue/804/0x3"
msgid "dialogue/804/0x3"
msgstr "Tabernero\nBienvenidos. ¿Estáis de\nviaje? Este pueblo no\ntiene nada, pero paz no\nle falta. Poneos cómodos."

msgctxt "dialogue/805/0x3"
msgid "dialogue/805/0x3"
msgstr "Piloto de Zoids\nCon el fin de la guerra,\nse acabó el negocio de\nmercenario. Tendré que\nhacerme transportista."

msgctxt "dialogue/806/0x3"
msgid "dialogue/806/0x3"
msgstr "Piloto de Zoids\nCreía que en el Imperio\nGuylos habría trabajo...\nPero no soy la única que\nlo pensó. ¿No habrá algo\npara mí?"

msgctxt "dialogue/807/0x3"
msgid "dialogue/807/0x3"
msgstr "Camarera\n¡Bienvenidos! Siéntense\nen cualquier mesa libre."

msgctxt "dialogue/808/0x3"
msgid "dialogue/808/0x3"
msgstr "Vecino\nLa camarera de aquí es\nmona, ¡pero las de\nGuygalos lo son más!"

msgctxt "dialogue/809/0x3"
msgid "dialogue/809/0x3"
msgstr "Vecino\n¡Viva el Imperio Guylos!\n¡Viva Su Majestad\nRudolph! Y ya puestos,\n¡viva la camarera!"

msgctxt "dialogue/810/0x3"
msgid "dialogue/810/0x3"
msgstr "Vecino\n¡Viva el Imperio Guylos!\n¡Viva Su Majestad\nRudolph! Y ya puestos,\n¡viva la camarera!"

msgctxt "dialogue/811/0x3"
msgid "dialogue/811/0x3"
msgstr "Soldado imperial\nA la Primera División\nAcorazada nos enviaron a\nvigilar la frontera por\norden de Su Majestad, y\nde repente pasa esto..."

msgctxt "dialogue/812/0x3"
msgid "dialogue/812/0x3"
msgstr "Soldado imperial\nEl jefe de la división\ngoza de la confianza de\nSu Majestad. En la\nrebelión de Prozen luchó\na su lado. ¡Todo un\nejemplo de militar!"

msgctxt "dialogue/813/0x3"
msgid "dialogue/813/0x3"
msgstr "Soldado imperial\n¿Mandar a la Primera\nDivisión Acorazada solo a\nvigilar la frontera?...\n¿Quién será el enemigo?"

msgctxt "dialogue/814/0x3"
msgid "dialogue/814/0x3"
msgstr "Soldado imperial\n¡Me han destinado a la\ngloriosa Primera\nDivisión Acorazada! Yo...\ndigo, ¡este soldado está\nemocionadísimo!"

msgctxt "dialogue/815/0x3"
msgid "dialogue/815/0x3"
msgstr "Soldado imperial\nNuestro jefe de división\nes muy hábil, pero no\nsabe moverse en la\npolítica. Claro que eso\nes parte de su encanto."

msgctxt "dialogue/816/0x3"
msgid "dialogue/816/0x3"
msgstr "Investigador\n¿Qué Zoid desarrollaré\nahora?..."

msgctxt "dialogue/817/0x3"
msgid "dialogue/817/0x3"
msgstr "Soldado imperial\n¿Gente sospechosa?\nSerá algún malentendido."

msgctxt "dialogue/818/0x3"
msgid "dialogue/818/0x3"
msgstr "Soldado imperial\nSin novedad."

msgctxt "dialogue/819/0x3"
msgid "dialogue/819/0x3"
msgstr "Soldado imperial\n......No he visto a nadie\nsospechoso. Será algún\nerror..."

msgctxt "dialogue/820/0x3"
msgid "dialogue/820/0x3"
msgstr "Soldado imperial\n......Estoy de servicio."

msgctxt "dialogue/821/0x3"
msgid "dialogue/821/0x3"
msgstr "Soldado imperial\n...Sin novedad..."

msgctxt "dialogue/822/0x3"
msgid "dialogue/822/0x3"
msgstr "Guerrero Zoid\nSomos guerreros Zoid.\n¡No nos llames pilotos\nde Zoids!"

msgctxt "dialogue/823/0x3"
msgid "dialogue/823/0x3"
msgstr "Guerrero Zoid\nLas batallas Zoid son\ncombates entre Zoids\ncon reglas justas."

msgctxt "dialogue/824/0x3"
msgid "dialogue/824/0x3"
msgstr "Guerrero Zoid\nLas batallas Zoid las\nrige la Federación\nde Batallas Zoid, y en\nel terreno, el Judgeman."

msgctxt "dialogue/825/0x3"
msgid "dialogue/825/0x3"
msgstr "Guerrero Zoid\nSi quieres luchar contra\nel campeón del distrito,\nhazte más fuerte. Si\nvas ganando en la arena,\npodrás enfrentarte a él."

msgctxt "dialogue/826/0x3"
msgid "dialogue/826/0x3"
msgstr "Guerrero Zoid\n¡Quiero subir ya al\nrango A! Pero me faltan\nmuchos puntos. ¡A\nesforzarse más!"

msgctxt "dialogue/827/0x3"
msgid "dialogue/827/0x3"
msgstr "Guerrero Zoid\nRomeo City... ¡Los\nmejores Zoids y las\nmejores piezas! Todo\nguerrero Zoid sueña\ncon esta ciudad."

msgctxt "dialogue/828/0x3"
msgid "dialogue/828/0x3"
msgstr "Investigador\n¿Qué Zoid desarrollaré\nahora...?"

msgctxt "dialogue/829/0x3"
msgid "dialogue/829/0x3"
msgstr "Guerrero Zoid\n¡La próxima batalla\nZoid la gano yo!"

msgctxt "dialogue/830/0x3"
msgid "dialogue/830/0x3"
msgstr "Guerrero Zoid\nEl Team Vipers solo\ntiene Stealth Vipers.\nSon muchos, así que no\nte confíes."

msgctxt "dialogue/831/0x3"
msgid "dialogue/831/0x3"
msgstr "Guerrero Zoid\nEl Team Kong, como su\nnombre indica, es un\ngrupo de Iron Kongs.\nNo subestimes su\npotencia."

msgctxt "dialogue/832/0x3"
msgid "dialogue/832/0x3"
msgstr "Guerrero Zoid\nEl ejército sónico que\nrecorre la tierra: el\nTeam Sykes. ¿Podréis\nfrenar sus movimientos?"

msgctxt "dialogue/833/0x3"
msgid "dialogue/833/0x3"
msgstr "Guerrero Zoid\nEl Team Redlers solo\ntiene Zoids voladores.\n¡Qué trampa! Mejor que\nllevéis Zoids voladores."

msgctxt "dialogue/834/0x3"
msgid "dialogue/834/0x3"
msgstr "Guerrero Zoid\nLos Helcat, ya sabes,\nllevan camuflaje\nóptico. Son un incordio.\nNo te dejes engañar por\nsu ridículo nombre."

msgctxt "dialogue/835/0x3"
msgid "dialogue/835/0x3"
msgstr "Guerrero Zoid\nEl Team Cannon: un\nequipo de artilleros que\nlo apuesta todo al fuego.\nSi hay tiroteo, malo.\nVe con cuidado."

msgctxt "dialogue/836/0x3"
msgid "dialogue/836/0x3"
msgstr "Guerrero Zoid\nAtacan por tierra y\naire a la vez, es su\ntáctica habitual. Solo\nhuyendo no venceréis\nal Team Lights."

msgctxt "dialogue/837/0x3"
msgid "dialogue/837/0x3"
msgstr "Guerrero Zoid\nEl Team Bisons, un\nejército de toros bravos.\nSu fuego y su embestida\nno son normales. ¿Te\nbuscas un capote rojo?"

msgctxt "dialogue/838/0x3"
msgid "dialogue/838/0x3"
msgstr "Guerrero Zoid\nEl Team Tigers, un\nejército de tigres\ndorados. Cuidado con\nsu juego en equipo."

msgctxt "dialogue/839/0x3"
msgid "dialogue/839/0x3"
msgstr "Guerrero Zoid\nDespués del tigre, el\nleón. Prueba el poder\ndel rey de las bestias."

msgctxt "dialogue/840/0x3"
msgid "dialogue/840/0x3"
msgstr "Guerrero Zoid\nSi solo se pueden usar\narmas fijas, el próximo\nrival es duro. ¡Cuidado\ncon el Spark Liger, la\nbestia del trueno!"

msgctxt "dialogue/841/0x3"
msgid "dialogue/841/0x3"
msgstr "Guerrero Zoid\nNo hay ni un dato del\nrival. Aunque por el\nnombre parece un\nElephander..."

msgctxt "dialogue/842/0x3"
msgid "dialogue/842/0x3"
msgstr "Vecino\nHe oído que el príncipe\n{name} y los suyos han\nformado el ejército del\nReino. ¡Y dicen que\naguantan bien! ¡Me ha\nsorprendido!"

msgctxt "dialogue/843/0x3"
msgid "dialogue/843/0x3"
msgstr "Vecino\nHe oído que el príncipe\n{name} y los suyos han\nformado el ejército del\nReino. ¡Y dicen que\naguantan bien! ¡Me ha\nsorprendido!"

msgctxt "dialogue/844/0x3"
msgid "dialogue/844/0x3"
msgstr "Vecino\nOjalá que el príncipe\n{name} y los suyos lo\nlogren, pero que no se\narriesguen demasiado.\nMe preocupan."

msgctxt "dialogue/845/0x3"
msgid "dialogue/845/0x3"
msgstr "Vecino\nOjalá que el príncipe\n{name} y los suyos lo\nlogren, pero que no se\narriesguen demasiado.\nMe preocupan."

msgctxt "dialogue/846/0x3"
msgid "dialogue/846/0x3"
msgstr "Vecino\nLos imperiales están\nnerviosos y refuerzan\nel castillo. ¡Y así no\nhay soldados en la\nciudad, qué alivio!"

msgctxt "dialogue/847/0x3"
msgid "dialogue/847/0x3"
msgstr "Vecino\nLos imperiales están\nnerviosos y refuerzan\nel castillo. ¡Y así no\nhay soldados en la\nciudad, qué alivio!"

msgctxt "dialogue/848/0x3"
msgid "dialogue/848/0x3"
msgstr "Vecino\n¡La justicia está de\nnuestra parte! ¡El\npríncipe {name} echará\npronto a los imperiales!"

msgctxt "dialogue/849/0x3"
msgid "dialogue/849/0x3"
msgstr "Vecino\n¡La justicia está de\nnuestra parte! ¡El\npríncipe {name} echará\npronto a los imperiales!"

msgctxt "dialogue/850/0x3"
msgid "dialogue/850/0x3"
msgstr "Guardia real\nEl enemigo refuerza la\ndefensa del castillo...\n¿Será el preludio de\nuna ofensiva...?"

msgctxt "dialogue/851/0x3"
msgid "dialogue/851/0x3"
msgstr "Guardia real\nEl enemigo refuerza la\ndefensa del castillo...\n¿Será el preludio de\nuna ofensiva...?"

msgctxt "dialogue/852/0x3"
msgid "dialogue/852/0x3"
msgstr "Piloto de Zoids\nParece que los imperiales\nse han retirado de la\nciudad... Pero habrá otro\nlío. ¡Esto promete!"

msgctxt "dialogue/853/0x3"
msgid "dialogue/853/0x3"
msgstr "Piloto de Zoids\nParece que los imperiales\nse han retirado de la\nciudad... Pero habrá otro\nlío. ¡Esto promete!"

msgctxt "dialogue/854/0x3"
msgid "dialogue/854/0x3"
msgstr "Tabernero\n¡Hombre, bienvenidos!\n¿Qué tal os va?"

msgctxt "dialogue/855/0x3"
msgid "dialogue/855/0x3"
msgstr "Tabernero\n¡Hombre, bienvenidos!\n¿Qué tal os va?"

msgctxt "dialogue/856/0x3"
msgid "dialogue/856/0x3"
msgstr "Roman\n¡Oh, príncipe {name}!\n¡Bienvenido! Vamos,\ndescanse tranquilo."

msgctxt "dialogue/857/0x3"
msgid "dialogue/857/0x3"
msgstr "Roman\n¡Oh, príncipe {name}!\n¡Bienvenido! Vamos,\ndescanse tranquilo."

msgctxt "dialogue/858/0x3"
msgid "dialogue/858/0x3"
msgstr "Guardia real\nGracias a Su Alteza, ya\nno se ven imperiales por\nla ciudad. ¡Ya casi\nestá, ánimo!"

msgctxt "dialogue/859/0x3"
msgid "dialogue/859/0x3"
msgstr "Guardia real\nGracias a Su Alteza, ya\nno se ven imperiales por\nla ciudad. ¡Ya casi\nestá, ánimo!"

msgctxt "dialogue/860/0x3"
msgid "dialogue/860/0x3"
msgstr "Piloto de Zoids\nCuando uno está eufórico\nes cuando más peligro\ncorre. No te confíes.\nAunque sobra el consejo,\n¿verdad?"

msgctxt "dialogue/861/0x3"
msgid "dialogue/861/0x3"
msgstr "Piloto de Zoids\nCuando uno está de fiesta\nes cuando más peligro\nhay. Mejor no bajar la\nguardia. Aunque igual\nsobra el consejo, ¿no?"

msgctxt "dialogue/862/0x3"
msgid "dialogue/862/0x3"
msgstr "Soldado imperial\nSiempre hay quien quiere\naprovechar el jaleo para\nhacer tonterías. Y yo\nque también quería\nfestejarlo..."

msgctxt "dialogue/863/0x3"
msgid "dialogue/863/0x3"
msgstr "Soldado imperial\nCon tanta gente, vigilar\ncuesta lo suyo. Ojalá la\ncoronación termine sin\nincidentes."

msgctxt "dialogue/864/0x3"
msgid "dialogue/864/0x3"
msgstr "Soldado imperial\nSu Alteza Rudolph aún es\npequeño, pero con el\nregente Prozen, el\nImperio está a salvo. La\nguerra con la República\nacabará con su victoria."

msgctxt "dialogue/865/0x3"
msgid "dialogue/865/0x3"
msgstr "Vecino\n¿Que a qué viene tanto\njaleo? ¿De qué pueblo\nhabéis salido? Es la\ncoronación del príncipe\nheredero, Su Alteza\nRudolph."

msgctxt "dialogue/866/0x3"
msgid "dialogue/866/0x3"
msgstr "Vecino\nSu Alteza Rudolph acaba\nde cumplir diez años.\nPero con el regente\nProzen, estamos\ntranquilos."

msgctxt "dialogue/867/0x3"
msgid "dialogue/867/0x3"
msgstr "Vecino\nLa prosperidad actual es\nobra del difunto\nemperador, Su Majestad\nZeppelin II. Seguro que\nSu Alteza Rudolph la\nmantendrá."

msgctxt "dialogue/868/0x3"
msgid "dialogue/868/0x3"
msgstr "Vecino\nDicen que Su Alteza\nRudolph es muy bondadoso.\nOjalá se acabe la guerra\ny llegue la paz."

msgctxt "dialogue/869/0x3"
msgid "dialogue/869/0x3"
msgstr "Vecino\n¡De mayor me voy a\ncasar con Rudolph!"

msgctxt "dialogue/870/0x3"
msgid "dialogue/870/0x3"
msgstr "Vecino\nDicen que llegamos a las\npuertas de la capital de\nla República... Si la\nRepública cayera, el\ncontinente sería del\nImperio..."

msgctxt "dialogue/871/0x3"
msgid "dialogue/871/0x3"
msgstr "Guardia imperial\nA partir de aquí empieza\nel castillo de Miletos.\nLos civiles no pueden\npasar."

msgctxt "dialogue/872/0x3"
msgid "dialogue/872/0x3"
msgstr "Guardia imperial\nAy... Mira que tocarme\nguardia en un día así.\nQué mala suerte."

msgctxt "dialogue/873/0x3"
msgid "dialogue/873/0x3"
msgstr "Tabernero\n¡Hoy celebramos la\ncoronación de Su Alteza\nRudolph! ¡Venga, comed\ncuanto queráis!"

msgctxt "dialogue/874/0x3"
msgid "dialogue/874/0x3"
msgstr "Camarera\n¡Ay, qué ajetreo!\n¡Que me dejen descansar\nun poco!"

msgctxt "dialogue/875/0x3"
msgid "dialogue/875/0x3"
msgstr "Vecino\n¡Ay, qué bien sienta una\nbuena fiesta! Me siento\ndiez años más joven."

msgctxt "dialogue/876/0x3"
msgid "dialogue/876/0x3"
msgstr "Soldado imperial\n¡Secuestrar a Su Alteza\nRudolph! ¡Qué gentuza\nmás rastrera, los de la\nRepública!"

msgctxt "dialogue/877/0x3"
msgid "dialogue/877/0x3"
msgstr "Soldado imperial\nEn esa taberna hay un\ntipo amanerado que se\nmete con la gente. Ten\ncuidado."

msgctxt "dialogue/878/0x3"
msgid "dialogue/878/0x3"
msgstr "Vecino\n¿Un hombre y una mujer\ncon un niño? Pues no,\nno los he visto."

msgctxt "dialogue/879/0x3"
msgid "dialogue/879/0x3"
msgstr "Vecino\n¡Dicen que han\nsecuestrado a Su Alteza\nRudolph! Parece que han\nsido los de la República.\n¿Estará bien?"

msgctxt "dialogue/880/0x3"
msgid "dialogue/880/0x3"
msgstr "Vecino\n¿Conoces las ruinas de\nGalil? Son unas ruinas\nantiguas que hay en la\nmeseta de Galil."

msgctxt "dialogue/881/0x3"
msgid "dialogue/881/0x3"
msgstr "Vecino\nDicen que en la capital\nhay mucho revuelo porque\nhan secuestrado a Su\nAlteza Rudolph. Han\nmandado un enorme\ngrupo de búsqueda."

msgctxt "dialogue/882/0x3"
msgid "dialogue/882/0x3"
msgstr "Vecino\nEse de la República...\n¿cómo se llamaba?\n¡Ese Zoid enorme!"

msgctxt "dialogue/882/0x48"
msgid "dialogue/882/0x48"
msgstr "Vecino\n¡Eso, el Gojulas!\n¡Lo vi ir hacia las\nruinas de Galil!"

msgctxt "dialogue/883/0x3"
msgid "dialogue/883/0x3"
msgstr "Vecino\n¡Dicen que han\nsecuestrado a Rudolph!\nPobrecito... ¡Buaaah!"

msgctxt "dialogue/884/0x3"
msgid "dialogue/884/0x3"
msgstr "Tabernero\nBienvenidos. Sentaos\ndonde haya sitio."

msgctxt "dialogue/885/0x3"
msgid "dialogue/885/0x3"
msgstr "Piloto de Zoids\nAnoche vi un Gojulas\nque iba hacia las ruinas\nde Galil. No me equivoco:\nun Zoid tan llamativo no\nse confunde."

msgctxt "dialogue/887/0x3"
msgid "dialogue/887/0x3"
msgstr "Investigador\nPor fin hemos resuelto el\ndescontrol del Bloody\nDemon. Pronto podremos\nllevarlo al combate como\narma."

msgctxt "dialogue/888/0x3"
msgid "dialogue/888/0x3"
msgstr "Investigador\nLa investigación del\nBloody Demon está en su\nfase final. Je, je, je...\n¡El mundo no volverá a\nser el mismo...!"

msgctxt "dialogue/889/0x3"
msgid "dialogue/889/0x3"
msgstr "Investigador\nA veces hasta yo me\nasusto. ¿No estaremos\njugando con algo que\nno deberíamos tocar?"

msgctxt "dialogue/890/0x3"
msgid "dialogue/890/0x3"
msgstr "Aldeano\n¿Eh? ¡En Gray Colony\nno hay más que árboles!\n¡Aquí no hay nada!"

msgctxt "dialogue/890/0x52"
msgid "dialogue/890/0x52"
msgstr "Aldeano\nAh, bueno, lo que sí hay\nes el castillo del\nregente Prozen."

msgctxt "dialogue/891/0x3"
msgid "dialogue/891/0x3"
msgstr "Aldeano\nÚltimamente, de noche, se\nalza una columna de luz\nen lo hondo del bosque.\nDicen que luego quedan\nárboles calcinados.\n¡Ay, qué miedo!"

msgctxt "dialogue/892/0x3"
msgid "dialogue/892/0x3"
msgstr "Aldeano\n¿Te has enterado? ¡Dicen\nque han visto Zoids de la\nRepública! ¿Habrá otra\nguerra...?"

msgctxt "dialogue/893/0x3"
msgid "dialogue/893/0x3"
msgstr "Aldeano\n¡Vi un Zoid desconocido\nque iba hacia el fondo de\nlas montañas! Y por ahí\nes imposible cruzar las\nmontañas con un Zoid..."

msgctxt "dialogue/894/0x3"
msgid "dialogue/894/0x3"
msgstr "Aldeano\nEsta zona es territorio\ndel regente Prozen. Por\nlo visto, a veces vuelve\nde la capital."

msgctxt "dialogue/895/0x3"
msgid "dialogue/895/0x3"
msgstr "Aldeano\nAhí mismo está el monte\nIselina, pero el camino\nes muy abrupto. Solo se\npuede cruzar a pie, así\nque nadie se acerca."

msgctxt "dialogue/896/0x3"
msgid "dialogue/896/0x3"
msgstr "Investigador\n¿¡Quiénes sois!?\n¿¡Ladrones!? ¡Iiiih,\nsocorro!"

