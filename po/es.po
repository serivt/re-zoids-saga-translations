msgctxt "dialogue/384/0x285"
msgid "dialogue/384/0x285"
msgstr "Dark Judgeman\n¡Listooos... a luchaaar!"

msgctxt "dialogue/385/0xc"
msgid "dialogue/385/0xc"
msgstr "Dark Judgeman\nGrrrr... Fin de la\nbataaalla..."

msgctxt "dialogue/385/0x51"
msgid "dialogue/385/0x51"
msgstr "Dark Judgeman\n¡Ganadooor! ¡Team Blitz!"

msgctxt "dialogue/385/0x97"
msgid "dialogue/385/0x97"
msgstr "Dr. Laon\n¡Maldito seas, Tros! ¡La\npróxima vez...!"

msgctxt "dialogue/385/0xcb"
msgid "dialogue/385/0xcb"
msgstr "Dr. Laon\n¡Esto no quedará así,\nbanda de Tros!"

msgctxt "dialogue/386/0x3"
msgid "dialogue/386/0x3"
