msgctxt "dialogue/735/0x3"
msgid "dialogue/735/0x3"
msgstr "Guardia real\nLos Tres Guerreros vienen de\nnuestro reino, del Imperio y\nde la República. El del Imperio\nes el señor Arth."

msgctxt "dialogue/736/0x3"
msgid "dialogue/736/0x3"
