msgctxt "character-guide/3/0x4"
msgid "character-guide/3/0x4"
msgstr "Protagonista{window:3}Príncipe arcadio{window:4}H, 12{window:5}Zoids Saga{window:6}Príncipe de Arcadia. Huyó cuando el\nEmperador asaltó el reino y lucha por\nrecuperarlo con los Tres Guerreros."

msgctxt "character-guide/4/0x4"
msgid "character-guide/4/0x4"
msgstr "Regina{window:3}Guerrera arcadia{window:4}M, 14{window:5}Zoids Saga{window:6}Guerrera de Arcadia y tutora del príncipe,\nde sangre zoidiana. Seria y entrometida;\nsabe de tecnología antigua."

msgctxt "character-guide/5/0x4"
msgid "character-guide/5/0x4"
msgstr "Arth{window:3}Guerrero arcadio{window:4}H, 22{window:5}Zoids Saga{window:6}Guerrero de Arcadia, ex oficial de Guylos:\naporta la visión del Imperio. Callado pero\nmordaz. Buen luchador."

msgctxt "character-guide/6/0x4"
msgid "character-guide/6/0x4"
msgstr "Jack{window:3}Guerrero arcadio{window:4}H, 25{window:5}Zoids Saga{window:6}Guerrero de Arcadia, ex oficial de Helic:\naporta la visión de la República y es el\nestratega del príncipe."

msgctxt "character-guide/7/0x4"
msgid "character-guide/7/0x4"
msgstr "Dr. T{window:3}Investigador Zoid{window:4}H{window:5}Zoids Saga{window:6}Investigador del laboratorio Zoid de\nArcadia. Estudiaba el legado de Arcadia\npor encargo del rey."

msgctxt "character-guide/8/0x4"
msgid "character-guide/8/0x4"
msgstr "Rey de Arcadia{window:3}Rey de Arcadia{window:4}H{window:5}Zoids Saga{window:6}Padre del protagonista. El Emperador lo\ncapturó al invadir Arcadia. Nadie sabe\ndónde está."

msgctxt "character-guide/9/0x4"
msgid "character-guide/9/0x4"
msgstr "Reina de Arcadia{window:3}Reina de Arcadia{window:4}M{window:5}Zoids Saga{window:6}Madre del protagonista. El Emperador la\ncapturó al invadir Arcadia. Nadie sabe\ndónde está."

msgctxt "character-guide/23/0x4"
msgid "character-guide/23/0x4"
msgstr "Fran{window:3}Cuatro Reyes{window:4}M, 20{window:5}Zoids Saga{window:6}Una de los Cuatro Reyes, del Imperio como\nArth. Fría y serena, ante Arth muestra su\nodio. ¿Qué pasó entre ellos dos?"

msgctxt "character-guide/24/0x4"
msgid "character-guide/24/0x4"
msgstr "Gale{window:3}Cuatro Reyes{window:4}H, 30{window:5}Zoids Saga{window:6}Uno de los Cuatro Reyes. Fue el maestro\nde Jack en la República; ahora se\ninterpone en su camino."

msgctxt "character-guide/25/0x4"
msgid "character-guide/25/0x4"
msgstr "Opis{window:3}Cuatro Reyes{window:4}H{window:5}Zoids Saga{window:6}Uno de los Cuatro Reyes. Científico Zoid\nexpulsado del Imperio por sus peligrosos\nexperimentos."

msgctxt "character-guide/26/0x4"
msgid "character-guide/26/0x4"
msgstr "Blood{window:3}Cuatro Reyes{window:4}H, 16{window:5}Zoids Saga{window:6}Líder de los Cuatro Reyes y de confianza\ndel Emperador, con una ambición sin\nlímites. Rival del príncipe."

msgctxt "character-guide/27/0x4"
msgid "character-guide/27/0x4"
msgstr "Emperador{window:3}Jefe supremo{window:4}H{window:5}Zoids Saga{window:6}Causa del desastre de Arcadia. Nadie ha\nvisto su cara tras la máscara. Tomó el\nreino en una noche."

msgctxt "character-guide/43/0x4"
msgid "character-guide/43/0x4"
msgstr "Gold Judgeman{window:3}Árbitro Zoid{window:4}?{window:5}Zoids Saga{window:6}Dirige la final del Coliseo. El Judgeman de\nlos Judgeman."

msgctxt "character-guide/203/0x4"
msgid "character-guide/203/0x4"
msgstr "Rob Herman{window:3}Militar de Helic{window:4}H{window:5}Zoids, partes 1 y 2{window:6}Capitán y luego coronel de Helic. Conoció\na Van en Red River. Terco y querido por\nsus hombres. Hijo del presidente."

msgctxt "character-guide/204/0x4"
msgid "character-guide/204/0x4"
msgstr "Ford{window:3}Militar de Helic{window:4}H{window:5}Zoids, partes 1 y 2{window:6}Teniente coronel de Helic, ayudante de\nKrueger. A menudo manda la unidad en su\nlugar. Sin brillo, pero un estratega sólido."

msgctxt "character-guide/205/0x4"
msgid "character-guide/205/0x4"
msgstr "O'Connell{window:3}Militar de Helic{window:4}H{window:5}Zoids, partes 1 y 2{window:6}Teniente de Helic, ayudante de Herman.\nSiempre en el frente y terco como su jefe.\nContrató a Moonbay en Red River."

msgctxt "character-guide/206/0x4"
msgid "character-guide/206/0x4"
msgstr "Krueger{window:3}Militar de Helic{window:4}H{window:5}Zoids, parte 1{window:6}Coronel de Helic que dejó la reserva ante\nla invasión de Guylos. El mago del campo\nde batalla."

msgctxt "character-guide/223/0x4"
msgid "character-guide/223/0x4"
msgstr "Raven{window:3}Piloto de Zoids{window:4}H{window:5}Zoids, parte 1{window:6}Piloto criado por Prozen. Odia a los Zoids,\npero los pilota como un genio. Con Shadow\ny su Geno Saurer, lucha a muerte con Van."

msgctxt "character-guide/224/0x4"
msgid "character-guide/224/0x4"
msgstr "Shadow{window:3}Organoide{window:4}?{window:5}Zoids, partes 1 y 2{window:6}El organoide negro de Raven. Hiltz lo\ndestruyó, pero volvió; atacó a Raven y\nlas lágrimas de este lo despertaron."

msgctxt "character-guide/225/0x4"
msgid "character-guide/225/0x4"
msgstr "Gunter Prozen{window:3}Mariscal regente{window:4}H{window:5}Zoids, parte 1{window:6}Mariscal y regente de Guylos. Planea\nmatar a Rudolf y revivir al Death Saurer\npara dominar el mundo."

msgctxt "character-guide/226/0x4"
msgid "character-guide/226/0x4"
msgstr "Rudolf III{window:3}Emperador{window:4}H, 10{window:5}Zoids, partes 1 y 2{window:6}Nieto del emperador. Raptado por Rosso y\nperseguido por Prozen, llega con Van a\nGuygalos y trae la paz."

msgctxt "character-guide/243/0x4"
msgid "character-guide/243/0x4"
msgstr "Van Flyheight{window:3}Piloto de Zoids{window:4}H, 14{window:5}Zoids, parte 1{window:6}Chico de Wind Colony amante de los Zoids.\nHalla a Fiona y al organoide Zeke en unas\nruinas y viaja con ellos. Pilota un Liger."

msgctxt "character-guide/244/0x4"
msgid "character-guide/244/0x4"
msgstr "Fiona{window:3}Antigua zoidiana{window:4}M{window:5}Zoids, parte 1{window:6}Descendiente de los antiguos zoidianos.\nBuscó Zoid Eve con Van y luego ayudó al\nDr. D. Sigue despistada."

msgctxt "character-guide/245/0x4"
msgid "character-guide/245/0x4"
msgstr "Irvine{window:3}Cazador{window:4}H, 22{window:5}Zoids, parte 1{window:6}Iba tras Zeke, pero se hizo amigo de Van.\nPilota un Command Wolf. Su parche es una\ncámara."

msgctxt "character-guide/246/0x4"
msgid "character-guide/246/0x4"
msgstr "Moonbay{window:3}Transportista{window:4}M{window:5}Zoids, parte 1{window:6}Transportista del desierto que viaja con\nVan; dura y tierna como una hermana\nmayor."

msgctxt "character-guide/247/0x4"
msgid "character-guide/247/0x4"
msgstr "Zeke{window:3}Organoide{window:4}?{window:5}Zoids, partes 1 y 2{window:6}El organoide blanco de Van, despertado\njunto a Fiona. Siempre con Van, apoya a\nsu Shield Liger y a su Blade Liger."

msgctxt "character-guide/248/0x4"
msgid "character-guide/248/0x4"
msgstr "Dr. D{window:3}Investigador Zoid{window:4}H{window:5}Zoids, partes 1 y 2{window:6}Científico de Helic retirado a estudiar\ncómo hacer nevar. Vuelve para ayudar a\nVan. Toma café con sal."

msgctxt "character-guide/249/0x4"
msgid "character-guide/249/0x4"
msgstr "Rosso{window:3}Arcobaleno{window:4}H{window:5}Zoids, partes 1 y 2{window:6}Jefe de los bandidos Desalto Arcobaleno,\nex comando imperial. Escapa de prisión y\nacaba protegiendo a Rudolf."

msgctxt "character-guide/250/0x4"
msgid "character-guide/250/0x4"
msgstr "Viola{window:3}Arcobaleno{window:4}M{window:5}Zoids, partes 1 y 2{window:6}Miembro de Desalto Arcobaleno. Liberó a\nRosso de la cárcel y lo ayudó a raptar a\nRudolf."

msgctxt "character-guide/251/0x4"
msgid "character-guide/251/0x4"
msgstr "El enmascarado{window:3}Piloto de Zoids{window:4}H{window:5}Partes 1 y 2{window:6}Piloto misterioso de un Storm Sworder que\nayuda a Van. Se parece a Rosso, el líder\nde Desalto Arcobaleno."

msgctxt "character-guide/252/0x4"
msgid "character-guide/252/0x4"
msgstr "La enmascarada{window:3}Piloto de Zoids{window:4}M{window:5}Partes 1 y 2{window:6}Piloto misteriosa de un Storm Sworder que\nayuda a Van. Se parece a Viola. Su frase:\n\"Catch you later!\""

msgctxt "character-guide/253/0x4"
msgid "character-guide/253/0x4"
msgstr "Stinger{window:3}Cazador{window:4}H{window:5}Zoids, partes 1 y 2{window:6}Guapo por fuera, cruel y ruin por dentro.\nUsa gas venenoso y disfruta del dolor\najeno. En el bar pide leche, por la salud."

msgctxt "character-guide/403/0x4"
msgid "character-guide/403/0x4"
msgstr "Van Flyheight{window:3}Guardian Force{window:4}H, 16{window:5}Zoids, parte 2{window:6}Dos años después del Death Saurer, es un\ngran piloto y miembro de la Guardian\nForce."

msgctxt "character-guide/423/0x4"
msgid "character-guide/423/0x4"
msgstr "Karl Schubaltz{window:3}Militar imperial{window:4}H{window:5}Zoids, partes 1 y 2{window:6}Coronel imperial al mando de la 1.ª\nDivisión Blindada. Veterano de familia\nilustre y con mala suerte."

msgctxt "character-guide/424/0x4"
msgid "character-guide/424/0x4"
msgstr "Thomas Schubaltz{window:3}Guardian Force{window:4}H{window:5}Zoids, parte 2{window:6}Teniente imperial de la Guardian Force y\nhermano de Karl. Usa a Beak, su IA mejor\nque un organoide. Enamorado de Fiona."

msgctxt "character-guide/443/0x4"
msgid "character-guide/443/0x4"
msgstr "Fiona{window:3}Antigua zoidiana{window:4}M{window:5}Zoids, parte 2{window:6}Recuperó su memoria zoidiana y ayudaba\nal Dr. D, hasta que entró en la Guardian\nForce con Van. Sigue igual de despistada."

msgctxt "character-guide/444/0x4"
msgid "character-guide/444/0x4"
msgstr "Irvine{window:3}Cazador{window:4}H, 24{window:5}Zoids, parte 2{window:6}Tras el Death Saurer siguió cazando\nrecompensas y acabó con la Guardian\nForce. Amigo y rival de Van y Thomas."

msgctxt "character-guide/445/0x4"
msgid "character-guide/445/0x4"
msgstr "Moonbay{window:3}Cazadora{window:4}M{window:5}Zoids, parte 2{window:6}Transportista que acaba con la Guardian\nForce. Herman le da el Ultrasaurus y se lo\napropia. No pudo estrenar canción nueva."

msgctxt "character-guide/446/0x4"
msgid "character-guide/446/0x4"
msgstr "Raven{window:3}Piloto de Zoids{window:4}H{window:5}Zoids, parte 2{window:6}Vencido por Van, vagó sin memoria. Hiltz\nlo recluta; pilota el Geno Breaker, pero le\ncuesta dominarlo."

msgctxt "character-guide/447/0x4"
msgid "character-guide/447/0x4"
msgstr "Reese{window:3}Antigua zoidiana{window:4}M{window:5}Zoids, parte 2{window:6}Zoidiana antigua con el organoide azul\nSpecular. Experta en ataques mentales.\nTras la traición de Hiltz, se une a Raven."

msgctxt "character-guide/448/0x4"
msgid "character-guide/448/0x4"
msgstr "Hiltz{window:3}Piloto de Zoids{window:4}H{window:5}Zoids, parte 2{window:6}Zoidiano antiguo con el organoide\nAmbient. Revivió al Death Stinger y quiso\ndestruir el mundo."

msgctxt "character-guide/449/0x4"
msgid "character-guide/449/0x4"
msgstr "Specular{window:3}Organoide{window:4}?{window:5}Zoids, parte 2{window:6}El organoide azul de Reese. Lleva al Zoid\ncon el que se une más allá de su límite."

msgctxt "character-guide/450/0x4"
msgid "character-guide/450/0x4"
msgstr "Dark Kaiser{window:3}Desconocido{window:4}H{window:5}Zoids, parte 2{window:6}Prozen fundido con el Death Saurer. Usaba\na Hiltz y Reese para renacer, pero era\nparte del plan de Hiltz."

msgctxt "character-guide/451/0x4"
msgid "character-guide/451/0x4"
msgstr "Ambient{window:3}Organoide{window:4}?{window:5}Zoids, parte 2{window:6}El organoide rojo de Hiltz. Tiene poderes\nextraños, como unir los núcleos del Death\nStinger."

msgctxt "character-guide/452/0x4"
msgid "character-guide/452/0x4"
msgstr "Hiltz{window:3}Antiguo zoidiano{window:4}H{window:5}Parte 2{window:6}Hiltz tras absorber al Dark Kaiser y\nfundirse con el Death Saurer."

msgctxt "character-guide/603/0x4"
msgid "character-guide/603/0x4"
msgstr "Bit Cloud{window:3}Guerrero Zoid{window:4}H, 16{window:5}Zoids Zero{window:6}Chatarrero viajero que conoció al Liger\nZero y se unió al Equipo Blitz como\nguerrero Zoid."

msgctxt "character-guide/604/0x4"
msgid "character-guide/604/0x4"
msgstr "Leena Toros{window:3}Guerrera Zoid{window:4}M, 16{window:5}Zoids Zero{window:6}Hija del Dr. Toros y guerrera del Blitz.\nLinda pero brusca, temeraria y\ncaprichosa."

msgctxt "character-guide/605/0x4"
msgid "character-guide/605/0x4"
msgstr "Brad Hunter{window:3}Guerrero Zoid{window:4}H, 17{window:5}Zoids Zero{window:6}Guerrero libre a sueldo del Blitz, muy\nduro con el dinero. Cambió su Command\nWolf por el Shadow Fox."

msgctxt "character-guide/606/0x4"
msgid "character-guide/606/0x4"
msgstr "Jamie Hemeros{window:3}Guerrero Zoid{window:4}H, 14{window:5}Zoids Zero{window:6}Estratega y mecánico del Blitz. Tranquilo\ny amable, cambia por completo al pilotar\nel Raynos."

msgctxt "character-guide/607/0x4"
msgid "character-guide/607/0x4"
msgstr "Leon Toros{window:3}Guerrero Zoid{window:4}H{window:5}Zoids Zero{window:6}Ex guerrero del Blitz. Volvió con un Blade\nLiger rojo y se unió a Naomi. Hermano de\nLeena."

msgctxt "character-guide/608/0x4"
msgid "character-guide/608/0x4"
msgstr "Dr. Toros{window:3}Jefe y mecánico{window:4}H, 38{window:5}Zoids Zero{window:6}Director y mecánico del Blitz. Nadie sabe\nqué piensa; quizá solo es un fan de los\nZoids."

msgctxt "character-guide/623/0x4"
msgid "character-guide/623/0x4"
msgstr "Volta{window:3}Guerrero Zoid{window:4}H{window:5}Zoids Zero{window:6}Miembro del Backdraft, que organiza\nbatallas oscuras con trampas y asalta\nbatallas Zoid."

msgctxt "character-guide/624/0x4"
msgid "character-guide/624/0x4"
msgstr "Dr. Laon{window:3}Jefe y mecánico{window:4}H{window:5}Zoids Zero{window:6}Rival del Dr. Toros desde la universidad.\nPierde una y otra vez contra el Blitz,\nhasta que el Backdraft lo recluta."

msgctxt "character-guide/625/0x4"
msgid "character-guide/625/0x4"
msgstr "Dark Judgeman{window:3}Árbitro Zoid{window:4}?{window:5}Zoids Zero{window:6}IA árbitro de las batallas oscuras.\nAplasta al Judgeman y roba la batalla,\naunque a veces el Judgeman se defiende."

msgctxt "character-guide/626/0x4"
msgid "character-guide/626/0x4"
msgstr "Vega{window:3}Guerrero Zoid{window:4}H{window:5}Zoids Zero{window:6}Chico que pilota el legendario Berserk\nFury del Backdraft. Prevé los movimientos\ndel rival."

msgctxt "character-guide/643/0x4"
msgid "character-guide/643/0x4"
msgstr "Naomi Fluegel{window:3}Guerrera Zoid{window:4}M{window:5}Zoids Zero{window:6}La \"Relámpago Rojo\", tiradora sin igual y\nsolitaria. En una batalla oscura la salvó\nLeon, y desde entonces van en equipo."

msgctxt "character-guide/644/0x4"
msgid "character-guide/644/0x4"
msgstr "Harry Champ{window:3}Guerrero Zoid{window:4}H{window:5}Zoids Zero{window:6}Nacido para ser rey. Con su dinero reúne\nlos mejores Zoids para su Equipo Champ.\nAma a Leena y ve a Bit como su rival."

msgctxt "character-guide/645/0x4"
msgid "character-guide/645/0x4"
msgstr "Kirkland{window:3}Guerrero Zoid{window:4}H{window:5}Zoids Zero{window:6}Líder del Equipo Tigers. Desde que perdió\ncon el Blitz no gana, ni con ayuda del Dr.\nLaon."

msgctxt "character-guide/646/0x4"
msgid "character-guide/646/0x4"
msgstr "Benjamin{window:3}IA autónoma{window:4}?{window:5}Zoids Zero{window:6}Robot del Equipo Champ, enamorada del\nJudgeman. Atacó la sede de la liga para\nverlo."

msgctxt "character-guide/647/0x4"
msgid "character-guide/647/0x4"
msgstr "Sebastian{window:3}IA autónoma{window:4}?{window:5}Zoids Zero{window:6}Robot del Equipo Champ de Harry. Un raro\ncaso de sentido común."

msgctxt "character-guide/648/0x4"
msgid "character-guide/648/0x4"
msgstr "Judgeman{window:3}Árbitro Zoid{window:4}?{window:5}Zoids Zero{window:6}Árbitro imparcial y ley de las batallas\nZoid, enviado por la liga. ¡Mientras él\nesté, la justicia ganará!"

msgctxt "character-guide/803/0x4"
msgid "character-guide/803/0x4"
msgstr "Alster{window:3}Piloto de Zoids{window:4}H{window:5}Liger Zero (Game Boy){window:6}Protagonista de \"Liger Zero\" de Game Boy.\nUn año tras su aventura subterránea,\nprotege su aldea de los Zoids salvajes."

msgctxt "character-guide/804/0x4"
msgid "character-guide/804/0x4"
msgstr "Palty{window:3}Subterránea{window:4}M{window:5}Liger Zero (Game Boy){window:6}Heroína de \"Liger Zero\" de Game Boy. Un\naño tras la aventura subterránea, vive en\npaz en la aldea de Alster."

msgctxt "character-guide/805/0x4"
msgid "character-guide/805/0x4"
msgstr "Solid{window:3}Militar imperial{window:4}H{window:5}Liger Zero (Game Boy){window:6}Rival del protagonista de \"Liger Zero\" de\nGame Boy. Un año después, caza a los\nZoids salvajes que siembran el caos."

msgctxt "character-guide/806/0x4"
msgid "character-guide/806/0x4"
msgstr "Blue Gem{window:3}Ingeniero Zoid{window:4}H{window:5}Liger Zero (Game Boy){window:6}Mecánico que ayuda al protagonista de\n\"Liger Zero\" de Game Boy. Ahora repara\nZoids en la aldea de Alster."

msgctxt "dialogue/42/0xc"
msgid "dialogue/42/0xc"
msgstr "Jack\n¿Príncipe?\n¿Qué ocurre?"

msgctxt "dialogue/42/0x3d"
msgid "dialogue/42/0x3d"
msgstr "{name}\n......"

msgctxt "dialogue/42/0x5e"
msgid "dialogue/42/0x5e"
msgstr "Jack\n...¿Hm?\nAhora mismo debería..."

msgctxt "dialogue/42/0x89"
msgid "dialogue/42/0x89"
msgstr "Jack\n...Ya veo, se ha vuelto a\nescapar de la lección."

msgctxt "dialogue/42/0xcb"
msgid "dialogue/42/0xcb"
msgstr "{name}\n......"

msgctxt "dialogue/42/0xec"
msgid "dialogue/42/0xec"
msgstr "Jack\n...Uf...\nYa imagino la cara de Regina."

msgctxt "dialogue/42/0x12b"
msgid "dialogue/42/0x12b"
msgstr "Jack\nNo le dé disgustos a Regina,\npríncipe."

msgctxt "dialogue/42/0x161"
msgid "dialogue/42/0x161"
msgstr "Jack\nPensar en la posición de ella\ntambién es parte de sus\ndeberes como príncipe.\nNo lo olvide."

msgctxt "dialogue/42/0x1c2"
msgid "dialogue/42/0x1c2"
msgstr "{name}\n......"

msgctxt "dialogue/43/0xc"
msgid "dialogue/43/0xc"
msgstr "Arth\nPríncipe."

msgctxt "dialogue/43/0x2a"
msgid "dialogue/43/0x2a"
msgstr "{name}\n......"

msgctxt "dialogue/43/0x4b"
msgid "dialogue/43/0x4b"
msgstr "Arth\nQué raro verle por aquí."

msgctxt "dialogue/43/0x81"
msgid "dialogue/43/0x81"
msgstr "Arth\n......"

msgctxt "dialogue/43/0x9b"
msgid "dialogue/43/0x9b"
msgstr "Arth\n...¿Otra vez escaqueándose...?"

msgctxt "dialogue/43/0xd5"
msgid "dialogue/43/0xd5"
msgstr "{name}\n......"

msgctxt "dialogue/43/0xf6"
msgid "dialogue/43/0xf6"
msgstr "Arth\n......"

msgctxt "dialogue/43/0x110"
msgid "dialogue/43/0x110"
msgstr "Arth\nEl rey le estaba buscando.\nVaya a verle."

msgctxt "dialogue/43/0x142"
msgid "dialogue/43/0x142"
msgstr "Arth\n¿O prefiere que le someta\na mi entrenamiento?"

msgctxt "dialogue/43/0x180"
msgid "dialogue/43/0x180"
msgstr "{name}\n......"

msgctxt "dialogue/45/0x3"
msgid "dialogue/45/0x3"
msgstr "Guardia real\nSu Majestad está recorriendo\nel castillo."

msgctxt "dialogue/45/0x3e"
msgid "dialogue/45/0x3e"
msgstr "Guardia real\nCreo que ahora está en la sala\ndel fondo."

msgctxt "dialogue/45/0x70"
msgid "dialogue/45/0x70"
msgstr "Guardia real\n...Por cierto, parecía estar\nbuscando al príncipe\n{name}."

msgctxt "dialogue/46/0x3"
msgid "dialogue/46/0x3"
msgstr "Rey de Arcadia\n...{name}..."

msgctxt "dialogue/46/0x34"
msgid "dialogue/46/0x34"
msgstr "{name}\n......"

msgctxt "dialogue/46/0x4c"
msgid "dialogue/46/0x4c"
msgstr "Rey de Arcadia\n¿Cómo van tus estudios?"

msgctxt "dialogue/46/0x74"
msgid "dialogue/46/0x74"
msgstr "Rey de Arcadia\n¿Sigues como es debido lo que\nte enseñan los Tres Guerreros?"

msgctxt "dialogue/47/0xc"
msgid "dialogue/47/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/47/0x24"
msgid "dialogue/47/0x24"
msgstr "Rey de Arcadia\nTú serás quien me suceda..."

msgctxt "dialogue/47/0x5b"
msgid "dialogue/47/0x5b"
msgstr "Regina\n¡Príncipe!\n¿¡Dónde se ha metido!?"

msgctxt "dialogue/47/0x9a"
msgid "dialogue/47/0x9a"
msgstr "{name}\n......"

msgctxt "dialogue/48/0xc"
msgid "dialogue/48/0xc"
msgstr "Regina\n¡¡Príncipe!!"

msgctxt "dialogue/48/0x24"
msgid "dialogue/48/0x24"
msgstr "Regina\n¡Otra vez saltándose la\nlección para venir aquí!"

msgctxt "dialogue/48/0x62"
msgid "dialogue/48/0x62"
msgstr "Regina\n¡¡¡!!! ¡Ma-Majestad!\n¡Disculpe!"

msgctxt "dialogue/48/0xa3"
msgid "dialogue/48/0xa3"
msgstr "{name}\n......"

msgctxt "dialogue/49/0xc"
msgid "dialogue/49/0xc"
msgstr "Regina\n¡Como tutora del príncipe, este\nfallo es solo culpa mía!"

msgctxt "dialogue/49/0x5f"
msgid "dialogue/49/0x5f"
msgstr "Regina\nAceptaré cualquier castigo..."

msgctxt "dialogue/49/0x84"
msgid "dialogue/49/0x84"
msgstr "Rey de Arcadia\nNo importa. La culpa no\nes tuya."

msgctxt "dialogue/49/0xc2"
msgid "dialogue/49/0xc2"
msgstr "Regina\n¡¡Pero...!!"

msgctxt "dialogue/49/0xe1"
msgid "dialogue/49/0xe1"
msgstr "Rey de Arcadia\nHe dicho que está bien.\n{name}..."

msgctxt "dialogue/49/0x10d"
msgid "dialogue/49/0x10d"
msgstr "Rey de Arcadia\nNo: futuro rey de Arcadia."

msgctxt "dialogue/49/0x13d"
msgid "dialogue/49/0x13d"
msgstr "Rey de Arcadia\n¿Cuál es tu deber?\n¿Andar jugando por ahí?"

msgctxt "dialogue/49/0x186"
msgid "dialogue/49/0x186"
msgstr "{name}\n......"

msgctxt "dialogue/49/0x19e"
msgid "dialogue/49/0x19e"
msgstr "Rey de Arcadia\nNo. Es proteger la paz de\neste reino y de esta tierra."

msgctxt "dialogue/49/0x1e5"
msgid "dialogue/49/0x1e5"
msgstr "Rey de Arcadia\nY el legado antiguo que duerme\nen lo más hondo del castillo."

msgctxt "dialogue/49/0x22e"
msgid "dialogue/49/0x22e"
msgstr "Rey de Arcadia\nTu deber es guardar su\nsecreto."

msgctxt "dialogue/49/0x266"
msgid "dialogue/49/0x266"
msgstr "Rey de Arcadia\n...La paz de hoy no es más\nque algo pasajero."

msgctxt "dialogue/49/0x2a2"
msgid "dialogue/49/0x2a2"
msgstr "Rey de Arcadia\nSe sostiene sobre el frágil\nequilibrio de fuerzas entre\nla República y el Imperio,\nun equilibrio muy precario."

msgctxt "dialogue/49/0x2fd"
msgid "dialogue/49/0x2fd"
msgstr "Rey de Arcadia\nSi uno de los dos, o quizá...\nquizá otra fuerza distinta..."

msgctxt "dialogue/49/0x348"
msgid "dialogue/49/0x348"
msgstr "Rey de Arcadia\n...apareciera, bastaría para\nque se perdiera."

msgctxt "dialogue/49/0x388"
msgid "dialogue/49/0x388"
msgstr "Regina\n......"

msgctxt "dialogue/49/0x3b0"
msgid "dialogue/49/0x3b0"
msgstr "Jack\n......"

msgctxt "dialogue/49/0x3d8"
msgid "dialogue/49/0x3d8"
msgstr "Arth\n......"

msgctxt "dialogue/50/0xc"
msgid "dialogue/50/0xc"
msgstr "Regina\n¡!"

msgctxt "dialogue/50/0x2a"
msgid "dialogue/50/0x2a"
msgstr "Jack\n¡!"

msgctxt "dialogue/50/0x48"
msgid "dialogue/50/0x48"
msgstr "Arth\n¡!"

msgctxt "dialogue/50/0x5b"
msgid "dialogue/50/0x5b"
msgstr "Rey de Arcadia\n¡! ¡¿Qué ocurre?!"

msgctxt "dialogue/51/0x3"
msgid "dialogue/51/0x3"
msgstr "Soldado\n¡Nos atacan!\n¡¡Es un ataque por sorpresa!!"

msgctxt "dialogue/51/0x5a"
msgid "dialogue/51/0x5a"
msgstr "Arth\n¡Informe de la situación!"

msgctxt "dialogue/51/0x87"
msgid "dialogue/51/0x87"
msgstr "Soldado\n¡Atacan por el sur!\n¡¡Están rompiendo las murallas!!"

msgctxt "dialogue/51/0xd7"
msgid "dialogue/51/0xd7"
msgstr "Soldado\n¡¡¡Son tropas de la\nRepública!!!"

msgctxt "dialogue/51/0x107"
msgid "dialogue/51/0x107"
msgstr "Jack\n¡! ¡¿Imposible?!"

msgctxt "dialogue/51/0x133"
msgid "dialogue/51/0x133"
msgstr "Arth\n¡¿Qué significa esto, Jack?!"

msgctxt "dialogue/52/0x3"
msgid "dialogue/52/0x3"
msgstr "Soldado\n¡¡Han abierto brecha en\nla muralla!!"

msgctxt "dialogue/52/0x35"
msgid "dialogue/52/0x35"
msgstr "Regina\n¡¿Qué?!"

msgctxt "dialogue/52/0x4e"
msgid "dialogue/52/0x4e"
msgstr "Soldado\n¡¡Es el ejército imperial!!\n¡¡¡Avanza por el norte!!!"

msgctxt "dialogue/52/0x97"
msgid "dialogue/52/0x97"
msgstr "Arth\n¡¡¿Qué?!!"

msgctxt "dialogue/52/0xb9"
msgid "dialogue/52/0xb9"
msgstr "Jack\n¡¿También el Imperio?!"

msgctxt "dialogue/52/0xe3"
msgid "dialogue/52/0xe3"
msgstr "Arth\n¡Maldición!"

msgctxt "dialogue/52/0xf9"
msgid "dialogue/52/0xf9"
msgstr "Arth\n¡¡Jack, Regina, salimos!!"

msgctxt "dialogue/53/0x3"
msgid "dialogue/53/0x3"
msgstr "Rey de Arcadia\n¡Esperad! ¡¡Tres Guerreros!!"

msgctxt "dialogue/53/0x3d"
msgid "dialogue/53/0x3d"
msgstr "Arth\n¡Pero...!"

msgctxt "dialogue/53/0x58"
msgid "dialogue/53/0x58"
msgstr "Rey de Arcadia\nLlevaos a {name} y huid."

msgctxt "dialogue/53/0x8d"
msgid "dialogue/53/0x8d"
msgstr "Jack\n¡!"

msgctxt "dialogue/53/0xab"
msgid "dialogue/53/0xab"
msgstr "Arth\n¡!"

msgctxt "dialogue/53/0xc7"
msgid "dialogue/53/0xc7"
msgstr "Regina\n¡¡Majestad!!"

msgctxt "dialogue/53/0xe4"
msgid "dialogue/53/0xe4"
msgstr "Rey de Arcadia\nEl Imperio y la República...\nno tenemos ninguna opción."

msgctxt "dialogue/53/0x121"
msgid "dialogue/53/0x121"
msgstr "Rey de Arcadia\n...Lo que buscan es el\nlegado antiguo..."

msgctxt "dialogue/53/0x15d"
msgid "dialogue/53/0x15d"
msgstr "Rey de Arcadia\nTres Guerreros, ¡proteged el\nlegado antiguo con\n{name}!"

msgctxt "dialogue/53/0x1a2"
msgid "dialogue/53/0x1a2"
msgstr "Regina, Jack y Arth\n¡A la orden!"

msgctxt "dialogue/53/0x1cd"
msgid "dialogue/53/0x1cd"
msgstr "Rey de Arcadia\n...{name}..."

msgctxt "dialogue/53/0x1f0"
msgid "dialogue/53/0x1f0"
msgstr "Rey de Arcadia\nLos Tres Guerreros tienen la\nmisión de protegerte, pero\ntú, como príncipe, también\ndebes protegerlos.\nNo lo olvides..."

msgctxt "dialogue/53/0x276"
msgid "dialogue/53/0x276"
msgstr "{name}\n......"

msgctxt "dialogue/53/0x28e"
msgid "dialogue/53/0x28e"
msgstr "Rey de Arcadia\nAhora vete... ¡¡Vete ya!!\nPerdona a tu padre por\ncargarte con algo tan duro.\nPerdóname..."

msgctxt "dialogue/53/0x2f3"
msgid "dialogue/53/0x2f3"
msgstr "{name}\n......"

msgctxt "dialogue/54/0xc"
msgid "dialogue/54/0xc"
msgstr "Regina\n¡Príncipe, rápido, al\nsubterráneo!"

msgctxt "dialogue/54/0x3c"
msgid "dialogue/54/0x3c"
msgstr "{name}\n......."

msgctxt "dialogue/55/0xc"
msgid "dialogue/55/0xc"
msgstr "Jack\n¿Qué ocurre, príncipe...?"

msgctxt "dialogue/55/0x42"
msgid "dialogue/55/0x42"
msgstr "Regina\n¿Enemigos?"

msgctxt "dialogue/55/0x62"
msgid "dialogue/55/0x62"
msgstr "Arth\nNo lo sé."

msgctxt "dialogue/56/0xc"
msgid "dialogue/56/0xc"
msgstr "Caballero misterioso\n¡Basta con rodear el castillo!"

msgctxt "dialogue/56/0x44"
msgid "dialogue/56/0x44"
msgstr "Líder misterioso\nPrimero hay que tomar el\nsubterráneo..."

msgctxt "dialogue/56/0x86"
msgid "dialogue/56/0x86"
msgstr "Caballero misterioso\n¡¡!!"

msgctxt "dialogue/57/0xc"
msgid "dialogue/57/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/57/0x2d"
msgid "dialogue/57/0x2d"
msgstr "Regina\n¿Quiénes son? No son ni\nimperiales ni de la República..."

msgctxt "dialogue/57/0x72"
msgid "dialogue/57/0x72"
msgstr "Jack\nDejemos la charla para\ndespués."

msgctxt "dialogue/57/0x9e"
msgid "dialogue/57/0x9e"
msgstr "Jack\nAhora hay que pensar en\nescapar cuanto antes."

msgctxt "dialogue/57/0xf1"
msgid "dialogue/57/0xf1"
msgstr "Regina\nTienes razón.\nVamos, príncipe."

msgctxt "dialogue/57/0x128"
msgid "dialogue/57/0x128"
msgstr "{name}\n......"

msgctxt "dialogue/58/0xc"
msgid "dialogue/58/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/59/0xc"
msgid "dialogue/59/0xc"
msgstr "Arth\n...Esto es..."

msgctxt "dialogue/59/0x38"
msgid "dialogue/59/0x38"
msgstr "Jack\nZoids...\nAunque bastante viejos."

msgctxt "dialogue/59/0x7b"
msgid "dialogue/59/0x7b"
msgstr "{name}\n......"

msgctxt "dialogue/59/0x9c"
msgid "dialogue/59/0x9c"
msgstr "Regina\nNo es momento de ponerse\nexigentes."

msgctxt "dialogue/59/0xcc"
msgid "dialogue/59/0xcc"
msgstr "Arth\nEn fin, echemos un vistazo..."

msgctxt "dialogue/59/0x102"
msgid "dialogue/59/0x102"
msgstr "Jack\nDe acuerdo."

msgctxt "dialogue/60/0xc"
msgid "dialogue/60/0xc"
msgstr "Regina\nPríncipe, ya le expliqué lo\ndel Zoid Commander, ¿verdad?"

msgctxt "dialogue/60/0x5d"
msgid "dialogue/60/0x5d"
msgstr "{name}\n......"

msgctxt "dialogue/60/0x7e"
msgid "dialogue/60/0x7e"
msgstr "Regina\nLe pedí que lo llevara siempre\npuesto para registrar sus\npatrones de pensamiento,\n¿no es así?"

msgctxt "dialogue/60/0xeb"
msgid "dialogue/60/0xeb"
msgstr "{name}\n......"

msgctxt "dialogue/60/0x10c"
msgid "dialogue/60/0x10c\n"
msgstr "Regina\n¡Sí, eso que lleva en la\ncabeza!\n"

msgctxt "dialogue/60/0x13f"
msgid "dialogue/60/0x13f"
msgstr "Regina\nTransmite sus pensamientos al\nZoid y le ayuda a pilotarlo."

msgctxt "dialogue/60/0x19e"
msgid "dialogue/60/0x19e"
msgstr "Regina\nCon él, hasta con su nivel,\ndebería arreglárselas..."

msgctxt "dialogue/60/0x1ed"
msgid "dialogue/60/0x1ed"
msgstr "{name}\n......"

msgctxt "dialogue/60/0x20e"
msgid "dialogue/60/0x20e"
msgstr "Regina\n¡Aguántese!"

msgctxt "dialogue/60/0x234"
msgid "dialogue/60/0x234"
msgstr "Regina\n¡Esto pasa porque {name}\nsiempre falta a las prácticas!"

msgctxt "dialogue/60/0x27a"
msgid "dialogue/60/0x27a"
msgstr "{name}\n......"

msgctxt "dialogue/61/0xc"
msgid "dialogue/61/0xc"
msgstr "Regina\nBien, ahora falta el Zoid\nque pilotará el príncipe..."

msgctxt "dialogue/61/0x4e"
msgid "dialogue/61/0x4e\n"
msgstr "Arth\nNo hay problema. Parece que\ntodos funcionan.\n"

msgctxt "dialogue/61/0x83"
msgid "dialogue/61/0x83"
msgstr "Jack\nPríncipe, no hay tiempo."

msgctxt "dialogue/61/0xab"
msgid "dialogue/61/0xab"
msgstr "Jack\nElija el Zoid que va a\npilotar."

msgctxt "dialogue/62/0xc"
msgid "dialogue/62/0xc"
msgstr "Regina\nEste es el Shield Liger. Un Zoid\nrápido de gran defensa."

msgctxt "dialogue/62/0x5d"
msgid "dialogue/62/0x5d"
msgstr "Regina\nSu rasgo especial es el\nescudo E, que bloquea el daño."

msgctxt "dialogue/62/0xa0"
msgid "dialogue/62/0xa0"
msgstr "Regina\n¿Pilotará este Zoid?"

msgctxt "dialogue/63/0xc"
msgid "dialogue/63/0xc"
msgstr "Arth\nEste es el Sabre Tiger. Un Zoid\nrápido de gran ataque."

msgctxt "dialogue/63/0x5b"
msgid "dialogue/63/0x5b"
msgstr "Arth\nUn Zoid excelente, pilar del\nejército imperial."

msgctxt "dialogue/63/0xa4"
msgid "dialogue/63/0xa4"
msgstr "Arth\n¿Pilotará este Zoid?"

msgctxt "dialogue/64/0xc"
msgid "dialogue/64/0xc"
msgstr "Jack\nEste es el Raynos. Un Zoid de\ncombate aéreo muy rápido."

msgctxt "dialogue/64/0x49"
msgid "dialogue/64/0x49"
msgstr "Jack\nLos Zoids voladores solo\nllevan su armamento fijo,"

msgctxt "dialogue/64/0x8e"
msgid "dialogue/64/0x8e"
msgstr "Jack\npero es difícil acertarles\nsin armas antiaéreas."

msgctxt "dialogue/64/0xd1"
msgid "dialogue/64/0xd1"
msgstr "Jack\n¿Pilotará este Zoid?"

msgctxt "dialogue/65/0xc"
msgid "dialogue/65/0xc"
msgstr "Arth\n...Sin problemas. Nuestros\nZoids también están a bordo."

msgctxt "dialogue/65/0x59"
msgid "dialogue/65/0x59"
msgstr "Jack\nEl Zoid Commander le ayudará\na pilotar el Zoid."

msgctxt "dialogue/65/0xaa"
msgid "dialogue/65/0xaa"
msgstr "Jack\nTranquilo, vamos allá."

msgctxt "dialogue/66/0xc"
msgid "dialogue/66/0xc"
msgstr "Regina\n¡Ugh! ¡¿Ya han llegado\nhasta aquí?!"

msgctxt "dialogue/66/0x48"
msgid "dialogue/66/0x48"
msgstr "Arth\nNo hay tiempo de cargar los\ndemás Zoids..."

msgctxt "dialogue/66/0x97"
msgid "dialogue/66/0x97"
msgstr "Regina\n¡Vámonos, príncipe!"

msgctxt "dialogue/66/0xc7"
msgid "dialogue/66/0xc7"
msgstr "Jack\nVamos, dé la orden, príncipe."

msgctxt "dialogue/66/0xf7"
msgid "dialogue/66/0xf7"
msgstr "{name}\n......"

msgctxt "dialogue/67/0xc"
msgid "dialogue/67/0xc"
msgstr "Jack\n...Pero, ¿quiénes serían\nesos de antes?"

msgctxt "dialogue/67/0x55"
msgid "dialogue/67/0x55"
msgstr "Arth\nNi idea. Pero son enemigos."

msgctxt "dialogue/67/0x81"
msgid "dialogue/67/0x81"
msgstr "Jack\n...Tan directo como siempre.\n¿Tú qué opinas, Regina?"

msgctxt "dialogue/67/0xd0"
msgid "dialogue/67/0xd0"
msgstr "Regina\nYo tampoco los había visto.\nPero, más importante que eso..."

msgctxt "dialogue/67/0x11d"
msgid "dialogue/67/0x11d"
msgstr "Jack\nCierto. Primero escapar\nsanos y salvos, reagruparnos..."

msgctxt "dialogue/67/0x174"
msgid "dialogue/67/0x174"
msgstr "Arth\n¡¡Y recuperar el castillo!!"

msgctxt "dialogue/67/0x1a0"
msgid "dialogue/67/0x1a0"
msgstr "{name}\n......"

msgctxt "dialogue/67/0x1c1"
msgid "dialogue/67/0x1c1"
msgstr "Regina\nY el legado real..."

msgctxt "dialogue/67/0x1f5"
msgid "dialogue/67/0x1f5"
msgstr "Jack\nEl rey también lo mencionó,\npero ¿qué es el legado real?"

msgctxt "dialogue/67/0x254"
msgid "dialogue/67/0x254"
msgstr "Regina\nYo tampoco sé los detalles..."

msgctxt "dialogue/67/0x27c"
msgid "dialogue/67/0x27c"
msgstr "Regina\nSolo que está en una sala\nsellada del castillo..."

msgctxt "dialogue/67/0x2cf"
msgid "dialogue/67/0x2cf"
msgstr "Arth\nLo sabremos cuando\nrecuperemos el castillo."

msgctxt "dialogue/67/0x309"
msgid "dialogue/67/0x309"
msgstr "Jack\n......"

msgctxt "dialogue/67/0x331"
msgid "dialogue/67/0x331"
msgstr "Regina\n...Arth tiene razón. De nada\nsirve preocuparse ahora."

msgctxt "dialogue/67/0x388"
msgid "dialogue/67/0x388"
msgstr "Jack\nQué pasadizo tan largo.\n¿Hasta dónde llega?"

msgctxt "dialogue/67/0x3d7"
msgid "dialogue/67/0x3d7"
msgstr "Regina\nYa casi estamos en la salida."

msgctxt "dialogue/67/0x401"
msgid "dialogue/67/0x401"
msgstr "{name}\n......"

msgctxt "dialogue/67/0x422"
msgid "dialogue/67/0x422"
msgstr "Regina\nYa falta poco, príncipe."

msgctxt "dialogue/67/0x452"
msgid "dialogue/67/0x452"
msgstr "{name}\n......"

msgctxt "dialogue/704/0xc"
msgid "dialogue/704/0xc"
msgstr "Regina\n¡¿Esto es el Trinity Liger?!"

msgctxt "dialogue/704/0x44"
msgid "dialogue/704/0x44"
msgstr "Jack\n¿Trinity Liger?\nNunca he oído hablar de él."

msgctxt "dialogue/704/0x8f"
msgid "dialogue/704/0x8f"
msgstr "Regina\nDicen que se creó para\nproteger el legado de Arcadia."

msgctxt "dialogue/704/0xe8"
msgid "dialogue/704/0xe8"
msgstr "Arth\nPero en este estado..."

msgctxt "dialogue/704/0x11c"
msgid "dialogue/704/0x11c"
msgstr "{name}\n......"

msgctxt "dialogue/704/0x13d"
msgid "dialogue/704/0x13d"
msgstr "Regina\nSu núcleo Zoid está muerto...\nPero sus datos Zi sirven."

msgctxt "dialogue/704/0x196"
msgid "dialogue/704/0x196"
msgstr "Jack\n¿Datos Zi?"

msgctxt "dialogue/704/0x1be"
msgid "dialogue/704/0x1be"
msgstr "Regina\nSon como los planos para crear\nun Zoid desde un núcleo Zoid."

msgctxt "dialogue/704/0x207"
msgid "dialogue/704/0x207"
msgstr "Regina\nEs un invento de Arcadia. Así\nno hace falta una base militar:"

msgctxt "dialogue/704/0x266"
msgid "dialogue/704/0x266"
msgstr "Regina\nun laboratorio Zoid civil\npuede fabricar el Zoid."

msgctxt "dialogue/704/0x2a9"
msgid "dialogue/704/0x2a9"
msgstr "Regina\nClaro que también hacen falta\nnúcleo, piezas... y dinero."

msgctxt "dialogue/704/0x305"
msgid "dialogue/704/0x305"
msgstr "¡Conseguiste los datos Zi del\nTrinity Liger!"

msgctxt "dialogue/732/0x3"
msgid "dialogue/732/0x3"
msgstr "Guardia real\nEl señor Arth estaba en el\ncuartel de la guardia. Como\nbuen exoficial imperial, no\ndescuida el entrenamiento."

msgctxt "dialogue/733/0x3"
msgid "dialogue/733/0x3\n"
msgstr "Guardia real\nPríncipe, no salga del\ncastillo, por favor.\n"

msgctxt "dialogue/734/0x3"
msgid "dialogue/734/0x3"
msgstr "Guardia real\nAquí abajo está el hangar\nde los Zoids. Es peligroso,\nno entre."

msgctxt "dialogue/740/0x3"
msgid "dialogue/740/0x3"
msgstr "Guardia real\nLa familia real de Arcadia\nlleva generaciones guardando\nun tesoro secreto. Aunque\nnadie sabe qué es."

