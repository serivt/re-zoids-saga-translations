msgstr "Herman"

msgctxt "dialogue/68/0xc"
msgid "dialogue/68/0xc"
msgstr "Regina\nDe todos modos, vayamos al\npueblo de Arcana, aquí cerca."

msgctxt "dialogue/73/0xc"
msgid "dialogue/73/0xc"
msgstr "Jack\nEn cualquier caso, separémonos\ny veamos cómo está el pueblo."

msgctxt "dialogue/74/0xc"
msgid "dialogue/74/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/74/0x2d"
msgid "dialogue/74/0x2d"
msgstr "Jack\nHay guardias por todas\npartes."

msgctxt "dialogue/74/0x69"
msgid "dialogue/74/0x69"
msgstr "Arth\n...Y bien a la vista..."

msgctxt "dialogue/74/0x9f"
msgid "dialogue/74/0x9f"
msgstr "Regina\n¿Qué quieres decir?"

msgctxt "dialogue/74/0xc9"
msgid "dialogue/74/0xc9"
msgstr "Jack\nEl pueblo tiene nuevos amos.\nQuieren que todos lo sepan."

msgctxt "dialogue/74/0x11e"
msgid "dialogue/74/0x11e"
msgstr "Regina\n¡Grr!"

msgctxt "dialogue/75/0x3"
msgid "dialogue/75/0x3"
msgstr "Soldado (capitán)\n¡Eh! ¡Vosotros!\n¿No sabéis que hay toque\nde queda?"

msgctxt "dialogue/75/0x6c"
msgid "dialogue/75/0x6c"
msgstr "Arth\nNo."

msgctxt "dialogue/75/0x83"
msgid "dialogue/75/0x83"
msgstr "Soldado 1\n¡¿Cómo dices?!"

msgctxt "dialogue/75/0x9b"
msgid "dialogue/75/0x9b"
msgstr "Soldado 2\n¡Vosotros! ¡Quedáis detenidos!"

msgctxt "dialogue/75/0xd7"
msgid "dialogue/75/0xd7"
msgstr "Jack\nDisculpe, señor soldado."

msgctxt "dialogue/75/0xfb"
msgid "dialogue/75/0xfb"
msgstr "Jack\nAcabamos de llegar del campo\nhace un momento..."

msgctxt "dialogue/75/0x141"
msgid "dialogue/75/0x141"
msgstr "Soldado (capitán)\n¿Del campo? ¿De qué campo?\n¿A qué habéis venido\na Arcadia?"

msgctxt "dialogue/75/0x19a"
msgid "dialogue/75/0x19a"
msgstr "Jack\nPues verá... Por el norte,\npasadas las montañas..."

msgctxt "dialogue/75/0x1ee"
msgid "dialogue/75/0x1ee"
msgstr "Soldado (capitán)\n¡Mmm, no me convences!\n¡Eh! ¡Lleváoslos!"

msgctxt "dialogue/75/0x23d"
msgid "dialogue/75/0x23d"
msgstr "Jack\n¡Es-espere, por favor!\n¡De verdad que solo somos\nviajeros!"

msgctxt "dialogue/75/0x28f"
msgid "dialogue/75/0x28f"
msgstr "Soldado (capitán)\n¡Silencio!"

msgctxt "dialogue/76/0x3"
msgid "dialogue/76/0x3"
msgstr "Anciano\n¡Vaya, vaya, pero si es\nT-Thomas! ¡Te estaba esperando!"

msgctxt "dialogue/76/0x52"
msgid "dialogue/76/0x52"
msgstr "Jack\n¿? ¡! ¡Ah! ¡T-tío!\n¡Cuánto tiempo! ¡Acabo\nde llegar!"

msgctxt "dialogue/76/0xa6"
msgid "dialogue/76/0xa6"
msgstr "Soldado (capitán)\nAh, ¿y tú quién eres?\n¿Los conoces?"

msgctxt "dialogue/76/0xec"
msgid "dialogue/76/0xec"
msgstr "Anciano\nSoy Roman, el encargado\nde este pueblo."

msgctxt "dialogue/76/0x131"
msgid "dialogue/76/0x131"
msgstr "Roman\nSon parientes míos. Este es\nmi sobrino, T-Thomas."

msgctxt "dialogue/76/0x17d"
msgid "dialogue/76/0x17d"
msgstr "Jack\nS-sí, eso. Yo soy Thomas."

msgctxt "dialogue/76/0x1ae"
msgid "dialogue/76/0x1ae"
msgstr "Soldado (capitán)\nQué sospechoso. ¿Es verdad?"

msgctxt "dialogue/77/0x3"
msgid "dialogue/77/0x3"
msgstr "Roman\nEs la verdad, se lo aseguro.\nTome, tome, acepte esto."

msgctxt "dialogue/77/0x36"
msgid "dialogue/77/0x36"
msgstr "Soldado (capitán)\n¡Hmpf! Tened más cuidado\na partir de ahora."

msgctxt "dialogue/78/0x3"
msgid "dialogue/78/0x3"
msgstr "Roman\nUsted es el príncipe\n{name}, ¿verdad?"

msgctxt "dialogue/78/0x32"
msgid "dialogue/78/0x32"
msgstr "{name}\n¡¡!!"

msgctxt "dialogue/78/0x4b"
msgid "dialogue/78/0x4b"
msgstr "Jack\nAnciano, ¿quién es usted?"

msgctxt "dialogue/78/0x70"
msgid "dialogue/78/0x70"
msgstr "Roman\nAquí no podemos hablar.\nVengan a mi casa, aquí delante."

msgctxt "dialogue/79/0xc"
msgid "dialogue/79/0xc"
msgstr "Jack\nEntonces, anciano, ¿usted\nantes era...?"

msgctxt "dialogue/79/0x3b"
msgid "dialogue/79/0x3b"
msgstr "Roman\nSí. Serví al rey de Arcadia.\nAunque de eso hace ya\nmucho tiempo."

msgctxt "dialogue/79/0x9e"
msgid "dialogue/79/0x9e"
msgstr "Regina\n¿Sabe algo del enemigo?\n¡Y de cómo está el castillo!"

msgctxt "dialogue/79/0xf3"
msgid "dialogue/79/0xf3"
msgstr "{name}\n......"

msgctxt "dialogue/79/0x10b"
msgid "dialogue/79/0x10b"
msgstr "Roman\nDel enemigo no sé nada."

msgctxt "dialogue/79/0x137"
msgid "dialogue/79/0x137"
msgstr "Roman\nVi fuego en el castillo y,\nen un abrir y cerrar de ojos,\nlo ocuparon."

msgctxt "dialogue/79/0x19e"
msgid "dialogue/79/0x19e"
msgstr "Roman\nY tampoco se sabe nada\ndel rey de Arcadia..."

msgctxt "dialogue/79/0x1e6"
msgid "dialogue/79/0x1e6"
msgstr "{name}\n......"

msgctxt "dialogue/79/0x207"
msgid "dialogue/79/0x207"
msgstr "Regina\n...Ya veo..."

msgctxt "dialogue/79/0x239"
msgid "dialogue/79/0x239"
msgstr "Arth\n......"

msgctxt "dialogue/79/0x25f"
msgid "dialogue/79/0x25f"
msgstr "Jack\n...Qué problema.\nTenemos muy poca información."

msgctxt "dialogue/79/0x29e"
msgid "dialogue/79/0x29e"
msgstr "Jack\nSi no sabemos qué busca\nel enemigo, recuperar\nel castillo..."

msgctxt "dialogue/79/0x2e4"
msgid "dialogue/79/0x2e4"
msgstr "Roman\n...No sé si será lo que\nbuscan, pero..."

msgctxt "dialogue/79/0x324"
msgid "dialogue/79/0x324"
msgstr "Regina\n¡¿Sabe algo?!"

msgctxt "dialogue/79/0x34b"
msgid "dialogue/79/0x34b"
msgstr "Roman\nSí. Les oí hablar de una\nsala sellada del castillo."

msgctxt "dialogue/79/0x3a8"
msgid "dialogue/79/0x3a8"
msgstr "Regina\n¡¿Una sala sellada?!\n¿Entonces buscan el legado\nantiguo?"

msgctxt "dialogue/79/0x3f5"
msgid "dialogue/79/0x3f5"
msgstr "{name}\n......"

msgctxt "dialogue/79/0x416"
msgid "dialogue/79/0x416"
msgstr "Jack\nEs pronto para decir que\nbuscan el legado solo\npor eso."

msgctxt "dialogue/79/0x465"
msgid "dialogue/79/0x465"
msgstr "Arth\nEs la única pista que hay."

msgctxt "dialogue/79/0x493"
msgid "dialogue/79/0x493"
msgstr "Jack\n......Es verdad. No tenemos\ntiempo para dudar."

msgctxt "dialogue/79/0x4ec"
msgid "dialogue/79/0x4ec"
msgstr "Arth\nSí. Solo nos queda\nperseguirlos."

msgctxt "dialogue/79/0x522"
msgid "dialogue/79/0x522"
msgstr "Regina\n¡Príncipe!"

msgctxt "dialogue/79/0x544"
msgid "dialogue/79/0x544"
msgstr "{name}\n......"

msgctxt "dialogue/80/0xc"
msgid "dialogue/80/0xc"
msgstr "Jack\n...Vaya, qué gente\nmás impaciente."

msgctxt "dialogue/80/0x4c"
msgid "dialogue/80/0x4c"
msgstr "Arth\nJe... Hacen buena pareja."

msgctxt "dialogue/80/0x7e"
msgid "dialogue/80/0x7e"
msgstr "Jack\nDesde luego. Vamos nosotros\ntambién. Anciano, muchas\ngracias por todo."

msgctxt "dialogue/80/0xd0"
msgid "dialogue/80/0xd0"
msgstr "Roman\nTened cuidado."

msgctxt "dialogue/705/0xc"
msgid "dialogue/705/0xc"
msgstr "Regina\nDisculpe, ¿podría mirar\nestos datos Zi?"

msgctxt "dialogue/705/0x50"
msgid "dialogue/705/0x50"
msgstr "Dr. T\n¡Esto es increíble! ¡Son los\ndatos Zi del Trinity Liger!"

msgctxt "dialogue/705/0xa5"
msgid "dialogue/705/0xa5"
msgstr "Regina\n¿Cómo sabe usted lo del\nTrinity Liger?"

msgctxt "dialogue/705/0xf6"
msgid "dialogue/705/0xf6"
msgstr "Dr. T\nSoy el Dr. T, jefe del\nlaboratorio de Zoids del\npueblo de Arcana."

msgctxt "dialogue/705/0x137"
msgid "dialogue/705/0x137"
msgstr "Dr. T\nEl rey de Arcadia me encargó\ninvestigar el legado\nde Arcadia."

msgctxt "dialogue/705/0x18e"
msgid "dialogue/705/0x18e"
msgstr "Dr. T\nEl Trinity Liger es el gran\ntema de estudio del legado."

msgctxt "dialogue/705/0x1d1"
msgid "dialogue/705/0x1d1"
msgstr "Dr. T\nAunque nadie sabía dónde\nestaba... ¿Dónde lo\nencontrasteis?"

msgctxt "dialogue/705/0x23e"
msgid "dialogue/705/0x23e"
msgstr "Regina\nAl fondo del pasadizo secreto\ndel castillo de Arcadia..."

msgctxt "dialogue/705/0x27e"
msgid "dialogue/705/0x27e"
msgstr "Dr. T\nYa veo... Sin algo así,\nnunca se habría encontrado."

msgctxt "dialogue/705/0x2d7"
msgid "dialogue/705/0x2d7"
msgstr "Dr. T\n¿Está bien Su Majestad?"

msgctxt "dialogue/705/0x30d"
msgid "dialogue/705/0x30d"
msgstr "{name}\n......"

msgctxt "dialogue/705/0x32e"
msgid "dialogue/705/0x32e"
msgstr "Regina\nE-esto... ¿Se podría fabricar\nel Trinity Liger con\nestos datos?"

msgctxt "dialogue/705/0x391"
msgid "dialogue/705/0x391"
msgstr "Dr. T\nMmm, con otro Zoid sería\nsencillo... Pero el núcleo\ndel Trinity Liger es especial."

msgctxt "dialogue/705/0x3f0"
msgid "dialogue/705/0x3f0"
msgstr "Dr. T\n...Seguramente solo haya\nuno en todo el mundo."

msgctxt "dialogue/705/0x437"
msgid "dialogue/705/0x437"
msgstr "Dr. T\nSin él, no se puede fabricar\nel Trinity Liger."

msgctxt "dialogue/705/0x482"
msgid "dialogue/705/0x482"
msgstr "Dr. T\nLo siento mucho..."

msgctxt "dialogue/705/0x4b0"
msgid "dialogue/705/0x4b0"
msgstr "Regina\nYa veo..."

msgctxt "dialogue/706/0xc"
msgid "dialogue/706/0xc"
msgstr "Dr. T\nAy, si tuviera el núcleo Zoid\ndel Trinity Liger..."

msgctxt "dialogue/713/0xc"
msgid "dialogue/713/0xc"
msgstr "Dr. T\n¡Usad el Trinity Liger\ny ganad, por favor!"

msgctxt "dialogue/714/0xc"
msgid "dialogue/714/0xc"
msgstr "Dr. T\nYo también quiero viajar\nrecopilando datos Zi."

msgctxt "dialogue/715/0x3"
msgid "dialogue/715/0x3"
msgstr "Investigador\n¿Ya ha usado los comandos de\nmazo? Son tácticas y\nmaniobras de todo tipo."

msgctxt "dialogue/715/0x76"
msgid "dialogue/715/0x76"
msgstr "Investigador\nAntes del combate puede elegir\nhasta 6 al crear comandos."

msgctxt "dialogue/715/0xc3"
msgid "dialogue/715/0xc3"
msgstr "Investigador\nEn combate puede usar uno por\nturno, y el que use no vuelve\na estar disponible hasta el\nsiguiente combate."

msgctxt "dialogue/715/0x130"
msgid "dialogue/715/0x130"
msgstr "Investigador\nSi los domina, el combate\nirá a su favor."

msgctxt "dialogue/715/0x17d"
msgid "dialogue/715/0x17d"
msgstr "Investigador\nUse este comando que hemos\ndesarrollado aquí."

msgctxt "dialogue/716/0x3"
msgid "dialogue/716/0x3"
msgstr "Investigador\n¿Ya ha usado los comandos de\nmazo? Son tácticas y\nmaniobras de todo tipo."

msgctxt "dialogue/716/0x76"
msgid "dialogue/716/0x76"
msgstr "Investigador\nAntes del combate puede elegir\nhasta 6 al crear comandos."

msgctxt "dialogue/716/0xc3"
msgid "dialogue/716/0xc3"
msgstr "Investigador\nEn combate puede usar uno por\nturno, y el que use no vuelve\na estar disponible hasta el\nsiguiente combate."

msgctxt "dialogue/716/0x130"
msgid "dialogue/716/0x130"
msgstr "Investigador\nSi los domina, el combate\nirá a su favor."

msgctxt "dialogue/745/0x3"
msgid "dialogue/745/0x3"
msgstr "Niño\n¡Han entrado un montón de\nZoids en el castillo! ¡De mayor\nyo seré piloto de Zoids!"

msgctxt "dialogue/746/0x3"
msgid "dialogue/746/0x3"
msgstr "Vecino\nHasta ayer creía que la paz\nduraría siempre... ¿Qué será\nahora de nosotros?"

msgctxt "dialogue/747/0x3"
msgid "dialogue/747/0x3"
msgstr "Vecino\n¡Maldita sea! ¡Qué aires\nse dan! ...Aunque yo no puedo\nhacer nada..."

msgctxt "dialogue/748/0x3"
msgid "dialogue/748/0x3"
msgstr "Soldado imperial\n¡Hay toque de queda en todo\nel reino! ¡Los civiles sin\nnada que hacer, a casa!"

msgctxt "dialogue/749/0x3"
msgid "dialogue/749/0x3"
msgstr "Soldado imperial\nArcadia está bajo el ejército\ndel Emperador. ¡Detendremos a\nquien se nos oponga!"

msgctxt "dialogue/750/0x3"
msgid "dialogue/750/0x3"
msgstr "Soldado imperial\n¡Los civiles no pueden\nsalir a la calle!"

msgctxt "dialogue/751/0x3"
msgid "dialogue/751/0x3"
msgstr "Tabernero\nQuién diría que el reino caería\ntan fácilmente... Y encima,\ntoque de queda. Adiós negocio."

msgctxt "dialogue/752/0x3"
msgid "dialogue/752/0x3"
msgstr "Vecino\nOtra guerra. A un viejo\ncomo yo poco le queda,\npero... ¿habrá paz cuando\ncrezcan mis nietos?"

msgctxt "dialogue/753/0x3"
msgid "dialogue/753/0x3"
msgstr "Piloto de Zoids\nLos del Emperador tomaron el\ncastillo mientras la República\ny el Imperio se vigilaban..."

msgctxt "dialogue/754/0x3"
msgid "dialogue/754/0x3\n"
msgstr "Roman\nPríncipe, sobreviva\npase lo que pase...\n"

msgctxt "dialogue/755/0x3"
msgid "dialogue/755/0x3"
msgstr "Roman\n...¡Ah, es verdad!\n¡Le enseñaré esta táctica!"

msgctxt "dialogue/976/0x3"
msgid "dialogue/976/0x3"
