msgid "dialogue/324/0xc"
msgstr "Leena\n¡Team Flügel! ¿El\npróximo es el equipo de\nNaomi?"

msgctxt "dialogue/324/0x57"
msgid "dialogue/324/0x57"
msgstr "Jack\n¿Naomi? ¿Quién es ella?"

msgctxt "dialogue/324/0x8b"
msgid "dialogue/324/0x8b"
msgstr "Leon\nUna guerrera invicta en\nel combate individual.\nEs una rival dura."

msgctxt "dialogue/324/0xd4"
msgid "dialogue/324/0xd4"
msgstr "Leena\n¡Bah! ¡Me da igual quién\nvenga! ¡Los haremos\npapilla y los haremos\ntrizas y—"

msgctxt "dialogue/324/0x131"
msgid "dialogue/324/0x131"
msgstr "Naomi\n¿Y qué equipo acabará\nhecho papilla y trizas?"

msgctxt "dialogue/325/0xc"
msgid "dialogue/325/0xc"
msgstr "Leena\n¡Naomi!"

msgctxt "dialogue/325/0x2e"
msgid "dialogue/325/0x2e"
msgstr "Naomi\nDicen que Team Blitz ha\nfichado a gente nueva.\n¿Es cierto?"

msgctxt "dialogue/325/0x7d"
msgid "dialogue/325/0x7d"
msgstr "Leon\nSí. Hay sus motivos."

msgctxt "dialogue/325/0xa7"
msgid "dialogue/325/0xa7"
msgstr "Naomi\nVaya. ¿Y me vas a contar\nesos motivos?"

msgctxt "dialogue/325/0xf2"
msgid "dialogue/325/0xf2"
msgstr "Leon\nCuando acabemos. Ahora\ncentrémonos en la\nbatalla Zoid."

msgctxt "dialogue/325/0x13d"
msgid "dialogue/325/0x13d"
msgstr "Naomi\nMuy bien. Lo estaré\nesperando."

msgctxt "dialogue/326/0xc"
msgid "dialogue/326/0xc"
msgstr "Leena\n¡¿Qué?! ¡Os voy a hacer\npapilla y trizas!"

msgctxt "dialogue/327/0xc"
msgid "dialogue/327/0xc"
msgstr "Judgeman\n¡Preparad el campo de\nbatalla!"

