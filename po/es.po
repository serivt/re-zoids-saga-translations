msgctxt "dialogue/10/0x3"
msgid "dialogue/10/0x3"
msgstr "No hay datos guardados."

msgctxt "dialogue/81/0xc"
msgid "dialogue/81/0xc"
msgstr "Jack\nVaya, parece que la\nvigilancia es escasa."

msgctxt "dialogue/81/0x4a"
msgid "dialogue/81/0x4a"
msgstr "Arth\nPor lo visto, al enemigo\ntampoco le sobran tropas..."

msgctxt "dialogue/81/0x95"
msgid "dialogue/81/0x95"
msgstr "Regina\nAun así, cruzar la puerta\nprincipal del castillo es\nimposible."

msgctxt "dialogue/81/0xdc"
msgid "dialogue/81/0xdc"
msgstr "Arth\nTendríamos que bajar de los\nZoids. Nosotros cuatro\nsolos no podríamos..."

msgctxt "dialogue/81/0x13b"
msgid "dialogue/81/0x13b"
msgstr "Regina\nSi no me equivoco, desde la\nentrada de la fábrica\nsubterránea, a la izquierda,\nse llega a la sala sellada..."

msgctxt "dialogue/82/0xc"
msgid "dialogue/82/0xc"
msgstr "Regina\n...Esta puerta se abre con\neste código."

msgctxt "dialogue/82/0x4e"
msgid "dialogue/82/0x4e"
msgstr "Arth\nSabes mucho, Regina..."

msgctxt "dialogue/82/0x88"
msgid "dialogue/82/0x88"
msgstr "Regina\nMi familia tiene la misión\nde estudiar el legado\nantiguo..."

msgctxt "dialogue/82/0xc0"
msgid "dialogue/82/0xc0"
msgstr "Regina\nAunque mi padre apenas me\nha contado lo que hay\ndentro."

msgctxt "dialogue/82/0x10d"
msgid "dialogue/82/0x10d"
msgstr "Jack\n¿Y cómo es que su hija está\nen el cuerpo de los\nGuerreros?"

msgctxt "dialogue/82/0x145"
msgid "dialogue/82/0x145"
msgstr "Regina\n........."

msgctxt "dialogue/82/0x173"
msgid "dialogue/82/0x173"
msgstr "Regina\n¡C-cada uno vale para unas\ncosas y no para otras!"

msgctxt "dialogue/82/0x1b7"
msgid "dialogue/82/0x1b7"
msgstr "Arth\nYa veo."

msgctxt "dialogue/82/0x1db"
msgid "dialogue/82/0x1db"
msgstr "{name}\n......"

msgctxt "dialogue/82/0x1fc"
msgid "dialogue/82/0x1fc"
msgstr "Regina\nAh, disculpad, príncipe...\nVamos, en marcha."

msgctxt "dialogue/83/0xc"
msgid "dialogue/83/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/83/0x2d"
msgid "dialogue/83/0x2d"
msgstr "Regina\n¿Esta es la sala sellada...?\n¿Dónde está el legado real?"

msgctxt "dialogue/83/0x78"
msgid "dialogue/83/0x78"
msgstr "Arth\n...Hemos llegado tarde..."

msgctxt "dialogue/83/0xa8"
msgid "dialogue/83/0xa8"
msgstr "Jack\n...Eso parece..."

msgctxt "dialogue/83/0xde"
msgid "dialogue/83/0xde"
msgstr "Regina\n¡¿Qué significa esto?!\n¡¿No será que el enemigo...?!"

msgctxt "dialogue/83/0x116"
msgid "dialogue/83/0x116"
msgstr "Voz masculina\n¡Os dais cuenta demasiado\ntarde! ¡¡Ratas!!"

msgctxt "dialogue/84/0xc"
msgid "dialogue/84/0xc"
msgstr "Blood\n¡El legado real, el\ntransportador espaciotemporal,\nse llevó a otro lugar hace\nmucho!"

msgctxt "dialogue/84/0x67"
msgid "dialogue/84/0x67"
msgstr "Jack\n¿Transportador\nespaciotemporal? ¡¿Ese es el\nlegado real?!"

msgctxt "dialogue/84/0xac"
msgid "dialogue/84/0xac"
msgstr "Blood\n¿Qué, no lo sabíais? Da\nigual, de todas formas vais\na morir aquí."

msgctxt "dialogue/84/0x109"
msgid "dialogue/84/0x109"
msgstr "Regina\n¡Ugh! ¡¿Qué pensáis hacer con\nel legado real?! ¡¡¿Y Su\nMajestad, el rey de Arcadia?!!"

msgctxt "dialogue/84/0x174"
msgid "dialogue/84/0x174"
msgstr "Blood\n¡No tengo por qué\ncontároslo! ¡¡Se acabó la\ncharla!!"

msgctxt "dialogue/84/0x1d7"
msgid "dialogue/84/0x1d7"
msgstr "Jack\n¡Vamos a abrirnos paso!\n¡Regina, el príncipe!\n¡Arth, adelante!"

msgctxt "dialogue/84/0x22a"
msgid "dialogue/84/0x22a"
msgstr "Arth\nEntendido."

msgctxt "dialogue/84/0x248"
msgid "dialogue/84/0x248"
msgstr "Regina\n¡Déjamelo a mí!"

msgctxt "dialogue/84/0x270"
msgid "dialogue/84/0x270"
msgstr "Blood\n¡No me subestiméis!\n¡¡Escuadrón Command Wolf,\nal ataque!!"

msgctxt "dialogue/85/0xc"
msgid "dialogue/85/0xc"
msgstr "{name}\n......¡¡!!"

msgctxt "dialogue/85/0x31"
msgid "dialogue/85/0x31"
msgstr "Jack\n¡¿El impacto del combate ha\nabierto un agujero en la\npared?!"

msgctxt "dialogue/85/0x73"
msgid "dialogue/85/0x73"
msgstr "Regina\n¡Príncipe! ¡Todos, por ese\nagujero!"

msgctxt "dialogue/85/0xa7"
msgid "dialogue/85/0xa7"
msgstr "Blood\n¡¡!!"

msgctxt "dialogue/86/0xc"
msgid "dialogue/86/0xc"
msgstr "Blood\n¡¿Qué?! ¡Maldición! ¡¿Por qué\nhay un pasadizo aquí?!"

msgctxt "dialogue/86/0x4f"
msgid "dialogue/86/0x4f"
msgstr "Blood\n¡! ¡¿Serán unas ruinas?!\nMaldita sea, mi plan..."

msgctxt "dialogue/86/0x8c"
msgid "dialogue/86/0x8c"
msgstr "Blood\n¡Tras ellos! ¡¡Seguidme!!"

msgctxt "dialogue/87/0xc"
msgid "dialogue/87/0xc"
msgstr "Jack\n¡Oiga! ¡¿Adónde vamos?!"

msgctxt "dialogue/87/0x50"
msgid "dialogue/87/0x50"
msgstr "Regina\n¡No lo sé! ¡Tendremos que\nseguir el camino!"

msgctxt "dialogue/87/0x91"
msgid "dialogue/87/0x91"
msgstr "{name}\n......"

msgctxt "dialogue/87/0xb2"
msgid "dialogue/87/0xb2"
msgstr "Arth\nSon los de antes. Nos\nsiguen."

msgctxt "dialogue/87/0xe6"
msgid "dialogue/87/0xe6"
msgstr "Regina\n¡!"

msgctxt "dialogue/87/0x104"
msgid "dialogue/87/0x104"
msgstr "Jack\n¡Démonos prisa!"

msgctxt "dialogue/88/0xc"
msgid "dialogue/88/0xc"
msgstr "Regina\n¡Ahora es peligroso volver!"

msgctxt "dialogue/88/0x3c"
msgid "dialogue/88/0x3c"
msgstr "Jack\nDe momento, sigamos por\neste pasadizo."

msgctxt "dialogue/89/0xc"
msgid "dialogue/89/0xc"
msgstr "Jack\n...¿Dónde estamos?"

msgctxt "dialogue/89/0x36"
msgid "dialogue/89/0x36"
msgstr "Regina\n...¿?... ¿Unas ruinas?"

msgctxt "dialogue/89/0x66"
msgid "dialogue/89/0x66"
msgstr "Arth\n¿Es el final?"

msgctxt "dialogue/89/0x88"
msgid "dialogue/89/0x88"
msgstr "Jack\n...Ojalá fuera así...\nSigamos adelante."

msgctxt "dialogue/90/0xc"
msgid "dialogue/90/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/90/0x2d"
msgid "dialogue/90/0x2d"
msgstr "Regina\n¡¿Qué ha sido eso?!\n¡Y este lugar...!"

msgctxt "dialogue/90/0x6f"
msgid "dialogue/90/0x6f"
msgstr "Arth\nEs igual."

msgctxt "dialogue/90/0x91"
msgid "dialogue/90/0x91"
msgstr "Jack\n...Es cierto. El ambiente\nes como el de la sala\nsellada..."

msgctxt "dialogue/90/0xda"
msgid "dialogue/90/0xda"
msgstr "Regina\n¡¿No será esto...?!"

msgctxt "dialogue/90/0x108"
msgid "dialogue/90/0x108"
msgstr "Blood\n¡Exacto! ¡¡El transportador\nespaciotemporal!!"

msgctxt "dialogue/91/0xc"
msgid "dialogue/91/0xc"
msgstr "Blood\nEl del castillo era una\ncopia de este."

msgctxt "dialogue/91/0x3c"
msgid "dialogue/91/0x3c"
msgstr "Blood\nAunque aquel está mejor\nconservado..."

msgctxt "dialogue/91/0x93"
msgid "dialogue/91/0x93"
msgstr "Regina\n¡Tú eres el de antes...!"

msgctxt "dialogue/91/0xc7"
msgid "dialogue/91/0xc7"
msgstr "Blood\nEl transportador es una de\nlas supertecnologías que\ndejaron los antiguos\nzoidianos."

msgctxt "dialogue/91/0x114"
msgid "dialogue/91/0x114"
msgstr "Blood\nCon él se puede viajar\nlibremente al pasado y al\nfuturo..."

msgctxt "dialogue/91/0x171"
msgid "dialogue/91/0x171"
msgstr "Regina\n¡¿Algo así en el reino de\nArcadia?!"

msgctxt "dialogue/91/0x1b3"
msgid "dialogue/91/0x1b3"
msgstr "Blood\nEl reino de Arcadia se creó\nprecisamente para proteger\nel transportador."

msgctxt "dialogue/91/0x210"
msgid "dialogue/91/0x210"
msgstr "{name}\n......"

msgctxt "dialogue/91/0x231"
msgid "dialogue/91/0x231"
msgstr "Regina\n¡¿Cómo dices?!"

msgctxt "dialogue/91/0x25b"
msgid "dialogue/91/0x25b"
msgstr "Blood\nPiénsalo. ¿Por qué ha\nexistido hasta hoy un país\ntan débil entre el Imperio\ny la República?"

msgctxt "dialogue/91/0x2c6"
msgid "dialogue/91/0x2c6"
msgstr "Jack\n...Una zona neutral para\nque ninguno de los dos\nabriera esa caja de Pandora\nque es el transportador..."

msgctxt "dialogue/91/0x32b"
msgid "dialogue/91/0x32b"
msgstr "Blood\nExacto. Pero ese papel ha\nterminado. Desde ahora el\ntransportador es cosa\nnuestra."

msgctxt "dialogue/91/0x390"
msgid "dialogue/91/0x390"
msgstr "Blood\nAunque lo que traerá no\nserá la paz, sino el caos."

msgctxt "dialogue/91/0x3f1"
msgid "dialogue/91/0x3f1"
msgstr "{name}\n......"

msgctxt "dialogue/91/0x412"
msgid "dialogue/91/0x412"
msgstr "Regina\n¡¿Qué quieres decir?!"

msgctxt "dialogue/91/0x43e"
msgid "dialogue/91/0x43e"
msgstr "Blood\nJe, je, je. Con el\ntransportador crearemos...\n¡el ejército de Zoids más\npoderoso!"

msgctxt "dialogue/91/0x497"
msgid "dialogue/91/0x497"
msgstr "Blood\n¡Reuniremos los Zoids más\nfuertes del pasado y del\nfuturo!"

msgctxt "dialogue/91/0x4cb"
msgid "dialogue/91/0x4cb"
msgstr "Blood\n¡Y sumiremos el mundo en el\ncaos para dominarlo!"

msgctxt "dialogue/91/0x508"
msgid "dialogue/91/0x508"
msgstr "Blood\nPara ello..."

msgctxt "dialogue/91/0x524"
msgid "dialogue/91/0x524"
msgstr "Blood\n...acabaremos con ese\nestorbo de rey de Arcadia\ny nos haremos con el reino."

msgctxt "dialogue/91/0x56d"
msgid "dialogue/91/0x56d"
msgstr "Blood\nEse es el guion de mi\nemperador. Y de momento\ntodo va según lo previsto."

msgctxt "dialogue/91/0x5d0"
msgid "dialogue/91/0x5d0"
msgstr "Regina\n¡No pienso...!"

msgctxt "dialogue/91/0x5fa"
msgid "dialogue/91/0x5fa"
msgstr "Blood\n¿...permitirlo? Hmpf,\nya es tarde."

msgctxt "dialogue/91/0x62b"
msgid "dialogue/91/0x62b"
msgstr "Blood\nCon el transportador del\ncastillo, los Cuatro\nGenerales ya han partido\na cazar Zoids."

msgctxt "dialogue/91/0x672"
msgid "dialogue/91/0x672"
msgstr "Blood\nAhora mismo alguien debe de\nhaber saltado en el tiempo\ndesde ese de ahí."

msgctxt "dialogue/91/0x6b5"
msgid "dialogue/91/0x6b5"
msgstr "Blood\nEl ejército de Zoids más\npoderoso es solo cuestión\nde tiempo."

msgctxt "dialogue/91/0x6f9"
msgid "dialogue/91/0x6f9"
msgstr "Jack\nLo detendremos. Detendremos\nsu ambición."

msgctxt "dialogue/91/0x735"
msgid "dialogue/91/0x735"
msgstr "Blood\n¿Podréis? Y te aclaro que\nno es mi ambición. Es la\nambición del emperador."

msgctxt "dialogue/91/0x78c"
msgid "dialogue/91/0x78c"
msgstr "Arth\n...¿Y cuál es tu ambición?"

msgctxt "dialogue/91/0x7c0"
msgid "dialogue/91/0x7c0"
msgstr "Blood\nJe, je, je... No tengo por\nqué responder."

msgctxt "dialogue/91/0x7fc"
msgid "dialogue/91/0x7fc"
msgstr "Blood\nAntes escapasteis, ¡pero\nesta vez no será así!"

msgctxt "dialogue/91/0x839"
msgid "dialogue/91/0x839"
msgstr "Blood\n¡¡Este lugar será vuestra\ntumba!!"

msgctxt "dialogue/91/0x884"
msgid "dialogue/91/0x884"
msgstr "Regina\n¡No será tan fácil! ¡¡Yo\nprotegeré al príncipe\n{name}!!"

msgctxt "dialogue/91/0x8ce"
msgid "dialogue/91/0x8ce"
msgstr "Blood\nBuena disposición...\n¡¡¡Entonces, venid a por mí!!!"

msgctxt "dialogue/91/0x915"
msgid "dialogue/91/0x915"
msgstr "Blood\n¡Soy uno de los Cuatro\nGenerales, Blood Keel!\n¡¡Allá voy!!"

msgctxt "dialogue/91/0x95e"
msgid "dialogue/91/0x95e"
msgstr "{name}\n......"

msgctxt "dialogue/92/0xc"
msgid "dialogue/92/0xc"
msgstr "Blood\n¡Tsk, el sistema de mando\nestá sin ajustar! ¡¡Ese\nOpis y su trabajo chapucero!!"

msgctxt "dialogue/92/0x73"
msgid "dialogue/92/0x73"
msgstr "Blood\n...Aunque una máquina tan\nbarata no puede seguir mi\nnivel..."

msgctxt "dialogue/92/0xd2"
msgid "dialogue/92/0xd2"
msgstr "Blood\n¡Me las pagarás!\n¡¡{name}... no lo olvidaré!!"

msgctxt "dialogue/92/0x11c"
msgid "dialogue/92/0x11c"
msgstr "{name}\n......"

msgctxt "dialogue/93/0xc"
msgid "dialogue/93/0xc"
msgstr "Regina\nEl transportador... ¡qué\ndesastre! ¡¡Hay que hacer\nalgo!!"

msgctxt "dialogue/93/0x5b"
msgid "dialogue/93/0x5b"
msgstr "Arth\nVamos tras él."

msgctxt "dialogue/93/0x7f"
msgid "dialogue/93/0x7f"
msgstr "{name}\n......"

msgctxt "dialogue/93/0xa0"
msgid "dialogue/93/0xa0"
msgstr "Jack\nPero ¿cómo vamos a seguirlo?"

msgctxt "dialogue/93/0xe4"
msgid "dialogue/93/0xe4"
msgstr "Regina\n¡Claro! El transportador\nse acaba de usar."

msgctxt "dialogue/93/0x11a"
msgid "dialogue/93/0x11a"
msgstr "Regina\nPuede que aún queden los\ndatos del destino..."

msgctxt "dialogue/93/0x15e"
msgid "dialogue/93/0x15e"
msgstr "Jack\n¡Es verdad!"

msgctxt "dialogue/93/0x184"
msgid "dialogue/93/0x184"
msgstr "Regina\nPríncipe, si usamos el\ntransportador ahora mismo,\npodremos seguir al enemigo."

msgctxt "dialogue/93/0x1cd"
msgid "dialogue/93/0x1cd"
msgstr "Regina\n...Aunque no hay garantías\nde que podamos volver."

msgctxt "dialogue/93/0x216"
msgid "dialogue/93/0x216"
msgstr "Regina\n¿Qué hacemos, príncipe?"

msgctxt "dialogue/93/0x244"
msgid "dialogue/93/0x244"
msgstr "{name}\n......"

msgctxt "dialogue/93/0x265"
msgid "dialogue/93/0x265"
msgstr "Regina\n¡¡E-espera, {name}!!\n¡¡Espérate!!"

msgctxt "dialogue/94/0xc"
msgid "dialogue/94/0xc"
msgstr "Jack\nVaya, vaya... Qué\nimprudente."

msgctxt "dialogue/94/0x46"
msgid "dialogue/94/0x46"
msgstr "Arth\n¿No vienes?"

msgctxt "dialogue/94/0x6e"
msgid "dialogue/94/0x6e"
msgstr "Jack\n¡Pues claro que voy!"

msgctxt "dialogue/95/0x3"
msgid "dialogue/95/0x3"
msgstr "Unas horas antes. Castillo de\nArcadia, salón del emperador"

msgctxt "dialogue/95/0x36"
msgid "dialogue/95/0x36"
msgstr "Fran\nEl castillo de Arcadia está\nbajo control, señor."

msgctxt "dialogue/95/0x79"
msgid "dialogue/95/0x79"
msgstr "Fran\nTambién controlamos la villa\ny la ciudad. Hemos decretado\nel toque de queda."

msgctxt "dialogue/95/0xc2"
msgid "dialogue/95/0xc2"
msgstr "Fran\nTanto la República como el\nImperio notaron el ataque y,\npara no destruirse entre sí,\nse retiraron a la frontera."

msgctxt "dialogue/95/0x12b"
msgid "dialogue/95/0x12b"
msgstr "Emperador\nBastaba con que sirvieran de\nchispa para nuestro ataque,"

msgctxt "dialogue/95/0x168"
msgid "dialogue/95/0x168"
msgstr "Emperador\ny que ahora se estén\nquietos..."

msgctxt "dialogue/95/0x198"
msgid "dialogue/95/0x198"
msgstr "Emperador\n...Aunque qué castillo más\nsobrio. Claro, al fin y al\ncabo era el suyo..."

msgctxt "dialogue/95/0x1f7"
msgid "dialogue/95/0x1f7"
msgstr "Fran\n¿?... ¿El suyo, señor?"

msgctxt "dialogue/95/0x22d"
msgid "dialogue/95/0x22d"
msgstr "Emperador\nNo es asunto tuyo.\nOlvídalo."

msgctxt "dialogue/95/0x25d"
msgid "dialogue/95/0x25d"
msgstr "Fran\n¡Sí, señor!"

msgctxt "dialogue/95/0x27d"
msgid "dialogue/95/0x27d"
msgstr "Emperador\nPor cierto, Fran."

msgctxt "dialogue/95/0x295"
msgid "dialogue/95/0x295"
msgstr "Emperador\n¿Qué Zoids son dignos de\nencabezar mi ejército?"

msgctxt "dialogue/95/0x2e8"
msgid "dialogue/95/0x2e8"
msgstr "Fran\n¿...De encabezarlo, señor?"

msgctxt "dialogue/95/0x31e"
msgid "dialogue/95/0x31e"
msgstr "Emperador\nEso es...\nY no hablo de chatarra\nfabricada en serie."

msgctxt "dialogue/95/0x35b"
msgid "dialogue/95/0x35b"
msgstr "Emperador\nQuiero dos fieras\nimponentes al frente de\nmis filas."

msgctxt "dialogue/95/0x3aa"
msgid "dialogue/95/0x3aa"
msgstr "Fran\nEl Shield Liger y el Saber\nTiger... y un organoide,\n¿verdad?"

msgctxt "dialogue/95/0x40d"
msgid "dialogue/95/0x40d"
msgstr "Emperador\nEntonces, ¡en marcha!\n¡Cruza el tiempo y encuentra\nesos dos Zoids!"

msgctxt "dialogue/95/0x45a"
msgid "dialogue/95/0x45a"
msgstr "Fran\n¡A la orden!"

msgctxt "dialogue/96/0xc"
msgid "dialogue/96/0xc"
msgstr "Emperador\n...Je, je, je. Castillo de\nArcadia, ¡he vuelto!"

msgctxt "dialogue/96/0x4b"
msgid "dialogue/96/0x4b"
msgstr "Emperador\nDicen que su hijo ha\nescapado, ¡¿y qué puede\nhacer él?!"

msgctxt "dialogue/96/0x88"
msgid "dialogue/96/0x88"
msgstr "Emperador\n¡¡Nadie, absolutamente\nnadie, podrá detener\nmi ambición!!"

msgctxt "dialogue/96/0xc9"
msgid "dialogue/96/0xc9"
msgstr "Emperador\nJe, je, je... ¡¡Ja, ja, ja,\nja, ja, ja!!"

msgctxt "dialogue/97/0xc"
msgid "dialogue/97/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/97/0x2d"
msgid "dialogue/97/0x2d"
msgstr "Regina\n{name}... ¡Digo,\npríncipe! ¿Estáis bien?"

msgctxt "dialogue/97/0x69"
msgid "dialogue/97/0x69"
msgstr "Regina\n¡Y además! Lanzarse así,\nsolo y por su cuenta..."

msgctxt "dialogue/97/0xac"
msgid "dialogue/97/0xac"
msgstr "Jack\nVamos, vamos, Regina.\nYa basta, ¿no?..."

msgctxt "dialogue/97/0xfb"
msgid "dialogue/97/0xfb"
msgstr "Regina\n¡Tú cállate!"

msgctxt "dialogue/97/0x12d"
msgid "dialogue/97/0x12d"
msgstr "Arth\n...Qué genio."

msgctxt "dialogue/97/0x155"
msgid "dialogue/97/0x155"
msgstr "Regina\n¡¡¿Qué has dicho?!!"

msgctxt "dialogue/97/0x181"
msgid "dialogue/97/0x181"
msgstr "Jack\n¡Vamos, vamos, los dos!\nArth, no la provoques."

msgctxt "dialogue/97/0x1c4"
msgid "dialogue/97/0x1c4"
msgstr "Jack\n¡Y lo más importante!"

msgctxt "dialogue/97/0x1e6"
msgid "dialogue/97/0x1e6"
msgstr "Jack\nAntes que nada, hay que\nseguir a los Zoids que\ndesaparecieron primero."

msgctxt "dialogue/97/0x237"
msgid "dialogue/97/0x237"
msgstr "Regina\n...Entendido, Jack."

msgctxt "dialogue/97/0x26d"
msgid "dialogue/97/0x26d"
msgstr "Arth\n......"

msgctxt "dialogue/97/0x293"
msgid "dialogue/97/0x293"
msgstr "Jack\n¿? ¿Qué ocurre, Arth?\n¿Te preocupa algo?"

msgctxt "dialogue/97/0x2e0"
msgid "dialogue/97/0x2e0"
msgstr "Arth\n...No, nada."

msgctxt "dialogue/97/0x304"
msgid "dialogue/97/0x304"
msgstr "Arth\nMás importante... por el\ntiempo que ha pasado, aún\ndeben de estar cerca.\nDémonos prisa."

msgctxt "dialogue/97/0x357"
msgid "dialogue/97/0x357"
msgstr "Jack\n...Tienes razón."

msgctxt "dialogue/97/0x383"
msgid "dialogue/97/0x383"
msgstr "Regina\n¿Y hacia dónde vamos?"

msgctxt "dialogue/97/0x3b1"
msgid "dialogue/97/0x3b1"
msgstr "{name}\n......"

msgctxt "dialogue/97/0x3d2"
msgid "dialogue/97/0x3d2"
msgstr "Jack\nParece que estamos en el\nlado de la República, al\notro lado del Red River."

msgctxt "dialogue/97/0x427"
msgid "dialogue/97/0x427"
msgstr "Jack\nSi no recuerdo mal, un poco\nmás al norte hay una\nciudad llamada Sand Colony."

msgctxt "dialogue/97/0x476"
msgid "dialogue/97/0x476"
msgstr "Jack\nDe momento, vayamos hacia\nallí."

msgctxt "dialogue/98/0xc"
msgid "dialogue/98/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/98/0x2d"
msgid "dialogue/98/0x2d"
msgstr "Jack\n¿Qué ocurre, príncipe?"

msgctxt "dialogue/98/0x55"
msgid "dialogue/98/0x55"
msgstr "Regina\n...Ya que nos hemos\narriesgado a viajar en el\ntiempo,"

msgctxt "dialogue/98/0xa8"
msgid "dialogue/98/0xa8"
msgstr "Regina\nahora deberíamos averiguar\nqué pretende el enemigo."

msgctxt "dialogue/98/0xe4"
msgid "dialogue/98/0xe4"
msgstr "Arth\nEstoy de acuerdo."

msgctxt "dialogue/99/0xc"
msgid "dialogue/99/0xc"
msgstr "Regina\nSu objetivo es crear el\nejército de Zoids más\npoderoso..."

msgctxt "dialogue/99/0x4b"
msgid "dialogue/99/0x4b"
msgstr "Regina\n¿De verdad será solo eso?"

msgctxt "dialogue/99/0x85"
msgid "dialogue/99/0x85"
msgstr "{name}\n......"

msgctxt "dialogue/99/0xa6"
msgid "dialogue/99/0xa6"
msgstr "Jack\nPor ahora no se puede\nsaber. Lo mejor será\npreguntárselo en persona."

msgctxt "dialogue/99/0xfd"
msgid "dialogue/99/0xfd"
msgstr "Regina\n¡Qué tranquilo te lo tomas!"

msgctxt "dialogue/99/0x129"
msgid "dialogue/99/0x129"
msgstr "Jack\nNo sirve de nada\nimpacientarse. En cualquier\ncaso, sabemos muy poco."

msgctxt "dialogue/99/0x176"
msgid "dialogue/99/0x176"
msgstr "Jack\nLo único que sabemos es\nsu objetivo."

msgctxt "dialogue/99/0x1ac"
msgid "dialogue/99/0x1ac"
msgstr "Jack\nAparte de eso, no sabemos\nnada: ni quiénes son, ni\nqué fuerzas tienen."

msgctxt "dialogue/99/0x1ff"
msgid "dialogue/99/0x1ff"
msgstr "Regina\n......"

msgctxt "dialogue/99/0x227"
msgid "dialogue/99/0x227"
msgstr "{name}\n¡¡¡¡!!!!"

msgctxt "dialogue/99/0x244"
msgid "dialogue/99/0x244"
msgstr "Regina\n¡¿Enemigos?!"

msgctxt "dialogue/100/0xc"
msgid "dialogue/100/0xc"
msgstr "Fran\n¡!\n¡¡Arth! ¡Tú!!"

msgctxt "dialogue/100/0x3f"
msgid "dialogue/100/0x3f"
msgstr "Arth\n......Así que eres tú, Fran."

msgctxt "dialogue/100/0x79"
msgid "dialogue/100/0x79"
msgstr "Fran\n¡¿Y qué si lo soy?!"

msgctxt "dialogue/100/0xb1"
msgid "dialogue/100/0xb1"
msgstr "Arth\n...¿Qué estás haciendo?"

msgctxt "dialogue/100/0xdd"
msgid "dialogue/100/0xdd"
msgstr "Fran\n¡¡No tengo por qué\ncontárselo a un traidor\ncomo tú!!"

msgctxt "dialogue/100/0x11d"
msgid "dialogue/100/0x11d"
msgstr "Arth\n...¿Qué estás haciendo?"

msgctxt "dialogue/100/0x149"
msgid "dialogue/100/0x149"
msgstr "Fran\n¡Ugh! ¡Siempre igual! Esa\ncara de saberlo todo.\n¡Como aquella vez!"

msgctxt "dialogue/100/0x1a8"
msgid "dialogue/100/0x1a8"
msgstr "Fran\n¡Arth! Algún día te haré...\nlo de aquella vez,"

msgctxt "dialogue/100/0x1db"
msgid "dialogue/100/0x1db"
msgstr "Fran\n¡haberte vuelto contra\nnosotros... te lo haré\nlamentar!"

msgctxt "dialogue/101/0xc"
msgid "dialogue/101/0xc"
msgstr "Arth\n...Lamentar..."

msgctxt "dialogue/101/0x38"
msgid "dialogue/101/0x38"
msgstr "Regina\n¡Arth! ¡¿Esa mujer...?!"

msgctxt "dialogue/101/0x6a"
msgid "dialogue/101/0x6a"
msgstr "Arth\nHa huido."

msgctxt "dialogue/101/0x8a"
msgid "dialogue/101/0x8a"
msgstr "Regina\n¿Que ha huido...?\n¡¡¿Qué quieres decir?!!"

msgctxt "dialogue/101/0xca"
msgid "dialogue/101/0xca"
msgstr "{name}\n......"

msgctxt "dialogue/101/0xeb"
msgid "dialogue/101/0xeb"
msgstr "Jack\nVamos, vamos...\nSabemos hacia dónde ha\nido..."

msgctxt "dialogue/101/0x13e"
msgid "dialogue/101/0x13e"
msgstr "Arth\nVamos..."

msgctxt "dialogue/101/0x164"
msgid "dialogue/101/0x164"
msgstr "Regina\n¡¿Pero qué te pasa?!"

msgctxt "dialogue/707/0xc"
msgid "dialogue/707/0xc"
msgstr "Dr. T\nYo también he ayudado al\nejército real: dejé el\ntransportador listo para\nusarse."

msgctxt "dialogue/707/0x5f"
msgid "dialogue/707/0x5f"
msgstr "Dr. T\nPero le afecta mucho el\ntransportador enemigo, y\nno hay manera de ir a la\népoca que uno quiere."

msgctxt "dialogue/708/0xc"
msgid "dialogue/708/0xc"
msgstr "Dr. T\nSi hubiera en alguna otra\népoca un núcleo Zoid del\nTrinity Liger..."

msgctxt "dialogue/709/0xc"
msgid "dialogue/709/0xc"
msgstr "Dr. T\n¡E-eso es...! ¡¡El núcleo\nZoid del Trinity Liger!!"

msgctxt "dialogue/709/0x4f"
msgid "dialogue/709/0x4f"
msgstr "Dr. T\n¡Genial! ¡¡Con esto el\nTrinity Liger volverá a\nla vida!!"

msgctxt "dialogue/709/0x9c"
msgid "dialogue/709/0x9c"
msgstr "Dr. T\n¡Por favor, déjame\nconstruirlo en mi\nlaboratorio!"

msgctxt "dialogue/710/0xc"
msgid "dialogue/710/0xc"
msgstr "Dr. T\n¿Qué tal va el Trinity\nLiger?"

msgctxt "dialogue/710/0x4c"
msgid "dialogue/710/0x4c"
msgstr "{name}\n......"

msgctxt "dialogue/710/0x6d"
msgid "dialogue/710/0x6d"
msgstr "Dr. T\nAy, yo también quiero ser\npiloto de Zoids. ¡Y correr\npor la tierra como el\nviento!"

msgctxt "dialogue/710/0xd4"
msgid "dialogue/710/0xd4"
msgstr "Dr. T\nOs tengo envidia."

msgctxt "dialogue/711/0xc"
msgid "dialogue/711/0xc"
msgstr "Dr. T\nHola, bienvenidos."

msgctxt "dialogue/711/0x2e"
msgid "dialogue/711/0x2e"
msgstr "Dr. T\n¿Qué tal va el Trinity\nLiger...?"

msgctxt "dialogue/711/0x5e"
msgid "dialogue/711/0x5e"
msgstr "Dr. T\n¡¡Aaah!! ¡¡P-pero ¿qué es\nesto?!!"

msgctxt "dialogue/711/0x9b"
msgid "dialogue/711/0x9b"
msgstr "Dr. T\n¡¿Qué le habéis hecho a mi\nTrinity Liger?!"

msgctxt "dialogue/711/0xd1"
msgid "dialogue/711/0xd1"
msgstr "Dr. T\n¡Así se pierde la belleza\noriginal del Trinity Liger!\n¡Su fuerza! ¡¡Su nobleza!!"

msgctxt "dialogue/711/0x130"
msgid "dialogue/711/0x130"
msgstr "Dr. T\n¡¡Si el primero en\nmodificar el Trinity Liger\ntenía que ser yo~~!!"

msgctxt "dialogue/712/0xc"
msgid "dialogue/712/0xc"
msgstr "Dr. T\n¡¡El primero en modificar\nel Trinity Liger tenía que\nhaber sido yo~~!!"

#. The party level after a save slot's name, 4 cells (32 pixels); {level} is up to 2 digits
msgctxt "port/save-slots/level"
msgid "port/save-slots/level"
msgstr "Nv{level}"

#. A save slot with no game, after its number: 14 cells (112 pixels)
msgctxt "port/save-slots/empty"
msgid "port/save-slots/empty"
msgstr "Vacía"

#. A save slot whose data is broken, after its number: 14 cells (112 pixels)
msgctxt "port/save-slots/broken"
msgid "port/save-slots/broken"
msgstr "Datos dañados"

#. The second help line for a save slot's game: {area} is its area (1-10), {money} up to 7 digits; 224 pixels
msgctxt "port/save-slots/details"
msgid "port/save-slots/details"
msgstr "Área {area}   Dinero: {money} G"

#. The help line while choosing the save slot to save into; 224 pixels
msgctxt "port/save-slots/save-help"
msgid "port/save-slots/save-help"
msgstr "¿En qué ranura quieres guardar?"

#. The help line while choosing the save slot to continue; 224 pixels
msgctxt "port/save-slots/load-help"
msgid "port/save-slots/load-help"
msgstr "¿Qué partida quieres continuar?"

#. The question before saving into an empty slot, {slot} its number; 224 pixels
msgctxt "port/save-slots/question"
msgid "port/save-slots/question"
msgstr "¿Guardar en la ranura {slot}?"

#. The question before saving over a slot's game, {slot} its number; 224 pixels
msgctxt "port/save-slots/overwrite"
msgid "port/save-slots/overwrite"
msgstr "¿Sobrescribir la ranura {slot}?"

#. The thanks once chapter 1, the end of the demo, is over: up to 3 lines of 224 pixels in the story box
msgctxt "port/demo/thanks"
msgid "port/demo/thanks"
msgstr "¡Gracias por jugar!\nLa demo termina aquí.\nLo que sigue, en próximas versiones."

#. The question after the demo's thanks, over the original's yes/no window: up to 3 lines of 224 pixels
msgctxt "port/demo/question"
msgid "port/demo/question"
msgstr "¿Quieres guardar tu progreso?"

#. The notice once the game is saved at the end of the demo: up to 3 lines of 224 pixels
msgctxt "port/demo/saved"
msgid "port/demo/saved"
msgstr "Partida guardada."

