msgctxt "dialogue/329/0xc"
msgid "dialogue/329/0xc"
msgstr "Naomi\nHe perdido. No lo hacéis\nnada mal."

msgctxt "dialogue/329/0x40"
msgid "dialogue/329/0x40"
msgstr "Leena\n¡Pues claro!"

msgctxt "dialogue/329/0x66"
msgid "dialogue/329/0x66"
msgstr "Naomi\nVosotros también,\nnovatos."

msgctxt "dialogue/329/0x9e"
msgid "dialogue/329/0x9e"
msgstr "Regina\nGracias."

msgctxt "dialogue/330/0xc"
msgid "dialogue/330/0xc"
msgstr "Harry\n¡Eh, eh! ¡No os olvidéis\ndel gran Harry!"

msgctxt "dialogue/330/0x4e"
msgid "dialogue/330/0x4e"
msgstr "Naomi\n¿Estabas aquí?"

msgctxt "dialogue/330/0x70"
msgid "dialogue/330/0x70"
msgstr "Leena\n¡Tú cállate, Harry!"

msgctxt "dialogue/330/0xb2"
msgid "dialogue/330/0xb2"
msgstr "Harry\nL-Leena, no me hagas\nesto..."

msgctxt "dialogue/330/0xec"
msgid "dialogue/330/0xec"
msgstr "Naomi\nJe, je, je. Bueno, me\nvoy. Ya nos veremos."

msgctxt "dialogue/331/0xc"
msgid "dialogue/331/0xc"
msgstr "Harry\n¿Y yo qué pinto aquí...?"

msgctxt "dialogue/332/0xc"
msgid "dialogue/332/0xc"
msgstr "Naomi\nPor cierto, Leon. Me\nprometiste contarme\nesos motivos."

msgctxt "dialogue/332/0x61"
msgid "dialogue/332/0x61"
msgstr "Leon\nSí. Naomi, ¿sabes lo de\nlas desapariciones de\nZoids?"

msgctxt "dialogue/332/0xb2"
msgid "dialogue/332/0xb2"
msgstr "Naomi\nSí. Pilotos del ranking\nque desaparecen uno tras\notro. ¿Ese es el motivo?"

msgctxt "dialogue/332/0x107"
msgid "dialogue/332/0x107"
msgstr "Leon\nParece que Team Blood\nestá metido en ello."

msgctxt "dialogue/332/0x14c"
msgid "dialogue/332/0x14c"
msgstr "Naomi\n¿Team Blood? ¿Los\ncampeones del distrito?\nEsto se pone interesante."

msgctxt "dialogue/332/0x1a3"
msgid "dialogue/332/0x1a3"
msgstr "Leon\nPor lo visto, ellos\ntienen una cuenta\npendiente con el líder\nde Team Blood."

msgctxt "dialogue/332/0x1f0"
msgid "dialogue/332/0x1f0"
msgstr "Leon\nPor eso luchamos juntos\ncomo equipo, hasta que\nnos toque enfrentarnos\na Team Blood."

msgctxt "dialogue/332/0x251"
msgid "dialogue/332/0x251"
msgstr "Leena\nPues eso. Ya sabes el\nmotivo, así que vuélvete\na casa."

msgctxt "dialogue/332/0x29c"
msgid "dialogue/332/0x29c"
msgstr "Naomi\nVaya, con una historia\ntan interesante, no me\nvoy tan fácilmente."

msgctxt "dialogue/332/0x2dd"
msgid "dialogue/332/0x2dd"
msgstr "Naomi\n...Decidido. Me uno\na vosotros."

msgctxt "dialogue/332/0x315"
msgid "dialogue/332/0x315"
msgstr "Leena\n¡Oye! ¿Qué estás\ndiciendo?"

msgctxt "dialogue/332/0x34d"
msgid "dialogue/332/0x34d"
msgstr "Naomi\n¿Qué más da? Cuantos más,\nmejor. Si sirven para\nalgo, claro."

msgctxt "dialogue/332/0x39a"
msgid "dialogue/332/0x39a"
msgstr "Leena\n¡¿Qué?! ¿Insinúas que yo\nno sirvo para nada?"

msgctxt "dialogue/332/0x3d3"
msgid "dialogue/332/0x3d3"
msgstr "Leena\n¡Muy bien! ¡Te demostraré\nque sí sirvo para algo!"

msgctxt "dialogue/332/0x426"
msgid "dialogue/332/0x426"
msgstr "Regina\nLeena, tranquila."

msgctxt "dialogue/332/0x455"
msgid "dialogue/332/0x455"
msgstr "Leon\nPues eso. Naomi, cuento\ncontigo otra vez."

msgctxt "dialogue/332/0x497"
msgid "dialogue/332/0x497"
msgstr "Naomi\nIgualmente. ¡Vuelve\nnuestro dúo!󸞍"

