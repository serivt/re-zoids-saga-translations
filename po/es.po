msgctxt "dialogue/353/0xc"
msgid "dialogue/353/0xc"
msgstr "Leena\n¡Team Champ!"

msgctxt "dialogue/353/0x36"
msgid "dialogue/353/0x36"
msgstr "Leena\n¡Este lo ganamos sin\ndespeinarnos!, ¿no?"

msgctxt "dialogue/353/0x60"
msgid "dialogue/353/0x60"
msgstr "Arth\n¿Los conoces?"

msgctxt "dialogue/353/0x8a"
msgid "dialogue/353/0x8a"
msgstr "Jamie\nDicen que es un hombre\nnacido para ser campeón,\npero..."

msgctxt "dialogue/353/0xdc"
msgid "dialogue/353/0xdc"
msgstr "Leena\nEso lo dice él solito."

msgctxt "dialogue/353/0x102"
msgid "dialogue/353/0x102"
msgstr "Harry\nEso ya lo veremos..."

msgctxt "dialogue/354/0xc"
msgid "dialogue/354/0xc"
msgstr "Harry\n¡Soy el campeón! A quien\nse cruce en mi camino,\nsea quien sea, no lo\ndejaré escapar..."

msgctxt "dialogue/354/0x6d"
msgid "dialogue/354/0x6d"
msgstr "Harry\n¡Aunque se trate de ti,\nLeena!"

msgctxt "dialogue/355/0xc"
msgid "dialogue/355/0xc"
msgstr "Leena\n¡E-eh, Benjamin!\n¿Qué le pasa a ese?"

msgctxt "dialogue/355/0x5b"
msgid "dialogue/355/0x5b"
msgstr "Benjamin\nPues no lo sé, querida.\nLleva así dos o tres\ndías."

msgctxt "dialogue/355/0xa8"
msgid "dialogue/355/0xa8"
msgstr "Benjamin\n¿Habrá comido algo\nraro?"

msgctxt "dialogue/355/0xea"
msgid "dialogue/355/0xea"
msgstr "Sebastian\nEso es que Harry por fin\nse siente campeón."

msgctxt "dialogue/355/0x137"
msgid "dialogue/355/0x137"
msgstr "Sebastian\nEsta vez Harry es otro.\n¡Preparaos!"

msgctxt "dialogue/355/0x17f"
msgid "dialogue/355/0x17f"
msgstr "Benjamin\nHasta luego..."

msgctxt "dialogue/356/0xc"
msgid "dialogue/356/0xc"
msgstr "Jamie\n¿Qué le habrá pasado?"

msgctxt "dialogue/356/0x42"
msgid "dialogue/356/0x42"
msgstr "Leena\n¿Habrá comido algo raro?\n¡Venga, vamos nosotros\ntambién!"

msgctxt "dialogue/357/0xc"
msgid "dialogue/357/0xc"
msgstr "Judgeman\n¡Preparad el campo de\nbatalla!"

msgctxt "dialogue/357/0x3e"
msgid "dialogue/357/0x3e"
msgstr "Judgeman\nTeam Blitz contra\nTeam Champ."

msgctxt "dialogue/357/0x7a"
msgid "dialogue/357/0x7a"
msgstr "Judgeman\nModo de batalla 5-2-5."

msgctxt "dialogue/357/0xa6"
msgid "dialogue/357/0xa6"
msgstr "Judgeman\n¡Listos... a luchar!"

msgctxt "dialogue/358/0xc"
msgid "dialogue/358/0xc"
msgstr "Judgeman\n¡Fin de la batalla!"

msgctxt "dialogue/358/0x38"
msgid "dialogue/358/0x38"
msgstr "Judgeman\n¡Ganador! ¡Team Blitz!"

msgctxt "dialogue/359/0xc"
msgid "dialogue/359/0xc"
msgstr "Harry\n......... (atontado)"

msgctxt "dialogue/359/0x3c"
msgid "dialogue/359/0x3c"
msgstr "Sebastian\n¡Eh, Harry, despierta!\n¡Que la batalla ya ha\nterminado!"

msgctxt "dialogue/359/0x93"
msgid "dialogue/359/0x93"
msgstr "Benjamin\n¿Qué le pasará? ¿Se habrá\ndado un mal golpe?"

msgctxt "dialogue/360/0xc"
msgid "dialogue/360/0xc"
msgstr "Leena\n¿Qué pasa? ¿Qué le\nocurre?"

msgctxt "dialogue/360/0x3e"
msgid "dialogue/360/0x3e"
msgstr "Benjamin\nSi es que no lo\nsabemos..."

msgctxt "dialogue/360/0x74"
msgid "dialogue/360/0x74"
msgstr "Harry\n¡Ah!\n¿Dónde estoy?"

msgctxt "dialogue/360/0x93"
msgid "dialogue/360/0x93"
msgstr "Harry\n¡¿...?! ¡Leena!\n¿Qué haces tú aquí?"

msgctxt "dialogue/360/0xce"
msgid "dialogue/360/0xce"
msgstr "Harry\nUn momento, ¿dónde\nestoy?"

msgctxt "dialogue/360/0xf0"
msgid "dialogue/360/0xf0"
msgstr "Harry\n¡Sebastian, Benjamin!\n¿Qué hago yo en un sitio\ncomo este?"

msgctxt "dialogue/360/0x151"
msgid "dialogue/360/0x151"
msgstr "Leena\nVuelve a ser el Harry de\nsiempre."

msgctxt "dialogue/360/0x181"
msgid "dialogue/360/0x181"
msgstr "Sebastian\n¡Espabila, Harry! ¡Si\nacabamos de luchar contra\nTeam Blitz!"

msgctxt "dialogue/360/0x1de"
msgid "dialogue/360/0x1de"
msgstr "Harry\n¿Quééé? ¡Yo jamás\nlucharía contra Leena!"

msgctxt "dialogue/360/0x225"
msgid "dialogue/360/0x225"
msgstr "Benjamin\nAy, Harry, por favor.\n¿Tendrás la memoria hecha\nun lío?"

msgctxt "dialogue/361/0xc"
msgid "dialogue/361/0xc"
msgstr "Sebastian\nEso parece. Vamos a\nllevarlo al hospital,\nBenjamin."

msgctxt "dialogue/361/0x59"
msgid "dialogue/361/0x59"
msgstr "Benjamin\nSí, vamos."

msgctxt "dialogue/361/0x91"
msgid "dialogue/361/0x91"
msgstr "Harry\n¡Eh, vosotros! ¿Qué\nhacéis? ¡Aaah, Leenaaa!"

msgctxt "dialogue/362/0xc"
msgid "dialogue/362/0xc"
msgstr "Leena\nPero ¿qué ha sido eso?"

msgctxt "dialogue/362/0x38"
msgid "dialogue/362/0x38"
msgstr "Jamie\n...Ni idea."

msgctxt "dialogue/363/0xc"
msgid "dialogue/363/0xc"
msgstr "Jack\n...¿Recuerdos\nconfusos?"

msgctxt "dialogue/363/0x2e"
msgid "dialogue/363/0x2e"
msgstr "Jack\nDisculpe, ¿ha visto a\nalgún hombre extraño\núltimamente?"

msgctxt "dialogue/363/0x75"
msgid "dialogue/363/0x75"
msgstr "Harry\n¿Y tú quién eres?"

msgctxt "dialogue/363/0x9d"
msgid "dialogue/363/0x9d"
msgstr "Leena\n¡Contesta, Harry!"

msgctxt "dialogue/363/0xcd"
msgid "dialogue/363/0xcd"
msgstr "Harry\n¡Si me lo pide Leena, no\nhay más remedio! Un tipo\nraro... ¿Uno con unas\ngafas extrañas?"

msgctxt "dialogue/363/0x132"
msgid "dialogue/363/0x132"
msgstr "Regina\nGafas extrañas...\n¡No puede ser!"

msgctxt "dialogue/363/0x16a"
msgid "dialogue/363/0x16a"
msgstr "Arth\nOpis."

msgctxt "dialogue/363/0x18c"
msgid "dialogue/363/0x18c"
msgstr "Jack\nSeguramente. El doctor\nOpis le lavó el cerebro."

msgctxt "dialogue/363/0x1dd"
msgid "dialogue/363/0x1dd"
msgstr "Leena\n¿Lavado de cerebro?\n¿Quién es ese tipo?"

msgctxt "dialogue/363/0x215"
msgid "dialogue/363/0x215"
msgstr "Regina\nNuestro enemigo. ¡Un\ncompinche de Blood!"

msgctxt "dialogue/363/0x24f"
msgid "dialogue/363/0x24f"
msgstr "Harry\n¡Imperdonable! ¡Mira que\nlavarme el cerebro a mí!"

msgctxt "dialogue/363/0x28c"
msgid "dialogue/363/0x28c"
msgstr "Harry\n¡Eh! ¡Desde hoy soy uno\nde los vuestros! ¡A esos\nque se burlaron de mí\nlos haré papilla..."

msgctxt "dialogue/363/0x2f1"
msgid "dialogue/363/0x2f1"
msgstr "Leena\n¿No acabarás tú hecho\npapilla?"

msgctxt "dialogue/363/0x327"
msgid "dialogue/363/0x327"
msgstr "Sebastian\nNo se puede descartar."

msgctxt "dialogue/363/0x35d"
msgid "dialogue/363/0x35d"
msgstr "Benjamin\nPues sí..."

msgctxt "dialogue/363/0x385"
msgid "dialogue/363/0x385"
msgstr "Harry\n¡Callaos!\n¡He dicho que lucho y\nlucho!"

msgctxt "dialogue/363/0x3bf"
msgid "dialogue/363/0x3bf"
msgstr "Harry se ha unido al\ngrupo."

msgctxt "dialogue/364/0x9"
msgid "dialogue/364/0x9"
msgstr "Ultrasaurus de la Federación\n¡Atención, Zoid no\nidentificado!"

msgctxt "dialogue/364/0x47"
msgid "dialogue/364/0x47"
msgstr "Ultrasaurus de la Federación\nEsta zona es de acceso\nprohibido. Abandónela\nde inmediato."

msgctxt "dialogue/364/0xb2"
msgid "dialogue/364/0xb2"
msgstr "Ultrasaurus de la Federación\nRepito: abandone la zona\nde inmediato. Si no\nobedece, será destruido.\nAbandone la zona de\ninmediato."

msgctxt "dialogue/365/0x3"
msgid "dialogue/365/0x3"
msgstr "Recepcionista\nBienvenidos al torneo de\nla Cúpula Principal."

msgctxt "dialogue/365/0x33"
msgid "dialogue/365/0x33"
msgstr "Recepcionista\n¿Desean participar en el\ntorneo?"

msgctxt "dialogue/365/0x67"
msgid "dialogue/365/0x67"
msgstr "Recepcionista\nSi participan, no podrán\nsalir de la arena hasta\nque terminen todas las\nbatallas Zoid."

msgctxt "dialogue/365/0xba"
msgid "dialogue/365/0xba"
msgstr "Recepcionista\n¿Participarán en el\ntorneo?"

msgctxt "dialogue/365/0xf6"
msgid "dialogue/365/0xf6"
msgstr "Recepcionista\nQuedan inscritos. Cuando\nquieran librar una\nbatalla Zoid, vuelvan a\nhablar conmigo."

msgctxt "dialogue/365/0x150"
msgid "dialogue/365/0x150"
msgstr "Recepcionista\nEsperamos su desafío en\notra ocasión."

msgctxt "dialogue/366/0x3"
msgid "dialogue/366/0x3"
msgstr "Recepcionista\nLa Cúpula Principal es la\narena del torneo final."

msgctxt "dialogue/366/0x3c"
msgid "dialogue/366/0x3c"
msgstr "Recepcionista\nSu equipo no reúne los\nrequisitos para competir."

msgctxt "dialogue/366/0x73"
msgid "dialogue/366/0x73"
msgstr "Recepcionista\nGanen primero los torneos\nde la Cúpula Este y la\nCúpula Sur, y luego\ninscríbanse."

msgctxt "dialogue/367/0xc"
msgid "dialogue/367/0xc"
msgstr "Brad\nHabéis tardado."

msgctxt "dialogue/367/0x32"
msgid "dialogue/367/0x32"
msgstr "Bit\n¡Ya me han contado las\nhazañas del Team Blitz!"

msgctxt "dialogue/367/0x79"
msgid "dialogue/367/0x79"
msgstr "Leena\n¡Bit! ¡Y Brad también!\n¡Cuánto tiempo! ¿Desde la\nRoyal Cup?"

msgctxt "dialogue/367/0xd6"
msgid "dialogue/367/0xd6"
msgstr "Jamie\n¿Qué hacéis aquí los dos?\nBit, ¿no te habías ido\nde viaje?"

msgctxt "dialogue/367/0x13b"
msgid "dialogue/367/0x13b"
msgstr "Bit\nPues sí. Pero al pasarme\npor Romeo City,"

msgctxt "dialogue/367/0x178"
msgid "dialogue/367/0x178"
msgstr "Bit\n¡no se hablaba de otra\ncosa que del Team Blitz!\n¡Alucinante!"

msgctxt "dialogue/367/0x1cb"
msgid "dialogue/367/0x1cb"
msgstr "Jamie\n¿Eh? Por cierto, Brad,\n¿no ibas a formar equipo\ncon Naomi?"

msgctxt "dialogue/367/0x22d"
msgid "dialogue/367/0x22d"
msgstr "Brad\n......Bueno, pasaron\nmuchas cosas. Pero eso\nya es agua pasada..."

msgctxt "dialogue/367/0x284"
msgid "dialogue/367/0x284"
msgstr "Jamie\nBit, Brad, nosotros..."

msgctxt "dialogue/367/0x2c8"
msgid "dialogue/367/0x2c8"
msgstr "Bit\nEl doctor me ha contado\nmás o menos lo que pasa."

msgctxt "dialogue/367/0x302"
msgid "dialogue/367/0x302"
msgstr "Bit\n¡Parece que va a haber\nbatallas de las buenas!\n¡Ya estoy impaciente!"

msgctxt "dialogue/367/0x34b"
msgid "dialogue/367/0x34b"
msgstr "Leena\n¿Te lo ha contado papá?"

msgctxt "dialogue/367/0x363"
msgid "dialogue/367/0x363"
msgstr "Leena\n¿Tú también vas a\nayudarnos, Brad?"

msgctxt "dialogue/367/0x399"
msgid "dialogue/367/0x399"
msgstr "Brad\nNo. Yo solo me muevo por\ndinero."

msgctxt "dialogue/367/0x3c7"
msgid "dialogue/367/0x3c7"
msgstr "Leena\nLo sabía..."

msgctxt "dialogue/367/0x3f1"
msgid "dialogue/367/0x3f1"
msgstr "Brad\n¿Qué decís? ¿Queréis\nfirmar un contrato\nconmigo?"

msgctxt "dialogue/367/0x456"
msgid "dialogue/367/0x456"
msgstr "Brad\nTrato hecho. Contad\nconmigo. Como favor, mis\nhonorarios irán a la\ncuenta del Dr. Tros."

msgctxt "dialogue/367/0x4b0"
msgid "dialogue/367/0x4b0"
msgstr "¡Bit y Brad se han unido\nal grupo!"

msgctxt "dialogue/367/0x4fa"
msgid "dialogue/367/0x4fa"
msgstr "Brad\nVale. Entonces me\nlimitaré a mirar."

msgctxt "dialogue/367/0x535"
msgid "dialogue/367/0x535"
msgstr "¡Bit se ha unido al grupo!"

msgctxt "dialogue/368/0x3"
msgid "dialogue/368/0x3"
msgstr "Recepcionista\nSi abandonan la arena\ndurante el torneo,\nperderán todas sus\nvictorias."

msgctxt "dialogue/368/0x4e"
msgid "dialogue/368/0x4e"
msgstr "Recepcionista\n¿Aun así, desean salir?"

msgctxt "dialogue/368/0x84"
msgid "dialogue/368/0x84"
msgstr "Recepcionista\nSi desean volver a\nparticipar, hablen\nconmigo en la recepción."

msgctxt "dialogue/369/0xc"
msgid "dialogue/369/0xc"
msgstr "Brad\n¿Qué decís? ¿Al final\nfirmáis un contrato\nconmigo?"

msgctxt "dialogue/369/0x6e"
msgid "dialogue/369/0x6e"
msgstr "Brad\nTrato hecho. Contad\nconmigo. Como favor, mis\nhonorarios irán a la\ncuenta del Dr. Tros."

msgctxt "dialogue/369/0xc8"
msgid "dialogue/369/0xc8"
msgstr "¡Brad se ha unido al grupo!"

msgctxt "dialogue/369/0x104"
msgid "dialogue/369/0x104"
msgstr "Brad\nBueno, si cambiáis de\nidea, avisadme."

