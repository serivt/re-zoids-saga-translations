msgctxt "dialogue/384/0x54"
msgid "dialogue/384/0x54"
msgstr "Leena\n¿¡Dark Judgeman!?"

msgctxt "dialogue/384/0x86"
msgid "dialogue/384/0x86"
msgstr "Dr. Laon\n¡Ja, ja, ja, ja, ja!\n¡Os estaba esperando,\nseñores del Team Blitz!"

msgctxt "dialogue/384/0xd7"
msgid "dialogue/384/0xd7"
msgstr "Bit\nLaon... No hacía falta\ntanto lío. Me enfrento a\nti cuando quieras."

msgctxt "dialogue/384/0x13c"
msgid "dialogue/384/0x13c"
msgstr "Dr. Laon\n¡Silencio! ¡Todo es\nculpa de Tros!"

msgctxt "dialogue/384/0x179"
msgid "dialogue/384/0x179"
msgstr "Dr. Laon\n¡Vamos, luchad contra\nmis Zoids más poderosos!"

msgctxt "dialogue/384/0x1b5"
msgid "dialogue/384/0x1b5"
msgstr "Bit\nQué remedio... Parece\nque no queda otra que\nluchar..."

msgctxt "dialogue/384/0x206"
msgid "dialogue/384/0x206"
msgstr "Dark Judgeman\nTeam Blitz contraaa\nTeam Elephanders"

msgctxt "dialogue/384/0x24f"
msgid "dialogue/384/0x24f"
