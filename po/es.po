msgctxt "dialogue/69/0xc"
msgid "dialogue/69/0xc"
msgstr "Regina\n¡Príncipe! Primero hay que\naveriguar qué trama el\nenemigo al otro lado del\ntiempo."

msgctxt "dialogue/69/0x57"
msgid "dialogue/69/0x57"
msgstr "Regina\n¡Piense en lo que debemos\nhacer ahora!"

msgctxt "dialogue/70/0xc"
msgid "dialogue/70/0xc"
msgstr "Arth\n¡Príncipe, aguante por\nahora! ¡Llegará el día en\nque recuperemos el castillo!"

msgctxt "dialogue/71/0xc"
msgid "dialogue/71/0xc"
msgstr "Jack\nParece que el ejército\nimperial vuelca todas sus\nfuerzas en defender el\ncastillo."

msgctxt "dialogue/71/0x4f"
msgid "dialogue/71/0x4f"
msgstr "Jack\nPríncipe, seguro que muy\npronto recuperaremos el\ncastillo."

msgctxt "dialogue/72/0xc"
msgid "dialogue/72/0xc"
msgstr "Regina\n...... Parece que el\nenemigo ha bloqueado el\npasadizo de huida."

msgctxt "dialogue/72/0x5a"
msgid "dialogue/72/0x5a"
msgstr "Regina\nEl enemigo no será tan\ningenuo como para dejarnos\nentrar por aquí..."

msgctxt "dialogue/102/0xc"
msgid "dialogue/102/0xc"
msgstr "Regina\nArth y esa mujer...\n¿Se conocerán...?"

msgctxt "dialogue/102/0x50"
msgid "dialogue/102/0x50"
msgstr "{name}\n......"

msgctxt "dialogue/102/0x71"
msgid "dialogue/102/0x71"
msgstr "Jack\n¿Por qué lo cree?"

msgctxt "dialogue/102/0xa7"
msgid "dialogue/102/0xa7"
msgstr "Regina\nNo sé, me dio la impresión\nde que había algo detrás."

msgctxt "dialogue/102/0xe7"
msgid "dialogue/102/0xe7"
msgstr "Jack\nPuede que sí. Pero hasta\nque Arth decida contarlo\npor sí mismo..."

msgctxt "dialogue/102/0x144"
msgid "dialogue/102/0x144"
msgstr "Regina\n¿Quieres decir que no le\npreguntemos nada?"

msgctxt "dialogue/102/0x176"
msgid "dialogue/102/0x176"
msgstr "Jack\nExacto. Todos tenemos\nalgún que otro secreto."

msgctxt "dialogue/102/0x1c5"
msgid "dialogue/102/0x1c5"
msgstr "Regina\n......"

msgctxt "dialogue/102/0x1ed"
msgid "dialogue/102/0x1ed"
msgstr "{name}\n......"

msgctxt "dialogue/103/0x3"
msgid "dialogue/103/0x3"
msgstr "Regina y Jack\n¡Príncipe!"

msgctxt "dialogue/103/0x2f"
msgid "dialogue/103/0x2f"
msgstr "Arth\n¡!"

msgctxt "dialogue/103/0x4b"
msgid "dialogue/103/0x4b"
msgstr "Van\n¡Aaay, qué daño...!"

msgctxt "dialogue/103/0x6d"
msgid "dialogue/103/0x6d"
msgstr "{name}\n......"

msgctxt "dialogue/103/0x8e"
msgid "dialogue/103/0x8e"
msgstr "Regina\n¡Príncipe! ¿Está herido?"

msgctxt "dialogue/103/0xbd"
msgid "dialogue/103/0xbd"
msgstr "Jack\n...Parece que está bien.\nY tú, chaval, ¿te has\nhecho daño?"

msgctxt "dialogue/103/0x110"
msgid "dialogue/103/0x110"
msgstr "Regina\n...¿Un organoide?"

msgctxt "dialogue/103/0x140"
msgid "dialogue/103/0x140"
msgstr "Van\n¡No soy ningún chaval!\n¡Me llamo Van! Y este es\nmi compañero, Zeke."

msgctxt "dialogue/103/0x187"
msgid "dialogue/103/0x187"
msgstr "Van\n¡Pero no es momento de\nponerse a saludar\ntan tranquilos!"

msgctxt "dialogue/103/0x1be"
msgid "dialogue/103/0x1be"
msgstr "Van\n¡Tengo que perseguir a\nesa mujer!"

msgctxt "dialogue/103/0x1f0"
msgid "dialogue/103/0x1f0"
msgstr "Van\n¡Lo siento, tengo prisa!\n¡Vamos, Zeke!"

msgctxt "dialogue/104/0xc"
msgid "dialogue/104/0xc"
msgstr "Arth\n¿Esa mujer? ¿Se refiere\na Fran...?"

msgctxt "dialogue/104/0x44"
msgid "dialogue/104/0x44"
msgstr "Regina\n¿Qué significa esto?\n¿Ese chico también iba\ndetrás de esa mujer?"

msgctxt "dialogue/104/0x9f"
msgid "dialogue/104/0x9f"
msgstr "Jack\nNo puedo asegurarlo..."

msgctxt "dialogue/104/0xe3"
msgid "dialogue/104/0xe3"
msgstr "Arth\n......"

msgctxt "dialogue/104/0x109"
msgid "dialogue/104/0x109"
msgstr "Regina\n¿Tendrá algo que ver con\nese organoide?"

msgctxt "dialogue/104/0x154"
msgid "dialogue/104/0x154"
msgstr "Jack\nQuién sabe...\nEs muy posible, pero..."

msgctxt "dialogue/104/0x19d"
msgid "dialogue/104/0x19d"
msgstr "Regina\n...No entiendo nada..."

msgctxt "dialogue/104/0x1d9"
msgid "dialogue/104/0x1d9"
msgstr "Arth\nHabrá que investigar."

msgctxt "dialogue/104/0x203"
msgid "dialogue/104/0x203"
msgstr "Jack\nCierto. Busquemos\ninformación en el pueblo.\nQuizá averigüemos algo."

msgctxt "dialogue/104/0x262"
msgid "dialogue/104/0x262"
msgstr "{name}\n......"

msgctxt "dialogue/105/0x3"
msgid "dialogue/105/0x3"
msgstr "Vecino\n¿Una mujer sospechosa?\nMmm, con eso solo no\nsabría decirte."

msgctxt "dialogue/105/0x51"
msgid "dialogue/105/0x51"
msgstr "Arth\nUna mujer alta, de mirada\npenetrante."

msgctxt "dialogue/105/0x76"
msgid "dialogue/105/0x76"
msgstr "Vecino\nAh, ¿será la muchacha que\niba con una niña rubia?"

msgctxt "dialogue/105/0xd5"
msgid "dialogue/105/0xd5"
msgstr "Jack\n¿Una niña rubia?"

msgctxt "dialogue/105/0xf6"
msgid "dialogue/105/0xf6"
msgstr "Vecino\nSí, ninguna de las dos es\nde por aquí. Por eso las\nrecuerdo bien."

msgctxt "dialogue/105/0x14d"
msgid "dialogue/105/0x14d"
msgstr "Regina\n¿Quién será? ¿O será otra\npersona?"

msgctxt "dialogue/105/0x187"
msgid "dialogue/105/0x187"
msgstr "Jack\n...No lo sé."

msgctxt "dialogue/105/0x1b7"
msgid "dialogue/105/0x1b7"
msgstr "Arth\n......"

msgctxt "dialogue/106/0x3"
msgid "dialogue/106/0x3"
msgstr "Vecino\nDicen que hace poco los de\nla República volaron el\nFire Bridge que cruza\nel Red River."

msgctxt "dialogue/106/0x64"
msgid "dialogue/106/0x64"
msgstr "Vecino\nTambién hubo escaramuzas\nen el Red River...\n¿Irá a estallar una\nguerra?"

msgctxt "dialogue/106/0xc5"
msgid "dialogue/106/0xc5"
msgstr "{name}\n......"

msgctxt "dialogue/107/0x3"
msgid "dialogue/107/0x3"
msgstr "Vecino\nSi estalla la guerra, a\nnosotros nos da igual.\nAl contrario: hay negocio\npor todas partes."

msgctxt "dialogue/108/0x3"
msgid "dialogue/108/0x3"
msgstr "Vecino\nNo sé nada de esa mujer,\npero sí de los amigos del\nchico del organoide.\nEstaban en la taberna."

msgctxt "dialogue/108/0x77"
msgid "dialogue/108/0x77"
msgstr "Arth\n¿Compañeros?"

msgctxt "dialogue/108/0x8e"
msgid "dialogue/108/0x8e"
msgstr "Vecino\nUn tipo con mala cara,\nuna mujer con pinta de\navariciosa y una niña\nrubia algo despistada."

msgctxt "dialogue/108/0xed"
msgid "dialogue/108/0xed"
msgstr "Vecino\nHace un rato, el de mala\ncara y la niña estuvieron\nde compras."

msgctxt "dialogue/109/0x3"
msgid "dialogue/109/0x3"
msgstr "Vecino\nNo sé quién habrá sido,\npero volar el Fire Bridge\nnos ha fastidiado bien."

msgctxt "dialogue/109/0x64"
msgid "dialogue/109/0x64"
msgstr "Vecino\nYa no llega mercancía del\nImperio. El negocio está\npor los suelos."

msgctxt "dialogue/110/0x3"
msgid "dialogue/110/0x3"
msgstr "Vecino\nDicen que han aparecido\nladrones en Rock Colony,\naquí al lado. Qué tiempos\ntan peligrosos."

msgctxt "dialogue/111/0x3"
msgid "dialogue/111/0x3"
msgstr "Vecino\n¿Un chico y un organoide?\nSí, gritaba que se habían\nllevado a la niña que\nlo acompañaba."

msgctxt "dialogue/111/0x62"
msgid "dialogue/111/0x62"
msgstr "Vecino\nSe habrá perdido, seguro.\nEs algo muy normal en\neste pueblo..."

msgctxt "dialogue/112/0x3"
msgid "dialogue/112/0x3"
msgstr "Vecino\nEsto es Sand Colony. Todo\nel que viaja por la zona\npasa por aquí."

msgctxt "dialogue/113/0x3"
msgid "dialogue/113/0x3"
msgstr "Vecino\nNo sé si es la mujer que\nbuscáis, pero había una\nque no paraba de preguntar\npor Zoids."

msgctxt "dialogue/113/0x74"
msgid "dialogue/113/0x74"
msgstr "Jack\n¿Por Zoids?"

msgctxt "dialogue/113/0x97"
msgid "dialogue/113/0x97"
msgstr "Vecino\nSí, por Ligers, Tigers y\ncosas así... Como si en\nun sitio tan perdido fuera\na haber Zoids tan raros."

msgctxt "dialogue/113/0x11a"
msgid "dialogue/113/0x11a"
msgstr "Regina\n......"

msgctxt "dialogue/114/0x3"
msgid "dialogue/114/0x3"
msgstr "Vecino\n¿Buscáis a un niño? Lo\nsiento, no sé nada."

msgctxt "dialogue/115/0xc"
msgid "dialogue/115/0xc"
msgstr "Moonbay\nPerdona, estamos hablando\nde algo importante."

msgctxt "dialogue/116/0xc"
msgid "dialogue/116/0xc"
msgstr "Dr. D\n¡Oh, qué mona es esa\nmuchachita! ¿Te tomas\nun té conmigo?"

msgctxt "dialogue/117/0xc"
msgid "dialogue/117/0xc"
msgstr "Irvine\n¿Eh? ¿Qué queréis?"

msgctxt "dialogue/117/0x3e"
msgid "dialogue/117/0x3e"
msgstr "Jack\n¿Conoce a un chico llamado\nVan?"

msgctxt "dialogue/117/0x78"
msgid "dialogue/117/0x78"
msgstr "Moonbay\n¿¡Van!?"

msgctxt "dialogue/117/0x9c"
msgid "dialogue/117/0x9c"
msgstr "Irvine\n¿Quiénes sois vosotros...?"

msgctxt "dialogue/117/0xd0"
msgid "dialogue/117/0xd0"
msgstr "Arth\nBuscamos a un chico\nllamado Van. ¿Dónde está?"

msgctxt "dialogue/117/0x113"
msgid "dialogue/117/0x113"
msgstr "Irvine\nNo tengo por qué\ncontártelo."

msgctxt "dialogue/117/0x157"
msgid "dialogue/117/0x157"
msgstr "Arth\n...Qué mala cara."

msgctxt "dialogue/117/0x183"
msgid "dialogue/117/0x183"
msgstr "Irvine\n¡¿Qué has dicho?!\n¡¡Mira quién habla!!"

msgctxt "dialogue/118/0xc"
msgid "dialogue/118/0xc"
msgstr "Moonbay\n¡Ya basta, Irvine!"

msgctxt "dialogue/118/0x42"
msgid "dialogue/118/0x42"
msgstr "Regina\n¡Ya está bien, Arth!"

msgctxt "dialogue/118/0x7a"
msgid "dialogue/118/0x7a"
msgstr "Arth\n......"

msgctxt "dialogue/118/0xa0"
msgid "dialogue/118/0xa0"
msgstr "Irvine\n¡Tsk!"

msgctxt "dialogue/118/0xc4"
msgid "dialogue/118/0xc4"
msgstr "Dr. D\n¿Qué, ya se acabó?\nQué aburrimiento."

msgctxt "dialogue/118/0x107"
msgid "dialogue/118/0x107"
msgstr "Irvine\n¡Tú calla, viejo!"

msgctxt "dialogue/118/0x13b"
msgid "dialogue/118/0x13b"
msgstr "Moonbay\nTú también, Irvine.\nY vosotros, ¿quiénes sois?"

msgctxt "dialogue/118/0x18a"
msgid "dialogue/118/0x18a"
msgstr "Jack\nVerá, perseguimos a cierta\nmujer, y parece que Van\ntambién va tras ella..."

msgctxt "dialogue/118/0x1f5"
msgid "dialogue/118/0x1f5"
msgstr "Moonbay\n¡¿Van?!"

msgctxt "dialogue/118/0x21d"
msgid "dialogue/118/0x21d"
msgstr "Jack\nSí. Iba con un organoide\nllamado Zeke."

msgctxt "dialogue/118/0x270"
msgid "dialogue/118/0x270"
msgstr "Irvine\n¿Solo iba con Zeke?"

msgctxt "dialogue/118/0x2b3"
msgid "dialogue/118/0x2b3"
msgstr "Arth\nNo tengo por qué\ncontártelo."

msgctxt "dialogue/118/0x2e5"
msgid "dialogue/118/0x2e5"
msgstr "Irvine\n¡¿Qué?! ¡Serás...!"

msgctxt "dialogue/118/0x317"
msgid "dialogue/118/0x317"
msgstr "Regina\n¡Arth!"

msgctxt "dialogue/118/0x33e"
msgid "dialogue/118/0x33e"
msgstr "Regina\nPerdonad. Solo iban él\ny el organoide."

msgctxt "dialogue/118/0x37c"
msgid "dialogue/118/0x37c"
msgstr "Irvine y Moonbay\n......"

msgctxt "dialogue/118/0x3b0"
msgid "dialogue/118/0x3b0"
msgstr "Dr. D\n¿La jovencita no estaba\ncon él?"

msgctxt "dialogue/118/0x3ea"
msgid "dialogue/118/0x3ea"
msgstr "Regina\n¿La jovencita?"

msgctxt "dialogue/118/0x412"
msgid "dialogue/118/0x412"
msgstr "Moonbay\nEs una chica llamada\nFiona. Creía que estaba\ncon Van."

msgctxt "dialogue/118/0x46f"
msgid "dialogue/118/0x46f"
msgstr "Regina\n¿Qué significa esto?"

msgctxt "dialogue/118/0x499"
msgid "dialogue/118/0x499"
msgstr "Regina\nEse tal Van persigue a\nFran, y la tal Fiona, que\ndebería ir con él, no\nestá..."

msgctxt "dialogue/118/0x4fe"
msgid "dialogue/118/0x4fe"
msgstr "Arth\n...Se la ha llevado Fran."

msgctxt "dialogue/118/0x530"
msgid "dialogue/118/0x530"
msgstr "Jack\nPodría ser, pero\n¿por qué?"

msgctxt "dialogue/118/0x56c"
msgid "dialogue/118/0x56c"
msgstr "Irvine\n¿Qué pasa? ¿Sabéis algo?\nSi os lo calláis, lo vais\na lamentar."

msgctxt "dialogue/118/0x5c7"
msgid "dialogue/118/0x5c7"
msgstr "Moonbay\nQue lo dejes, Irvine."

msgctxt "dialogue/118/0x5ed"
msgid "dialogue/118/0x5ed"
msgstr "Moonbay\nLa mujer que perseguís y\nel motivo por el que Van\nla persigue..."

msgctxt "dialogue/118/0x63c"
msgid "dialogue/118/0x63c"
msgstr "Moonbay\n¿Os parece buena base\npara hacer un trato?"

msgctxt "dialogue/118/0x68f"
msgid "dialogue/118/0x68f"
msgstr "Jack\n¿Es decir, que unamos\nfuerzas?"

msgctxt "dialogue/118/0x6bf"
msgid "dialogue/118/0x6bf"
msgstr "Moonbay\nEso. De momento, el\nobjetivo es encontrar a\nesa mujer. ¡Hasta\nentonces, vamos juntos!"

msgctxt "dialogue/118/0x71c"
msgid "dialogue/118/0x71c"
msgstr "Irvine\nNo me fío."

msgctxt "dialogue/118/0x748"
msgid "dialogue/118/0x748"
msgstr "Moonbay\nPero buscar a Van y a\nFiona nosotros solos\nsería muy difícil."

msgctxt "dialogue/118/0x79b"
msgid "dialogue/118/0x79b"
msgstr "Jack\nCierto. Buscando entre\nmás gente seremos más\neficaces."

msgctxt "dialogue/118/0x7f0"
msgid "dialogue/118/0x7f0"
msgstr "Irvine\n¡Tsk! Qué remedio.\nDe momento, tregua."

msgctxt "dialogue/118/0x832"
msgid "dialogue/118/0x832"
msgstr "¡Irvine y los suyos se\nunen al grupo!"

msgctxt "dialogue/119/0xc"
msgid "dialogue/119/0xc"
msgstr "Irvine\nVale, ya hemos unido\nfuerzas, pero ¿por dónde\nempezamos a buscar?"

msgctxt "dialogue/119/0x50"
msgid "dialogue/119/0x50"
msgstr "Moonbay\nPues..."

msgctxt "dialogue/119/0x7a"
msgid "dialogue/119/0x7a"
msgstr "Arth\n...Tiene que tener\ncómplices."

msgctxt "dialogue/119/0xaa"
msgid "dialogue/119/0xaa"
msgstr "Regina\n¿Cómplices?"

msgctxt "dialogue/119/0xcc"
msgid "dialogue/119/0xcc"
msgstr "Arth\nFran no lleva mucho\ntiempo aquí."

msgctxt "dialogue/119/0x10b"
msgid "dialogue/119/0x10b"
msgstr "Arth\nLlevarse a una persona\nno es nada fácil."

msgctxt "dialogue/119/0x149"
msgid "dialogue/119/0x149"
msgstr "Jack\n...¿Quiere decir que\nalguien la ayuda?"

msgctxt "dialogue/119/0x181"
msgid "dialogue/119/0x181"
msgstr "Moonbay\nCómplices... ¡No me digas\nque son esos!"

msgctxt "dialogue/119/0x1b9"
msgid "dialogue/119/0x1b9"
msgstr "Irvine\nOtra vez esos..."

msgctxt "dialogue/119/0x1e7"
msgid "dialogue/119/0x1e7"
msgstr "Regina\n¿Sabéis quién puede ser?"

msgctxt "dialogue/119/0x20f"
msgid "dialogue/119/0x20f"
msgstr "Moonbay\nDesert Arcobaleno. Unos\nladrones del desierto.\nDe ellos me lo creo."

msgctxt "dialogue/119/0x26c"
msgid "dialogue/119/0x26c"
msgstr "Arth\nDecidido."

msgctxt "dialogue/119/0x290"
msgid "dialogue/119/0x290"
msgstr "Irvine\nPor cierto, si queréis que\nluche, meted mi Zoid en la\nformación de la unidad."

msgctxt "dialogue/120/0x3"
msgid "dialogue/120/0x3"
msgstr "Vecino\nHe oído que hay ladrones\nen Rock Colony, aquí al\nlado."

msgctxt "dialogue/120/0x43"
msgid "dialogue/120/0x43"
msgstr "Vecino\nPor cierto, hace un rato\nun chaval con un organoide\npreguntaba lo mismo..."

msgctxt "dialogue/121/0x3"
msgid "dialogue/121/0x3"
msgstr "Vecino\n¿Una banda de ladrones?\nNi idea."

msgctxt "dialogue/122/0x3"
msgid "dialogue/122/0x3"
msgstr "Vecino\n¿Ladrones? Con eso de que\nva a estallar la guerra,\npor aquí cada vez hay\nmenos seguridad."

msgctxt "dialogue/123/0x3"
msgid "dialogue/123/0x3"
msgstr "Vecino\n¿Desalto... qué? En este\npueblo no me suena."

msgctxt "dialogue/124/0xc"
msgid "dialogue/124/0xc"
msgstr "Moonbay\n¡¿Van?!"

msgctxt "dialogue/124/0x32"
msgid "dialogue/124/0x32"
msgstr "Irvine\n¡Otra vez lanzándose por\nsu cuenta!"

msgctxt "dialogue/124/0x6e"
msgid "dialogue/124/0x6e"
msgstr "Van\n¡Moonbay! ¡Y también\nIrvine!"

msgctxt "dialogue/124/0xa4"
msgid "dialogue/124/0xa4"
msgstr "Irvine\nTienes prisa, ¿no?\n¡Vamos a quitarlos de\nen medio!"

msgctxt "dialogue/124/0xef"
msgid "dialogue/124/0xef"
msgstr "Van\n¡Gracias, Irvine!\n¡Te los dejo a ti!"

msgctxt "dialogue/125/0xc"
msgid "dialogue/125/0xc"
msgstr "Irvine\n¡Eh! ¡¡Espera!!\n¡Te digo que no te lances\ntú solo!"

msgctxt "dialogue/125/0x69"
msgid "dialogue/125/0x69"
msgstr "Moonbay\n¡Irvine! ¡Primero hay que\nocuparse del enemigo que\ntenemos delante!"

msgctxt "dialogue/125/0xac"
msgid "dialogue/125/0xac"
msgstr "Moonbay\n¡Vosotros también, por\nfavor!"

msgctxt "dialogue/125/0xdc"
msgid "dialogue/125/0xdc"
msgstr "{name}\n......¡¡!!"

msgctxt "dialogue/126/0xc"
msgid "dialogue/126/0xc"
msgstr "Irvine\nEse Van...\nSe ha largado. Qué poca\npaciencia tiene."

msgctxt "dialogue/126/0x59"
msgid "dialogue/126/0x59"
msgstr "Moonbay\nIgual que alguien que yo\nme sé."

msgctxt "dialogue/126/0x85"
msgid "dialogue/126/0x85"
msgstr "Irvine\n¿Ah, sí? ¿Y de quién\nhablas?"

msgctxt "dialogue/126/0xc1"
msgid "dialogue/126/0xc1"
msgstr "Dr. D\n¡Jo, jo, jo, jo!"

msgctxt "dialogue/126/0xeb"
msgid "dialogue/126/0xeb"
msgstr "Irvine\n¡Cállate, viejo!"

msgctxt "dialogue/126/0x11b"
msgid "dialogue/126/0x11b"
msgstr "Jack\n¡Dejémonos de eso y\nvayamos tras él!"

msgctxt "dialogue/126/0x164"
msgid "dialogue/126/0x164"
msgstr "Irvine\nYa lo sé.\n¡¡Vamos!!"

msgctxt "dialogue/127/0xc"
msgid "dialogue/127/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/127/0x2d"
msgid "dialogue/127/0x2d"
msgstr "Regina\n...¿Qué ha pasado aquí?"

msgctxt "dialogue/127/0x5f"
msgid "dialogue/127/0x5f"
msgstr "Jack\n...Parece que ha habido\nun combate."

msgctxt "dialogue/127/0x97"
msgid "dialogue/127/0x97"
msgstr "Arth\n......"

msgctxt "dialogue/127/0xbd"
msgid "dialogue/127/0xbd"
msgstr "Irvine\n......"

msgctxt "dialogue/127/0xe7"
msgid "dialogue/127/0xe7"
msgstr "Moonbay\nSea como sea, preguntemos\na alguien."

msgctxt "dialogue/128/0x3"
msgid "dialogue/128/0x3"
msgstr "Vecino\n¡¿Que qué ha pasado?!\n¡Un Redler nos atacó de\nrepente!"

msgctxt "dialogue/128/0x54"
msgid "dialogue/128/0x54"
msgstr "Vecino\n¡Seguro que eran los\nladrones que rondan por\naquí últimamente!"

msgctxt "dialogue/129/0x3"
msgid "dialogue/129/0x3"
msgstr "Vecino\n¿Una banda de ladrones?\nNo sé... De momento, solo\nera un Redler."

msgctxt "dialogue/130/0x3"
msgid "dialogue/130/0x3"
msgstr "Vecino\n¿Ladrones? Dicen que\ntienen su guarida en la\ncueva del norte."

msgctxt "dialogue/131/0x3"
msgid "dialogue/131/0x3"
msgstr "Vecino\nNo vi bien quién pilotaba\nel Redler..., pero parecía\nuna mujer."

msgctxt "dialogue/131/0x5c"
msgid "dialogue/131/0x5c"
msgstr "Vecino\nHay mujeres temibles en\neste mundo. La mía es un\nángel a su lado."

msgctxt "dialogue/132/0x3"
msgid "dialogue/132/0x3"
msgstr "Niño\n¿Una niña rubia...?\nCreo que la vi un\nmomento..."

msgctxt "dialogue/132/0x4c"
msgid "dialogue/132/0x4c"
msgstr "Niño\nPero fue visto y no\nvisto..."

msgctxt "dialogue/133/0x3"
msgid "dialogue/133/0x3"
msgstr "Vecino\n¿Una niña rubia? Sí,\niba en la cabina del\nRedler. ¡La vi con mis\npropios ojos!"

msgctxt "dialogue/134/0xc"
msgid "dialogue/134/0xc"
msgstr "Irvine\nUn Redler... Está claro."

msgctxt "dialogue/134/0x40"
msgid "dialogue/134/0x40"
msgstr "Moonbay\n...Ya..."

msgctxt "dialogue/134/0x6e"
msgid "dialogue/134/0x6e"
msgstr "Irvine\n¿Qué pasa, Moonbay?"

msgctxt "dialogue/134/0x9e"
msgid "dialogue/134/0x9e"
msgstr "Moonbay\nHay algo que no me cuadra."

msgctxt "dialogue/134/0xc8"
msgid "dialogue/134/0xc8"
msgstr "Moonbay\nPor muy brutos que sean,\n¿atacarían un pueblo con\nun solo Zoid...?"

msgctxt "dialogue/134/0x125"
msgid "dialogue/134/0x125"
msgstr "Irvine\nPero era un Redler.\nY dicen que llevaba a\nFiona."

msgctxt "dialogue/134/0x174"
msgid "dialogue/134/0x174"
msgstr "Moonbay\n......"

msgctxt "dialogue/134/0x19c"
msgid "dialogue/134/0x19c"
msgstr "Irvine\nDarle vueltas no sirve de\nnada. Se lo preguntaremos\na ellos. ¡Vamos!"

msgctxt "dialogue/135/0x3"
msgid "dialogue/135/0x3"
msgstr "Vecino\nDesde que nos atacaron los\nladrones, no pego ojo por\nmiedo a que vuelvan..."

msgctxt "dialogue/136/0x3"
msgid "dialogue/136/0x3"
msgstr "Vecino\nAntes de acabar con los\nladrones, ¿no podría\nalguien acabar con mi\nparienta...?"

msgctxt "dialogue/137/0x3"
msgid "dialogue/137/0x3"
msgstr "Vecino\nÚltimamente, con tanto\nladrón y demás, esto se ha\nvuelto muy agitado."

msgctxt "dialogue/138/0x3"
msgid "dialogue/138/0x3"
msgstr "Vecino\nEsto es Rock Colony. Un\npueblo de campo sin nada."

msgctxt "dialogue/139/0x3"
msgid "dialogue/139/0x3"
msgstr "Niño\nDicen que aún es peligroso\njugar fuera...\nQué aburrido..."

msgctxt "dialogue/140/0x3"
msgid "dialogue/140/0x3"
msgstr "Vecino\nMe preocupan los ladrones,\npero ojalá la guerra\ntermine pronto..."

msgctxt "dialogue/141/0xc"
msgid "dialogue/141/0xc"
msgstr "Rosso\nConque sois vosotros...\nTal como dijo esa mujer."

msgctxt "dialogue/141/0x4c"
msgid "dialogue/141/0x4c"
msgstr "Van\n¡Llegas tarde, Irvine!"

msgctxt "dialogue/141/0x7c"
msgid "dialogue/141/0x7c"
msgstr "Irvine\nLa estrella siempre sale\nal final."

msgctxt "dialogue/141/0xb6"
msgid "dialogue/141/0xb6"
msgstr "Rosso\n¡¡Déjate de palabrería!!"

msgctxt "dialogue/141/0xda"
msgid "dialogue/141/0xda"
msgstr "Rosso\nPero me habéis ahorrado\ntrabajo al traer hasta\naquí al organoide."

msgctxt "dialogue/141/0x127"
msgid "dialogue/141/0x127"
msgstr "Rosso\nSi le ofrezco el organoide\na esa persona,"

msgctxt "dialogue/141/0x166"
msgid "dialogue/141/0x166"
msgstr "Rosso\npodré volver otra vez\nal ejército..."

msgctxt "dialogue/141/0x1a5"
msgid "dialogue/141/0x1a5"
msgstr "Rosso\n¡Vamos, Viola!"

msgctxt "dialogue/141/0x1d3"
msgid "dialogue/141/0x1d3"
msgstr "Viola\n¡Sí!"

msgctxt "dialogue/141/0x1f9"
msgid "dialogue/141/0x1f9"
msgstr "Van\n¡No os entregaré a Zeke!\n¡Y vais a devolverme\na Fiona!"

msgctxt "dialogue/141/0x252"
msgid "dialogue/141/0x252"
msgstr "Rosso\n¿Fiona?"

msgctxt "dialogue/141/0x27a"
msgid "dialogue/141/0x27a"
msgstr "Van\n¡No te hagas el tonto!\n¡¡Vamos, Zeke!!"

msgctxt "dialogue/141/0x2b3"
msgid "dialogue/141/0x2b3"
msgstr "Jack\n¡Van! ¡Únete a nuestra\nformación y lucha como\nes debido, por favor!"

msgctxt "dialogue/141/0x303"
msgid "dialogue/141/0x303"
msgstr "¡Van se une al grupo!"

msgctxt "dialogue/142/0xc"
msgid "dialogue/142/0xc"
msgstr "Rosso\n¡¿Qué?!"

msgctxt "dialogue/142/0x20"
msgid "dialogue/142/0x20"
msgstr "Rosso\n¡¿Cómo han podido perforar\nel blindaje de este\nRed Horn?!"

msgctxt "dialogue/142/0x6f"
msgid "dialogue/142/0x6f"
msgstr "Viola\n¡Rosso!"

msgctxt "dialogue/142/0x97"
msgid "dialogue/142/0x97"
msgstr "Van\n¡Venga!\n¡¿Dónde está Fiona?!"

msgctxt "dialogue/142/0xc9"
msgid "dialogue/142/0xc9"
msgstr "Rosso\n¿Fiona? ¡¿De qué hablas?!"

msgctxt "dialogue/142/0xf9"
msgid "dialogue/142/0xf9"
msgstr "Irvine\nNo te hagas el tonto.\nTe la llevaste en el\nRedler, ¿no?"

msgctxt "dialogue/142/0x14a"
msgid "dialogue/142/0x14a"
msgstr "Viola\n¿El Redler?"

msgctxt "dialogue/142/0x176"
msgid "dialogue/142/0x176"
msgstr "Irvine\nEs vuestro Redler, ¿no?\nY también el que atacó\nRock Colony."

msgctxt "dialogue/142/0x1c5"
msgid "dialogue/142/0x1c5"
msgstr "Rosso\n......"

msgctxt "dialogue/142/0x1eb"
msgid "dialogue/142/0x1eb"
msgstr "Viola\n......"

msgctxt "dialogue/142/0x215"
msgid "dialogue/142/0x215"
msgstr "Moonbay\n¿No es tu Redler?"

msgctxt "dialogue/142/0x24d"
msgid "dialogue/142/0x24d"
msgstr "Viola\nEso es......"

msgctxt "dialogue/142/0x27d"
msgid "dialogue/142/0x27d"
msgstr "Rosso\nNo es el Redler de Viola."

msgctxt "dialogue/142/0x2b3"
msgid "dialogue/142/0x2b3"
msgstr "Irvine\nEntonces, ¿de quién es?"

msgctxt "dialogue/142/0x2ed"
msgid "dialogue/142/0x2ed"
msgstr "Rosso\nDe una mujer llamada Fran."

msgctxt "dialogue/142/0x314"
msgid "dialogue/142/0x314"
msgstr "{name}/Regina/Jack/Arth\n¡!"

msgctxt "dialogue/142/0x347"
msgid "dialogue/142/0x347"
msgstr "Viola\n¡Rosso!"

msgctxt "dialogue/142/0x36f"
msgid "dialogue/142/0x36f"
msgstr "Rosso\nDa igual. Hemos perdido.\nLa culpa es mía por\ncreerme las palabras\nde esa mujer."

msgctxt "dialogue/142/0x3c6"
msgid "dialogue/142/0x3c6"
msgstr "Viola\n...Rosso."

msgctxt "dialogue/142/0x3f0"
msgid "dialogue/142/0x3f0"
msgstr "Jack\n¿Qué quiere decir?"

msgctxt "dialogue/142/0x41e"
msgid "dialogue/142/0x41e"
msgstr "Rosso\nSolo nos interesaba\nese organoide."

msgctxt "dialogue/142/0x45b"
msgid "dialogue/142/0x45b"
msgstr "Rosso\nEsa tal Fran dijo que\ntraería al organoide, y\npor eso colaboramos..."

msgctxt "dialogue/142/0x4ae"
msgid "dialogue/142/0x4ae"
msgstr "Rosso\nDe esa mocosa llamada\nFiona no sé nada."

msgctxt "dialogue/142/0x4f7"
msgid "dialogue/142/0x4f7"
msgstr "Van\n¡¿Cómo voy a creerme eso?!"

msgctxt "dialogue/142/0x527"
msgid "dialogue/142/0x527"
msgstr "Rosso\nCreerlo o no es cosa\nvuestra. Esa mujer nos\nha utilizado."

msgctxt "dialogue/142/0x574"
msgid "dialogue/142/0x574"
msgstr "Rosso\nSeguramente quería usarnos\npara reteneros aquí."

msgctxt "dialogue/142/0x5c9"
msgid "dialogue/142/0x5c9"
msgstr "Jack\n¿Y nosotros caímos en la\ntrampa y hemos perdido\nel tiempo aquí?"

msgctxt "dialogue/142/0x628"
msgid "dialogue/142/0x628"
msgstr "Irvine\nNo me fío."

msgctxt "dialogue/142/0x654"
msgid "dialogue/142/0x654"
msgstr "Arth\nEn Fran no me extrañaría."

msgctxt "dialogue/142/0x684"
msgid "dialogue/142/0x684"
msgstr "Jack\nPríncipe, ¿qué opina?"

msgctxt "dialogue/142/0x6b6"
msgid "dialogue/142/0x6b6"
msgstr "{name}\n......"

msgctxt "dialogue/142/0x6d7"
msgid "dialogue/142/0x6d7"
msgstr "Jack\nEntonces, ¿sabe usted\nadónde han ido Fran\ny la señorita Fiona?"

msgctxt "dialogue/142/0x72e"
msgid "dialogue/142/0x72e"
msgstr "Rosso\n......"

msgctxt "dialogue/142/0x754"
msgid "dialogue/142/0x754"
msgstr "Viola\n......"

msgctxt "dialogue/142/0x77e"
msgid "dialogue/142/0x77e"
msgstr "Viola\n...Seguramente a Red\nRiver, al oeste. En el\nlado imperial, pasado\nel Fire Bridge."

msgctxt "dialogue/142/0x7e9"
msgid "dialogue/142/0x7e9"
msgstr "Van\n¿El Fire Bridge?\nLo derribamos nosotros\nen la última batalla."

msgctxt "dialogue/142/0x82c"
msgid "dialogue/142/0x82c"
msgstr "Van\n¡¿Y ahora qué hacemos?!"

msgctxt "dialogue/142/0x858"
msgid "dialogue/142/0x858"
msgstr "Rosso\n...En algún punto de Red\nRiver debería haber una\ncueva para rodearlo."

msgctxt "dialogue/142/0x8a9"
msgid "dialogue/142/0x8a9"
msgstr "Moonbay\n¿Y dónde está esa cueva?"

msgctxt "dialogue/142/0x8df"
msgid "dialogue/142/0x8df"
msgstr "Rosso\nHmpf, no tengo por qué\ncontaros tanto.\nBuscadla vosotros."

msgctxt "dialogue/142/0x92e"
msgid "dialogue/142/0x92e"
msgstr "Van\n¡Si es así, en marcha!\n¡Espérame, Fiona!"

msgctxt "dialogue/142/0x971"
msgid "dialogue/142/0x971"
msgstr "Van\nIrvine, Moonbay...\ny, eh, no sé quiénes\nsois, ¡pero deprisa!"

msgctxt "dialogue/143/0xc"
msgid "dialogue/143/0xc"
msgstr "Irvine\n¡Eh, te he dicho que no\nvayas solo! ¡Escucha a los\ndemás de una vez!"

msgctxt "dialogue/143/0x5b"
msgid "dialogue/143/0x5b"
msgstr "Moonbay\n¡Eh! ¡Espérate, Van!"

msgctxt "dialogue/144/0xc"
msgid "dialogue/144/0xc"
msgstr "Rosso\nJe, je, je... Nos han dado\nuna paliza en toda regla."

msgctxt "dialogue/144/0x3e"
msgid "dialogue/144/0x3e"
msgstr "Viola\n......"

msgctxt "dialogue/144/0x68"
msgid "dialogue/144/0x68"
msgstr "Rosso\nEn fin, nosotros también\nnos largamos."

msgctxt "dialogue/144/0x9c"
msgid "dialogue/144/0x9c"
msgstr "Viola\n¿Rosso?"

msgctxt "dialogue/144/0xc2"
msgid "dialogue/144/0xc2"
msgstr "Rosso\nConociendo a esa mujer,\nno solo habrá movido ficha\nen el pueblo: también en\nel Imperio y la República."

msgctxt "dialogue/144/0x11b"
msgid "dialogue/144/0x11b"
msgstr "Rosso\nAhora somos una banda\nde ladrones también para\nel Imperio."

msgctxt "dialogue/144/0x168"
msgid "dialogue/144/0x168"
msgstr "Viola\n¡No puede ser!"

msgctxt "dialogue/144/0x190"
msgid "dialogue/144/0x190"
msgstr "Rosso\n¡Pero no pienso dejar que\nesa mujer se salga con\nla suya así como así!"

msgctxt "dialogue/144/0x1c9"
msgid "dialogue/144/0x1c9"
msgstr "Rosso\n¡Vamos, Viola!"

msgctxt "dialogue/145/0x3"
msgid "dialogue/145/0x3"
msgstr "Vecino\nYa han acabado con los\nladrones. Por fin algo\nde tranquilidad."

msgctxt "dialogue/146/0x3"
msgid "dialogue/146/0x3"
msgstr "Vecino\n¡Bueno, ya no quedan\nladrones, así que a\nreabrir el negocio!"

msgctxt "dialogue/147/0x3"
msgid "dialogue/147/0x3"
msgstr "Vecino\nAcabar con los ladrones...\n¡Qué gente más valiente!"

msgctxt "dialogue/148/0x3"
msgid "dialogue/148/0x3"
msgstr "Piloto de Zoids\n¿Ya han acabado con los\nladrones...? Y yo que\nquería la recompensa..."

msgctxt "dialogue/149/0x3"
msgid "dialogue/149/0x3"
msgstr "Vecino\nAunque hayan acabado con\nlos ladrones, la guerra\nno terminará, ¿verdad?\nOjalá acabe antes de que\nmi nieto se haga mayor..."

msgctxt "dialogue/150/0x3"
msgid "dialogue/150/0x3"
msgstr "Vecino\nAunque no haya ladrones,\nla guerra nos matará\nigual. Entonces prefiero\nmorir en mi tierra..."

msgctxt "dialogue/151/0x3"
msgid "dialogue/151/0x3"
msgstr "Vecino\n¡Los hombres, a la hora de\nla verdad, no sirven para\nnada! ¡¡Está claro, el\nfuturo es de las mujeres!!"

msgctxt "dialogue/152/0xc"
msgid "dialogue/152/0xc"
msgstr "Van\n¡¿Raven?!\n¡¿Qué haces tú aquí?!"

msgctxt "dialogue/152/0x45"
msgid "dialogue/152/0x45"
msgstr "Van\n¡¿No ibas con el ejército\nimperial?! ¿O es que\nquieres luchar conmigo\notra vez?"

msgctxt "dialogue/152/0x92"
msgid "dialogue/152/0x92"
msgstr "Van\n¡¡Esta vez no será como\nla anterior!!"

msgctxt "dialogue/152/0xcd"
msgid "dialogue/152/0xcd"
msgstr "Raven\nPara hablar sigues siendo\nun experto, Van."

msgctxt "dialogue/152/0xff"
msgid "dialogue/152/0xff"
msgstr "Raven\nEres una basura que no\nsabe manejar un Zoid sin\nsu organoide..."

msgctxt "dialogue/152/0x156"
msgid "dialogue/152/0x156"
msgstr "Raven\n¿Quieres que te derrote\nigual que la otra vez?"

msgctxt "dialogue/152/0x194"
msgid "dialogue/152/0x194"
msgstr "Van\n¡¿Qué has dicho?!"

msgctxt "dialogue/152/0x1b4"
msgid "dialogue/152/0x1b4"
msgstr "Raven\nManejas mal los Zoids,\ny luchas todavía peor."

msgctxt "dialogue/152/0x1f7"
msgid "dialogue/152/0x1f7"
msgstr "Raven\nTe enseñaré cómo se lucha\nde verdad con un Zoid."

msgctxt "dialogue/153/0xc"
msgid "dialogue/153/0xc"
msgstr "Raven\nJe. Ha sido bastante\ndivertido."

msgctxt "dialogue/153/0x32"
msgid "dialogue/153/0x32"
msgstr "Raven\nPero parece que esta\nbatalla la ha preparado\nesa mujer..."

msgctxt "dialogue/153/0x85"
msgid "dialogue/153/0x85"
msgstr "Van\n¡¿Qué has dicho?!"

msgctxt "dialogue/153/0xa7"
msgid "dialogue/153/0xa7"
msgstr "Raven\nY eso no me gusta...\nPor hoy me retiro..."

msgctxt "dialogue/154/0xc"
msgid "dialogue/154/0xc"
msgstr "Regina\n...¿Hemos ganado?"

msgctxt "dialogue/154/0x38"
msgid "dialogue/154/0x38"
msgstr "Irvine\n...No puede ser. Ni\nsiquiera se ha fusionado\ncon el organoide."

msgctxt "dialogue/154/0x8b"
msgid "dialogue/154/0x8b"
msgstr "Moonbay\n¿Quieres decir que nos\nha dejado escapar?"

msgctxt "dialogue/154/0xc1"
msgid "dialogue/154/0xc1"
msgstr "Van\n¡Maldita sea!"

msgctxt "dialogue/154/0xd8"
msgid "dialogue/154/0xd8"
msgstr "Voz de niña\n¡¡Vaaan!!"

msgctxt "dialogue/154/0x102"
msgid "dialogue/154/0x102"
msgstr "Van\n¡Fiona!"

msgctxt "dialogue/155/0xc"
msgid "dialogue/155/0xc"
msgstr "Van\n¡¿Estás bien, Fiona?!\n¿Te has hecho daño?"

msgctxt "dialogue/155/0x40"
msgid "dialogue/155/0x40"
msgstr "Fiona\nNo, estoy bien."

msgctxt "dialogue/155/0x68"
msgid "dialogue/155/0x68"
msgstr "Moonbay\nAy, esta niña, qué susto\nnos ha dado."

msgctxt "dialogue/155/0x9e"
msgid "dialogue/155/0x9e"
msgstr "Van\nPor cierto, ¿adónde ha ido\nla mujer que se llevó\na Fiona?"

msgctxt "dialogue/155/0xed"
msgid "dialogue/155/0xed"
msgstr "Fiona\n¿? No lo sé."

msgctxt "dialogue/155/0x115"
msgid "dialogue/155/0x115"
msgstr "Regina\n¿Qué significa esto?\n¿Ha huido?"

msgctxt "dialogue/155/0x147"
msgid "dialogue/155/0x147"
msgstr "Jack\n...¿Qué opinas, Arth?"

msgctxt "dialogue/155/0x181"
msgid "dialogue/155/0x181"
msgstr "Arth\nNo lo sé.\nPero esto no ha acabado."

msgctxt "dialogue/155/0x1c4"
msgid "dialogue/155/0x1c4"
msgstr "Regina\n...Ya."

msgctxt "dialogue/155/0x1ec"
msgid "dialogue/155/0x1ec"
msgstr "Jack\n......"

msgctxt "dialogue/155/0x214"
msgid "dialogue/155/0x214"
msgstr "{name}\n......"

msgctxt "dialogue/155/0x235"
msgid "dialogue/155/0x235"
msgstr "Moonbay\nBueno, no es un sitio\npara quedarse mucho.\nVámonos de aquí."

msgctxt "dialogue/155/0x28e"
msgid "dialogue/155/0x28e"
msgstr "Irvine\nSí, con el jaleo de antes\npuede que aparezca el\nejército imperial."

msgctxt "dialogue/156/0xc"
msgid "dialogue/156/0xc"
msgstr "Van\nGracias, nos habéis\nsalvado."

msgctxt "dialogue/156/0x3a"
msgid "dialogue/156/0x3a"
msgstr "Moonbay\nY vosotros, ¿qué vais\na hacer ahora?"

msgctxt "dialogue/156/0x76"
msgid "dialogue/156/0x76"
msgstr "Jack\n...Investigaremos un poco\nmás por esta zona."

msgctxt "dialogue/156/0xb8"
msgid "dialogue/156/0xb8"
msgstr "Moonbay\n...Ya veo."

msgctxt "dialogue/156/0xde"
msgid "dialogue/156/0xde"
msgstr "Irvine\nNo os paséis de la raya."

msgctxt "dialogue/157/0xc"
msgid "dialogue/157/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/157/0x2d"
msgid "dialogue/157/0x2d"
msgstr "Regina\n¡Príncipe!"

msgctxt "dialogue/157/0x51"
msgid "dialogue/157/0x51"
msgstr "Arth\n...¡Fran!"

msgctxt "dialogue/157/0x79"
msgid "dialogue/157/0x79"
msgstr "Jack\nComo pensaba, estaba\nescondida..."

msgctxt "dialogue/157/0xb3"
msgid "dialogue/157/0xb3"
msgstr "Fran\n...Así que lo sabíais."

msgctxt "dialogue/157/0xe7"
msgid "dialogue/157/0xe7"
msgstr "Jack\nNo. Todavía no sabemos\ncuál es su objetivo."

msgctxt "dialogue/157/0x129"
msgid "dialogue/157/0x129"
msgstr "Fran\nEs evidente. Enfrentar al\nShield Liger con el\nSaber Tiger."

msgctxt "dialogue/157/0x170"
msgid "dialogue/157/0x170"
msgstr "Fran\nSi caían los dos, bien. Y\nsi quedaba uno, no saldría\nsin daños."

msgctxt "dialogue/157/0x1c5"
msgid "dialogue/157/0x1c5"
msgstr "Fran\nCapturarlo entonces\nsería muy fácil."

msgctxt "dialogue/157/0x1f7"
msgid "dialogue/157/0x1f7"
msgstr "Fran\nTraer aquí a Raven me\ncostó bastante, ¿sabes?"

msgctxt "dialogue/157/0x242"
msgid "dialogue/157/0x242"
msgstr "Jack\nNo me refiero a eso. ¿Por\nqué no huyó cuando el\nplan fracasó?"

msgctxt "dialogue/157/0x2a1"
msgid "dialogue/157/0x2a1"
msgstr "Jack\n¿No había ninguna\nnecesidad de presentarse\nante nosotros, verdad?"

msgctxt "dialogue/157/0x2ee"
msgid "dialogue/157/0x2ee"
msgstr "Fran\nPues porque...\nje, je, je..."

msgctxt "dialogue/157/0x324"
msgid "dialogue/157/0x324"
msgstr "Fran\n¡¡Porque estás tú aquí!!\n¡¡¡Arth!!!"

msgctxt "dialogue/157/0x363"
msgid "dialogue/157/0x363"
msgstr "Regina\n¡¿Eh?!"

msgctxt "dialogue/157/0x385"
msgid "dialogue/157/0x385"
msgstr "{name}\n......"

msgctxt "dialogue/157/0x3a6"
msgid "dialogue/157/0x3a6"
msgstr "Jack\nAsí que... era eso."

msgctxt "dialogue/157/0x3d4"
msgid "dialogue/157/0x3d4"
msgstr "Arth\n......"

msgctxt "dialogue/157/0x3fa"
msgid "dialogue/157/0x3fa"
msgstr "Fran\n¡Nos traicionaste!\n¡Y eso que él era tu\nmejor amigo...!"

msgctxt "dialogue/157/0x455"
msgid "dialogue/157/0x455"
msgstr "Fran\nY él... para mí...\n¡¡él era para mí...!!"

msgctxt "dialogue/157/0x4a0"
msgid "dialogue/157/0x4a0"
msgstr "Fran\n¡Y aun así, ¿por qué...?!\n¡¡¿Por qué lo dejaste\nmorir?!!"

msgctxt "dialogue/157/0x4ed"
msgid "dialogue/157/0x4ed"
msgstr "Regina\n¡!"

msgctxt "dialogue/157/0x50b"
msgid "dialogue/157/0x50b"
msgstr "{name}\n......"

msgctxt "dialogue/157/0x52c"
msgid "dialogue/157/0x52c"
msgstr "Arth\n...¿Eso es todo lo que\ntienes que decir?"

msgctxt "dialogue/157/0x566"
msgid "dialogue/157/0x566"
msgstr "Fran\n...¿Qué?"

msgctxt "dialogue/157/0x58a"
msgid "dialogue/157/0x58a"
msgstr "Arth\nTe pregunto si eso es\ntodo lo que tienes\nque decir."

msgctxt "dialogue/157/0x5c8"
msgid "dialogue/157/0x5c8"
msgstr "Fran\n¡¡Te haré lamentar\nhaberlo matado!!"

msgctxt "dialogue/158/0xc"
msgid "dialogue/158/0xc"
msgstr "Fran\n¡¿Por qué?! ¡¿Por qué no\npuedo vencerle?!\n¡Acuérdate de esto!\n¡¡Arth...!!"

msgctxt "dialogue/159/0xc"
msgid "dialogue/159/0xc"
msgstr "Arth\n...Me acuerdo. Aunque\nviva mil años, no podría\nolvidarlo..."

msgctxt "dialogue/159/0x69"
msgid "dialogue/159/0x69"
msgstr "Regina\n¿Arth?"

msgctxt "dialogue/159/0x8d"
msgid "dialogue/159/0x8d"
msgstr "{name}\n......"

msgctxt "dialogue/159/0xae"
msgid "dialogue/159/0xae"
msgstr "Arth\n...Lo siento, príncipe.\n...Algún día... se lo\ncontaré."

msgctxt "dialogue/159/0xf9"
msgid "dialogue/159/0xf9"
msgstr "{name}\n......"

msgctxt "dialogue/159/0x11a"
msgid "dialogue/159/0x11a"
msgstr "Jack\n...Volvamos.\nA Arcadia..."

msgctxt "dialogue/160/0xc"
msgid "dialogue/160/0xc"
msgstr "Emperador\n¿Que {name} y los suyos\nsiguieron a Fran con el\ntransportador de las\nruinas?"

msgctxt "dialogue/160/0x58"
msgid "dialogue/160/0x58"
msgstr "Blood\n¡Sí, Majestad!\nLo lamento mucho."

msgctxt "dialogue/160/0x8c"
msgid "dialogue/160/0x8c"
msgstr "Emperador\nQuién iba a pensar que el\ntransportador de las\nruinas funcionaría..."

msgctxt "dialogue/160/0xc4"
msgid "dialogue/160/0xc4"
msgstr "Blood\n......"

msgctxt "dialogue/160/0xec"
msgid "dialogue/160/0xec"
msgstr "Emperador\nEn fin, no importa.\nDestruid las ruinas. No\nnecesito dos\ntransportadores."

msgctxt "dialogue/160/0x137"
msgid "dialogue/160/0x137"
msgstr "Blood\n¡! Pero si por casualidad\nel transportador del\ncastillo se averiase..."

msgctxt "dialogue/160/0x184"
msgid "dialogue/160/0x184"
msgstr "Emperador\n¿Pretendes que conserve el\ntransportador de las\nruinas?"

msgctxt "dialogue/160/0x1ae"
msgid "dialogue/160/0x1ae"
msgstr "Emperador\nBasta con una sola baza.\nY esa baza la tengo yo."

msgctxt "dialogue/160/0x1f7"
msgid "dialogue/160/0x1f7"
msgstr "Blood\n¡Sí, Majestad!"

msgctxt "dialogue/161/0xc"
msgid "dialogue/161/0xc"
msgstr "Gale\nHa llegado un informe\nde Fran."

msgctxt "dialogue/161/0x40"
msgid "dialogue/161/0x40"
msgstr "Emperador\n¿Mm?"

msgctxt "dialogue/161/0x5a"
msgid "dialogue/161/0x5a"
msgstr "Gale\nDice que ha fracasado la\ncaptura del Shield Liger,\nel Saber Tiger y el\norganoide."

msgctxt "dialogue/161/0xbd"
msgid "dialogue/161/0xbd"
msgstr "Emperador\n...Ya veo. Creía que esa\nmujer sería más útil..."

msgctxt "dialogue/161/0xfc"
msgid "dialogue/161/0xfc"
msgstr "Emperador\nDecidle a Fran que\ndestruya el transportador\nde las ruinas."

msgctxt "dialogue/161/0x141"
msgid "dialogue/161/0x141"
msgstr "Gale\n¡Sí, Majestad!"

msgctxt "dialogue/162/0xc"
msgid "dialogue/162/0xc"
msgstr "Emperador\nEncerraré a {name} y a\nlos suyos más allá del\ntiempo... ¡Fuajajajaja!"

msgctxt "dialogue/162/0x5e"
msgid "dialogue/162/0x5e"
msgstr "Blood\n......"

msgctxt "dialogue/163/0xc"
msgid "dialogue/163/0xc"
msgstr "Fran\n¿Que destruya el\ntransportador? ¿Lo dices\nen serio, Gale?"

msgctxt "dialogue/163/0x46"
msgid "dialogue/163/0x46"
msgstr "Gale\nSu Majestad ordena que\nencerremos al príncipe y\na los suyos más allá del\ntiempo."

msgctxt "dialogue/163/0x91"
msgid "dialogue/163/0x91"
msgstr "Fran\n...¡Ugh! ¡Entendido!"

msgctxt "dialogue/163/0xbf"
msgid "dialogue/163/0xbf"
msgstr "Fran\n¡¡Arth!!"

msgctxt "dialogue/164/0xc"
msgid "dialogue/164/0xc"
msgstr "Regina\n¡Eh! Qué raro...\nLa puerta empieza a\nvolverse inestable."

msgctxt "dialogue/164/0x5f"
msgid "dialogue/164/0x5f"
msgstr "{name}\n¡!"

msgctxt "dialogue/164/0x76"
msgid "dialogue/164/0x76"
msgstr "Arth\nNo puede ser... ¡Fran!"

msgctxt "dialogue/164/0xa6"
msgid "dialogue/164/0xa6"
msgstr "Jack\n¡Démonos prisa, príncipe!"

msgctxt "dialogue/165/0xc"
msgid "dialogue/165/0xc"
msgstr "Fran\n...¡Arth!\n¡Seré yo quien acabe\ncontigo con mis manos...!"

msgctxt "dialogue/165/0x57"
msgid "dialogue/165/0x57"
msgstr "Fran\nPero si destruyo\neste aparato..."

msgctxt "dialogue/165/0x9a"
msgid "dialogue/165/0x9a"
msgstr "Fran\n¡¡Ya no podré vengarme\nde ti...!!"

msgctxt "dialogue/165/0xe3"
msgid "dialogue/165/0xe3"
msgstr "Fran\n¿¡Te parece bien eso,\nFran!?"

msgctxt "dialogue/166/0xc"
msgid "dialogue/166/0xc"
msgstr "Fran\n¡! ¡¿Quién anda ahí?!"

msgctxt "dialogue/166/0x2b"
msgid "dialogue/166/0x2b"
msgstr "Soldado del Reino\n¡Somos el ejército del\nReino de Arcadia!\n¡Hemos tomado las ruinas!"

msgctxt "dialogue/166/0x7d"
msgid "dialogue/166/0x7d"
msgstr "Soldado del Reino\n¡Apártate de ese\ntransportador!"

msgctxt "dialogue/166/0xbd"
msgid "dialogue/166/0xbd"
msgstr "Fran\n...El ejército del Reino.\nLlegan antes de lo que\nesperaba."

msgctxt "dialogue/166/0xe9"
msgid "dialogue/166/0xe9"
msgstr "Fran\n¿Alguien se contuvo al\naplastar al ejército del\nReino...?"

msgctxt "dialogue/166/0x132"
msgid "dialogue/166/0x132"
msgstr "Fran\n...Je, je, je. Muy bien.\nNo sé quién será, pero\nle seguiré el juego."

msgctxt "dialogue/166/0x181"
msgid "dialogue/166/0x181"
msgstr "Fran\n¡Arth! ¡Si así puedo\nacabar contigo, le venderé\nmi alma al diablo...!"

msgctxt "dialogue/167/0xc"
msgid "dialogue/167/0xc"
msgstr "Arth\n...¡!"

msgctxt "dialogue/167/0x2e"
msgid "dialogue/167/0x2e"
msgstr "Regina\n¿Qué significa esto?"

msgctxt "dialogue/167/0x4f"
msgid "dialogue/167/0x4f"
msgstr "Soldado del Reino\n¡Bienvenido de vuelta,\npríncipe! ¡¡Y también\nlos Tres Guerreros!!"

msgctxt "dialogue/167/0xa2"
msgid "dialogue/167/0xa2"
msgstr "Jack\n¿Y ustedes son...?"

msgctxt "dialogue/167/0xc3"
msgid "dialogue/167/0xc3"
msgstr "Soldado del Reino\nSomos del ejército de\nArcadia. Escapamos de las\npurgas en aquel caos y al\nfin nos hemos reagrupado."

msgctxt "dialogue/167/0x12a"
msgid "dialogue/167/0x12a"
msgstr "Soldado del Reino\nSupimos que iba a las\nruinas y hemos venido\nen su ayuda, príncipe."

msgctxt "dialogue/167/0x189"
msgid "dialogue/167/0x189"
msgstr "Soldado del Reino\nPero ha ido de un pelo.\nUn soldado enemigo iba a\ndestruir el transportador\ny lo paramos a tiempo..."

msgctxt "dialogue/167/0x1fc"
msgid "dialogue/167/0x1fc"
msgstr "Regina\nUn momento. ¿Y entonces\nestas ruinas?"

msgctxt "dialogue/167/0x231"
msgid "dialogue/167/0x231"
msgstr "Soldado del Reino\nSí, las hemos tomado\nnosotros."

msgctxt "dialogue/167/0x267"
msgid "dialogue/167/0x267"
msgstr "{name}\n......"

msgctxt "dialogue/167/0x27f"
msgid "dialogue/167/0x27f"
msgstr "Soldado del Reino\n¡Príncipe, sus órdenes!"

msgctxt "dialogue/167/0x2af"
msgid "dialogue/167/0x2af"
msgstr "{name}\n......"

msgctxt "dialogue/167/0x2d0"
msgid "dialogue/167/0x2d0"
msgstr "Jack\nPríncipe..."

msgctxt "dialogue/167/0x2f6"
msgid "dialogue/167/0x2f6"
msgstr "Arth\n......"

msgctxt "dialogue/167/0x31c"
msgid "dialogue/167/0x31c"
msgstr "Regina\n{name}... ¡Ánimo!"

msgctxt "dialogue/167/0x34b"
msgid "dialogue/167/0x34b"
msgstr "{name}\n......"

msgctxt "dialogue/167/0x363"
msgid "dialogue/167/0x363"
msgstr "Soldado del Reino\n¡Viva el príncipe\n{name}!"

msgctxt "dialogue/168/0xc"
msgid "dialogue/168/0xc"
msgstr "Emperador\n¿Que has fracasado en\ndestruir el transportador\nde las ruinas?"

msgctxt "dialogue/168/0x4c"
msgid "dialogue/168/0x4c"
msgstr "Fran\n...Sí, señor.\nLo lamento mucho..."

msgctxt "dialogue/168/0x8b"
msgid "dialogue/168/0x8b"
msgstr "Emperador\n¡Y encima dejas que los\nsupervivientes de Arcadia\nocupen las ruinas...!"

msgctxt "dialogue/168/0xe2"
msgid "dialogue/168/0xe2"
msgstr "Fran\n......"

msgctxt "dialogue/168/0x108"
msgid "dialogue/168/0x108"
msgstr "Emperador\n¡¡Necia!!\n¡¡¡Fuera de mi vista!!!"

msgctxt "dialogue/169/0xc"
msgid "dialogue/169/0xc"
msgstr "Emperador\n¡Malditos sean...!\n¡No son más que unos\ninútiles!"

msgctxt "dialogue/170/0xc"
msgid "dialogue/170/0xc"
msgstr "Opis\nVaya, vaya, Majestad.\nVeo que hoy está usted\nde muy buen humor..."

msgctxt "dialogue/170/0x61"
msgid "dialogue/170/0x61"
msgstr "Emperador\nHmpf. ¿Es una pulla,\nOpis?"

msgctxt "dialogue/170/0x91"
msgid "dialogue/170/0x91"
msgstr "Opis\nJe, je, je, en absoluto."

msgctxt "dialogue/170/0xc1"
msgid "dialogue/170/0xc1"
msgstr "Opis\nSolo le traigo noticias\nque mejorarán su humor,\nMajestad."

msgctxt "dialogue/170/0x11a"
msgid "dialogue/170/0x11a"
msgstr "Emperador\n¿Está terminado?\n¿El amplificador de\nRare Hertz?"

msgctxt "dialogue/170/0x161"
msgid "dialogue/170/0x161"
msgstr "Opis\nSolo falta probarlo en\ncombate."

msgctxt "dialogue/170/0x191"
msgid "dialogue/170/0x191"
msgstr "Blood\nEntonces, yo..."

msgctxt "dialogue/170/0x1b9"
msgid "dialogue/170/0x1b9"
msgstr "Opis\n¡Qué dices! ¡Lo he creado\nyo! ¡Yo dirigiré la\noperación!"

msgctxt "dialogue/170/0x20e"
msgid "dialogue/170/0x20e"
msgstr "Opis\n¡No pienso cederle a otro\nalgo tan divertido!"

msgctxt "dialogue/170/0x24e"
msgid "dialogue/170/0x24e"
msgstr "Blood\nCon el debido respeto,\ndoctor, el mando táctico\nno es su especialidad."

msgctxt "dialogue/170/0x299"
msgid "dialogue/170/0x299"
msgstr "Opis\nJe, je, je, ¿qué estás\ntramando, Blood?"

msgctxt "dialogue/170/0x2dd"
msgid "dialogue/170/0x2dd"
msgstr "Blood\n......"

msgctxt "dialogue/170/0x305"
msgid "dialogue/170/0x305"
msgstr "Emperador\n¡Basta!\nOpis dirigirá esta\noperación."

msgctxt "dialogue/170/0x348"
msgid "dialogue/170/0x348"
msgstr "Opis\nJe, je, je, como debe ser."

msgctxt "dialogue/170/0x376"
msgid "dialogue/170/0x376"
msgstr "Emperador\nBlood y Gale, reforzad\nlas defensas del castillo\npor si ataca el Reino."

msgctxt "dialogue/170/0x3b6"
msgid "dialogue/170/0x3b6"
msgstr "Blood y Gale\n¡Sí, señor!"

msgctxt "dialogue/171/0xc"
msgid "dialogue/171/0xc"
msgstr "Opis\nCon el amplificador de\nRare Hertz, hasta el Zoid\nmás poderoso caerá en un\ninstante..."

msgctxt "dialogue/171/0x6f"
msgid "dialogue/171/0x6f"
msgstr "Emperador\nCuento contigo, Opis."

msgctxt "dialogue/171/0x9f"
msgid "dialogue/171/0x9f"
msgstr "Opis\nDéjelo en mis manos..."

msgctxt "dialogue/172/0xc"
msgid "dialogue/172/0xc"
msgstr "Blood\nEl ejército del Reino se\nha rehecho muy deprisa..."

msgctxt "dialogue/172/0x54"
msgid "dialogue/172/0x54"
msgstr "Gale\n......"

msgctxt "dialogue/172/0x7a"
msgid "dialogue/172/0x7a"
msgstr "Blood\nSegún los rumores..."

msgctxt "dialogue/172/0x9e"
msgid "dialogue/172/0x9e"
msgstr "Blood\nhay alguien que dejó\nescapar adrede a los\nsupervivientes de Arcadia."

msgctxt "dialogue/172/0xf9"
msgid "dialogue/172/0xf9"
msgstr "Gale\n......"

msgctxt "dialogue/172/0x11f"
msgid "dialogue/172/0x11f"
msgstr "Blood\n¿No te parece que eso es\nuna traición hacia\nnosotros?"

msgctxt "dialogue/173/0xc"
msgid "dialogue/173/0xc"
msgstr "Gale\nParece que te gustan más\nlas conspiraciones que\nla batalla."

msgctxt "dialogue/173/0x53"
msgid "dialogue/173/0x53"
msgstr "Blood\nCierto. Prefiero apuñalar\na que me apuñalen por la\nespalda."

msgctxt "dialogue/173/0xa6"
msgid "dialogue/173/0xa6"
msgstr "Gale\nEntiendo. Entonces\nprocuraré no darte nunca\nla espalda."

msgctxt "dialogue/174/0x3"
msgid "dialogue/174/0x3"
msgstr "Soldado del Reino\n...¡! ¡Vibración\nespaciotemporal! Han usado\nel transportador del\ncastillo."

msgctxt "dialogue/174/0x6a"
msgid "dialogue/174/0x6a"
msgstr "{name}\n......"

msgctxt "dialogue/174/0x8b"
msgid "dialogue/174/0x8b"
msgstr "Regina\n¿Se sabe a qué época?"

msgctxt "dialogue/174/0xb8"
msgid "dialogue/174/0xb8"
msgstr "Soldado del Reino\nEso no lo sabemos...\nPero si captamos la onda\nde la vibración, podremos\nseguirles."

msgctxt "dialogue/174/0x111"
msgid "dialogue/174/0x111"
msgstr "Regina\n¡Príncipe! Vamos tras\nellos ahora mismo."

msgctxt "dialogue/174/0x14b"
msgid "dialogue/174/0x14b"
msgstr "Jack\nEspere. No perdemos nada\npor preparar bien el\nequipo antes."

msgctxt "dialogue/175/0x3"
msgid "dialogue/175/0x3"
msgstr "Soldado del Reino 1\nParece que el enemigo\nenterró estas ruinas\nsubterráneas al retirarse."

msgctxt "dialogue/176/0x3"
msgid "dialogue/176/0x3"
msgstr "Soldado del Reino 2\nLa puerta está activa.\n¡Tengan cuidado!"

msgctxt "dialogue/177/0xc"
msgid "dialogue/177/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/177/0x2d"
msgid "dialogue/177/0x2d"
msgstr "Regina\n¿Dónde estamos...?"

msgctxt "dialogue/177/0x57"
msgid "dialogue/177/0x57"
msgstr "Jack\n...Quién sabe.\nExploremos un poco los\nalrededores."

msgctxt "dialogue/177/0x8e"
msgid "dialogue/177/0x8e"
msgstr "Jack\nSi hay algún pueblo,\nquizá podamos reunir\ninformación."

msgctxt "dialogue/177/0xd9"
msgid "dialogue/177/0xd9"
msgstr "Regina\nSí... Vamos, príncipe."

msgctxt "dialogue/178/0xc"
msgid "dialogue/178/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/178/0x2d"
msgid "dialogue/178/0x2d"
msgstr "Regina\n¿¡Q-qué pasa!?\n¡El Zoid no me obedece!"

msgctxt "dialogue/178/0x72"
msgid "dialogue/178/0x72"
msgstr "Arth\n¿¡!? ¡Rare Hertz!"

msgctxt "dialogue/178/0x9e"
msgid "dialogue/178/0x9e"
msgstr "Jack\n¡Regina!\n¡Activa el Pulse Guard!"

msgctxt "dialogue/178/0xe9"
msgid "dialogue/178/0xe9"
msgstr "Regina\nJack, ¿qué ha sido eso?"

msgctxt "dialogue/178/0x117"
msgid "dialogue/178/0x117"
msgstr "Jack\nPor lo visto, esto es una\nzona de Rare Hertz."

msgctxt "dialogue/178/0x160"
msgid "dialogue/178/0x160"
msgstr "Regina\nRare Hertz..."

msgctxt "dialogue/178/0x18c"
msgid "dialogue/178/0x18c"
msgstr "Jack\nUna misteriosa frecuencia\nque enloquece a los Zoids."

msgctxt "dialogue/178/0x1ba"
msgid "dialogue/178/0x1ba"
msgstr "Jack\nEl Pulse Guard la frena\nhasta cierto punto, pero\nno del todo."

msgctxt "dialogue/178/0x20b"
msgid "dialogue/178/0x20b"
msgstr "Jack\nEs peligroso adentrarse\nen esta región."

msgctxt "dialogue/178/0x24d"
msgid "dialogue/178/0x24d"
msgstr "Regina\n...Tienes razón.\nBusquemos otra ruta,\npríncipe."

msgctxt "dialogue/179/0xc"
msgid "dialogue/179/0xc"
msgstr "Regina\n¡Príncipe! Hemos entrado\nen la zona de Rare Hertz.\nEs peligroso. Cambiemos\nde rumbo."

msgctxt "dialogue/180/0x3"
msgid "dialogue/180/0x3"
msgstr "Vecino\n¿Qué quieres? ¡Estoy\nocupado preparando la\nhuida!"

msgctxt "dialogue/180/0x41"
msgid "dialogue/180/0x41"
msgstr "Vecino\n¡Pregúntale a otro!"

msgctxt "dialogue/181/0x3"
msgid "dialogue/181/0x3"
msgstr "Vecino\nY yo que creía que por\nfin había paz por aquí...\nOtra guerra más..."

msgctxt "dialogue/182/0x3"
msgid "dialogue/182/0x3"
msgstr "Vecino\nMás allá, en el desierto,\nestá el fuerte Kronos."

msgctxt "dialogue/182/0x3d"
msgid "dialogue/182/0x3d"
msgstr "Vecino\nAunque, si no existiera,\naquí no habría guerras..."

msgctxt "dialogue/183/0x3"
msgid "dialogue/183/0x3"
msgstr "Vecino\nEste desierto se ha\nconvertido en una zona de\nRare Hertz."

msgctxt "dialogue/183/0x3f"
msgid "dialogue/183/0x3f"
msgstr "Vecino\nAunque el Pulse Guard del\npropio Zoid la frena\nhasta cierto punto..."

msgctxt "dialogue/183/0x8a"
msgid "dialogue/183/0x8a"
msgstr "Vecino\nQuién sabe cómo estará el\nfuerte Kronos, en pleno\ndesierto."

msgctxt "dialogue/184/0x3"
msgid "dialogue/184/0x3"
msgstr "Vecino\n¿Volverá a venir el\nejército imperial?"

msgctxt "dialogue/185/0x3"
msgid "dialogue/185/0x3"
msgstr "Vecino\nHuir del pueblo, sí...\npero ¿adónde iremos...?"

msgctxt "dialogue/186/0x3"
msgid "dialogue/186/0x3"
msgstr "Vecino\n¿El ejército de la\nRepública?"

msgctxt "dialogue/186/0x1b"
msgid "dialogue/186/0x1b"
msgstr "Vecino\nDeberían estar acampados\nen la fortaleza de Mount\nOssa, al sur."

msgctxt "dialogue/187/0x3"
msgid "dialogue/187/0x3"
msgstr "Vecino\nNi el ejército imperial\npuede cruzar el desierto."

msgctxt "dialogue/187/0x37"
msgid "dialogue/187/0x37"
msgstr "Vecino\nSolo pueden vigilarse\nunos a otros fuera de la\nzona de Rare Hertz."

msgctxt "dialogue/188/0x3"
msgid "dialogue/188/0x3"
msgstr "Vecino\n¿Cruzar el desierto?\nNo es que no haya forma..."

msgctxt "dialogue/188/0x40"
msgid "dialogue/188/0x40"
msgstr "Vecino\nHay un desvío. La ruta\nque cruza las montañas\ndel este."

msgctxt "dialogue/189/0x3"
msgid "dialogue/189/0x3"
msgstr "Vecino\n¿Que adónde huiremos?\nEl desierto, ni hablar.\nEs zona de Rare Hertz."

msgctxt "dialogue/189/0x50"
msgid "dialogue/189/0x50"
msgstr "Vecino\nBordeando el desierto\nhacia el este hay un\ndesvío por las montañas."

msgctxt "dialogue/189/0x9b"
msgid "dialogue/189/0x9b"
msgstr "Vecino\nEl camino es estrecho y el\nejército no pasa por ahí:\nsería como pedir a gritos\nuna emboscada."

msgctxt "dialogue/189/0xf8"
msgid "dialogue/189/0xf8"
msgstr "Vecino\nAsí que para nosotros es\nuna ruta segura."

msgctxt "dialogue/190/0xc"
msgid "dialogue/190/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/191/0xc"
msgid "dialogue/191/0xc"
msgstr "Regina\n¿¡Enemigos!?"

msgctxt "dialogue/191/0x2e"
msgid "dialogue/191/0x2e"
msgstr "Jack\n¿¡El ejército imperial!?"

msgctxt "dialogue/191/0x54"
msgid "dialogue/191/0x54"
msgstr "Arth\n...¡!"

msgctxt "dialogue/191/0x76"
msgid "dialogue/191/0x76"
msgstr "Regina\n¿¡Qué pretendéis!?\n¡Atacarnos así, sin más!"

msgctxt "dialogue/191/0xc1"
msgid "dialogue/191/0xc1"
msgstr "Jack\nAsí que no hay nada que\nhablar, ¿eh?"

msgctxt "dialogue/191/0xf5"
msgid "dialogue/191/0xf5"
msgstr "Arth\nPues sin miramientos.\n¡Vamos!"

msgctxt "dialogue/192/0xc"
msgid "dialogue/192/0xc"
msgstr "Regina\n¿Era el último?"

msgctxt "dialogue/192/0x34"
msgid "dialogue/192/0x34"
msgstr "Jack\n...Eso parece.\nPero..."

msgctxt "dialogue/192/0x71"
msgid "dialogue/192/0x71"
msgstr "Regina\n¿Qué? ¿Aún hay algo más?"

msgctxt "dialogue/192/0xa3"
msgid "dialogue/192/0xa3"
msgstr "Jack\nNo es exactamente eso..."

msgctxt "dialogue/192/0xe1"
msgid "dialogue/192/0xe1"
msgstr "Arth\nNo tenían táctica."

msgctxt "dialogue/192/0x105"
msgid "dialogue/192/0x105"
msgstr "Regina\n¡Explicadlo como es\ndebido!"

msgctxt "dialogue/192/0x137"
msgid "dialogue/192/0x137"
msgstr "Jack\nVamos, vamos. Regina, ¿tú\nno has notado nada?"

msgctxt "dialogue/192/0x17e"
msgid "dialogue/192/0x17e"
msgstr "Jack\nPues... algo extraño,\npor ejemplo."

msgctxt "dialogue/192/0x1ae"
msgid "dialogue/192/0x1ae"
msgstr "Regina\nMmm... Es verdad que no\nnoté ninguna estrategia\nni nada parecido..."

msgctxt "dialogue/192/0x211"
msgid "dialogue/192/0x211"
msgstr "Jack\nExacto."

msgctxt "dialogue/192/0x229"
msgid "dialogue/192/0x229"
msgstr "Jack\nEn un Zoid pilotado se\nnotan las manías de quien\nlo maneja."

msgctxt "dialogue/192/0x280"
msgid "dialogue/192/0x280"
msgstr "Jack\nY más aún en un Zoid del\nejército imperial."

msgctxt "dialogue/192/0x2a6"
msgid "dialogue/192/0x2a6"
msgstr "Jack\nSus pilotos tendrían que\nestar bien entrenados."

msgctxt "dialogue/192/0x2e5"
msgid "dialogue/192/0x2e5"
msgstr "Jack\nPero no se notaba nada de\neso. Y la respuesta es..."

msgctxt "dialogue/192/0x33a"
msgid "dialogue/192/0x33a"
msgstr "Regina\nZoids sin piloto...\nZoids salvajes, ¿no?"

msgctxt "dialogue/192/0x381"
msgid "dialogue/192/0x381"
msgstr "Arth\nNo. Los Zoids salvajes no\nsuelen atacar en grupo\nde esta manera."

msgctxt "dialogue/192/0x3d6"
msgid "dialogue/192/0x3d6"
msgstr "Jack\nEs decir, que alguien los\ncontrolaba..."

msgctxt "dialogue/192/0x413"
msgid "dialogue/192/0x413"
msgstr "Opis\n¡Exactamente!"

msgctxt "dialogue/193/0xc"
msgid "dialogue/193/0xc"
msgstr "Opis\nPríncipe {name},\nqueridos Tres Guerreros."

msgctxt "dialogue/193/0x3c"
msgid "dialogue/193/0x3c"
msgstr "Opis\n¿Qué os ha parecido mi\nejército de Zoids\ndesbocados?"

msgctxt "dialogue/193/0x8b"
msgid "dialogue/193/0x8b"
msgstr "Jack\n...¿Quién es usted?"

msgctxt "dialogue/193/0xb7"
msgid "dialogue/193/0xb7"
msgstr "Opis\nAl servicio del Emperador\ndel Nuevo Imperio de\nArcadia: Opis, uno de los\nCuatro Reyes."

msgctxt "dialogue/193/0xfe"
msgid "dialogue/193/0xfe"
msgstr "Opis\nUn científico que estudia\nlos Zoids. Encantado de\nconoceros."

msgctxt "dialogue/193/0x14c"
msgid "dialogue/193/0x14c"
msgstr "{name}\n......"

msgctxt "dialogue/193/0x16d"
msgid "dialogue/193/0x16d"
msgstr "Regina\n¿¡Qué Nuevo Imperio de\nArcadia!? ¡¡No te burles\nde nosotros!!"

msgctxt "dialogue/193/0x1ba"
msgid "dialogue/193/0x1ba"
msgstr "Opis\nUna jovencita chillando\ncomo un perrito, qué\nordinario. ¿Quieres que\nte modifique yo?"

msgctxt "dialogue/193/0x21f"
msgid "dialogue/193/0x21f"
msgstr "Regina\n¡!\n¿¡C-cómo dices!?"

msgctxt "dialogue/193/0x254"
msgid "dialogue/193/0x254"
msgstr "Jack\n¡Regina! Cálmate."

msgctxt "dialogue/193/0x286"
msgid "dialogue/193/0x286"
msgstr "Opis\nJe, je, je, eso, eso. Si\nte enfadas te saldrán\narrugas."

msgctxt "dialogue/193/0x2ca"
msgid "dialogue/193/0x2ca"
msgstr "Jack\n¿Y qué quiere de nosotros\nel doctor Opis?"

msgctxt "dialogue/193/0x30a"
msgid "dialogue/193/0x30a"
msgstr "Opis\nQuería presumir del\namplificador de Rare Hertz\nque acabo de crear."

msgctxt "dialogue/193/0x35f"
msgid "dialogue/193/0x35f"
msgstr "Arth\n¿Amplificador de Rare\nHertz...?"

msgctxt "dialogue/193/0x393"
msgid "dialogue/193/0x393"
msgstr "Opis\n¡Eso es! Amplifica por\nmedios mecánicos el Rare\nHertz natural y hace que\nlos Zoids se desboquen."

msgctxt "dialogue/193/0x3fc"
msgid "dialogue/193/0x3fc"
msgstr "Opis\n¡Grandioso!\n¡El invento de un\nauténtico genio!"

msgctxt "dialogue/193/0x433"
msgid "dialogue/193/0x433"
msgstr "Opis\n¿No os parece, jóvenes?"

msgctxt "dialogue/193/0x467"
msgid "dialogue/193/0x467"
msgstr "Jack\n...¿Y para qué quiere\nalgo así?"

msgctxt "dialogue/193/0x49b"
msgid "dialogue/193/0x49b"
msgstr "Opis\n¿Por qué? ¿¡Me preguntas\npor qué!? ¡Muy bien, os lo\nexplicaré por esta vez,\npobres ignorantes!"

msgctxt "dialogue/193/0x4f4"
msgid "dialogue/193/0x4f4"
msgstr "Opis\nMi gran amplificador de\nRare Hertz pone bajo su\ninfluencia a cualquier\nZoid."

msgctxt "dialogue/193/0x54f"
msgid "dialogue/193/0x54f"
msgstr "Opis\n¡Incluso aunque use el\nPulse Guard!"

msgctxt "dialogue/193/0x581"
msgid "dialogue/193/0x581"
msgstr "Opis\nLos Zoids se desbocan y\nescapan al control humano.\nRecogerlos después es\npan comido."

msgctxt "dialogue/193/0x5e2"
msgid "dialogue/193/0x5e2"
msgstr "Opis\nJe, je, je. ¿Veis ya lo\ngrande que soy?"

msgctxt "dialogue/193/0x624"
msgid "dialogue/193/0x624"
msgstr "Opis\nPero, por desgracia, mi\nquerido amplificador de\nRare Hertz aún está en\nfase experimental."

msgctxt "dialogue/193/0x66f"
msgid "dialogue/193/0x66f"
msgstr "Opis\nSu alcance es limitado.\nPero ¡un genio no para!\n¡Ni retrocede jamááás!"

msgctxt "dialogue/193/0x6cc"
msgid "dialogue/193/0x6cc"
msgstr "Opis\nEn este experimento he\nlogrado dominar por\ncompleto el fuerte Kronos\ny sus alrededores."

msgctxt "dialogue/193/0x71f"
msgid "dialogue/193/0x71f"
msgstr "Opis\nAmpliaré el alcance.\n¡Primero, la fortaleza de\nMount Ossa! ¡¡Y después,\nNew Helic City!!"

msgctxt "dialogue/193/0x77a"
msgid "dialogue/193/0x77a"
msgstr "Opis\nBuena ocasión para que el\nejército de la República\naprenda lo grande que soy."

msgctxt "dialogue/193/0x7bd"
msgid "dialogue/193/0x7bd"
msgstr "Opis\nAlgún día completaré un\naparato capaz de dominar\neste planeta entero."

msgctxt "dialogue/193/0x81a"
msgid "dialogue/193/0x81a"
msgstr "Opis\nInspiración repentina,\nconstante investigación...\n¡Magnífico! ¡Sin duda soy\nun genio! ¡Je, je, je!"

msgctxt "dialogue/193/0x881"
msgid "dialogue/193/0x881"
msgstr "Opis\nBien, señores. ¡Hasta la\npróxima!"

msgctxt "dialogue/194/0xc"
msgid "dialogue/194/0xc"
msgstr "Regina\n¡Espera!"

msgctxt "dialogue/194/0x36"
msgid "dialogue/194/0x36"
msgstr "Jack\nLa fortaleza de Mount\nOssa... Mala cosa. Es la\núltima línea de defensa\nde la República."

msgctxt "dialogue/194/0x99"
msgid "dialogue/194/0x99"
msgstr "Jack\nDebe de haber muchos Zoids\nreunidos. Y entre ellos,\nclaro, el más fuerte de\nla República..."

msgctxt "dialogue/194/0xf8"
msgid "dialogue/194/0xf8"
msgstr "Arth\n¿La seguimos?"

msgctxt "dialogue/194/0x11a"
msgid "dialogue/194/0x11a"
msgstr "Regina\n¡Pues claro! ¡No podemos\ndejar suelta a alguien\ntan peligrosa!"

msgctxt "dialogue/194/0x169"
msgid "dialogue/194/0x169"
msgstr "Regina\n¡...Le voy a enseñar bien\nenseñado que está\nequivocada!"

msgctxt "dialogue/194/0x1cb"
msgid "dialogue/194/0x1cb"
msgstr "{name}\n......"

msgctxt "dialogue/194/0x1ec"
msgid "dialogue/194/0x1ec"
msgstr "Arth\n...¿No sería mejor que\nte reprogramaran a ti?"

msgctxt "dialogue/194/0x233"
msgid "dialogue/194/0x233"
msgstr "Regina\n¿¡Cómo dices!?"

msgctxt "dialogue/194/0x25d"
msgid "dialogue/194/0x25d"
msgstr "Jack\n¡En cualquier caso,\ncorramos a la fortaleza\nde Mount Ossa!"

msgctxt "dialogue/195/0x3"
msgid "dialogue/195/0x3"
msgstr "Soldado de la República\n¡Alto! ¡¡Alto!!\n¡¡Quién va!!"

msgctxt "dialogue/195/0x38"
msgid "dialogue/195/0x38"
msgstr "Soldado de la República\n¡Esto es la fortaleza de\nMount Ossa! Se prohíbe la\nentrada a civiles."

msgctxt "dialogue/196/0x3"
msgid "dialogue/196/0x3"
msgstr "Soldado de la República\n¡Atrás! ¡Prohibido pasar!\nSi tenéis algún asunto, id\na la entrada principal,\nal sur."

msgctxt "dialogue/197/0x3"
msgid "dialogue/197/0x3"
msgstr "Soldado de la República\nPor la antigua erupción y\nel Rare Hertz, en este\nsubsuelo aún quedan muchos\nZoids salvajes."

msgctxt "dialogue/197/0x74"
msgid "dialogue/197/0x74"
msgstr "Soldado de la República\nSin permiso del comandante\nno se puede pasar.\nRetírese, por favor."

msgctxt "dialogue/198/0xc"
msgid "dialogue/198/0xc"
msgstr "{name}\n....."

msgctxt "dialogue/198/0x22"
msgid "dialogue/198/0x22"
msgstr "Soldado de la República\n¡Alto! ¡¡Alto!!\n¡¡Quién va!!"

msgctxt "dialogue/198/0x57"
msgid "dialogue/198/0x57"
msgstr "Soldado de la República\n¡Más allá está la\nfortaleza de Mount Ossa!\nSe prohíbe la entrada\na civiles."

msgctxt "dialogue/198/0xbc"
msgid "dialogue/198/0xbc"
msgstr "Jack\nEs una emergencia."

msgctxt "dialogue/198/0xec"
msgid "dialogue/198/0xec"
msgstr "Jack\nTenemos que comunicarle\nalgo al comandante."

msgctxt "dialogue/198/0x130"
msgid "dialogue/198/0x130"
msgstr "Soldado de la República\nNada, nada."

msgctxt "dialogue/199/0xc"
msgid "dialogue/199/0xc"
msgstr "Jack\nParece que con las manos\nvacías no nos dejarán...\nTendremos que pensar\nen algo."

msgctxt "dialogue/199/0x61"
msgid "dialogue/199/0x61"
msgstr "Arth\n¿Qué hacemos? ¿Volvemos al\npueblo a replantear\nel plan?"

msgctxt "dialogue/199/0xac"
msgid "dialogue/199/0xac"
msgstr "Regina\n...Sí. Insistir aquí\nno va a servir de nada."

msgctxt "dialogue/200/0xc"
msgid "dialogue/200/0xc"
msgstr "Dr. D\nOh, esta chiquilla, tan\nmona incluso enfadada...\nqué tacto..."

msgctxt "dialogue/200/0x5b"
msgid "dialogue/200/0x5b"
msgstr "Regina\n¡Ay! ¿¡Q-q-qué es esto!?"

msgctxt "dialogue/201/0xc"
msgid "dialogue/201/0xc"
msgstr "Jack\n¡! ¿¡Usted es...!?\nEl que iba con Van\ny los demás..."

msgctxt "dialogue/201/0x57"
msgid "dialogue/201/0x57"
msgstr "Regina\n¡Dr. D! ¿Qué está haciendo\nen un sitio como este?"

msgctxt "dialogue/201/0xa8"
msgid "dialogue/201/0xa8"
msgstr "Dr. D\nSalta a la vista, ¿no?\nEstrechando lazos."

msgctxt "dialogue/201/0xf5"
msgid "dialogue/201/0xf5"
msgstr "Regina\n¡¡No me refería a eso!!"

msgctxt "dialogue/201/0x123"
msgid "dialogue/201/0x123"
msgstr "Arth\n¿Un ladrón?"

msgctxt "dialogue/201/0x140"
msgid "dialogue/201/0x140"
msgstr "Soldado de la República\n¡Insolente! ¡Llamar ladrón\nal Dr. D!"

msgctxt "dialogue/201/0x185"
msgid "dialogue/201/0x185"
msgstr "Soldado de la República\nEste señor es un eminente\ncientífico de nuestra\nRepública."

msgctxt "dialogue/201/0x1d9"
msgid "dialogue/201/0x1d9"
msgstr "Jack\nAh, entonces escúchenos,\npor favor. Resulta que en\nel desierto de más allá..."

msgctxt "dialogue/201/0x22e"
msgid "dialogue/201/0x22e"
msgstr "Dr. D\nRare Hertz, ¿verdad? Y\nademás, artificial..."

msgctxt "dialogue/201/0x274"
msgid "dialogue/201/0x274"
msgstr "{name}\n......"

msgctxt "dialogue/202/0xc"
msgid "dialogue/202/0xc"
msgstr "Dr. D\nEh, perdona, ¿me dejarías\nver al comandante?"

msgctxt "dialogue/202/0x4a"
msgid "dialogue/202/0x4a"
msgstr "Soldado de la República\n¡Sí, señor! ¡Adelante!"

msgctxt "dialogue/203/0xc"
msgid "dialogue/203/0xc"
msgstr "Dr. D\nVenga, venga, ¿llevaríais\na este pobre anciano\nindefenso hasta la sala\nde mando...?"

msgctxt "dialogue/203/0x78"
msgid "dialogue/203/0x78"
msgstr "{name}\n......"

msgctxt "dialogue/204/0xc"
msgid "dialogue/204/0xc"
msgstr "Teniente coronel Ford\n¡Dr. D! ¡Llega en buen\nmomento!"

msgctxt "dialogue/204/0x50"
msgid "dialogue/204/0x50"
msgstr "Dr. D\nEs lo del fuerte Kronos,\n¿verdad?"

msgctxt "dialogue/204/0x82"
msgid "dialogue/204/0x82"
msgstr "Teniente coronel Ford\nAsí que ya lo sabía..."

msgctxt "dialogue/205/0xc"
msgid "dialogue/205/0xc"
msgstr "Teniente coronel Ford\n¡! ...¿Y ellos?\n¿Quiénes son?"

msgctxt "dialogue/205/0x4b"
msgid "dialogue/205/0x4b"
msgstr "Dr. D\nDigamos que son\nconocidos míos."

msgctxt "dialogue/205/0x86"
msgid "dialogue/205/0x86"
msgstr "Dr. D\nMás importante: ¿cuál es\nla situación?"

msgctxt "dialogue/205/0xbc"
msgid "dialogue/205/0xbc"
msgstr "Teniente coronel Ford\nSí. Desde hace unas horas,\nalrededor del fuerte\nKronos..."

msgctxt "dialogue/205/0xf3"
msgid "dialogue/205/0xf3"
msgstr "Teniente coronel Ford\n...se ha detectado una\ncantidad anómala de\nRare Hertz."

msgctxt "dialogue/205/0x138"
msgid "dialogue/205/0x138"
msgstr "Teniente coronel Ford\nA la vez, perdimos el\ncontacto con el fuerte\nKronos."

msgctxt "dialogue/205/0x187"
msgid "dialogue/205/0x187"
msgstr "Teniente coronel Ford\nTampoco parece haber\ncontacto con la vanguardia\nimperial que atacaba\nel fuerte Kronos."

msgctxt "dialogue/205/0x1e6"
msgid "dialogue/205/0x1e6"
msgstr "Teniente coronel Ford\nSegún las comunicaciones\nimperiales interceptadas y\nel reconocimiento aéreo..."

msgctxt "dialogue/205/0x23d"
msgid "dialogue/205/0x23d"
msgstr "Teniente coronel Ford\n...el grueso del ejército\nimperial se ha retirado\nde momento del desierto."

msgctxt "dialogue/205/0x296"
msgid "dialogue/205/0x296"
msgstr "Dr. D\n¿Enviasteis tropas al\nfuerte Kronos?"

msgctxt "dialogue/205/0x2d0"
msgid "dialogue/205/0x2d0"
msgstr "Teniente coronel Ford\nSí. Pero el Rare Hertz\ndescontrola a los Zoids y\nno podemos acercarnos."

msgctxt "dialogue/205/0x33b"
msgid "dialogue/205/0x33b"
msgstr "Teniente coronel Ford\nEl escudo de pulsos no\nsirve de nada."

msgctxt "dialogue/205/0x37b"
msgid "dialogue/205/0x37b"
msgstr "Dr. D\nNormal. Este Rare Hertz\nno es natural."

msgctxt "dialogue/205/0x3ca"
msgid "dialogue/205/0x3ca"
msgstr "Teniente coronel Ford\n¿¡Quiere decir que es obra\nhumana!? Entonces, ¿un\narma nueva del Imperio...?"

msgctxt "dialogue/205/0x41d"
msgid "dialogue/205/0x41d"
msgstr "Dr. D\nNo es del Imperio. Parece\nque lo trajo alguien\nque ellos conocen."

msgctxt "dialogue/205/0x476"
msgid "dialogue/205/0x476"
msgstr "Teniente coronel Ford\n¿Quiénes son ellos...?"

msgctxt "dialogue/205/0x4b4"
msgid "dialogue/205/0x4b4"
msgstr "Dr. D\nVete a saber."

msgctxt "dialogue/205/0x4d8"
msgid "dialogue/205/0x4d8"
msgstr "Teniente coronel Ford\n...¿Son de fiar?"

msgctxt "dialogue/205/0x512"
msgid "dialogue/205/0x512"
msgstr "Dr. D\nNo queda más remedio\nque fiarse."

msgctxt "dialogue/205/0x538"
msgid "dialogue/205/0x538"
msgstr "Dr. D\nDe momento, hay que\nocuparse del aparato que\ngenera ese Rare Hertz."

msgctxt "dialogue/205/0x589"
msgid "dialogue/205/0x589"
msgstr "Teniente coronel Ford\n...Verá, Dr. D. Tampoco\nsabemos nada del Coronel\nKrueger..."

msgctxt "dialogue/205/0x5f6"
msgid "dialogue/205/0x5f6"
msgstr "Dr. D\n¿Qué? ¿Estaba en el\nfuerte Kronos?"

msgctxt "dialogue/205/0x630"
msgid "dialogue/205/0x630"
msgstr "Teniente coronel Ford\nNo, estaba probando el\nGojulas ZG cerca del\nfuerte Kronos."

msgctxt "dialogue/205/0x677"
msgid "dialogue/205/0x677"
msgstr "Teniente coronel Ford\nLo último que nos dijo fue\nque había recibido una\nseñal de emergencia y que\niba hacia el fuerte..."

msgctxt "dialogue/205/0x6e2"
msgid "dialogue/205/0x6e2"
msgstr "Dr. D\n¿Quién más lo sabe?"

msgctxt "dialogue/205/0x718"
msgid "dialogue/205/0x718"
msgstr "Teniente coronel Ford\nAparte de mí, unos pocos:\nel Capitán Herman y su\nayudante, la Teniente\nO'Connell."

msgctxt "dialogue/205/0x777"
msgid "dialogue/205/0x777"
msgstr "Dr. D\n¿¡El Capitán Herman!?\n¿Ha venido Rob?"

msgctxt "dialogue/205/0x7bb"
msgid "dialogue/205/0x7bb"
msgstr "Teniente coronel Ford\nVolvió anoche de\nNew Helic City..."

msgctxt "dialogue/205/0x7fe"
msgid "dialogue/205/0x7fe"
msgstr "Teniente coronel Ford\nVenía por el Gojulas ZG.\nDiscutió con el Coronel\nKrueger sobre quién\nlo pilotaría..."

msgctxt "dialogue/205/0x867"
msgid "dialogue/205/0x867"
msgstr "Dr. D\n...Siempre igual..."

msgctxt "dialogue/206/0xc"
msgid "dialogue/206/0xc"
msgstr "Capitán Herman\nQué cosas dice, Dr. D.\nEl Gojulas ZG es digno\nde que lo pilote yo."

msgctxt "dialogue/206/0x71"
msgid "dialogue/206/0x71"
msgstr "Dr. D\nYa salió..."

msgctxt "dialogue/206/0xa7"
msgid "dialogue/206/0xa7"
msgstr "Capitán Herman\nLe pedí al viejo que\nse tomara un descanso,"

msgctxt "dialogue/206/0xea"
msgid "dialogue/206/0xea"
msgstr "Capitán Herman\npero es un hombre muy\ntestarudo..."

msgctxt "dialogue/206/0x12e"
msgid "dialogue/206/0x12e"
msgstr "Dr. D\nEn fin. Lo de la\ndesaparición de Krueger,\nen secreto por ahora.\nAfectaría a la moral."

msgctxt "dialogue/206/0x197"
msgid "dialogue/206/0x197"
msgstr "Teniente coronel Ford\nEntendido."

msgctxt "dialogue/206/0x1c3"
msgid "dialogue/206/0x1c3"
msgstr "Dr. D\nOs pido que me ayudéis a\ninvestigar. Al fin y al\ncabo, soy un pobre\nenfermo."

msgctxt "dialogue/206/0x222"
msgid "dialogue/206/0x222"
msgstr "{name}\n......"

msgctxt "dialogue/206/0x243"
msgid "dialogue/206/0x243"
msgstr "Dr. D\nDe momento, pensaremos qué\nhacer con los\namplificadores de\nRare Hertz."

msgctxt "dialogue/206/0x2a8"
msgid "dialogue/206/0x2a8"
msgstr "{name}\n......"

msgctxt "dialogue/207/0xc"
msgid "dialogue/207/0xc"
msgstr "Regina\nDr. D, ¿y qué hacemos?"

msgctxt "dialogue/207/0x48"
msgid "dialogue/207/0x48"
msgstr "Dr. D\nEscuchad bien. Para\nlocalizar los aparatos\nque generan el\nRare Hertz..."

msgctxt "dialogue/207/0x93"
msgid "dialogue/207/0x93"
msgstr "Dr. D\n...he instalado un medidor\nen vuestros Zoids."

msgctxt "dialogue/207/0xe2"
msgid "dialogue/207/0xe2"
msgstr "{name}\n......."

msgctxt "dialogue/207/0x105"
msgid "dialogue/207/0x105"
msgstr "Dr. D\nPara generar un Rare Hertz\ntan potente..."

msgctxt "dialogue/207/0x146"
msgid "dialogue/207/0x146"
msgstr "Dr. D\n...no bastará con un\nsolo aparato."

msgctxt "dialogue/207/0x17a"
msgid "dialogue/207/0x17a"
msgstr "Jack\nO sea, ¿que registremos\nlos alrededores del fuerte\nKronos con el medidor para\nlocalizar los aparatos?"

msgctxt "dialogue/207/0x1dd"
msgid "dialogue/207/0x1dd"
msgstr "Dr. D\nEso es. Tú sí que\nlo pillas rápido."

msgctxt "dialogue/207/0x21e"
msgid "dialogue/207/0x21e"
msgstr "Dr. D\nNo como otros..."

msgctxt "dialogue/207/0x252"
msgid "dialogue/207/0x252"
msgstr "Arth\n......"

msgctxt "dialogue/207/0x278"
msgid "dialogue/207/0x278"
msgstr "{name}\n......"

msgctxt "dialogue/207/0x299"
msgid "dialogue/207/0x299"
msgstr "Regina\nP-pues vamos rápido."

msgctxt "dialogue/207/0x2cf"
msgid "dialogue/207/0x2cf"
msgstr "Jack\nS-sí. ¿Y cómo se hace?"

msgctxt "dialogue/207/0x30b"
msgid "dialogue/207/0x30b"
msgstr "Dr. D\nBah, es fácil. Entráis\nen la zona de Rare Hertz."

msgctxt "dialogue/207/0x346"
msgid "dialogue/207/0x346"
msgstr "Dr. D\nY os quedáis allí hasta\nque el aparato dé el visto\nbueno."

msgctxt "dialogue/207/0x384"
msgid "dialogue/207/0x384"
msgstr "Regina\nSi entramos en la zona de\nRare Hertz, ¿no nos\nafectará?"

msgctxt "dialogue/207/0x3cd"
msgid "dialogue/207/0x3cd"
msgstr "Dr. D\nNo os preocupéis. El\nmedidor lleva un potente\nescudo de pulsos."

msgctxt "dialogue/207/0x424"
msgid "dialogue/207/0x424"
msgstr "Dr. D\nHasta que acabe la\nmedición estaréis bien."

msgctxt "dialogue/207/0x460"
msgid "dialogue/207/0x460"
msgstr "Arth\nNos atacarán los Zoids\ndesbocados."

msgctxt "dialogue/207/0x492"
msgid "dialogue/207/0x492"
msgstr "Dr. D\nPodréis con ellos.\n¿O es que os da miedo?"

msgctxt "dialogue/207/0x4e7"
msgid "dialogue/207/0x4e7"
msgstr "Arth\n...Hmpf. Maldito viejo."

msgctxt "dialogue/207/0x519"
msgid "dialogue/207/0x519"
msgstr "Dr. D\nJo, jo, jo. ¡Id y dadlo\ntodo!"

msgctxt "dialogue/209/0xc"
msgid "dialogue/209/0xc"
msgstr "Capitán Herman\n¿Estará a salvo el Gojulas\nZG que fue al fuerte\nKronos?"

msgctxt "dialogue/210/0xc"
msgid "dialogue/210/0xc"
msgstr "Teniente coronel Ford\n¿Estará a salvo el Coronel\nKrueger en el fuerte\nKronos?"

msgctxt "dialogue/211/0xc"
msgid "dialogue/211/0xc"
msgstr "Teniente O'Connell\n...Otra vez confiando una\nmisión a civiles..."

msgctxt "dialogue/212/0xc"
msgid "dialogue/212/0xc"
msgstr "Jack\nPríncipe, a partir de aquí\nempieza la zona de\nRare Hertz."

msgctxt "dialogue/212/0x4b"
msgid "dialogue/212/0x4b"
msgstr "{name}\n......"

msgctxt "dialogue/212/0x6c"
msgid "dialogue/212/0x6c"
msgstr "Regina\n...Príncipe, no se\narriesgue demasiado."

msgctxt "dialogue/212/0xac"
msgid "dialogue/212/0xac"
msgstr "Jack\nVamos, pues. Siga\ncombatiendo hasta que\nacabe la medición."

msgctxt "dialogue/212/0x103"
msgid "dialogue/212/0x103"
msgstr "Arth\nSí."

msgctxt "dialogue/212/0x121"
msgid "dialogue/212/0x121"
msgstr "Regina\n¡Entendido!"

msgctxt "dialogue/212/0x144"
msgid "dialogue/212/0x144"
msgstr "{name}\n......"

msgctxt "dialogue/213/0xc"
msgid "dialogue/213/0xc"
msgstr "Jack\nYa debería bastar.\nPríncipe, nos retiramos\ndel combate. ¡Regina!"

msgctxt "dialogue/213/0x5f"
msgid "dialogue/213/0x5f"
msgstr "Regina\nEntendido. Vamos,\npríncipe."

msgctxt "dialogue/213/0x8b"
msgid "dialogue/213/0x8b"
msgstr "Regina\nSolo falta que el Dr. D\nlo analice y listo."

msgctxt "dialogue/213/0xd0"
msgid "dialogue/213/0xd0"
msgstr "Regina\nPríncipe, volvamos a la\nfortaleza de Mount Ossa."

msgctxt "dialogue/214/0xc"
msgid "dialogue/214/0xc"
msgstr "Dr. D\nBuen trabajo, sí señor."

msgctxt "dialogue/214/0x3e"
msgid "dialogue/214/0x3e"
msgstr "Jack\nY bien, doctor, ¿qué\nresultados hay?"

msgctxt "dialogue/214/0x76"
msgid "dialogue/214/0x76"
msgstr "Dr. D\nHum. Parece que hay cinco\namplificadores de\nRare Hertz."

msgctxt "dialogue/214/0xbf"
msgid "dialogue/214/0xbf"
msgstr "Teniente coronel Ford\nCinco..."

msgctxt "dialogue/214/0xe9"
msgid "dialogue/214/0xe9"
msgstr "Dr. D\nEl principal, en el fuerte\nKronos; los otros cuatro\nson auxiliares."

msgctxt "dialogue/214/0x126"
msgid "dialogue/214/0x126"
msgstr "Dr. D\nEstán colocados alrededor\nde la zona de Rare Hertz."

msgctxt "dialogue/214/0x166"
msgid "dialogue/214/0x166"
msgstr "Capitán Herman\nEntonces es fácil:\nbasta con destruirlos\ntodos a la vez."

msgctxt "dialogue/214/0x1a3"
msgid "dialogue/214/0x1a3"
msgstr "Capitán Herman\n¡Los bombardearé con los\nPteras y los destruiré\nde una vez!"

msgctxt "dialogue/214/0x1ee"
msgid "dialogue/214/0x1ee"
msgstr "Dr. D\nNo es tan fácil. Incluso\ndesde el aire os afectará\nel Rare Hertz."

msgctxt "dialogue/214/0x243"
msgid "dialogue/214/0x243"
msgstr "Teniente coronel Ford\nEl Dr. D tiene razón,\nCapitán Herman. Así no\nhabría un bombardeo\npreciso."

msgctxt "dialogue/214/0x2ac"
msgid "dialogue/214/0x2ac"
msgstr "Jack\nAdemás, desde el aire se\nllama demasiado la\natención. El enemigo\nestaría alerta."

msgctxt "dialogue/214/0x301"
msgid "dialogue/214/0x301"
msgstr "Capitán Herman\n...Muy bien. Formaremos un\nequipo especial de élite\ny nos acercaremos por\ntierra."

msgctxt "dialogue/214/0x366"
msgid "dialogue/214/0x366"
msgstr "Dr. D\nSí, algo así será."

msgctxt "dialogue/214/0x39e"
msgid "dialogue/214/0x39e"
msgstr "Regina\nPero, doctor, ¿qué hacemos\ncon el Rare Hertz?"

msgctxt "dialogue/214/0x3da"
msgid "dialogue/214/0x3da"
msgstr "Dr. D\nHum... De eso hablaremos\nen el hangar."

msgctxt "dialogue/215/0xc"
msgid "dialogue/215/0xc"
msgstr "Irvine\n¡Será idiota!\n¡Mira que largarse así\npor su cuenta!"

msgctxt "dialogue/215/0x5b"
msgid "dialogue/215/0x5b"
msgstr "Moonbay\n¡Ya, Irvine, pero eso no\nsignifica que tengas que\nlargarte tú también!"

msgctxt "dialogue/215/0xb4"
msgid "dialogue/215/0xb4"
msgstr "Moonbay\n¡Además, ya lo has visto!\n¡¡Esa manada de Zoids\ndesbocados!!"

msgctxt "dialogue/215/0xf1"
msgid "dialogue/215/0xf1"
msgstr "Moonbay\nAntes de llegar al fuerte\nKronos acabarías hecho\npolvo."

msgctxt "dialogue/215/0x13c"
msgid "dialogue/215/0x13c"
msgstr "Jack\nPero si son... Moonbay\ny los demás. ¿Qué ha\npasado?"

msgctxt "dialogue/215/0x19b"
msgid "dialogue/215/0x19b"
msgstr "Arth\nSolo es un tipo con mala\ncara armando jaleo."

msgctxt "dialogue/215/0x1d7"
msgid "dialogue/215/0x1d7"
msgstr "Irvine\n¿Ah? ¡Mira quién fue a\nhablar!"

msgctxt "dialogue/215/0x21b"
msgid "dialogue/215/0x21b"
msgstr "Regina\n¡Arth!"

msgctxt "dialogue/215/0x241"
msgid "dialogue/215/0x241"
msgstr "Regina\nDisculpad. ¿Ha pasado\nalgo?"

msgctxt "dialogue/215/0x27d"
msgid "dialogue/215/0x27d"
msgstr "Moonbay\nPues..."

msgctxt "dialogue/215/0x2a5"
msgid "dialogue/215/0x2a5"
msgstr "Irvine\nEl idiota de Van dijo que\niba a echar un vistazo al\nfuerte Kronos y salió\ndisparado."

msgctxt "dialogue/215/0x30a"
msgid "dialogue/215/0x30a"
msgstr "Moonbay\nY encima Fiona se fue con\nél, tan amable. Eso sí,\nZeke se quedó aquí."

msgctxt "dialogue/215/0x371"
msgid "dialogue/215/0x371"
msgstr "Jack\nNo puede ser, ¿Van y los\ndemás también...?"

msgctxt "dialogue/215/0x3ab"
msgid "dialogue/215/0x3ab"
msgstr "Dr. D\nJo, jo, jo. Muy propio\ndel chaval."

msgctxt "dialogue/215/0x3dd"
msgid "dialogue/215/0x3dd"
msgstr "Irvine\n¡Viejo!"

msgctxt "dialogue/215/0x403"
msgid "dialogue/215/0x403"
msgstr "Moonbay\n¡Dr. D!"

msgctxt "dialogue/215/0x42b"
msgid "dialogue/215/0x42b"
msgstr "Dr. D\nPero si los chavales no\nestán, tendréis que\nencargaros vosotros."

msgctxt "dialogue/216/0xc"
msgid "dialogue/216/0xc"
msgstr "Capitán Herman\nNi hablar. ¡No podemos\ndepender de civiles!"

msgctxt "dialogue/216/0x59"
msgid "dialogue/216/0x59"
msgstr "Dr. D\nVamos, vamos. Parece que\nel enemigo de esta vez es\nconocido suyo. ¿Verdad?"

msgctxt "dialogue/216/0xb7"
msgid "dialogue/216/0xb7"
msgstr "{name}\n......"

msgctxt "dialogue/216/0xd8"
msgid "dialogue/216/0xd8"
msgstr "Moonbay\nOye, ¿de qué va todo esto?"

msgctxt "dialogue/216/0x110"
msgid "dialogue/216/0x110"
msgstr "Dr. D\nYa que estáis, escuchad\nvosotros también."

msgctxt "dialogue/216/0x140"
msgid "dialogue/216/0x140"
msgstr "Dr. D\nEl amplificador enemigo\nha convertido el fuerte\nKronos en una potente\nzona de Rare Hertz."

msgctxt "dialogue/216/0x1a9"
msgid "dialogue/216/0x1a9"
msgstr "Irvine\n¿Amplificador de Rare\nHertz? ¿Y eso qué es?"

msgctxt "dialogue/216/0x1eb"
msgid "dialogue/216/0x1eb"
msgstr "Moonbay\n¡Calla y escucha, Irvine!"

msgctxt "dialogue/216/0x223"
msgid "dialogue/216/0x223"
msgstr "Dr. D\nHay cinco amplificadores\nde Rare Hertz en total."

msgctxt "dialogue/216/0x257"
msgid "dialogue/216/0x257"
msgstr "Dr. D\nBasta con destruirlos\ntodos."

msgctxt "dialogue/216/0x295"
msgid "dialogue/216/0x295"
msgstr "Moonbay\nPero con el Rare Hertz no\nhay quien se acerque, ¿no?"

msgctxt "dialogue/216/0x2d9"
msgid "dialogue/216/0x2d9"
msgstr "Dr. D\nCierto. Por eso he creado\nun escudo protector contra\nese Rare Hertz tan fuerte."

msgctxt "dialogue/216/0x322"
msgid "dialogue/216/0x322"
msgstr "Dr. D\nYa está instalado en\nvuestros Zoids."

msgctxt "dialogue/216/0x366"
msgid "dialogue/216/0x366"
msgstr "Capitán Herman\nUn momento. No puedo dejar\nesto en manos de civiles.\nIré con ellos."

msgctxt "dialogue/216/0x3b9"
msgid "dialogue/216/0x3b9"
msgstr "Teniente coronel Ford\n¡Capitán Herman!"

msgctxt "dialogue/216/0x3e7"
msgid "dialogue/216/0x3e7"
msgstr "Capitán Herman\nEl fuerte Kronos es una\ninstalación militar. Les\nvendrá bien tener a un\nmilitar de la República."

msgctxt "dialogue/216/0x44c"
msgid "dialogue/216/0x44c"
msgstr "Teniente coronel Ford\nEs cierto... Bien, yo\ntambién iré. Teniente\nO'Connell, lo siento, pero\nusted también viene."

msgctxt "dialogue/216/0x4af"
msgid "dialogue/216/0x4af"
msgstr "Teniente O'Connell\n¡Sí, señor!"

msgctxt "dialogue/216/0x4d7"
msgid "dialogue/216/0x4d7"
msgstr "Jack\n...¿Doctor?"

msgctxt "dialogue/216/0x501"
msgid "dialogue/216/0x501"
msgstr "Dr. D\nTodos haciendo lo que les\nda la gana... ¡Haced lo\nque queráis!"

msgctxt "dialogue/216/0x54f"
msgid "dialogue/216/0x54f"
msgstr "¡Herman y los demás se\nunieron al grupo!"

msgctxt "dialogue/217/0xc"
msgid "dialogue/217/0xc"
msgstr "Teniente O'Connell\n¡Amplificador de Rare\nHertz localizado!"

msgctxt "dialogue/217/0x46"
msgid "dialogue/217/0x46"
msgstr "Capitán Herman\n¡Destruidlo!"

msgctxt "dialogue/218/0xc"
msgid "dialogue/218/0xc"
msgstr "Irvine\n¡Ese Van! Cuando vuelva,\nle voy a echar un sermón\nque se va a enterar."

msgctxt "dialogue/219/0xc"
msgid "dialogue/219/0xc"
msgstr "Moonbay\n¡Con tanto Rare Hertz, no\nhay manera de hacer\nnegocio!"

msgctxt "dialogue/220/0xc"
msgid "dialogue/220/0xc"
msgstr "Zeke\n¡Kuuuuun!"

msgctxt "dialogue/221/0xc"
msgid "dialogue/221/0xc"
msgstr "Jack\nDentro del fuerte el Rare\nHertz es demasiado fuerte\ny el escudo no funciona."

msgctxt "dialogue/221/0x55"
msgid "dialogue/221/0x55"
msgstr "Jack\n¡Es peligroso!\n¡¡Retrocedamos!!"

msgctxt "dialogue/222/0xc"
msgid "dialogue/222/0xc"
msgstr "Teniente coronel Ford\nEste es el fuerte Kronos,\npero..."

msgctxt "dialogue/222/0x46"
msgid "dialogue/222/0x46"
msgstr "Capitán Herman\nAlrededor del fuerte el\nRare Hertz es demasiado\nfuerte. El escudo no va."

msgctxt "dialogue/222/0x9b"
msgid "dialogue/222/0x9b"
msgstr "Jack\nPrimero habrá que destruir\nlos aparatos auxiliares\nde alrededor, ¿verdad?"

msgctxt "dialogue/223/0xc"
msgid "dialogue/223/0xc"
msgstr "Capitán Herman\nPor fin hemos llegado\nhasta aquí."

msgctxt "dialogue/223/0x48"
msgid "dialogue/223/0x48"
msgstr "Teniente coronel Ford\nHasta aquí, sí. Pero ahora\nviene el amplificador de\nRare Hertz principal."

msgctxt "dialogue/223/0x9d"
msgid "dialogue/223/0x9d"
msgstr "Teniente coronel Ford\nEl enemigo estará bien\npreparado..."

msgctxt "dialogue/223/0xe6"
msgid "dialogue/223/0xe6"
msgstr "Capitán Herman\nSi no, no tendría gracia."

msgctxt "dialogue/223/0x12a"
msgid "dialogue/223/0x12a"
msgstr "Teniente coronel Ford\nNo cambias, ¿eh?"

msgctxt "dialogue/223/0x15e"
msgid "dialogue/223/0x15e"
msgstr "Teniente O'Connell\nPrimero, registremos\nesta zona."

msgctxt "dialogue/224/0xc"
msgid "dialogue/224/0xc"
msgstr "{name}\n¡¡!!"

msgctxt "dialogue/224/0x25"
msgid "dialogue/224/0x25"
msgstr "Arth\n¡! ¡¿Quién va?!"

msgctxt "dialogue/224/0x42"
msgid "dialogue/224/0x42"
msgstr "Van\n¡Uaaah, espera, espera!\n¡Soy yo, yo!"

msgctxt "dialogue/225/0xc"
msgid "dialogue/225/0xc"
msgstr "Arth\nNo conozco a nadie que se\nllame \"Yo\"."

msgctxt "dialogue/225/0x4e"
msgid "dialogue/225/0x4e"
msgstr "Van\n¡Lo dices a propósito!\n¡Eres tan pesado como\nIrvine!"

msgctxt "dialogue/225/0xa5"
msgid "dialogue/225/0xa5"
msgstr "Fiona\nJiji, Van está nervioso."

msgctxt "dialogue/225/0xd7"
msgid "dialogue/225/0xd7"
msgstr "Van\n¡Calla! No estoy nervioso.\n¡Solo me he asustado!"

msgctxt "dialogue/225/0x124"
msgid "dialogue/225/0x124"
msgstr "Jack\nVan. Estás bien, por lo\nque veo."

msgctxt "dialogue/225/0x156"
msgid "dialogue/225/0x156"
msgstr "Capitán Herman\nSiempre dando sustos,\nmocoso."

msgctxt "dialogue/225/0x18a"
msgid "dialogue/225/0x18a"
msgstr "Capitán Herman\nPor cierto, ¿no habréis\nvisto al coronel Krueger?"

msgctxt "dialogue/225/0x1d0"
msgid "dialogue/225/0x1d0"
msgstr "Van\n¿El coronel Krueger?\n¿Será ese viejo, Fiona?"

msgctxt "dialogue/225/0x21b"
msgid "dialogue/225/0x21b"
msgstr "Fiona\n¿El viejo es el coronel\nKrueger?"

msgctxt "dialogue/225/0x255"
msgid "dialogue/225/0x255"
msgstr "Van\n¡Eso te estoy preguntando\nyo, Fiona!"

msgctxt "dialogue/225/0x291"
msgid "dialogue/225/0x291"
msgstr "Fiona\n¿Ah, sí? No lo sé."

msgctxt "dialogue/225/0x2c1"
msgid "dialogue/225/0x2c1"
msgstr "Capitán Herman\n¡Dejaos de tonterías!\n¿Dónde está ese viejo?"

msgctxt "dialogue/226/0xc"
msgid "dialogue/226/0xc"
msgstr "Coronel Krueger\nQuién me iba a decir que\nun mocoso inexperto me\nllamaría viejo."

msgctxt "dialogue/226/0x63"
msgid "dialogue/226/0x63"
msgstr "Teniente coronel Ford\n¡Coronel Krueger!\n¡Está usted bien!"

msgctxt "dialogue/226/0x9f"
msgid "dialogue/226/0x9f"
msgstr "Coronel Krueger\nSí, más o menos."

msgctxt "dialogue/226/0xc3"
msgid "dialogue/226/0xc3"
msgstr "Coronel Krueger\nBueno, no es sitio para\nhablar de pie. Venid."

msgctxt "dialogue/227/0xc"
msgid "dialogue/227/0xc"
msgstr "Coronel Krueger\nPor cierto, ¿quiénes son\nestos?"

msgctxt "dialogue/227/0x4a"
msgid "dialogue/227/0x4a"
msgstr "Teniente coronel Ford\nConocidos del Dr. D,\nal parecer."

msgctxt "dialogue/227/0x7e"
msgid "dialogue/227/0x7e"
msgstr "Teniente coronel Ford\nLes hemos encargado\ndestruir los\namplificadores de Rare\nHertz."

msgctxt "dialogue/227/0xd0"
msgid "dialogue/227/0xd0"
msgstr "Van\n¿Amplificadores de Rare\nHertz?"

msgctxt "dialogue/227/0xfc"
msgid "dialogue/227/0xfc"
msgstr "Coronel Krueger\nYa veo. Así que esa es la\ncausa de este desboque."

msgctxt "dialogue/227/0x147"
msgid "dialogue/227/0x147"
msgstr "Fiona\n¿Qué es eso?"

msgctxt "dialogue/227/0x16d"
msgid "dialogue/227/0x16d"
msgstr "Jack\nUn aparato que amplifica\nel Rare Hertz de forma\nartificial y hace que los\nZoids se desboquen."

msgctxt "dialogue/227/0x1c0"
msgid "dialogue/227/0x1c0"
msgstr "Jack\nEs obra de los compinches\nde aquella mujer."

msgctxt "dialogue/227/0x1fe"
msgid "dialogue/227/0x1fe"
msgstr "Van\n¡Maldita sea! ¡¿Otra vez\nesos?!"

msgctxt "dialogue/227/0x234"
msgid "dialogue/227/0x234"
msgstr "Capitán Herman\nY dicen que el\namplificador de Rare Hertz\nprincipal está en este\nfuerte Kronos."

msgctxt "dialogue/227/0x299"
msgid "dialogue/227/0x299"
msgstr "Coronel Krueger\n...Hmm. Será el hangar\nsubterráneo."

msgctxt "dialogue/227/0x2d5"
msgid "dialogue/227/0x2d5"
msgstr "Capitán Herman\n¿El hangar subterráneo?\n¿Está usted seguro?"

msgctxt "dialogue/227/0x317"
msgid "dialogue/227/0x317"
msgstr "Coronel Krueger\nEstaba a rebosar de Zoids\ndesbocados."

msgctxt "dialogue/227/0x353"
msgid "dialogue/227/0x353"
msgstr "Coronel Krueger\nNo sé si tienen voluntad\npropia, pero debe de ser\nun lugar muy importante."

msgctxt "dialogue/227/0x3bc"
msgid "dialogue/227/0x3bc"
msgstr "Capitán Herman\nYa veo..."

msgctxt "dialogue/227/0x3ea"
msgid "dialogue/227/0x3ea"
msgstr "Jack\nParece que habrá que\ncomprobarlo."

msgctxt "dialogue/227/0x422"
msgid "dialogue/227/0x422"
msgstr "Arth\nSí."

msgctxt "dialogue/227/0x440"
msgid "dialogue/227/0x440"
msgstr "Regina\nEso parece..., ¿príncipe?"

msgctxt "dialogue/227/0x471"
msgid "dialogue/227/0x471"
msgstr "{name}\n......"

msgctxt "dialogue/227/0x492"
msgid "dialogue/227/0x492"
msgstr "Coronel Krueger\nCapitán Herman, le dejo\nesto a su cargo."

msgctxt "dialogue/227/0x4ce"
msgid "dialogue/227/0x4ce"
msgstr "Capitán Herman\n¡Coronel, déjelo en mis\nmanos!"

msgctxt "dialogue/227/0x508"
msgid "dialogue/227/0x508"
msgstr "Coronel Krueger\nAhora que sé lo que pasa,\nno puedo quedarme quieto.\n¿Qué piloto de Zoids no\nsalvaría a los Zoids?"

msgctxt "dialogue/227/0x577"
msgid "dialogue/227/0x577"
msgstr "Van\n¡Bien dicho, viejo!\n¡Yo también voy!"

msgctxt "dialogue/227/0x5ba"
msgid "dialogue/227/0x5ba"
msgstr "Capitán Herman\n...En eso de no atender a\nrazones, el coronel me\ngana de largo."

msgctxt "dialogue/227/0x609"
msgid "dialogue/227/0x609"
msgstr "Capitán Herman\nEntendido. Nosotros nos\ncentraremos en defender\nel fuerte."

msgctxt "dialogue/227/0x650"
msgid "dialogue/227/0x650"
msgstr "Coronel Krueger\nLo siento...\n¡Vamos, chicos!"

msgctxt "dialogue/227/0x686"
msgid "dialogue/227/0x686"
msgstr "¡Van y Krueger se unieron\nal grupo!"

msgctxt "dialogue/228/0xc"
msgid "dialogue/228/0xc"
msgstr "Capitán Herman\nCuidad del coronel\nKrueger. Es una persona\nmuy importante para la\nRepública..."

msgctxt "dialogue/229/0xc"
msgid "dialogue/229/0xc"
msgstr "Teniente coronel Ford\n...Superiores y\nsubordinados, todos van\na lo suyo..."

msgctxt "dialogue/230/0xc"
msgid "dialogue/230/0xc"
msgstr "Teniente O'Connell\nÁnimo. ¡Con lo que valéis,\nseguro que lo conseguís!"

msgctxt "dialogue/231/0xc"
msgid "dialogue/231/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/231/0x2d"
msgid "dialogue/231/0x2d"
msgstr "Regina\nAsí que este es el\namplificador principal."

msgctxt "dialogue/231/0x5f"
msgid "dialogue/231/0x5f"
msgstr "Van\n¡Por culpa de este\ntrasto, los Zoids...!"

msgctxt "dialogue/231/0x95"
msgid "dialogue/231/0x95"
msgstr "Coronel Krueger\n¡Pero aquí se acaba todo!"

msgctxt "dialogue/232/0xc"
msgid "dialogue/232/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/232/0x2d"
msgid "dialogue/232/0x2d"
msgstr "Regina\n¡No puede ser!\n¡¿Qué está pasando?!"

msgctxt "dialogue/232/0x5f"
msgid "dialogue/232/0x5f"
msgstr "Jack\n¡No lo sé!"

msgctxt "dialogue/232/0x89"
msgid "dialogue/232/0x89"
msgstr "Arth\nMal asunto. Nos van a\nrodear."

msgctxt "dialogue/232/0xb5"
msgid "dialogue/232/0xb5"
msgstr "Jack\n¡Volvamos arriba de\nmomento!"

msgctxt "dialogue/233/0xc"
msgid "dialogue/233/0xc"
msgstr "Capitán Herman\n¡¿Qué significa esto?!\n¡El desboque no se ha\ndetenido!"

msgctxt "dialogue/233/0x54"
msgid "dialogue/233/0x54"
msgstr "Jack\nNo lo sé. Hemos destruido\nel amplificador de Rare\nHertz, pero..."

msgctxt "dialogue/233/0xa9"
msgid "dialogue/233/0xa9"
msgstr "Capitán Herman\n¡Pues el desboque sigue!"

msgctxt "dialogue/233/0xe9"
msgid "dialogue/233/0xe9"
msgstr "Arth\nNi idea."

msgctxt "dialogue/233/0x109"
msgid "dialogue/233/0x109"
msgstr "Capitán Herman\n¡¿Cómo dices?! ¡Tú...!"

msgctxt "dialogue/233/0x13b"
msgid "dialogue/233/0x13b"
msgstr "Teniente coronel Ford\n¡Basta ya, capitán Herman!"

msgctxt "dialogue/233/0x177"
msgid "dialogue/233/0x177"
msgstr "Coronel Krueger\nYa veo...\nParece que el enemigo nos\nla ha jugado..."

msgctxt "dialogue/233/0x1c8"
msgid "dialogue/233/0x1c8"
msgstr "Jack\n¿Qué quiere decir?"

msgctxt "dialogue/233/0x1f4"
msgid "dialogue/233/0x1f4"
msgstr "{name}\n......"

msgctxt "dialogue/233/0x215"
msgid "dialogue/233/0x215"
msgstr "Coronel Krueger\nQue ese amplificador de\nRare Hertz no solo sirve\npara desbocar a los Zoids."

msgctxt "dialogue/233/0x27e"
msgid "dialogue/233/0x27e"
msgstr "Capitán Herman\n¿Qué quiere decir,\ncoronel Krueger?"

msgctxt "dialogue/233/0x2c4"
msgid "dialogue/233/0x2c4"
msgstr "Coronel Krueger\nEso ya no lo sé.\nAveriguarlo es trabajo\ndel Dr. D."

msgctxt "dialogue/233/0x31d"
msgid "dialogue/233/0x31d"
msgstr "Coronel Krueger\nLo más sensato es volver\na la fortaleza de Mount\nOssa."

msgctxt "dialogue/233/0x367"
msgid "dialogue/233/0x367"
msgstr "Teniente coronel Ford\nEntendido."

msgctxt "dialogue/233/0x387"
msgid "dialogue/233/0x387"
msgstr "Teniente coronel Ford\nCoronel Krueger, vuelva\ncon ellos a la fortaleza\nde Mount Ossa."

msgctxt "dialogue/233/0x3da"
msgid "dialogue/233/0x3da"
msgstr "Teniente coronel Ford\nEl capitán Herman, el\nteniente O'Connell y yo\nnos quedaremos en el\nfuerte Kronos"

msgctxt "dialogue/233/0x423"
msgid "dialogue/233/0x423"
msgstr "Teniente coronel Ford\ny seguiremos vigilando la\nsituación."

msgctxt "dialogue/233/0x461"
msgid "dialogue/233/0x461"
msgstr "Capitán Herman\n¡! ¡Pero...!"

msgctxt "dialogue/233/0x48d"
msgid "dialogue/233/0x48d"
msgstr "Teniente coronel Ford\n¡Es una orden, capitán\nHerman!"

msgctxt "dialogue/233/0x4c9"
msgid "dialogue/233/0x4c9"
msgstr "Capitán Herman\n¡Tsk! ¡Entendido!"

msgctxt "dialogue/233/0x4fd"
msgid "dialogue/233/0x4fd"
msgstr "Coronel Krueger\nOs lo encargo. Bien,\nvámonos."

msgctxt "dialogue/234/0xc"
msgid "dialogue/234/0xc"
msgstr "Dr. D\nAsí que el desboque no se\ndetuvo..."

msgctxt "dialogue/234/0x46"
msgid "dialogue/234/0x46"
msgstr "Jack\n¿Qué significa esto,\ndoctor?"

msgctxt "dialogue/234/0x84"
msgid "dialogue/234/0x84"
msgstr "Dr. D\nEl enemigo es astuto. El\nfin del amplificador de\nRare Hertz no es el\ndesboque."

msgctxt "dialogue/234/0xe5"
msgid "dialogue/234/0xe5"
msgstr "Irvine\n¿Eh? ¿Qué quieres decir,\nabuelo?"

msgctxt "dialogue/234/0x123"
msgid "dialogue/234/0x123"
msgstr "Dr. D\n¿No lo entiendes?"

msgctxt "dialogue/234/0x14d"
msgid "dialogue/234/0x14d"
msgstr "Irvine\n¡¿Cómo quieres que lo\nentienda?!"

msgctxt "dialogue/234/0x17f"
msgid "dialogue/234/0x17f"
msgstr "Dr. D\nTan inmaduro como siempre.\nMuy bien, te lo explicaré."

msgctxt "dialogue/234/0x1ce"
msgid "dialogue/234/0x1ce"
msgstr "Irvine\nMaldito vejestorio..."

msgctxt "dialogue/234/0x1fe"
msgid "dialogue/234/0x1fe"
msgstr "Moonbay\n¡Irvine!"

msgctxt "dialogue/234/0x226"
msgid "dialogue/234/0x226"
msgstr "Dr. D\nEl propósito del\namplificador de Rare Hertz\nes lavarles el cerebro a\nlos Zoids."

msgctxt "dialogue/234/0x27f"
msgid "dialogue/234/0x27f"
msgstr "Regina\n¡! ¡¿Lavarles el cerebro?!"

msgctxt "dialogue/234/0x2a7"
msgid "dialogue/234/0x2a7"
msgstr "Dr. D\nAsí es. Un Zoid no es un\nsimple arma. Es un ser\nvivo con voluntad propia."

msgctxt "dialogue/234/0x2f6"
msgid "dialogue/234/0x2f6"
msgstr "Dr. D\nPor eso responde a la\nvoluntad de su piloto."

msgctxt "dialogue/234/0x335"
msgid "dialogue/234/0x335"
msgstr "Dr. D\nVosotros también lo\nhabréis notado alguna vez."

msgctxt "dialogue/234/0x375"
msgid "dialogue/234/0x375"
msgstr "Irvine\n......"

msgctxt "dialogue/234/0x39f"
msgid "dialogue/234/0x39f"
msgstr "Dr. D\nAl desbocarlos con el Rare\nHertz, anulan esa\nvoluntad."

msgctxt "dialogue/234/0x3ea"
msgid "dialogue/234/0x3ea"
msgstr "Dr. D\nSeguramente les imponen\nuna voluntad nueva para\nque obedezcan órdenes."

msgctxt "dialogue/234/0x449"
msgid "dialogue/234/0x449"
msgstr "Coronel Krueger\nEntonces, la forma de\ndetener el desboque..."

msgctxt "dialogue/234/0x489"
msgid "dialogue/234/0x489"
msgstr "Dr. D\n...Por desgracia, no hay\nninguna."

msgctxt "dialogue/234/0x4b9"
msgid "dialogue/234/0x4b9"
msgstr "Coronel Krueger\nSin el Rare Hertz, puede\nque el ejército imperial\naproveche este caos para\nvolver a invadirnos."

msgctxt "dialogue/234/0x52a"
msgid "dialogue/234/0x52a"
msgstr "Coronel Krueger\nPero no podemos dejar a\nlos Zoids desbocados así."

msgctxt "dialogue/234/0x569"
msgid "dialogue/234/0x569"
msgstr "Coronel Krueger\nEn lo táctico, son una\nincógnita demasiado grave."

msgctxt "dialogue/234/0x59d"
msgid "dialogue/234/0x59d"
msgstr "Coronel Krueger\nSin saber de qué lado se\npondrán los Zoids\ndesbocados, habrá que\neliminarlos ya mismo..."

msgctxt "dialogue/234/0x60a"
msgid "dialogue/234/0x60a"
msgstr "Dr. D\n¿Aunque sea por las malas?"

msgctxt "dialogue/234/0x642"
msgid "dialogue/234/0x642"
msgstr "Coronel Krueger\nMejor eso que dejar morir\nal paciente."

msgctxt "dialogue/234/0x682"
msgid "dialogue/234/0x682"
msgstr "Dr. D\n...De acuerdo."

msgctxt "dialogue/234/0x6a2"
msgid "dialogue/234/0x6a2"
msgstr "Dr. D\nHaremos que el magma del\nvolcán de Mount Ossa\nfluya hacia el fuerte\nKronos."

msgctxt "dialogue/234/0x6eb"
msgid "dialogue/234/0x6eb"
msgstr "Dr. D\nEs una pena, pero así\nacabaremos con todos de\nun golpe."

msgctxt "dialogue/234/0x731"
msgid "dialogue/234/0x731"
msgstr "Jack\nPero ¿cómo vamos a\nconducir el magma hasta\nallí?"

msgctxt "dialogue/234/0x77a"
msgid "dialogue/234/0x77a"
msgstr "Dr. D\nEl volcán de Mount Ossa\nsigue muy activo."

msgctxt "dialogue/234/0x7bb"
msgid "dialogue/234/0x7bb"
msgstr "Dr. D\nSi abrimos un agujero en\nel punto que da al fuerte\nKronos, el magma saldrá\ntodo hacia allí."

msgctxt "dialogue/234/0x818"
msgid "dialogue/234/0x818"
msgstr "Dr. D\nEs muchísimo más fácil que\nhacer que nieve."

msgctxt "dialogue/234/0x858"
msgid "dialogue/234/0x858"
msgstr "Regina\nDoctor, lo dice como si\nfuera fácil, pero ¿cómo\nabrimos el agujero?"

msgctxt "dialogue/234/0x8a1"
msgid "dialogue/234/0x8a1"
msgstr "Dr. D\nSi no recuerdo mal, había\npor ahí un cañón láser\npara perforar la roca,\n¿no es así?"

msgctxt "dialogue/234/0x905"
msgid "dialogue/234/0x905"
msgstr "Coronel Krueger\nContigo no hay quien\npueda. Sí, debería estar\nen alguna parte de la zona\nde ampliación del fuerte."

msgctxt "dialogue/234/0x95e"
msgid "dialogue/234/0x95e"
msgstr "Coronel Krueger\nAunque, tras la erupción\nde hace poco y los Zoids\ndesbocados, no sé en qué\nestado estará."

msgctxt "dialogue/234/0x9c5"
msgid "dialogue/234/0x9c5"
msgstr "Dr. D\nCon saber eso basta.\nLo demás es cosa vuestra."

msgctxt "dialogue/234/0xa11"
msgid "dialogue/234/0xa11"
msgstr "{name}\n......"

msgctxt "dialogue/234/0xa32"
msgid "dialogue/234/0xa32"
msgstr "Jack\nEntendido. Vayamos a\nrecuperarlo ahora mismo."

msgctxt "dialogue/234/0xa77"
msgid "dialogue/234/0xa77"
msgstr "Coronel Krueger\nUn momento. Tú, muchacho,\nve con ellos en mi lugar."

msgctxt "dialogue/234/0xad2"
msgid "dialogue/234/0xad2"
msgstr "Irvine\n¡Eh, espera!\n¿Tú no vas?"

msgctxt "dialogue/234/0xb15"
msgid "dialogue/234/0xb15"
msgstr "Coronel Krueger\nSin el Rare Hertz, puede\nque venga el ejército\nimperial."

msgctxt "dialogue/234/0xb64"
msgid "dialogue/234/0xb64"
msgstr "Coronel Krueger\nUn buen comandante no\ndesaprovecharía esta\nocasión."

msgctxt "dialogue/234/0xba7"
msgid "dialogue/234/0xba7"
msgstr "Coronel Krueger\nNo puedo irme de aquí."

msgctxt "dialogue/234/0xbe3"
msgid "dialogue/234/0xbe3"
msgstr "Irvine\n¡Tsk! ¡¿Y por qué yo?!"

msgctxt "dialogue/234/0xc1f"
msgid "dialogue/234/0xc1f"
msgstr "Coronel Krueger\nQuién sabe, ni yo mismo\nlo sé..."

msgctxt "dialogue/234/0xc55"
msgid "dialogue/234/0xc55"
msgstr "Coronel Krueger\nPero, ¿qué te parece?"

msgctxt "dialogue/234/0xc7b"
msgid "dialogue/234/0xc7b"
msgstr "Coronel Krueger\nEl Dr. D ha terminado el\narma que usaste aquella\nvez."

msgctxt "dialogue/234/0xccc"
msgid "dialogue/234/0xccc"
msgstr "Coronel Krueger\n¿Qué tal si la pruebas\notra vez?"

msgctxt "dialogue/234/0xd1a"
msgid "dialogue/234/0xd1a"
msgstr "Irvine\nJe, ¡acepto el reto!\n¡Viejo, me la llevo\nprestada!"

msgctxt "dialogue/234/0xd70"
msgid "dialogue/234/0xd70"
msgstr "¡Irvine se unió al grupo!"

msgctxt "dialogue/236/0xc"
msgid "dialogue/236/0xc"
msgstr "Coronel Krueger\n¡El resto queda en\nvuestras manos!"

msgctxt "dialogue/237/0xc"
msgid "dialogue/237/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/237/0x2d"
msgid "dialogue/237/0x2d"
msgstr "Jack\nAsí que este es el cañón\nláser para perforar la\nroca..."

msgctxt "dialogue/237/0x71"
msgid "dialogue/237/0x71"
msgstr "Regina\nCon esto se podría abrir\nun agujero hasta en\nun volcán."

msgctxt "dialogue/237/0xb3"
msgid "dialogue/237/0xb3"
msgstr "Dr. D\n¿Habéis recuperado el\ncañón láser?"

msgctxt "dialogue/237/0xe9"
msgid "dialogue/237/0xe9"
msgstr "Jack\nSí, acabamos de hacerlo."

msgctxt "dialogue/237/0x115"
msgid "dialogue/237/0x115"
msgstr "Dr. D\nBien. Los Zoids desbocados\nse dirigen al cráter del\nvolcán Mount Ossa."

msgctxt "dialogue/237/0x172"
msgid "dialogue/237/0x172"
msgstr "Arth\n¡!"

msgctxt "dialogue/237/0x18e"
msgid "dialogue/237/0x18e"
msgstr "Regina\n¿¡Cómo dice!?"

msgctxt "dialogue/237/0x1ba"
msgid "dialogue/237/0x1ba"
msgstr "Dr. D\nParece que alguien los\nestá controlando, como\npensaba. ¡Daos prisa!"

msgctxt "dialogue/237/0x209"
msgid "dialogue/237/0x209"
msgstr "Jack\nPríncipe. Seguramente\nOpis también..."

msgctxt "dialogue/237/0x244"
msgid "dialogue/237/0x244"
msgstr "{name}\n......"

msgctxt "dialogue/237/0x265"
msgid "dialogue/237/0x265"
msgstr "Jack\nDémonos prisa, príncipe."

msgctxt "dialogue/238/0xc"
msgid "dialogue/238/0xc"
msgstr "Dr. D\nBuen trabajo."

msgctxt "dialogue/238/0x38"
msgid "dialogue/238/0x38"
msgstr "Jack\n¿Cómo están los Zoids\ndesbocados?"

msgctxt "dialogue/238/0x68"
msgid "dialogue/238/0x68"
msgstr "Dr. D\nIgual que antes.\nVan derechos al cráter."

msgctxt "dialogue/238/0xa9"
msgid "dialogue/238/0xa9"
msgstr "Dr. D\nVosotros también, id\ncuanto antes al cráter."

msgctxt "dialogue/238/0xe2"
msgid "dialogue/238/0xe2"
msgstr "Dr. D\nYa os indicaré dónde\nhay que perforar."

msgctxt "dialogue/238/0x123"
msgid "dialogue/238/0x123"
msgstr "{name}\n......"

msgctxt "dialogue/239/0xc"
msgid "dialogue/239/0xc"
msgstr "Opis\nJi, ji, ji, qué fastidio\nque me interrumpan un gran\nexperimento científico..."

msgctxt "dialogue/239/0x60"
msgid "dialogue/239/0x60"
msgstr "{name}\n......"

msgctxt "dialogue/239/0x81"
msgid "dialogue/239/0x81"
msgstr "Regina\n¡Opis!"

msgctxt "dialogue/239/0xa7"
msgid "dialogue/239/0xa7"
msgstr "Opis\n¿No sois capaces de ver la\ngrandeza de este\namplificador de Rare\nHertz?"

msgctxt "dialogue/239/0xf4"
msgid "dialogue/239/0xf4"
msgstr "Opis\nQué lamentable..."

msgctxt "dialogue/239/0x126"
msgid "dialogue/239/0x126"
msgstr "Regina\n¡No digas tonterías!"

msgctxt "dialogue/239/0x15c"
msgid "dialogue/239/0x15c"
msgstr "Opis\n¿¡Tonterías!? ¡Los tontos\nsois vosotros!"

msgctxt "dialogue/239/0x18e"
msgid "dialogue/239/0x18e"
msgstr "Opis\n¡¡No permitiré que os\ninterpongáis en mi\ncamino!!"

msgctxt "dialogue/239/0x1c8"
msgid "dialogue/239/0x1c8"
msgstr "Arth\n¿Y qué piensas hacer?"

msgctxt "dialogue/239/0x1fe"
msgid "dialogue/239/0x1fe"
msgstr "Opis\nAcabar con vosotros. ¡Con\nmis propias manos!\n¡Ji, ji, ji, ja, ja, ja!"

msgctxt "dialogue/240/0xc"
msgid "dialogue/240/0xc"
msgstr "Jack\nVan, Irvine,\nseparémonos."

msgctxt "dialogue/240/0x4b"
msgid "dialogue/240/0x4b"
msgstr "Jack\nVosotros id al cráter."

msgctxt "dialogue/240/0x89"
msgid "dialogue/240/0x89"
msgstr "Irvine\n¿Qué dices? No pienso\ndecir \"vale\" así\ncomo así."

msgctxt "dialogue/240/0xe2"
msgid "dialogue/240/0xe2"
msgstr "Van\n¡Eso! ¡Nosotros también\nluchamos!"

msgctxt "dialogue/240/0x11a"
msgid "dialogue/240/0x11a"
msgstr "Jack\nNo. Ahora mismo los Zoids\ndesbocados van hacia\nel cráter."

msgctxt "dialogue/240/0x161"
msgid "dialogue/240/0x161"
msgstr "Jack\nDejadnos esto a nosotros\ny corred al cráter."

msgctxt "dialogue/240/0x1a8"
msgid "dialogue/240/0x1a8"
msgstr "Irvine\n......Entendido.\nOs lo dejamos a vosotros."

msgctxt "dialogue/240/0x1ed"
msgid "dialogue/240/0x1ed"
msgstr "Van\n¡Irvine!"

msgctxt "dialogue/240/0x211"
msgid "dialogue/240/0x211"
msgstr "Irvine\n¡Van, no te entretengas!\n¡Y no olvides el láser\nde perforación!"

msgctxt "dialogue/240/0x262"
msgid "dialogue/240/0x262"
msgstr "Van\n¡E-eh, sí, déjamelo a mí!"

msgctxt "dialogue/241/0xc"
msgid "dialogue/241/0xc"
msgstr "Opis\n¡! ¡¡Eh, vosotros, que\naún no he terminado\nde hablar!!"

msgctxt "dialogue/241/0x5b"
msgid "dialogue/241/0x5b"
msgstr "Jack\nSi quiere hablar, ya le\nescuchamos nosotros."

msgctxt "dialogue/241/0x95"
msgid "dialogue/241/0x95"
msgstr "Opis\nQué insolencia..."

msgctxt "dialogue/241/0xbd"
msgid "dialogue/241/0xbd"
msgstr "Opis\n¡Os enseñaré que la gran\nciencia siempre acaba\ntriunfando!\n¡Ji, ji, ji, ji!"

msgctxt "dialogue/242/0xc"
msgid "dialogue/242/0xc"
msgstr "Opis\n¡Imposible! ¡¡La gran\nciencia, yo, con mi\nprodigioso cerebro...!!"

msgctxt "dialogue/242/0x61"
msgid "dialogue/242/0x61"
msgstr "Regina\n¡{name} no va a perder\ncontra un científico\nmalvado!"

msgctxt "dialogue/242/0xa9"
msgid "dialogue/242/0xa9"
msgstr "Jack\nHa perdido, doctor Opis.\n¿No podría retirarse?"

msgctxt "dialogue/242/0x102"
msgid "dialogue/242/0x102"
msgstr "Opis\n........."

msgctxt "dialogue/242/0x130"
msgid "dialogue/242/0x130"
msgstr "Opis\nJi, ji, ji... ¡Os\narrepentiréis de\nesa blandura!"

msgctxt "dialogue/243/0xc"
msgid "dialogue/243/0xc"
msgstr "Jack\n...Lo siento, príncipe.\nHe actuado por mi\ncuenta..."

msgctxt "dialogue/243/0x54"
msgid "dialogue/243/0x54"
msgstr "{name}\n......"

msgctxt "dialogue/243/0x75"
msgid "dialogue/243/0x75"
msgstr "Arth\nNo te preocupes."

msgctxt "dialogue/243/0x99"
msgid "dialogue/243/0x99"
msgstr "Regina\n......Jack, qué buenazo\neres."

msgctxt "dialogue/243/0xd5"
msgid "dialogue/243/0xd5"
msgstr "Regina\nPor cierto, ¿qué habrá\npasado con Van y\nlos demás...?"

msgctxt "dialogue/244/0xc"
msgid "dialogue/244/0xc"
msgstr "Irvine\nParece que es por aquí..."

msgctxt "dialogue/244/0x46"
msgid "dialogue/244/0x46"
msgstr "Van\n¡Muy bien, voy a darle\nun buen cañonazo!"

msgctxt "dialogue/244/0x80"
msgid "dialogue/244/0x80"
msgstr "Irvine\nCuidado, ese láser no es\ncomo un arma: solo se\npuede usar una vez.\n¡No falles!"

msgctxt "dialogue/244/0xe2"
msgid "dialogue/244/0xe2"
msgstr "Van\n¡Ya lo sé!"

msgctxt "dialogue/245/0xc"
msgid "dialogue/245/0xc"
msgstr "Van\n¡Vamos, salgamos de aquí!"

msgctxt "dialogue/245/0x3c"
msgid "dialogue/245/0x3c"
msgstr "Irvine\n¡No quiero morir abrasado\nen un sitio como este!"

msgctxt "dialogue/246/0xc"
msgid "dialogue/246/0xc"
msgstr "Dr. D\n...Parece que la erupción\nya ha remitido."

msgctxt "dialogue/246/0x51"
msgid "dialogue/246/0x51"
msgstr "Coronel Krueger\nPero usar el Rare Hertz\ncomo arma... Es\nsorprendente."

msgctxt "dialogue/246/0xa8"
msgid "dialogue/246/0xa8"
msgstr "Dr. D\nPero no funcionará\ndos veces."

msgctxt "dialogue/246/0xd0"
msgid "dialogue/246/0xd0"
msgstr "Dr. D\nBasta con fabricar en\nserie escudos protectores\ncontra el Rare Hertz."

msgctxt "dialogue/246/0x11d"
msgid "dialogue/246/0x11d"
msgstr "Dr. D\nAunque seguramente el\nImperio también tomará\nmedidas."

msgctxt "dialogue/246/0x164"
msgid "dialogue/246/0x164"
msgstr "Coronel Krueger\n...Seguramente."

msgctxt "dialogue/246/0x194"
msgid "dialogue/246/0x194"
msgstr "Dr. D\nVosotros también habéis\nhecho un gran trabajo."

msgctxt "dialogue/247/0xc"
msgid "dialogue/247/0xc"
msgstr "Coronel Krueger\nPermitidme que yo también\nos dé las gracias."

msgctxt "dialogue/247/0x4c"
msgid "dialogue/247/0x4c"
msgstr "Regina\nNo es nada. Esto también\nes asunto nuestro."

msgctxt "dialogue/247/0x91"
msgid "dialogue/247/0x91"
msgstr "Dr. D\nJo, jo, jo. ¿Algún día me\ncontaréis el motivo?"

msgctxt "dialogue/247/0xdb"
msgid "dialogue/247/0xdb"
msgstr "{name}\n......"

msgctxt "dialogue/247/0xfc"
msgid "dialogue/247/0xfc"
msgstr "Regina\nEso es..."

msgctxt "dialogue/247/0x124"
msgid "dialogue/247/0x124"
msgstr "Dr. D\nBueno, no os preocupéis.\nYa me lo contaréis."

msgctxt "dialogue/247/0x166"
msgid "dialogue/247/0x166"
msgstr "Jack\nLo siento, doctor. Ya se\nlo contaremos algún día."

msgctxt "dialogue/247/0x1a4"
msgid "dialogue/247/0x1a4"
msgstr "Dr. D\nSí, lo estoy deseando.\nHasta la próxima."

msgctxt "dialogue/248/0xc"
msgid "dialogue/248/0xc"
msgstr "Coronel Krueger\n¿Quiénes son esos?"

msgctxt "dialogue/248/0x3c"
msgid "dialogue/248/0x3c"
msgstr "Dr. D\nConocidos míos. Bueno,\nahora también son\nconocidos tuyos."

msgctxt "dialogue/248/0x99"
msgid "dialogue/248/0x99"
msgstr "Coronel Krueger\n...Ya veo. Lo dejaremos\nasí, entonces."

msgctxt "dialogue/249/0xc"
msgid "dialogue/249/0xc"
msgstr "Emperador\nPara lo mucho que\npresumía Opis... Qué\npapel tan lamentable."

msgctxt "dialogue/249/0x57"
msgid "dialogue/249/0x57"
msgstr "Blood\n¡Sí, señor! Pero ¿no nos\nserviría el amplificador\nde Rare Hertz?"

msgctxt "dialogue/249/0xa6"
msgid "dialogue/249/0xa6"
msgstr "Emperador\nNo es más que un arma de\nsorpresa. Si se protegen\ndel Rare Hertz, no sirve\nde nada."

msgctxt "dialogue/249/0x105"
msgid "dialogue/249/0x105"
msgstr "Blood\nCierto... Le pido\ndisculpas."

msgctxt "dialogue/249/0x13d"
msgid "dialogue/249/0x13d"
msgstr "Emperador\nAhórrate los halagos. Eso\nya lo sabías tú."

msgctxt "dialogue/249/0x186"
msgid "dialogue/249/0x186"
msgstr "Blood\n...Sí, señor."

msgctxt "dialogue/249/0x1ac"
msgid "dialogue/249/0x1ac"
msgstr "Emperador\nPor cierto, ¿cómo va la\ndefensa del castillo?"

msgctxt "dialogue/249/0x1e8"
msgid "dialogue/249/0x1e8"
msgstr "Blood\n¡Sí, señor! Hemos\nreforzado las defensas\nen todo el recinto."

msgctxt "dialogue/249/0x229"
msgid "dialogue/249/0x229"
msgstr "Blood\nAunque ataque el ejército\ndel Reino, las tropas del\ncastillo bastan para\nrepelerlo."

msgctxt "dialogue/249/0x284"
msgid "dialogue/249/0x284"
msgstr "Emperador\nBien, confío en ti.\nPuedes retirarte."

msgctxt "dialogue/249/0x2be"
msgid "dialogue/249/0x2be"
msgstr "Blood\n¡Sí, señor!"

msgctxt "dialogue/250/0xc"
msgid "dialogue/250/0xc"
msgstr "Emperador\n{name}, mosca molesta...\nNo toleraré que te\ninterpongas..."

msgctxt "dialogue/250/0x48"
msgid "dialogue/250/0x48"
msgstr "Emperador\n¡Gale! ¡Llamad a Gale!"

msgctxt "dialogue/251/0x3"
msgid "dialogue/251/0x3"
msgstr "Soldado del Reino\n¡Bienvenido, príncipe!"

msgctxt "dialogue/251/0x35"
msgid "dialogue/251/0x35"
msgstr "Jack\n¿Ha pasado algo?"

msgctxt "dialogue/251/0x5c"
msgid "dialogue/251/0x5c"
msgstr "Soldado del Reino\nParece que el enemigo está\nreforzando la defensa del\ncastillo de Arcadia, pero\npor lo demás, nada."

msgctxt "dialogue/251/0xb5"
msgid "dialogue/251/0xb5"
msgstr "Arth\n¿Reforzando la defensa?"

msgctxt "dialogue/251/0xe1"
msgid "dialogue/251/0xe1"
msgstr "Regina\n¿Qué querrá decir?"

msgctxt "dialogue/251/0x10b"
msgid "dialogue/251/0x10b"
msgstr "Jack\n...No lo sé. Pero más vale\nser precavidos."

msgctxt "dialogue/251/0x154"
msgid "dialogue/251/0x154"
msgstr "Jack\nSeguid vigilando el\ncastillo de Arcadia,\npor favor."

msgctxt "dialogue/251/0x194"
msgid "dialogue/251/0x194"
msgstr "Soldado del Reino\n¡Entendido!"

msgctxt "dialogue/251/0x1c0"
msgid "dialogue/251/0x1c0"
msgstr "Arth\nVenga el enemigo como\nvenga..."

msgctxt "dialogue/251/0x1f8"
msgid "dialogue/251/0x1f8"
msgstr "Jack\n...solo nos queda hacerle\nfrente, claro."

msgctxt "dialogue/251/0x232"
msgid "dialogue/251/0x232"
msgstr "Regina\nSí. Ánimo, príncipe."

msgctxt "dialogue/251/0x26b"
msgid "dialogue/251/0x26b"
msgstr "{name}\n......"

msgctxt "dialogue/252/0xc"
msgid "dialogue/252/0xc"
msgstr "Gale\n...¿Me ha llamado,\nMajestad?"

msgctxt "dialogue/252/0x3e"
msgid "dialogue/252/0x3e"
msgstr "Emperador\nSí. ¿Te has enterado de\nlo de Opis?"

msgctxt "dialogue/252/0x77"
msgid "dialogue/252/0x77"
msgstr "Gale\nHe oído que el príncipe\n{name} destruyó el\namplificador de Rare\nHertz."

msgctxt "dialogue/252/0xcd"
msgid "dialogue/252/0xcd"
msgstr "Emperador\n¡No es ningún príncipe!\n¡Quien gobierna ahora\neste país soy yo!"

msgctxt "dialogue/252/0x114"
msgid "dialogue/252/0x114"
msgstr "Gale\n...Como ordene."

msgctxt "dialogue/252/0x138"
msgid "dialogue/252/0x138"
msgstr "Emperador\n¡Un plan! ¡Dime un plan!\n¡Préstame tu ingenio de\nantiguo militar de la\nRepública!"

msgctxt "dialogue/252/0x193"
msgid "dialogue/252/0x193"
msgstr "Gale\nNos faltan tropas para\nun territorio como el\ndel Reino de Arcadia."

msgctxt "dialogue/252/0x1d8"
msgid "dialogue/252/0x1d8"
msgstr "Gale\nFortificar el castillo\nde Arcadia, frenar al\nenemigo con defensa\nmóvil y resistir-"

msgctxt "dialogue/252/0x231"
msgid "dialogue/252/0x231"
msgstr "Emperador\n¡De ningún modo!"

msgctxt "dialogue/252/0x245"
msgid "dialogue/252/0x245"
msgstr "Emperador\n¡Si dejamos que {name}\ncampe a sus anchas, solo\ndará ánimos al ejército\ndel Reino!"

msgctxt "dialogue/252/0x281"
msgid "dialogue/252/0x281"
msgstr "Emperador\n¡Si faltan tropas, que\nla calidad lo compense!"

msgctxt "dialogue/252/0x2ad"
msgid "dialogue/252/0x2ad"
msgstr "Emperador\n¡Eso, calidad! ¡Investiga\nlos Zoids del Imperio de\nla última etapa de la\nguerra!"

msgctxt "dialogue/252/0x2f0"
msgid "dialogue/252/0x2f0"
msgstr "Emperador\n¡Con esos datos\nreforzaremos los Zoids\nde nuestro ejército!"

msgctxt "dialogue/252/0x32b"
msgid "dialogue/252/0x32b"
msgstr "Emperador\n¡Gale! Viaja a través\ndel tiempo e investiga\nlos Zoids del Imperio."

msgctxt "dialogue/252/0x364"
msgid "dialogue/252/0x364"
msgstr "Emperador\nSeguramente {name} te\nperseguirá, pero..."

msgctxt "dialogue/252/0x3a4"
msgid "dialogue/252/0x3a4"
msgstr "Gale\n{name} y sus aliados...\nLos aplastaré, ya lo\nverá."

msgctxt "dialogue/252/0x3ee"
msgid "dialogue/252/0x3ee"
msgstr "Emperador\nMe tranquiliza oírlo.\nConfío en ti, Gale."

msgctxt "dialogue/252/0x424"
msgid "dialogue/252/0x424"
msgstr "Gale\n¡Sí, señor!"

msgctxt "dialogue/253/0xc"
msgid "dialogue/253/0xc"
msgstr "Emperador\nPondré a prueba tu\nlealtad... Gale."

msgctxt "dialogue/254/0x3"
msgid "dialogue/254/0x3"
msgstr "Soldado del Reino 1\n¡...! ¡Hay una vibración\nespaciotemporal! Han\nusado el dispositivo de\ntransporte\nespaciotemporal del\ncastillo."

msgctxt "dialogue/254/0x54"
msgid "dialogue/254/0x54"
msgstr "Soldado del Reino 2\n¿¡Qué!? ¡Otra vez!\n¡Avisad al príncipe y\nlos suyos enseguida!"

msgctxt "dialogue/254/0x8b"
msgid "dialogue/254/0x8b"
msgstr "Soldado del Reino 1\n¡Sí, señor!"

msgctxt "dialogue/254/0xa3"
msgid "dialogue/254/0xa3"
msgstr "Soldado del Reino 2\nMalditos... ¿Qué estarán\ntramando esta vez?"

msgctxt "dialogue/255/0xc"
msgid "dialogue/255/0xc"
msgstr "Jack\nPríncipe, han detectado\nuna vibración\nespaciotemporal."

msgctxt "dialogue/255/0x49"
msgid "dialogue/255/0x49"
msgstr "{name}\n......"

msgctxt "dialogue/255/0x6a"
msgid "dialogue/255/0x6a"
msgstr "Regina\n¿¡Otra vez!? ¿Adónde\nesta vez?"

msgctxt "dialogue/255/0x9e"
msgid "dialogue/255/0x9e"
msgstr "Arth\nNo lo sé."

msgctxt "dialogue/255/0xc0"
msgid "dialogue/255/0xc0"
msgstr "Jack\nPero no podemos pasarlo\npor alto."

msgctxt "dialogue/255/0xee"
msgid "dialogue/255/0xee"
msgstr "Jack\n¡Sigámoslos en cuanto\nestemos preparados!"

msgctxt "dialogue/256/0x3"
msgid "dialogue/256/0x3"
msgstr "Soldado del Reino 1\nLa puerta está activa.\n¡Tened cuidado!"

msgctxt "dialogue/257/0x3"
msgid "dialogue/257/0x3"
msgstr "Soldado del Reino 2\n¡Derrotad al enemigo sin\nfalta, por favor!"

msgctxt "dialogue/258/0xc"
msgid "dialogue/258/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/258/0x2d"
msgid "dialogue/258/0x2d"
msgstr "Regina\n...¿Dónde estamos?"

msgctxt "dialogue/258/0x57"
msgid "dialogue/258/0x57"
msgstr "Jack\nNo lo sé. Exploremos un\npoco los alrededores."

msgctxt "dialogue/259/0xc"
msgid "dialogue/259/0xc"
msgstr "Arth\n¡...!"

msgctxt "dialogue/259/0x28"
msgid "dialogue/259/0x28"
msgstr "Regina\n¿¡Una explosión!?"

msgctxt "dialogue/259/0x4c"
msgid "dialogue/259/0x4c"
msgstr "Jack\n¡Vamos a ver!"

msgctxt "dialogue/260/0xc"
msgid "dialogue/260/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/260/0x2d"
msgid "dialogue/260/0x2d"
msgstr "Jack\n...Esto es..."

msgctxt "dialogue/260/0x5b"
msgid "dialogue/260/0x5b"
msgstr "Arth\n......"

msgctxt "dialogue/260/0x81"
msgid "dialogue/260/0x81"
msgstr "Regina\n¿Qué demonios ha pasado\naquí?"

msgctxt "dialogue/260/0xb5"
msgid "dialogue/260/0xb5"
msgstr "Jack\nNo lo sé."

msgctxt "dialogue/260/0xd1"
msgid "dialogue/260/0xd1"
msgstr "Jack\nPero puede que haya\nsupervivientes."

msgctxt "dialogue/260/0x10d"
msgid "dialogue/260/0x10d"
msgstr "Regina\n...Tienes razón.\nVamos, príncipe."

msgctxt "dialogue/261/0xc"
msgid "dialogue/261/0xc"
msgstr "Arth\n¡...! ¿Quién anda ahí?"

msgctxt "dialogue/261/0x30"
msgid "dialogue/261/0x30"
msgstr "Regina\n¿¡Un enemigo!?"

msgctxt "dialogue/262/0xc"
msgid "dialogue/262/0xc"
msgstr "Jack\n¡Alto!"

msgctxt "dialogue/262/0x34"
msgid "dialogue/262/0x34"
msgstr "Arth\n¿Quién eres?"

msgctxt "dialogue/262/0x54"
msgid "dialogue/262/0x54"
msgstr "Jack\nSi se entrega sin\nresistirse, no le\nharemos daño."

msgctxt "dialogue/262/0x9b"
msgid "dialogue/262/0x9b"
msgstr "Gale\n...Conque no me haréis\ndaño... No has cambiado,\nJack."

msgctxt "dialogue/262/0xec"
msgid "dialogue/262/0xec"
msgstr "Jack\n¡¡...!! ¡U-usted es...!"

msgctxt "dialogue/262/0x124"
msgid "dialogue/262/0x124"
msgstr "Arth\n......"

msgctxt "dialogue/262/0x14a"
msgid "dialogue/262/0x14a"
msgstr "Regina\n¿¡Qué!?"

msgctxt "dialogue/262/0x16c"
msgid "dialogue/262/0x16c"
msgstr "{name}\n......"

msgctxt "dialogue/262/0x18d"
msgid "dialogue/262/0x18d"
msgstr "Jack\n¡Instructor Gale! ¿Q-qué\nhace aquí? ¿¡No habrá\nsido usted!?"

msgctxt "dialogue/262/0x1dc"
msgid "dialogue/262/0x1dc"
msgstr "Gale\n¿Y si así fuera?"

msgctxt "dialogue/262/0x20a"
msgid "dialogue/262/0x20a"
msgstr "Jack\nN-no puede ser..."

msgctxt "dialogue/262/0x236"
msgid "dialogue/262/0x236"
msgstr "Gale\n¿No me haréis daño?\nHmpf, qué ingenuo, Jack."

msgctxt "dialogue/262/0x277"
msgid "dialogue/262/0x277"
msgstr "Jack\n...Instructor Gale."

msgctxt "dialogue/262/0x2a3"
msgid "dialogue/262/0x2a3"
msgstr "Gale\nTe lo enseñé. Reglamento\nde combate de la\nRepública, capítulo 1."

msgctxt "dialogue/262/0x2e4"
msgid "dialogue/262/0x2e4"
msgstr "Jack\n...La victoria es siempre\npara quien va un paso por\ndelante del rival."

msgctxt "dialogue/262/0x333"
msgid "dialogue/262/0x333"
msgstr "Gale\nExacto. ¡Esto es una\nguerra, Jack!"

msgctxt "dialogue/262/0x376"
msgid "dialogue/262/0x376"
msgstr "Jack\nGuerra... ¿¡Por qué lucha\nusted, instructor!?"

msgctxt "dialogue/262/0x3c3"
msgid "dialogue/262/0x3c3"
msgstr "Gale\n...Eso no es asunto tuyo."

msgctxt "dialogue/262/0x3ef"
msgid "dialogue/262/0x3ef"
msgstr "Gale\nNo permitiré que nadie\nse interponga en mi\ncamino. Ni siquiera tú,\nJack."

msgctxt "dialogue/263/0xc"
msgid "dialogue/263/0xc"
msgstr "Jack\n......"

msgctxt "dialogue/263/0x40"
msgid "dialogue/263/0x40"
msgstr "Arth\n¿Estás bien?"

msgctxt "dialogue/263/0x62"
msgid "dialogue/263/0x62"
msgstr "Jack\nSí, perdonad..."

msgctxt "dialogue/263/0x94"
msgid "dialogue/263/0x94"
msgstr "Jack\nPríncipe, ha sido culpa\nmía."

msgctxt "dialogue/263/0xc3"
msgid "dialogue/263/0xc3"
msgstr "{name}\n......"

msgctxt "dialogue/263/0xe4"
msgid "dialogue/263/0xe4"
msgstr "Arth\n¿Quién era?"

msgctxt "dialogue/263/0x106"
msgid "dialogue/263/0x106"
msgstr "Regina\n¡Oye, Arth!"

msgctxt "dialogue/263/0x134"
msgid "dialogue/263/0x134"
msgstr "Jack\nNo, no pasa nada.\n...Escúchelo usted\ntambién, príncipe."

msgctxt "dialogue/263/0x17e"
msgid "dialogue/263/0x17e"
msgstr "{name}\n......"

msgctxt "dialogue/263/0x19f"
msgid "dialogue/263/0x19f"
msgstr "Jack\nSe llama Gale. Fue mi\ninstructor en la\nRepública cuando yo era\ncadete..."

msgctxt "dialogue/263/0x1e6"
msgid "dialogue/263/0x1e6"
msgstr "Jack\nY, cuando me destinaron\na una unidad de combate,\ntambién fue mi superior."

msgctxt "dialogue/263/0x22b"
msgid "dialogue/263/0x22b"
msgstr "Jack\nMe enseñó todo lo que\ndebe saber un militar de\nla República, desde\npilotar Zoids hasta\ndirigir operaciones..."

msgctxt "dialogue/263/0x284"
msgid "dialogue/263/0x284"
msgstr "Jack\nNo, me enseñó muchas\ncosas importantes como\npersona."

msgctxt "dialogue/263/0x2cb"
msgid "dialogue/263/0x2cb"
msgstr "Jack\n...Esta herida del\nbrazo..."

msgctxt "dialogue/263/0x2f1"
msgid "dialogue/263/0x2f1"
msgstr "Jack\nMe la hice cuando, aún\ninexperto, el enemigo me\nrodeó..."

msgctxt "dialogue/263/0x338"
msgid "dialogue/263/0x338"
msgstr "Jack\nYo ya esperaba la\nmuerte, y fue él quien\nrompió el cerco enemigo\nél solo para salvarme."

msgctxt "dialogue/263/0x399"
msgid "dialogue/263/0x399"
msgstr "Regina\n......Ya veo..."

msgctxt "dialogue/263/0x3cc"
msgid "dialogue/263/0x3cc"
msgstr "{name}\n......"

msgctxt "dialogue/263/0x3ed"
msgid "dialogue/263/0x3ed"
msgstr "Jack\n¡Y aun así! ¿¡Por qué es\nuno de ellos!?\n¿¡Por qué!?"

msgctxt "dialogue/263/0x438"
msgid "dialogue/263/0x438"
msgstr "Arth\nPues pregúntaselo."

msgctxt "dialogue/263/0x46a"
msgid "dialogue/263/0x46a"
msgstr "Jack\n...¿Eh?"

msgctxt "dialogue/263/0x490"
msgid "dialogue/263/0x490"
msgstr "Arth\nTarde o temprano os\nveréis. ¿Por qué no se lo\npreguntas entonces?"

msgctxt "dialogue/263/0x4e1"
msgid "dialogue/263/0x4e1"
msgstr "Regina\n¡Arth!"

msgctxt "dialogue/263/0x505"
msgid "dialogue/263/0x505"
msgstr "Jack\n......Tienes razón.\nPuede que sí."

msgctxt "dialogue/263/0x54d"
msgid "dialogue/263/0x54d"
msgstr "{name}\n......"

msgctxt "dialogue/263/0x56e"
msgid "dialogue/263/0x56e"
msgstr "Jack\nPríncipe... Gracias,\nArth."

msgctxt "dialogue/263/0x5a9"
msgid "dialogue/263/0x5a9"
msgstr "Arth\nMe debes una. No lo\nolvides."

msgctxt "dialogue/263/0x5d3"
msgid "dialogue/263/0x5d3"
msgstr "Jack\nSí, entendido."

msgctxt "dialogue/263/0x602"
msgid "dialogue/263/0x602"
msgstr "{name}\n......"

msgctxt "dialogue/263/0x623"
msgid "dialogue/263/0x623"
msgstr "Regina\n...Pero ¿qué os pasa?"

msgctxt "dialogue/263/0x649"
msgid "dialogue/263/0x649"
msgstr "Regina\nPor cierto, el enemigo\nde antes..."

msgctxt "dialogue/263/0x677"
msgid "dialogue/263/0x677"
msgstr "Regina\n¡Ah!"

msgctxt "dialogue/263/0x699"
msgid "dialogue/263/0x699"
msgstr "Jack\nPuedes llamarlo enemigo."

msgctxt "dialogue/263/0x6c3"
msgid "dialogue/263/0x6c3"
msgstr "Regina\n...Ese tal Gale, ¿no?\n¿Con qué objetivo habrá\natacado este lugar?"

msgctxt "dialogue/263/0x71e"
msgid "dialogue/263/0x71e"
msgstr "Jack\nEso..."

msgctxt "dialogue/263/0x73a"
msgid "dialogue/263/0x73a"
msgstr "Jack\nDe momento tenemos muy\npoca información.\nInvestiguemos la base."

msgctxt "dialogue/263/0x78b"
msgid "dialogue/263/0x78b"
msgstr "Regina\n...Vale.\nVamos."

msgctxt "dialogue/264/0xc"
msgid "dialogue/264/0xc"
msgstr "Jack\n¡Mm! Esa chica es..."

msgctxt "dialogue/264/0x3c"
msgid "dialogue/264/0x3c"
msgstr "Regina\n¿No es Fiona, la chica\nque iba con ese tal\nVan...?"

msgctxt "dialogue/264/0x8d"
msgid "dialogue/264/0x8d"
msgstr "Jack\nEso parece, pero..."

msgctxt "dialogue/264/0xbd"
msgid "dialogue/264/0xbd"
msgstr "Arth\nHa crecido."

msgctxt "dialogue/264/0xe5"
msgid "dialogue/264/0xe5"
msgstr "Regina\nSí. Eso significa que\nno estamos en la misma\népoca que la otra vez..."

msgctxt "dialogue/264/0x144"
msgid "dialogue/264/0x144"
msgstr "Jack\n...Eso parece."

msgctxt "dialogue/264/0x168"
msgid "dialogue/264/0x168"
msgstr "Jack\nEscuchad, lo del salto\nespaciotemporal..."

msgctxt "dialogue/264/0x1a4"
msgid "dialogue/264/0x1a4"
msgstr "Arth\nSí. No quiero más líos."

msgctxt "dialogue/264/0x1e0"
msgid "dialogue/264/0x1e0"
msgstr "Regina\n...Claro."

msgctxt "dialogue/264/0x209"
msgid "dialogue/264/0x209"
msgstr "{name}\n......"

msgctxt "dialogue/265/0xc"
msgid "dialogue/265/0xc"
msgstr "Fiona\n¿Eh? A-anda, vosotros\nsois..."

msgctxt "dialogue/265/0x42"
msgid "dialogue/265/0x42"
msgstr "Jack\nCuánto tiempo, Fiona."

msgctxt "dialogue/265/0x7a"
msgid "dialogue/265/0x7a"
msgstr "Fiona\nCuánto tiempo. Eh...\nJack, ¿verdad?"

msgctxt "dialogue/265/0xba"
msgid "dialogue/265/0xba"
msgstr "Jack\nHa crecido mucho."

msgctxt "dialogue/265/0xf0"
msgid "dialogue/265/0xf0"
msgstr "Fiona\nClaro, hace casi dos\naños que no nos vemos."

msgctxt "dialogue/265/0x12e"
msgid "dialogue/265/0x12e"
msgstr "Arth\n...Dos años..."

msgctxt "dialogue/265/0x15a"
msgid "dialogue/265/0x15a"
msgstr "Fiona\nCuánto tiempo a ti\ntambién, Arth."

msgctxt "dialogue/265/0x190"
msgid "dialogue/265/0x190"
msgstr "Arth\nSí."

msgctxt "dialogue/265/0x1ae"
msgid "dialogue/265/0x1ae"
msgstr "Fiona\nJi, ji. No has cambiado\nnada."

msgctxt "dialogue/265/0x1d4"
msgid "dialogue/265/0x1d4"
msgstr "Fiona\n¿Dónde habéis estado\ndesde entonces?"

msgctxt "dialogue/265/0x202"
msgid "dialogue/265/0x202"
msgstr "Jack\n¡Eh! Sí, bueno, verá,\neh..."

msgctxt "dialogue/265/0x242"
msgid "dialogue/265/0x242"
msgstr "Arth\nAquí y allá."

msgctxt "dialogue/265/0x262"
msgid "dialogue/265/0x262"
msgstr "Fiona\n¿Aquí y allá? Debe de\nser agotador."

msgctxt "dialogue/265/0x298"
msgid "dialogue/265/0x298"
msgstr "Jack\n...No, no tanto..."

msgctxt "dialogue/265/0x2d2"
msgid "dialogue/265/0x2d2"
msgstr "Fiona\n......¿Eh?"

msgctxt "dialogue/266/0xc"
msgid "dialogue/266/0xc"
msgstr "Fiona\n{name} y Regina no\nhabéis cambiado nada."

msgctxt "dialogue/266/0x4e"
msgid "dialogue/266/0x4e"
msgstr "Jack\n¡!"

msgctxt "dialogue/266/0x6c"
msgid "dialogue/266/0x6c"
msgstr "Arth\n¡¡!!"

msgctxt "dialogue/266/0x8a"
msgid "dialogue/266/0x8a"
msgstr "Fiona\n...Es como si el tiempo\nse hubiera detenido\ndesde entonces..."

msgctxt "dialogue/266/0xd8"
msgid "dialogue/266/0xd8"
msgstr "{name}\n......"

msgctxt "dialogue/266/0xf9"
msgid "dialogue/266/0xf9"
msgstr "Regina\n¡N-no es verdad!"

msgctxt "dialogue/266/0x11f"
msgid "dialogue/266/0x11f"
msgstr "Regina\nPues he crecido, y\nmucho, en todo lo que\ntenía que crecer—"

msgctxt "dialogue/266/0x168"
msgid "dialogue/266/0x168"
msgstr "Arth\nMenos en el pecho."

msgctxt "dialogue/266/0x18a"
msgid "dialogue/266/0x18a"
msgstr "Regina\n¡Ugh...!"

msgctxt "dialogue/266/0x1b2"
msgid "dialogue/266/0x1b2"
msgstr "Fiona\nJi, ji, ji.\nSeguís igual que siempre."

msgctxt "dialogue/266/0x1ed"
msgid "dialogue/266/0x1ed"
msgstr "Jack\nPerdona el numerito.\n¿Y qué haces tú aquí?"

msgctxt "dialogue/266/0x236"
msgid "dialogue/266/0x236"
msgstr "Fiona\nPues verás..."

msgctxt "dialogue/266/0x254"
msgid "dialogue/266/0x254"
msgstr "Fiona\nÚltimamente están\natacando una tras otra\nlas bases de la zona\nfronteriza..."

msgctxt "dialogue/266/0x2bb"
msgid "dialogue/266/0x2bb"
msgstr "Regina\n¿No es solo esta base?"

msgctxt "dialogue/266/0x2ef"
msgid "dialogue/266/0x2ef"
msgstr "Fiona\nNo. Ya han atacado\nmuchísimas bases..."

msgctxt "dialogue/266/0x321"
msgid "dialogue/266/0x321"
msgstr "Fiona\nQuería descubrir al\nmenos quién es el\nenemigo, pero..."

msgctxt "dialogue/266/0x360"
msgid "dialogue/266/0x360"
msgstr "Fiona\nParece que esta vez\ntambién llegué tarde."

msgctxt "dialogue/266/0x394"
msgid "dialogue/266/0x394"
msgstr "Regina\n......"

msgctxt "dialogue/266/0x3bc"
msgid "dialogue/266/0x3bc"
msgstr "Jack\n......\n¿Pero por qué estás tú\nen esto, Fiona?"

msgctxt "dialogue/266/0x401"
msgid "dialogue/266/0x401"
msgstr "Fiona\nAyudo a la Guardian\nForce en sus misiones."

msgctxt "dialogue/266/0x44e"
msgid "dialogue/266/0x44e"
msgstr "Regina\n¿La Guardian Force?"

msgctxt "dialogue/266/0x480"
msgid "dialogue/266/0x480"
msgstr "Fiona\nSí. Van y Zeke están\nconmigo. Y también el\nteniente Schwarz."

msgctxt "dialogue/266/0x4d3"
msgid "dialogue/266/0x4d3"
msgstr "Arth\nYa veo. La Guardian\nForce. Impresionante."

msgctxt "dialogue/267/0xc"
msgid "dialogue/267/0xc"
msgstr "Fiona\nJe, je. Increíble,\n¿verdad?"

msgctxt "dialogue/268/0xc"
msgid "dialogue/268/0xc"
msgstr "Regina\nOye, Arth, ¿tú sabes\nqué es la Guardian\nForce...?"

msgctxt "dialogue/268/0x63"
msgid "dialogue/268/0x63"
msgstr "Jack\n¡Qué va! Lo ha dicho\npor decir."

msgctxt "dialogue/268/0x9d"
msgid "dialogue/268/0x9d"
msgstr "Fiona\n¿Y vosotros qué hacéis\naquí?"

msgctxt "dialogue/268/0xcf"
msgid "dialogue/268/0xcf"
msgstr "Arth\nSeguimos a un hombre.\nLo vimos cerca de aquí."

msgctxt "dialogue/268/0x118"
msgid "dialogue/268/0x118"
msgstr "Fiona\n...Mmm. ¿Será de la banda\nque ha atacado la base?"

msgctxt "dialogue/268/0x161"
msgid "dialogue/268/0x161"
msgstr "Arth\nEs posible."

msgctxt "dialogue/268/0x189"
msgid "dialogue/268/0x189"
msgstr "Fiona\n¿Y si lo buscamos\njuntos? ¡Cuantos más\nseamos, más divertido!"

msgctxt "dialogue/268/0x1ea"
msgid "dialogue/268/0x1ea"
msgstr "Arth\nSí, sin problema."

msgctxt "dialogue/269/0xc"
msgid "dialogue/269/0xc"
msgstr "Regina\n¡Oye! ¡¡Arth!!\n¿Cómo que sin problema?"

msgctxt "dialogue/269/0x4f"
msgid "dialogue/269/0x4f"
msgstr "Jack\nNo, puede que Arth\ntenga razón."

msgctxt "dialogue/269/0x98"
msgid "dialogue/269/0x98"
msgstr "Regina\n¿Jack?"

msgctxt "dialogue/269/0xbe"
msgid "dialogue/269/0xbe"
msgstr "Jack\nElla tiene más\ninformación. No vamos a\nsalir perdiendo."

msgctxt "dialogue/269/0x117"
msgid "dialogue/269/0x117"
msgstr "Regina\n...Está bien.\nVamos juntos."

msgctxt "dialogue/269/0x158"
msgid "dialogue/269/0x158"
msgstr "Fiona\n¡Bien!\nAsí podremos volver a\nviajar juntos."

msgctxt "dialogue/269/0x19b"
msgid "dialogue/269/0x19b"
msgstr "Fiona\nEl próximo objetivo será\nseguramente la base Bego,\nal oeste. ¡Vamos rápido!"

msgctxt "dialogue/269/0x1f4"
msgid "dialogue/269/0x1f4"
msgstr "Fiona\nPuede que ya la hayan\natacado."

msgctxt "dialogue/269/0x233"
msgid "dialogue/269/0x233"
msgstr "{name}\n......"

msgctxt "dialogue/269/0x254"
msgid "dialogue/269/0x254"
msgstr "Regina\n¡¡Cómo!! ¿¡Y por qué no\nlo dices antes!?\n¡Vamos, deprisa!"

msgctxt "dialogue/269/0x29a"
msgid "dialogue/269/0x29a"
msgstr "¡Fiona se ha unido\nal grupo!"

msgctxt "dialogue/270/0xc"
msgid "dialogue/270/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/270/0x2d"
msgid "dialogue/270/0x2d"
msgstr "Jack\nEsto está muy\ntranquilo..."

msgctxt "dialogue/270/0x61"
msgid "dialogue/270/0x61"
msgstr "Regina\n¿Ya la habrán atacado?"

msgctxt "dialogue/270/0x8b"
msgid "dialogue/270/0x8b"
msgstr "Jack\n...Quién sabe. Puede\nque sea el enemigo.\nVayamos con cuidado—"

msgctxt "dialogue/270/0xdc"
msgid "dialogue/270/0xdc"
msgstr "Arth\nNo va a poder ser."

msgctxt "dialogue/270/0x10a"
msgid "dialogue/270/0x10a"
msgstr "Regina\n¿?\n...Oye, ¿y Fiona?"

msgctxt "dialogue/270/0x145"
msgid "dialogue/270/0x145"
msgstr "Arth\nDijo que iba a entrar\nsola en la base y se fue."

msgctxt "dialogue/270/0x185"
msgid "dialogue/270/0x185"
msgstr "Regina\n¿¡Y qué haces!?\n¡¡Haberla detenido!!"

msgctxt "dialogue/271/0xc"
msgid "dialogue/271/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/271/0x2e"
msgid "dialogue/271/0x2e"
msgstr "Regina\n¿Qué? ¿¡Enemigos!?"

msgctxt "dialogue/271/0x56"
msgid "dialogue/271/0x56"
msgstr "Arth\nNos tienen rodeados."

msgctxt "dialogue/271/0x82"
msgid "dialogue/271/0x82"
msgstr "Jack\n......Ni siquiera noté\nal enemigo... ¿¡Pero qué\nestoy haciendo!?"

msgctxt "dialogue/271/0xe9"
msgid "dialogue/271/0xe9"
msgstr "Arth\nYa te lamentarás luego."

msgctxt "dialogue/271/0x113"
msgid "dialogue/271/0x113"
msgstr "Regina\nEso. Ahora hay que salir\nde esta como sea."

msgctxt "dialogue/271/0x155"
msgid "dialogue/271/0x155"
msgstr "Jack\n...Tenéis razón.\n¿Cómo estamos?"

msgctxt "dialogue/271/0x18b"
msgid "dialogue/271/0x18b"
msgstr "Arth\nMal. No tienen ni un\npunto débil. Están bien\nentrenados."

msgctxt "dialogue/271/0x1c8"
msgid "dialogue/271/0x1c8"
msgstr "Arth\nNo en vano son la\nPrimera División\nAcorazada del Imperio."

msgctxt "dialogue/271/0x208"
msgid "dialogue/271/0x208"
msgstr "Regina\n¿La Primera División\nAcorazada?"

msgctxt "dialogue/271/0x232"
msgid "dialogue/271/0x232"
msgstr "Arth\nSí, ese estandarte no\ndeja lugar a dudas."

msgctxt "dialogue/271/0x26a"
msgid "dialogue/271/0x26a"
msgstr "Jack\nEl Imperio... Entonces,\n¿tendrá relación con\nlos atacantes—?"

msgctxt "dialogue/271/0x2b3"
msgid "dialogue/271/0x2b3"
msgstr "Schwarz\nAquí la Primera División\nAcorazada del Imperio.\nLes habla su comandante,\nel coronel Schwarz."

msgctxt "dialogue/271/0x2fa"
msgid "dialogue/271/0x2fa"
msgstr "Schwarz\nNo opongan una\nresistencia inútil y\ndepongan las armas."

msgctxt "dialogue/271/0x33b"
msgid "dialogue/271/0x33b"
msgstr "Schwarz\nEstán completamente\nrodeados."

msgctxt "dialogue/271/0x367"
msgid "dialogue/271/0x367"
msgstr "Schwarz\nRepito: no opongan una\nresistencia inútil y\ndepongan las armas."

msgctxt "dialogue/271/0x3b6"
msgid "dialogue/271/0x3b6"
msgstr "Regina\nQué caballeroso. Nada\nque ver con alguien que\nyo me sé."

msgctxt "dialogue/271/0x3f2"
msgid "dialogue/271/0x3f2"
msgstr "Arth\nCon una dama recatada\nyo también sería un\ncaballero."

msgctxt "dialogue/271/0x437"
msgid "dialogue/271/0x437"
msgstr "Regina\n...¿Qué quieres decir\ncon eso...?"

msgctxt "dialogue/271/0x46d"
msgid "dialogue/271/0x46d"
msgstr "Jack\nArth, y tú también,\nRegina, no es momento\npara esto."

msgctxt "dialogue/271/0x4bf"
msgid "dialogue/271/0x4bf"
msgstr "{name}\n......"

msgctxt "dialogue/271/0x4e0"
msgid "dialogue/271/0x4e0"
msgstr "Jack\n¿? ¿Qué ocurre, príncipe?\n¡Fiona!"

msgctxt "dialogue/271/0x527"
msgid "dialogue/271/0x527"
msgstr "Fiona\n¡Coronel! ¡Coronel\nSchwarz!"

msgctxt "dialogue/271/0x55b"
msgid "dialogue/271/0x55b"
msgstr "Regina\n¿Os conocéis?"

msgctxt "dialogue/271/0x581"
msgid "dialogue/271/0x581"
msgstr "Jack\n...Eso parece."

msgctxt "dialogue/271/0x5b9"
msgid "dialogue/271/0x5b9"
msgstr "Arth\nParece que nos hemos\nsalvado."

msgctxt "dialogue/272/0xc"
msgid "dialogue/272/0xc"
msgstr "Schwarz\nFiona me lo ha contado\ntodo."

msgctxt "dialogue/272/0x34"
msgid "dialogue/272/0x34"
msgstr "Schwarz\nSiento haber sido tan\nbrusco. Disculpadme."

msgctxt "dialogue/272/0x7d"
msgid "dialogue/272/0x7d"
msgstr "Jack\nAl contrario, coronel.\nSu maniobra ha sido\nadmirable."

msgctxt "dialogue/272/0xc6"
msgid "dialogue/272/0xc6"
msgstr "Schwarz\nJa, ja, ja. Qué amable."

msgctxt "dialogue/272/0xf8"
msgid "dialogue/272/0xf8"
msgstr "Schwarz\nPero si vais con Fiona,\n¿también sois de la\nGuardian Force?"

msgctxt "dialogue/272/0x15b"
msgid "dialogue/272/0x15b"
msgstr "Regina\nEh... pues nosotros—"

msgctxt "dialogue/272/0x18b"
msgid "dialogue/272/0x18b"
msgstr "Fiona\nSí. Investigamos los\nataques a bases de la\nzona fronteriza."

msgctxt "dialogue/272/0x1dc"
msgid "dialogue/272/0x1dc"
msgstr "Fiona\n¿Y usted, coronel\nSchwarz?"

msgctxt "dialogue/272/0x20a"
msgid "dialogue/272/0x20a"
msgstr "Schwarz\n...No. Recibimos una\nllamada de emergencia de\nesta base y vinimos,\npero..."

msgctxt "dialogue/272/0x26b"
msgid "dialogue/272/0x26b"
msgstr "Jack\nY los atacantes ya se\nhabían marchado..."

msgctxt "dialogue/272/0x2a7"
msgid "dialogue/272/0x2a7"
msgstr "Schwarz\nExacto. Y entonces\naparecisteis vosotros."

msgctxt "dialogue/272/0x2ed"
msgid "dialogue/272/0x2ed"
msgstr "Fiona\nEntonces, ¿usted tampoco\nsabe quiénes son los\natacantes, coronel?"

msgctxt "dialogue/272/0x344"
msgid "dialogue/272/0x344"
msgstr "Schwarz\nNo. La llamada solo\ndecía que era una mujer\nde pelo azul."

msgctxt "dialogue/272/0x3a1"
msgid "dialogue/272/0x3a1"
msgstr "Fiona\nUna mujer de pelo\nazul..."

msgctxt "dialogue/272/0x3cd"
msgid "dialogue/272/0x3cd"
msgstr "Arth\n¿No era el barbudo?"

msgctxt "dialogue/272/0x407"
msgid "dialogue/272/0x407"
msgstr "Schwarz\n¿El barbudo? No dijeron\nnada de eso. ¿Quién es?"

msgctxt "dialogue/272/0x468"
msgid "dialogue/272/0x468"
msgstr "Jack\n...Creemos que forma\nparte... de la banda que\nataca las bases."

msgctxt "dialogue/272/0x4af"
msgid "dialogue/272/0x4af"
msgstr "Schwarz\n...Ya veo."

msgctxt "dialogue/272/0x4d9"
msgid "dialogue/272/0x4d9"
msgstr "Regina\n...Jack..."

msgctxt "dialogue/272/0x509"
msgid "dialogue/272/0x509"
msgstr "Schwarz\n¿Qué vais a hacer ahora?"

msgctxt "dialogue/272/0x541"
msgid "dialogue/272/0x541"
msgstr "Fiona\nSi aquí está todo bien,\niremos más al oeste, a\nla base Zeta."

msgctxt "dialogue/272/0x586"
msgid "dialogue/272/0x586"
msgstr "Fiona\nTambién podrían\natacarla."

msgctxt "dialogue/272/0x5c4"
msgid "dialogue/272/0x5c4"
msgstr "Schwarz\nYa veo. Entonces os\nacompañaré."

msgctxt "dialogue/272/0x5fc"
msgid "dialogue/272/0x5fc"
msgstr "Fiona\n¿De verdad? ¡Muchas\ngracias!"

msgctxt "dialogue/272/0x63c"
msgid "dialogue/272/0x63c"
msgstr "Schwarz\nEs muy probable que esa\nmujer de pelo azul sea\nalguien que conozco."

msgctxt "dialogue/272/0x695"
msgid "dialogue/272/0x695"
msgstr "Fiona\n...Sí, es cierto."

msgctxt "dialogue/272/0x6c1"
msgid "dialogue/272/0x6c1"
msgstr "Schwarz\n¿Os importa que os\nacompañe?"

msgctxt "dialogue/272/0x701"
msgid "dialogue/272/0x701"
msgstr "Arth\nSin problema."

msgctxt "dialogue/272/0x723"
msgid "dialogue/272/0x723"
msgstr "Regina\nContamos con usted,\ncoronel Schwarz."

msgctxt "dialogue/272/0x75a"
msgid "dialogue/272/0x75a"
msgstr "Schwarz se ha unido\nal grupo."

msgctxt "dialogue/273/0xc"
msgid "dialogue/273/0xc"
msgstr "Schwarz\n...Parece que no hemos\nllegado a tiempo."

msgctxt "dialogue/273/0x50"
msgid "dialogue/273/0x50"
msgstr "Jack\n......De todos modos,\npuede que haya alguna\npista."

msgctxt "dialogue/273/0x99"
msgid "dialogue/273/0x99"
msgstr "Jack\nEntremos a echar un\nvistazo."

msgctxt "dialogue/274/0xc"
msgid "dialogue/274/0xc"
msgstr "Fiona\n¡Van!"

msgctxt "dialogue/274/0x30"
msgid "dialogue/274/0x30"
msgstr "Van\n¡Fiona!"

msgctxt "dialogue/274/0x54"
msgid "dialogue/274/0x54"
msgstr "Schwarz\nSe te ve bien, Van\nFlyheight."

msgctxt "dialogue/274/0x92"
msgid "dialogue/274/0x92"
msgstr "Van\n¡Tú también has venido,\nSchwarz! Pues a ti\ntambién se te ve bien."

msgctxt "dialogue/274/0xd1"
msgid "dialogue/274/0xd1"
msgstr "Van\n¡Pero si sois vosotros!"

msgctxt "dialogue/274/0xfa"
msgid "dialogue/274/0xfa"
msgstr "{name}\n......"

msgctxt "dialogue/274/0x11b"
msgid "dialogue/274/0x11b"
msgstr "Jack\nCuánto tiempo, Van."

msgctxt "dialogue/274/0x151"
msgid "dialogue/274/0x151"
msgstr "Van\n¡Y que lo digas! ¿Qué\nhabéis estado haciendo?"

msgctxt "dialogue/274/0x18f"
msgid "dialogue/274/0x18f"
msgstr "Arth\nDe todo."

msgctxt "dialogue/274/0x1af"
msgid "dialogue/274/0x1af"
msgstr "Van\n¡De todo! ¡Pues ya me lo\ncontaréis!"

msgctxt "dialogue/274/0x1e1"
msgid "dialogue/274/0x1e1"
msgstr "Van\n¿? {name}, no has\ncrecido nada, ¿eh?"

msgctxt "dialogue/274/0x21b"
msgid "dialogue/274/0x21b"
msgstr "Fiona\nA {name} no le gusta\nla leche."

msgctxt "dialogue/274/0x243"
msgid "dialogue/274/0x243"
msgstr "Jack/Arth/Regina\n......"

msgctxt "dialogue/274/0x27f"
msgid "dialogue/274/0x27f"
msgstr "Van\nHay que comer de todo.\nSi no, nunca serás un\nbuen piloto de Zoids."

msgctxt "dialogue/274/0x2d9"
msgid "dialogue/274/0x2d9"
msgstr "{name}\n......"

msgctxt "dialogue/274/0x2fa"
msgid "dialogue/274/0x2fa"
msgstr "Fiona\n¿Has averiguado algo,\nVan?"

msgctxt "dialogue/274/0x328"
msgid "dialogue/274/0x328"
msgstr "Van\nNo, cuando llegué ya\nestaba todo así."

msgctxt "dialogue/274/0x35c"
msgid "dialogue/274/0x35c"
msgstr "Van\nPero..."

msgctxt "dialogue/274/0x37e"
msgid "dialogue/274/0x37e"
msgstr "Fiona\n¿Pero?"

msgctxt "dialogue/274/0x3a0"
msgid "dialogue/274/0x3a0"
msgstr "Van\nSegún los supervivientes,\nel atacante era un hombre\ncon un organoide rojo."

msgctxt "dialogue/274/0x3ff"
msgid "dialogue/274/0x3ff"
msgstr "Fiona\nUn organoide rojo...\nEntonces..."

msgctxt "dialogue/274/0x439"
msgid "dialogue/274/0x439"
msgstr "Van\nSí, seguramente fue ese\ntipo, Hiltz."

msgctxt "dialogue/274/0x473"
msgid "dialogue/274/0x473"
msgstr "Jack\n¿Hiltz? ¿Quién es?"

msgctxt "dialogue/274/0x4a5"
msgid "dialogue/274/0x4a5"
msgstr "Van\nNo lo sé. Solo sé que\nes un hombre con un\norganoide rojo."

msgctxt "dialogue/274/0x4e2"
msgid "dialogue/274/0x4e2"
msgstr "Van\nPero está claro que\nactúa con algún\nobjetivo."

msgctxt "dialogue/274/0x529"
msgid "dialogue/274/0x529"
msgstr "Jack\nAun así, esto es un\nproblema."

msgctxt "dialogue/274/0x559"
msgid "dialogue/274/0x559"
msgstr "Arth\n¿Por qué?"

msgctxt "dialogue/274/0x57b"
msgid "dialogue/274/0x57b"
msgstr "Jack\nCada ataque a una base\nlo ha hecho alguien\ndistinto."

msgctxt "dialogue/274/0x5bf"
msgid "dialogue/274/0x5bf"
msgstr "Van\n¿En serio?"

msgctxt "dialogue/274/0x5e3"
msgid "dialogue/274/0x5e3"
msgstr "Fiona\nSí. Parece que el coronel\nSchwarz se encontró con\nReese. Y la base Ark la\natacó..."

msgctxt "dialogue/274/0x64c"
msgid "dialogue/274/0x64c"
msgstr "Jack\n...Un hombre llamado\nGale."

msgctxt "dialogue/274/0x680"
msgid "dialogue/274/0x680"
msgstr "Van\n¿Gale?"

msgctxt "dialogue/274/0x6a0"
msgid "dialogue/274/0x6a0"
msgstr "Fiona\nPor lo visto, es el\nseñor de la barba."

msgctxt "dialogue/274/0x6d0"
msgid "dialogue/274/0x6d0"
msgstr "Van\n¿Y eso qué significa?"

msgctxt "dialogue/274/0x6f4"
msgid "dialogue/274/0x6f4"
msgstr "Schwarz\nAún tenemos muy poca\ninformación."

msgctxt "dialogue/274/0x72c"
msgid "dialogue/274/0x72c"
msgstr "Jack\nConvendría ordenar la\ninformación que tenemos."

msgctxt "dialogue/274/0x76e"
msgid "dialogue/274/0x76e"
msgstr "Van\n¡Ah! Creo que había un\npueblo cerca de aquí."

msgctxt "dialogue/274/0x7a8"
msgid "dialogue/274/0x7a8"
msgstr "Schwarz\nBien. Reagrupémonos\nallí."

msgctxt "dialogue/275/0xc"
msgid "dialogue/275/0xc"
msgstr "Fiona\n¡Irvine! ¡Moonbay!"

msgctxt "dialogue/275/0x40"
msgid "dialogue/275/0x40"
msgstr "Moonbay\n¿Eh? ...¡Ah!\n¡Fiona! ¿Qué tal estás?"

msgctxt "dialogue/275/0x81"
msgid "dialogue/275/0x81"
msgstr "Van\n¡Moonbay!"

msgctxt "dialogue/275/0xa3"
msgid "dialogue/275/0xa3"
msgstr "Moonbay\n¿Eres tú, Van?\n¡Te veo aún más fuerte\nque antes!"

msgctxt "dialogue/275/0xf0"
msgid "dialogue/275/0xf0"
msgstr "Van\n¡Lo mismo digo! ¿Qué\nhaces por aquí?"

msgctxt "dialogue/275/0x12f"
msgid "dialogue/275/0x12f"
msgstr "Irvine\nYo sooy la transportista\ndel desieertooo...\no algo así."

msgctxt "dialogue/275/0x16c"
msgid "dialogue/275/0x16c"
msgstr "Irvine\nY además, la que me\npaga el sueldo."

msgctxt "dialogue/275/0x1a8"
msgid "dialogue/275/0x1a8"
msgstr "Moonbay\nEso. Últimamente la zona\nfronteriza es peligrosa.\nLo he contratado como\nguardaespaldas."

msgctxt "dialogue/275/0x203"
msgid "dialogue/275/0x203"
msgstr "Irvine\n¿Y qué hacéis vosotros?"

msgctxt "dialogue/275/0x22f"
msgid "dialogue/275/0x22f"
msgstr "Irvine\nCuántas caras conocidas\njuntas, ¿eh?"

msgctxt "dialogue/275/0x276"
msgid "dialogue/275/0x276"
msgstr "Jack\nCuánto tiempo sin verle."

msgctxt "dialogue/275/0x2a0"
msgid "dialogue/275/0x2a0"
msgstr "Arth\nSigues con esa mirada\nde pocos amigos."

msgctxt "dialogue/275/0x2d4"
msgid "dialogue/275/0x2d4"
msgstr "Irvine\n¡Mira quién habla! ¡Tú\ntampoco has cambiado!"

msgctxt "dialogue/275/0x30e"
msgid "dialogue/275/0x30e"
msgstr "Moonbay\nDéjalo ya, Irvine."

msgctxt "dialogue/275/0x332"
msgid "dialogue/275/0x332"
msgstr "Moonbay\n¿Qué hacéis aquí en\nrealidad? ¿Es por los\nataques a las bases de\nla frontera?"

msgctxt "dialogue/275/0x385"
msgid "dialogue/275/0x385"
msgstr "Van\nSí. Pero solo sabemos\ncómo son los culpables."

msgctxt "dialogue/275/0x3c1"
msgid "dialogue/275/0x3c1"
msgstr "Fiona\nUna chica de pelo azul,\nun hombre con un\norganoide rojo y el\nseñor de la barba."

msgctxt "dialogue/275/0x40f"
msgid "dialogue/275/0x40f"
msgstr "Irvine/Moonbay\n......"

msgctxt "dialogue/275/0x443"
msgid "dialogue/275/0x443"
msgstr "Irvine\n...¿Los de hace un rato?"

msgctxt "dialogue/275/0x479"
msgid "dialogue/275/0x479"
msgstr "Moonbay\nPor la descripción,\nparecen ellos, pero..."

msgctxt "dialogue/275/0x4b9"
msgid "dialogue/275/0x4b9"
msgstr "Van\n¿Sabéis algo?"

msgctxt "dialogue/275/0x4e3"
msgid "dialogue/275/0x4e3"
msgstr "Moonbay\nDe camino hacia aquí,"

msgctxt "dialogue/275/0x519"
msgid "dialogue/275/0x519"
msgstr "Moonbay\nvimos a esos tres ir\nhacia la base Deme."

msgctxt "dialogue/275/0x56a"
msgid "dialogue/275/0x56a"
msgstr "Van\n¡¿En serio, Moonbay?!"

msgctxt "dialogue/275/0x596"
msgid "dialogue/275/0x596"
msgstr "Moonbay\nAunque no es seguro."

msgctxt "dialogue/275/0x5c2"
msgid "dialogue/275/0x5c2"
msgstr "Irvine\nBueno, no pasan\ndesapercibidos. Seguro\nque eran ellos."

msgctxt "dialogue/275/0x604"
msgid "dialogue/275/0x604"
msgstr "Moonbay\nBueno, nosotros nos\nvamos ya. ¡Hasta luego,\nVan, Fiona!"

msgctxt "dialogue/275/0x655"
msgid "dialogue/275/0x655"
msgstr "Fiona\n¿Ya os vais?"

msgctxt "dialogue/275/0x683"
msgid "dialogue/275/0x683"
msgstr "Moonbay\nEsta carga tiene que\nllegar a su hora,"

msgctxt "dialogue/275/0x6be"
msgid "dialogue/275/0x6be"
msgstr "Moonbay\nasí que no podemos\nentretenernos mucho."

msgctxt "dialogue/275/0x6f0"
msgid "dialogue/275/0x6f0"
msgstr "Irvine\nJe. Como sois vosotros,\n¡os regalo esto!"

msgctxt "dialogue/275/0x73b"
msgid "dialogue/275/0x73b"
msgstr "Irvine\n¡Hasta la vista!"

msgctxt "dialogue/276/0xc"
msgid "dialogue/276/0xc"
msgstr "Van\nAsí que lo siguiente es\nla base Deme. ¿Qué es lo\nque buscan?"

msgctxt "dialogue/276/0x4c"
msgid "dialogue/276/0x4c"
msgstr "Regina\nSi estaban los tres\njuntos..."

msgctxt "dialogue/276/0x86"
msgid "dialogue/276/0x86"
msgstr "Jack\nEl Instructor Gale con\nesos tales Hiltz y\nReese... Pero ¿por qué?"

msgctxt "dialogue/276/0xe1"
msgid "dialogue/276/0xe1"
msgstr "Fiona\nVamos a ver. ¡A la base\nde investigación Deme!"

msgctxt "dialogue/276/0x11f"
msgid "dialogue/276/0x11f"
msgstr "Arth\nSí. Allí se aclarará\ntodo."

msgctxt "dialogue/276/0x160"
msgid "dialogue/276/0x160"
msgstr "{name}\n......"

msgctxt "dialogue/277/0x3"
msgid "dialogue/277/0x3"
msgstr "Soldado imperial\nA partir de aquí, se\nprohíbe el paso a los\nciviles."

msgctxt "dialogue/278/0x3"
msgid "dialogue/278/0x3"
msgstr "Soldado imperial\nA partir de aquí, se\nprohíbe el paso a los\nciviles."

msgctxt "dialogue/278/0x45"
msgid "dialogue/278/0x45"
msgstr "Schwarz\nSoy el Coronel Schwarz,\njefe de la Primera\nDivisión Acorazada del\nImperio. ¡Déjeme pasar!"

msgctxt "dialogue/278/0xa1"
msgid "dialogue/278/0xa1"
msgstr "Soldado imperial\nSin permiso del\ncomandante Hiltz, nadie\npuede pasar de aquí."

msgctxt "dialogue/278/0xfc"
msgid "dialogue/278/0xfc"
msgstr "Schwarz\n¡¿Comandante Hiltz?!\n¡El comandante de esta\nbase no se llama así!"

msgctxt "dialogue/278/0x147"
msgid "dialogue/278/0x147"
msgstr "Schwarz\n¡Pasaré aunque sea por\nla fuerza!"

msgctxt "dialogue/278/0x178"
msgid "dialogue/278/0x178"
msgstr "Soldado imperial\nAunque me diga eso,\nseñor..."

msgctxt "dialogue/278/0x1b4"
msgid "dialogue/278/0x1b4"
msgstr "Jack\nCoronel, aún no tenemos\npruebas claras."

msgctxt "dialogue/278/0x1f7"
msgid "dialogue/278/0x1f7"
msgstr "Jack\nInvestiguemos un poco\nmás por la zona."

msgctxt "dialogue/278/0x235"
msgid "dialogue/278/0x235"
msgstr "Fiona\nEso, eso. Hay que\ncalmarse y tomar un café\ncon sal. Creo que había\nuna ciudad grande al sur."

msgctxt "dialogue/278/0x2a0"
msgid "dialogue/278/0x2a0"
msgstr "Schwarz\n......"

msgctxt "dialogue/279/0xc"
msgid "dialogue/279/0xc"
msgstr "Fiona\n¿Eh? Eso es..."

msgctxt "dialogue/279/0x38"
msgid "dialogue/279/0x38"
msgstr "Schwarz\n¿Un Dibison? ¡¿Thomas?!"

msgctxt "dialogue/279/0x70"
msgid "dialogue/279/0x70"
msgstr "Thomas\nEres tú, hermano... Te\nderrotaré y demostraré\nque soy un militar\nexcelente..."

msgctxt "dialogue/279/0xd3"
msgid "dialogue/279/0xd3"
msgstr "Van\n¿Eh? ¿Qué dices, Thomas?\n¿Te ha afectado el calor?"

msgctxt "dialogue/279/0x11e"
msgid "dialogue/279/0x11e"
msgstr "Thomas\nNo dejaré que te quedes\ncon la señorita Fiona...\nMuere, Van."

msgctxt "dialogue/279/0x15b"
msgid "dialogue/279/0x15b"
msgstr "Thomas\n¡Beak! ¡Megalomax!"

msgctxt "dialogue/279/0x197"
msgid "dialogue/279/0x197"
msgstr "Van\n¡O-oye!"

msgctxt "dialogue/279/0x1bb"
msgid "dialogue/279/0x1bb"
msgstr "Fiona\n¡Van! ¡Al Teniente\nSchwarz le pasa algo!"

msgctxt "dialogue/279/0x1f5"
msgid "dialogue/279/0x1f5"
msgstr "Van\n¡Ah! ¡¿Lo está\ncontrolando Reese?!"

msgctxt "dialogue/279/0x225"
msgid "dialogue/279/0x225"
msgstr "Van\n¡Maldita sea, le daré un\npuñetazo a Thomas para\nque entre en razón!"

msgctxt "dialogue/279/0x260"
msgid "dialogue/279/0x260"
msgstr "Van\n¡Vamos!"

msgctxt "dialogue/280/0xc"
msgid "dialogue/280/0xc"
msgstr "Fiona\n¡Teniente Schwarz!"

msgctxt "dialogue/280/0x38"
msgid "dialogue/280/0x38"
msgstr "Thomas\n¡Ah! ¡S-señorita Fiona!\n¿Qué ha pasado aquí?\n...¡Ya lo entiendo! ¡Has\nsido tú, Van!"

msgctxt "dialogue/280/0x97"
msgid "dialogue/280/0x97"
msgstr "Van\n¡¿Por qué yo?! ¡Reese te\nestaba controlando!"

msgctxt "dialogue/280/0xe4"
msgid "dialogue/280/0xe4"
msgstr "Thomas\n¡No digas tonterías!\n¡Yo jamás caería en\nmanos del enemigo!"

msgctxt "dialogue/280/0x13d"
msgid "dialogue/280/0x13d"
msgstr "Fiona\nEs verdad, Teniente\nSchwarz. Reese te estaba\ncontrolando."

msgctxt "dialogue/280/0x190"
msgid "dialogue/280/0x190"
msgstr "Thomas\nSí, la señorita Fiona\ntiene razón. Me estaban\ncontrolando."

msgctxt "dialogue/280/0x1e3"
msgid "dialogue/280/0x1e3"
msgstr "Van\n......"

msgctxt "dialogue/280/0x208"
msgid "dialogue/280/0x208"
msgstr "{name}\n......"

msgctxt "dialogue/280/0x229"
msgid "dialogue/280/0x229"
msgstr "Jack\nEs alguien bastante\npeculiar."

msgctxt "dialogue/280/0x25b"
msgid "dialogue/280/0x25b"
msgstr "Regina\nY eso que es guapo..."

msgctxt "dialogue/280/0x287"
msgid "dialogue/280/0x287"
msgstr "Jack\nVaya, ¿te gusta ese\ntipo de hombre? Yo creía\nque preferías a alguien\ncomo el príncipe..."

msgctxt "dialogue/280/0x2e4"
msgid "dialogue/280/0x2e4"
msgstr "Regina\n¡Es-es-es-espera, Jack!\n¡¿Qué estás diciendo?!"

msgctxt "dialogue/280/0x337"
msgid "dialogue/280/0x337"
msgstr "Arth\nLo tiene difícil,\npríncipe."

msgctxt "dialogue/280/0x364"
msgid "dialogue/280/0x364"
msgstr "{name}\n......"

msgctxt "dialogue/280/0x385"
msgid "dialogue/280/0x385"
msgstr "Arth\n...Aunque quien lo tiene\ndifícil es Regina."

msgctxt "dialogue/280/0x3c0"
msgid "dialogue/280/0x3c0"
msgstr "{name}\n......"

msgctxt "dialogue/280/0x3e1"
msgid "dialogue/280/0x3e1"
msgstr "Van\nBueno, Thomas.\n¿Qué ha sido de Reese?"

msgctxt "dialogue/280/0x420"
msgid "dialogue/280/0x420"
msgstr "Thomas\nNo tengo por qué\ndecírtelo a ti."

msgctxt "dialogue/280/0x456"
msgid "dialogue/280/0x456"
msgstr "Van\n¡¿Cómo dices?!"

msgctxt "dialogue/280/0x478"
msgid "dialogue/280/0x478"
msgstr "Fiona\nTeniente Schwarz, ¿dónde\nestán Reese y los demás?"

msgctxt "dialogue/280/0x4b8"
msgid "dialogue/280/0x4b8"
msgstr "Thomas\nSí, señorita Fiona."

msgctxt "dialogue/280/0x4d8"
msgid "dialogue/280/0x4d8"
msgstr "Thomas\nReese y Hiltz fueron al\ninterior de la base con\nel barbudo."

msgctxt "dialogue/280/0x52f"
msgid "dialogue/280/0x52f"
msgstr "Van\n...Tú, desde luego..."

msgctxt "dialogue/280/0x55b"
msgid "dialogue/280/0x55b"
msgstr "Thomas\n¡No te quedes ahí\nparado, Van! ¡Vamos tras\nellos!"

msgctxt "dialogue/280/0x59a"
msgid "dialogue/280/0x59a"
msgstr "Thomas\nVamos, señorita Fiona."

msgctxt "dialogue/281/0xc"
msgid "dialogue/281/0xc"
msgstr "Hiltz\nSí que habéis tardado."

msgctxt "dialogue/281/0x46"
msgid "dialogue/281/0x46"
msgstr "Reese\n¡Al fin y al cabo, unos\npanolis como estos no\ndan para más!"

msgctxt "dialogue/281/0x91"
msgid "dialogue/281/0x91"
msgstr "Van\nHiltz..."

msgctxt "dialogue/281/0xb5"
msgid "dialogue/281/0xb5"
msgstr "Thomas\n¡¿Cómo os atrevéis a\nutilizarme?!"

msgctxt "dialogue/281/0xf7"
msgid "dialogue/281/0xf7"
msgstr "Van\n¡Thomas, tú cállate!"

msgctxt "dialogue/281/0x12b"
msgid "dialogue/281/0x12b"
msgstr "Thomas\n¡¿Qué has dicho, Van?!\n¡No voy a dejar que te\nhagas el chulo delante\nde la señorita Fiona!"

msgctxt "dialogue/281/0x18e"
msgid "dialogue/281/0x18e"
msgstr "Van\n¡¿De qué hablas?!"

msgctxt "dialogue/281/0x1b2"
msgid "dialogue/281/0x1b2"
msgstr "Thomas\n¡De algo importante!\n¡Muy importante! ¡No\ndejaré que te quedes con\nla señorita Fiona!"

msgctxt "dialogue/281/0x207"
msgid "dialogue/281/0x207"
msgstr "Reese\n...Estos tíos..."

msgctxt "dialogue/281/0x235"
msgid "dialogue/281/0x235"
msgstr "Hiltz\nLamentablemente, no\ntenemos tiempo para\nvuestro número cómico."

msgctxt "dialogue/282/0xc"
msgid "dialogue/282/0xc"
msgstr "Fiona\nOye, se han escapado."

msgctxt "dialogue/282/0x3c"
msgid "dialogue/282/0x3c"
msgstr "Thomas\n¡¿Cómo?!\n¡Van, a por ellos!"

msgctxt "dialogue/283/0xc"
msgid "dialogue/283/0xc"
msgstr "Van\n...¿Y de quién es la\nculpa? ¡Vamos, Fiona!"

msgctxt "dialogue/283/0x48"
msgid "dialogue/283/0x48"
msgstr "Fiona\n¡Sí!"

msgctxt "dialogue/284/0xc"
msgid "dialogue/284/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/284/0x24"
msgid "dialogue/284/0x24"
msgstr "Jack/Arth\n......"

msgctxt "dialogue/284/0x54"
msgid "dialogue/284/0x54"
msgstr "Regina\n...¡N-nosotros también\ntenemos que seguirlos!"

msgctxt "dialogue/285/0xc"
msgid "dialogue/285/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/285/0x2d"
msgid "dialogue/285/0x2d"
msgstr "Gale\nY nosotros, tengamos\nuna charla importante\nentre nosotros..."

msgctxt "dialogue/285/0x78"
msgid "dialogue/285/0x78"
msgstr "Jack\n...¡Instructor Gale...!"

msgctxt "dialogue/286/0xc"
msgid "dialogue/286/0xc"
msgstr "Gale\nInstructor Gale... Eso\nes cosa del pasado."

msgctxt "dialogue/286/0x38"
msgid "dialogue/286/0x38"
msgstr "Gale\nAhora soy Gale, uno de\nlos Cuatro Reyes de Su\nMajestad el Emperador."

msgctxt "dialogue/286/0x78"
msgid "dialogue/286/0x78"
msgstr "Arth\n¿Qué pretendes? ¿Por qué\natacas las bases?"

msgctxt "dialogue/286/0xba"
msgid "dialogue/286/0xba"
msgstr "Gale\nBlood ya os habrá\ncontado el objetivo del\nEmperador."

msgctxt "dialogue/286/0xf0"
msgid "dialogue/286/0xf0"
msgstr "Gale\nYo solo le ayudo a\nconseguirlo."

msgctxt "dialogue/286/0x12c"
msgid "dialogue/286/0x12c"
msgstr "Regina\nCrear el ejército de\nZoids más poderoso..."

msgctxt "dialogue/286/0x166"
msgid "dialogue/286/0x166"
msgstr "Gale\nAsí es. Para ello he\nreunido datos de combate\nreal de los Zoids de\nesta época. Nada más."

msgctxt "dialogue/286/0x1cb"
msgid "dialogue/286/0x1cb"
msgstr "Regina\n¿Y quiénes son ellos?\n¿Por qué estabais juntos?"

msgctxt "dialogue/286/0x205"
msgid "dialogue/286/0x205"
msgstr "Gale\n¿Mm? Ah, ¿te refieres a\nHiltz y Reese? No sé\ncuál es su verdadero\nobjetivo."

msgctxt "dialogue/286/0x256"
msgid "dialogue/286/0x256"
msgstr "Gale\nSolo que las bases del\nImperio les estorbaban,\nasí que colaboramos."

msgctxt "dialogue/286/0x29f"
msgid "dialogue/286/0x29f"
msgstr "Gale\nA ellos les estorban\nlas bases; yo estudio\nlos Zoids. Destruirlas\nes solo un paso más."

msgctxt "dialogue/286/0x2fa"
msgid "dialogue/286/0x2fa"
msgstr "Gale\nYa tengo los datos que\nnecesitaba. Con ellos\nreforzaremos nuestros\nZoids para compensar\nque somos pocos."

msgctxt "dialogue/286/0x35b"
msgid "dialogue/286/0x35b"
msgstr "Jack\n¿Por qué?"

msgctxt "dialogue/286/0x383"
msgid "dialogue/286/0x383"
msgstr "Gale\n¿Qué?"

msgctxt "dialogue/286/0x3a3"
msgid "dialogue/286/0x3a3"
msgstr "Jack\n¿Por qué nos cuenta todo\nesto?"

msgctxt "dialogue/286/0x3d7"
msgid "dialogue/286/0x3d7"
msgstr "Jack\n¿Por qué nos revela sus\npropios secretos?"

msgctxt "dialogue/286/0x418"
msgid "dialogue/286/0x418"
msgstr "Jack\n¡Instructor Gale! ¿Qué es\nlo que pretende usted?"

msgctxt "dialogue/286/0x459"
msgid "dialogue/286/0x459"
msgstr "Jack\n¿Qué le ha pasado?\n¡Dígamelo, por favor!"

msgctxt "dialogue/286/0x4a4"
msgid "dialogue/286/0x4a4"
msgstr "Gale\n......Parece que he\nhablado más de la cuenta."

msgctxt "dialogue/286/0x4d8"
msgid "dialogue/286/0x4d8"
msgstr "Gale\nHe jurado lealtad al\nEmperador. Ni más ni\nmenos."

msgctxt "dialogue/286/0x52b"
msgid "dialogue/286/0x52b"
msgstr "Jack\n¡Instructor Gale!"

msgctxt "dialogue/286/0x553"
msgid "dialogue/286/0x553"
msgstr "Gale\nEl Gale que conocías ya\nno existe."

msgctxt "dialogue/286/0x583"
msgid "dialogue/286/0x583"
msgstr "Gale\nSoy Gale, de los Cuatro\nReyes. ...Por ahora,\nbasta con eso."

msgctxt "dialogue/286/0x5c6"
msgid "dialogue/286/0x5c6"
msgstr "Jack\n¡Le detendré!"

msgctxt "dialogue/286/0x5e6"
msgid "dialogue/286/0x5e6"
msgstr "Jack\nNo sé qué tiene usted en\nmente. ¡Pero pienso\ndetenerle!"

msgctxt "dialogue/286/0x649"
msgid "dialogue/286/0x649"
msgstr "Gale\n...¿Podrás? ¿Crees que\nalguien tan blando como\ntú podrá detenerme?"

msgctxt "dialogue/286/0x696"
msgid "dialogue/286/0x696"
msgstr "Gale\n¡Muéstrame tu\ndeterminación, Jack!"

msgctxt "dialogue/287/0xc"
msgid "dialogue/287/0xc"
msgstr "Gale\n...Hmm... Ya veo. Has\ndemostrado tu\ndeterminación."

msgctxt "dialogue/287/0x4f"
msgid "dialogue/287/0x4f"
msgstr "Gale\nPero aún te falta mucho.\nNo creas que volverás\na ganar la próxima vez."

msgctxt "dialogue/288/0xc"
msgid "dialogue/288/0xc"
msgstr "Jack\n¡Instructor Gale!"

msgctxt "dialogue/288/0x36"
msgid "dialogue/288/0x36"
msgstr "Regina\n...Parece que tiene sus\nmotivos."

msgctxt "dialogue/288/0x6c"
msgid "dialogue/288/0x6c"
msgstr "Arth\n......"

msgctxt "dialogue/288/0x93"
msgid "dialogue/288/0x93"
msgstr "{name}\n......"

msgctxt "dialogue/289/0xc"
msgid "dialogue/289/0xc"
msgstr "Regina\n¡Van! ¿Qué tal os ha ido\na vosotros?"

msgctxt "dialogue/289/0x44"
msgid "dialogue/289/0x44"
msgstr "Thomas\nPor culpa de este inútil\nse nos ha escapado."

msgctxt "dialogue/289/0x82"
msgid "dialogue/289/0x82"
msgstr "Van\n¡¿Qué?! ¡Ha sido porque\nno parabas de disparar\ncon el Megalomax!"

msgctxt "dialogue/289/0xd3"
msgid "dialogue/289/0xd3"
msgstr "Thomas\nDisparar todo a la vez\nes una gozada."

msgctxt "dialogue/289/0x105"
msgid "dialogue/289/0x105"
msgstr "Van\n¡Oye! ¡Eso no es excusa\npara fijarme a mí como\nblanco!"

msgctxt "dialogue/289/0x152"
msgid "dialogue/289/0x152"
msgstr "Fiona\n¿Y el señor de la barba?"

msgctxt "dialogue/289/0x18a"
msgid "dialogue/289/0x18a"
msgstr "Jack\n...Se nos ha escapado."

msgctxt "dialogue/289/0x1bc"
msgid "dialogue/289/0x1bc"
msgstr "Fiona\nVaya. Volvemos a estar\ncomo al principio..."

msgctxt "dialogue/289/0x1f8"
msgid "dialogue/289/0x1f8"
msgstr "Jack\nNo. Por un tiempo no\nhabrá problema. Dijo que\nya había cumplido su\nobjetivo."

msgctxt "dialogue/289/0x253"
msgid "dialogue/289/0x253"
msgstr "Fiona\n¿Eso te dijo el señor de\nla barba?"

msgctxt "dialogue/289/0x291"
msgid "dialogue/289/0x291"
msgstr "Jack\nSí."

msgctxt "dialogue/289/0x2b1"
msgid "dialogue/289/0x2b1"
msgstr "Thomas\n¡No podemos fiarnos de\neso! No se puede creer\nlo que diga el enemigo."

msgctxt "dialogue/289/0x2fa"
msgid "dialogue/289/0x2fa"
msgstr "Fiona\nPero a mí el señor de la\nbarba no me parece tan\nmala persona."

msgctxt "dialogue/289/0x33d"
msgid "dialogue/289/0x33d"
msgstr "Fiona\nEn la base Ark, para lo\ndestrozada que quedó,\nhubo pocos heridos..."

msgctxt "dialogue/289/0x392"
msgid "dialogue/289/0x392"
msgstr "Thomas\n¡Tiene razón, señorita\nFiona! Aunque sea el\nenemigo, hay que empezar\npor confiar en la gente."

msgctxt "dialogue/289/0x3f7"
msgid "dialogue/289/0x3f7"
msgstr "Jack\n...Así que no parece tan\nmala persona..."

msgctxt "dialogue/289/0x43b"
msgid "dialogue/289/0x43b"
msgstr "Arth\nPor ahora basta con eso.\n¿Verdad, Jack?"

msgctxt "dialogue/289/0x476"
msgid "dialogue/289/0x476"
msgstr "{name}\n......"

msgctxt "dialogue/289/0x497"
msgid "dialogue/289/0x497"
msgstr "Jack\n...Sí."

msgctxt "dialogue/289/0x4bd"
msgid "dialogue/289/0x4bd"
msgstr "Van\nNosotros ya nos vamos.\n¿Y vosotros qué haréis?"

msgctxt "dialogue/289/0x502"
msgid "dialogue/289/0x502"
msgstr "Jack\nNosotros aún tenemos\ncosas que hacer."

msgctxt "dialogue/289/0x540"
msgid "dialogue/289/0x540"
msgstr "Van\n...Ya veo. ¡Pues hasta\nla próxima!"

msgctxt "dialogue/289/0x57a"
msgid "dialogue/289/0x57a"
msgstr "Fiona\n¡Hasta pronto!"

msgctxt "dialogue/290/0xc"
msgid "dialogue/290/0xc"
msgstr "Arth\nVolvamos nosotros\ntambién."

msgctxt "dialogue/290/0x34"
msgid "dialogue/290/0x34"
msgstr "Regina\nSí. Aún nos queda mucho\npor hacer."

msgctxt "dialogue/290/0x82"
msgid "dialogue/290/0x82"
msgstr "{name}\n......"

msgctxt "dialogue/290/0xa3"
msgid "dialogue/290/0xa3"
msgstr "Jack\nVolvamos. ¡A nuestra\népoca!"

msgctxt "dialogue/291/0xc"
msgid "dialogue/291/0xc"
msgstr "Blood\nA sus órdenes, Majestad."

msgctxt "dialogue/291/0x3e"
msgid "dialogue/291/0x3e"
msgstr "Emperador\nBuen trabajo."

msgctxt "dialogue/291/0x50"
msgid "dialogue/291/0x50"
msgstr "Emperador\nPor cierto, Blood,\n¿conoces las llamadas\nbatallas Zoid?"

msgctxt "dialogue/291/0x9b"
msgid "dialogue/291/0x9b"
msgstr "Blood\nUna competición de\ncombates entre Zoids con\nreglas justas..."

msgctxt "dialogue/291/0xee"
msgid "dialogue/291/0xee"
msgstr "Blood\nNo es más que un juego\nde niños."

msgctxt "dialogue/291/0x11e"
msgid "dialogue/291/0x11e"
msgstr "Emperador\nQué severo, Blood."

msgctxt "dialogue/291/0x13e"
msgid "dialogue/291/0x13e"
msgstr "Emperador\nPero, precisamente por\neso, también es cierto\nque abundan los Zoids\nde gran rendimiento."

msgctxt "dialogue/291/0x195"
msgid "dialogue/291/0x195"
msgstr "Blood\nEntendido. ¡Viajaré a la\népoca de las batallas\nZoid y reuniré\ninformación!"

msgctxt "dialogue/291/0x1f4"
msgid "dialogue/291/0x1f4"
msgstr "Emperador\nJe, je, je. Confío en\nti, Blood."

msgctxt "dialogue/292/0x3"
msgid "dialogue/292/0x3"
msgstr "Soldado del Reino 1\n¡...! ¡Detectamos una\nvibración\nespaciotemporal! Parece\nque han usado el\ndispositivo de transporte\nespaciotemporal del\ncastillo."

msgctxt "dialogue/292/0x54"
msgid "dialogue/292/0x54"
msgstr "Comandante del Reino\n¡¿Qué?!\n¿Se sabe el destino?"

msgctxt "dialogue/292/0x83"
msgid "dialogue/292/0x83"
msgstr "Soldado del Reino 1\n...No con exactitud..."

msgctxt "dialogue/292/0xab"
msgid "dialogue/292/0xab"
msgstr "Soldado del Reino 1\nPero las coordenadas son\nmuy distintas de las de\nlas otras veces."

msgctxt "dialogue/292/0xf6"
msgid "dialogue/292/0xf6"
msgstr "Comandante del Reino\n...¿Las coordenadas?\n¿Adónde pretenden ir?"

msgctxt "dialogue/292/0x13d"
msgid "dialogue/292/0x13d"
msgstr "Comandante del Reino\nAvisad al príncipe y los\ndemás. ¡Rápido!"

msgctxt "dialogue/292/0x171"
msgid "dialogue/292/0x171"
msgstr "Soldado del Reino 2\n¡Sí, señor!"

msgctxt "dialogue/293/0xc"
msgid "dialogue/293/0xc"
msgstr "Jack\nPríncipe, han detectado\nuna vibración\nespaciotemporal."

msgctxt "dialogue/293/0x49"
msgid "dialogue/293/0x49"
msgstr "{name}\n......"

msgctxt "dialogue/293/0x6a"
msgid "dialogue/293/0x6a"
msgstr "Regina\n¡Por fin!"

msgctxt "dialogue/293/0x92"
msgid "dialogue/293/0x92"
msgstr "Regina\nJack, ¿no se sabe nada\nmás?"

msgctxt "dialogue/293/0xcc"
msgid "dialogue/293/0xcc"
msgstr "Jack\nMe temo que no... Pero\nesta vez parece que es un\nsitio distinto."

msgctxt "dialogue/293/0x125"
msgid "dialogue/293/0x125"
msgstr "Regina\n¿Un sitio distinto?"

msgctxt "dialogue/293/0x153"
msgid "dialogue/293/0x153"
msgstr "Arth\nQue no es ni la República\nni el Imperio."

msgctxt "dialogue/293/0x191"
msgid "dialogue/293/0x191"
msgstr "Regina\nEntonces, ¿dónde es?"

msgctxt "dialogue/293/0x1bf"
msgid "dialogue/293/0x1bf"
msgstr "Arth\nNi idea."

msgctxt "dialogue/293/0x1df"
msgid "dialogue/293/0x1df"
msgstr "Regina\n¡Pues vaya respuesta!"

msgctxt "dialogue/293/0x209"
msgid "dialogue/293/0x209"
msgstr "Jack\nBueno, bueno. En todo\ncaso, hay que seguirlos."

msgctxt "dialogue/293/0x24b"
msgid "dialogue/293/0x24b"
msgstr "Jack\nPríncipe, partamos en\ncuanto estemos listos."

msgctxt "dialogue/293/0x28b"
msgid "dialogue/293/0x28b"
msgstr "Jack\n¿Está listo, príncipe?\nEntonces, en marcha."

msgctxt "dialogue/294/0xd"
msgid "dialogue/294/0xd"
msgstr "{name}\n......"

msgctxt "dialogue/294/0x2e"
msgid "dialogue/294/0x2e"
msgstr "Regina\nQué sitio tan desolado.\n¿Dónde estaremos?"

msgctxt "dialogue/294/0x7f"
msgid "dialogue/294/0x7f"
msgstr "Arth\n......Jack."

msgctxt "dialogue/294/0xb3"
msgid "dialogue/294/0xb3"
msgstr "Jack\nSí. Parece un campo de\nmaniobras... o un campo\nde batalla."

msgctxt "dialogue/294/0x106"
msgid "dialogue/294/0x106"
msgstr "Regina\n¿De batalla?"

msgctxt "dialogue/294/0x128"
msgid "dialogue/294/0x128"
msgstr "Jack\nNo es seguro, pero\nprobablemente..."

msgctxt "dialogue/294/0x15a"
msgid "dialogue/294/0x15a"
msgstr "Jack\nPor ahora, exploremos\nlos alrededores."

msgctxt "dialogue/295/0xc"
msgid "dialogue/295/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/295/0x2d"
msgid "dialogue/295/0x2d"
msgstr "Regina\n¿Enemigos? ¡¿Desde dónde\nnos disparan?!"

msgctxt "dialogue/295/0x69"
msgid "dialogue/295/0x69"
msgstr "Arth\nDesde todas partes..."

msgctxt "dialogue/295/0x91"
msgid "dialogue/295/0x91"
msgstr "Jack\n¡Salgamos de aquí como\nsea!"

msgctxt "dialogue/296/0xc"
msgid "dialogue/296/0xc"
msgstr "Judgeman\n¡Se confirma la entrada\nde terceros en el campo\nde batalla!"

msgctxt "dialogue/296/0x4b"
msgid "dialogue/296/0x4b"
msgstr "Judgeman\n¡Se confirma la entrada\nde terceros en el campo\nde batalla!"

msgctxt "dialogue/296/0x8a"
msgid "dialogue/296/0x8a"
msgstr "Judgeman\nSegún el reglamento de\nlas batallas Zoid, se\nsuspende la batalla."

msgctxt "dialogue/296/0xd5"
msgid "dialogue/296/0xd5"
msgstr "Judgeman\n¡Combate nulo!"

msgctxt "dialogue/296/0x108"
msgid "dialogue/296/0x108"
msgstr "{name}\n......"

msgctxt "dialogue/296/0x129"
msgid "dialogue/296/0x129"
msgstr "Regina\n¡¿Pero qué está pasando?!"

msgctxt "dialogue/297/0xc"
msgid "dialogue/297/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/297/0x2d"
msgid "dialogue/297/0x2d"
msgstr "Regina\n¿Qué pasa, {name}?"

msgctxt "dialogue/297/0x56"
msgid "dialogue/297/0x56"
msgstr "Regina\n¡Oh! ¡Aquello es...!"

msgctxt "dialogue/297/0x7f"
msgid "dialogue/297/0x7f"
msgstr "Blood\nAsí que los que han\ninterrumpido la batalla\nerais vosotros."

msgctxt "dialogue/297/0xca"
msgid "dialogue/297/0xca"
msgstr "Blood\nJe, je. Puede que ahora\nestas aburridas batallas\nse vuelvan algo más\ninteresantes."

msgctxt "dialogue/298/0xc"
msgid "dialogue/298/0xc"
msgstr "Jack\nAquel es Blood, uno de\nlos Cuatro Reyes, si no\nme equivoco..."

msgctxt "dialogue/298/0x50"
msgid "dialogue/298/0x50"
msgstr "Arth\n......Parece que\nvolveremos a vernos."

msgctxt "dialogue/298/0x86"
msgid "dialogue/298/0x86"
msgstr "Jack\nSí..."

msgctxt "dialogue/298/0xad"
msgid "dialogue/298/0xad"
msgstr "{name}\n......"

msgctxt "dialogue/299/0xc"
msgid "dialogue/299/0xc"
msgstr "Leena\n¡Oye! ¡Vosotros!"

msgctxt "dialogue/299/0x36"
msgid "dialogue/299/0x36"
msgstr "Leena\n¡¿Cómo se os ocurre\naparecer ahí con esa\ncara de despistados?!"

msgctxt "dialogue/299/0x75"
msgid "dialogue/299/0x75"
msgstr "Leena\n¡¿Dónde tenéis los ojos?!\n¡¿Tenéis el cerebro\npodrido o qué?!"

msgctxt "dialogue/299/0xcc"
msgid "dialogue/299/0xcc"
msgstr "Jamie\nLeena, tampoco hace falta\ndecir tanto..."

msgctxt "dialogue/299/0x10a"
msgid "dialogue/299/0x10a"
msgstr "Leon\nEs comprensible. Llevamos\nmucho esforzándonos para\nluchar contra ellos."

msgctxt "dialogue/299/0x169"
msgid "dialogue/299/0x169"
msgstr "Jamie\nEso es verdad, pero..."

msgctxt "dialogue/299/0x19f"
msgid "dialogue/299/0x19f"
msgstr "Leena\n¡Eso! ¡Con la Copa Real\nterminada y Bit y Brad\nde viaje!"

msgctxt "dialogue/299/0x1f6"
msgid "dialogue/299/0x1f6"
msgstr "Leena\n¡Y encima mi hermano Leon\nha vuelto a casa para\nayudarnos!"

msgctxt "dialogue/299/0x25b"
msgid "dialogue/299/0x25b"
msgstr "Leon\nYo también tenía ganas de\nvolver a formar equipo\ncon vosotros..."

msgctxt "dialogue/299/0x2b0"
msgid "dialogue/299/0x2b0"
msgstr "Leena\n¡Oye, tú! ¿Me escuchas?\n¡Deja de sonreír como\nun bobo!"

msgctxt "dialogue/299/0x30c"
msgid "dialogue/299/0x30c"
msgstr "{name}\n......"

msgctxt "dialogue/299/0x32d"
msgid "dialogue/299/0x32d"
msgstr "Regina\n¡¿Y tú qué?! ¡¿Dónde ves\nque {name} sonría como\nun bobo?!"

msgctxt "dialogue/299/0x385"
msgid "dialogue/299/0x385"
msgstr "Leena\n¡¿Cómo que \"tú\"?! ¡Tengo\nun nombre muy digno:\nLeena!"

msgctxt "dialogue/299/0x3d8"
msgid "dialogue/299/0x3d8"
msgstr "Leena\n¡¿Y tú quién eres?!"

msgctxt "dialogue/299/0x406"
msgid "dialogue/299/0x406"
msgstr "Regina\n¡Yo soy Regina!\n¡Y este es {name}!"

msgctxt "dialogue/299/0x444"
msgid "dialogue/299/0x444"
msgstr "Leena\n¡Hmpf! ¡No paras de\ndefenderlo! ¿Es que\nsois novios?"

msgctxt "dialogue/299/0x4ab"
msgid "dialogue/299/0x4ab"
msgstr "Regina\n¡¿Q-q-q-q-q-qué estás\ndiciendo?!"

msgctxt "dialogue/299/0x4f6"
msgid "dialogue/299/0x4f6"
msgstr "Regina\n{name} y yo no somos,\nn-no somos novios......"

msgctxt "dialogue/299/0x546"
msgid "dialogue/299/0x546"
msgstr "Leena\n¿Qué, qué? ¡Venga,\nconfiésalo ya!"

msgctxt "dialogue/299/0x584"
msgid "dialogue/299/0x584"
msgstr "Jack\n...¿Deberíamos pararlas?"

msgctxt "dialogue/299/0x5c2"
msgid "dialogue/299/0x5c2"
msgstr "Arth\nDéjalas hasta que se\nqueden a gusto."

msgctxt "dialogue/299/0x5f5"
msgid "dialogue/299/0x5f5"
msgstr "{name}\n......"

msgctxt "dialogue/299/0x616"
msgid "dialogue/299/0x616"
msgstr "Jamie\n¡Oigan! ¡Ustedes también\ndeberían pararlas!"

msgctxt "dialogue/299/0x65d"
msgid "dialogue/299/0x65d"
msgstr "Dr. Tros\nYo podría seguir\nmirando un rato..."

msgctxt "dialogue/299/0x6a1"
msgid "dialogue/299/0x6a1"
msgstr "Jamie\n¡Usted también, doctor!\n¡¿Pero qué dice?!"

msgctxt "dialogue/299/0x6e6"
msgid "dialogue/299/0x6e6"
msgstr "Dr. Tros\nNo sirve de nada quedarse\naquí. Volvamos a la\nGranja Tros."

msgctxt "dialogue/299/0x731"
msgid "dialogue/299/0x731"
msgstr "Dr. Tros\nYa que estáis, venid\ncon nosotros."

msgctxt "dialogue/299/0x765"
msgid "dialogue/299/0x765"
msgstr "Dr. Tros\n¡Eh, Leena! Tú también,\nseñorita. Venid con\nnosotros."

msgctxt "dialogue/299/0x7b8"
msgid "dialogue/299/0x7b8"
msgstr "Leena\n¡Vale, papá! Vamos,\nRegina."

msgctxt "dialogue/299/0x7f0"
msgid "dialogue/299/0x7f0"
msgstr "Regina\nSí."

msgctxt "dialogue/299/0x810"
msgid "dialogue/299/0x810"
msgstr "Jack\n...¿Cuándo se han hecho\ntan amigas?"

msgctxt "dialogue/299/0x857"
msgid "dialogue/299/0x857"
msgstr "Arth\n¿Y yo qué sé?"

msgctxt "dialogue/300/0xc"
msgid "dialogue/300/0xc"
msgstr "Dr. Tros\nBueno, ¿y qué hacíais\nvosotros en un sitio\ncomo ese?"

msgctxt "dialogue/300/0x53"
msgid "dialogue/300/0x53"
msgstr "Dr. Tros\nSabréis que está\nprohibido entrar en los\ncampos de batalla."

msgctxt "dialogue/300/0xa8"
msgid "dialogue/300/0xa8"
msgstr "Jack\nLe pedimos disculpas. No\nconocemos bien esta\nzona..."

msgctxt "dialogue/300/0xf7"
msgid "dialogue/300/0xf7"
msgstr "Regina\nLo sentimos mucho. Os\nhemos estropeado la\nbatalla..."

msgctxt "dialogue/300/0x14e"
msgid "dialogue/300/0x14e"
msgstr "Leena\n¡Nada, nada! Ya habrá\notra oportunidad. No te\npreocupes, Regina."

msgctxt "dialogue/300/0x1a5"
msgid "dialogue/300/0x1a5"
msgstr "Regina\nGracias, Leena..."

msgctxt "dialogue/300/0x1d9"
msgid "dialogue/300/0x1d9"
msgstr "Jack\n......"

msgctxt "dialogue/300/0x201"
msgid "dialogue/300/0x201"
msgstr "Arth\n......"

msgctxt "dialogue/300/0x227"
msgid "dialogue/300/0x227"
msgstr "Jamie\n......"

msgctxt "dialogue/300/0x24f"
msgid "dialogue/300/0x24f"
msgstr "Jack\nP-por cierto, sobre el\nequipo contra el que\nluchabais..."

msgctxt "dialogue/300/0x29c"
msgid "dialogue/300/0x29c"
msgstr "Leon\n¿Te refieres al Team\nBlood?"

msgctxt "dialogue/300/0x2ce"
msgid "dialogue/300/0x2ce"
msgstr "Arth\n¿Team Blood?"

msgctxt "dialogue/300/0x2f8"
msgid "dialogue/300/0x2f8"
msgstr "Dr. Tros\nEso es."

msgctxt "dialogue/300/0x30e"
msgid "dialogue/300/0x30e"
msgstr "Dr. Tros\nAparecieron como un\ncometa y enseguida se\nhicieron campeones\nabsolutos del distrito\ndel coliseo."

msgctxt "dialogue/300/0x36f"
msgid "dialogue/300/0x36f"
msgstr "Dr. Tros\nAunque son un grupo\nmuy misterioso."

msgctxt "dialogue/300/0x39d"
msgid "dialogue/300/0x39d"
msgstr "Dr. Tros\nAparte de que su líder\nes un hombre llamado\nBlood, no se sabe nada\nde ellos."

msgctxt "dialogue/300/0x3ff"
msgid "dialogue/300/0x3ff"
msgstr "{name}\n......"

msgctxt "dialogue/300/0x420"
msgid "dialogue/300/0x420"
msgstr "Regina\nBlood..."

msgctxt "dialogue/300/0x44a"
msgid "dialogue/300/0x44a"
msgstr "Dr. Tros\nBueno, sigamos hablando\npor aquí."

msgctxt "dialogue/301/0xc"
msgid "dialogue/301/0xc"
msgstr "Jamie\nPero, doctor, hablando de\ncosas raras, también son\nraras las desapariciones\nde Zoids de estos días."

msgctxt "dialogue/301/0x73"
msgid "dialogue/301/0x73"
msgstr "Jack\n¿Desapariciones de Zoids?"

msgctxt "dialogue/301/0xa1"
msgid "dialogue/301/0xa1"
msgstr "Leena\nSí. Últimamente, los\nmejores del ranking de\ntodas partes están\ndesapareciendo uno tras\notro."

msgctxt "dialogue/301/0xea"
msgid "dialogue/301/0xea"
msgstr "Leena\nY con sus Zoids."

msgctxt "dialogue/301/0x118"
msgid "dialogue/301/0x118"
msgstr "Dr. Tros\n¡Qué sinvergüenza!\nSolo van a por Zoids\npoco comunes."

msgctxt "dialogue/301/0x165"
msgid "dialogue/301/0x165"
msgstr "Dr. Tros\n¡Y yo también los quiero!"

msgctxt "dialogue/301/0x197"
msgid "dialogue/301/0x197"
msgstr "Jamie\n¡Doctor!\n¡No diga esas cosas!"

msgctxt "dialogue/301/0x1e0"
msgid "dialogue/301/0x1e0"
msgstr "Jack\nDesapariciones de Zoids\ny el misterioso Team\nBlood..."

msgctxt "dialogue/301/0x21e"
msgid "dialogue/301/0x21e"
msgstr "Jack\nY su líder es uno de los\nCuatro Reyes."

msgctxt "dialogue/301/0x256"
msgid "dialogue/301/0x256"
msgstr "Arth\nEsto huele mal."

msgctxt "dialogue/301/0x278"
msgid "dialogue/301/0x278"
msgstr "Regina\n¿Dónde está el Team\nBlood?"

msgctxt "dialogue/301/0x2b8"
msgid "dialogue/301/0x2b8"
msgstr "Dr. Tros\nNi idea. Como he dicho,\nson un grupo lleno de\nmisterios."

msgctxt "dialogue/301/0x305"
msgid "dialogue/301/0x305"
msgstr "Dr. Tros\n¿Creéis que el Team Blood\ntiene que ver con las\ndesapariciones?"

msgctxt "dialogue/301/0x35c"
msgid "dialogue/301/0x35c"
msgstr "Jack\nNo es seguro."

msgctxt "dialogue/301/0x37c"
msgid "dialogue/301/0x37c"
msgstr "Jack\nPero si el líder del Team\nBlood es quien creemos..."

msgctxt "dialogue/301/0x3d5"
msgid "dialogue/301/0x3d5"
msgstr "Jack\nEs muy posible."

msgctxt "dialogue/301/0x409"
msgid "dialogue/301/0x409"
msgstr "Dr. Tros\nVaya, vaya, esto se está\nponiendo interesante."

msgctxt "dialogue/301/0x452"
msgid "dialogue/301/0x452"
msgstr "Dr. Tros\nLo mejor será preguntarle\ndirectamente al Team\nBlood."

msgctxt "dialogue/301/0x4a3"
msgid "dialogue/301/0x4a3"
msgstr "Jack\nPero hace un momento ha\ndicho que no se sabe\ndónde está..."

msgctxt "dialogue/301/0x4e7"
msgid "dialogue/301/0x4e7"
msgstr "Dr. Tros\n¡Cierto! ¡Pero hay una\nforma segura de verlos!"

msgctxt "dialogue/301/0x531"
msgid "dialogue/301/0x531"
msgstr "{name}\n......"

msgctxt "dialogue/301/0x552"
msgid "dialogue/301/0x552"
msgstr "Regina\n¡¿Y cómo?!"

msgctxt "dialogue/301/0x584"
msgid "dialogue/301/0x584"
msgstr "Dr. Tros\nUna batalla Zoid.\nBasta con participar."

msgctxt "dialogue/301/0x5c6"
msgid "dialogue/301/0x5c6"
msgstr "Leena\nPero, papá, el Team Blood\nson los campeones\nabsolutos del coliseo de\nbatallas Zoid."

msgctxt "dialogue/301/0x617"
msgid "dialogue/301/0x617"
msgstr "Leena\nNo podemos retarlos\nnosotros. Nos dirán que\nno y ya está."

msgctxt "dialogue/301/0x66c"
msgid "dialogue/301/0x66c"
msgstr "Dr. Tros\nQué ingenua, Leena. En\nuna final por el título,\nno pueden negarse."

msgctxt "dialogue/301/0x6cb"
msgid "dialogue/301/0x6cb"
msgstr "Jamie\n¡¿L-los campeones del\ncoliseo?! ¡¿Pretende que\nlleguemos hasta ahí?!"

msgctxt "dialogue/301/0x728"
msgid "dialogue/301/0x728"
msgstr "Jamie\nAdemás, no es como las\nbatallas Zoid de siempre."

msgctxt "dialogue/301/0x76c"
msgid "dialogue/301/0x76c"
msgstr "Leon\nLa verdad es que esto se\npone interesante."

msgctxt "dialogue/301/0x7a6"
msgid "dialogue/301/0x7a6"
msgstr "Jamie\n¡Pero, Leon, tú también!"

msgctxt "dialogue/301/0x7da"
msgid "dialogue/301/0x7da"
msgstr "Jack\nDr. Tros, ¿qué hay que\nhacer para inscribirse\nen una batalla Zoid?"

msgctxt "dialogue/301/0x835"
msgid "dialogue/301/0x835"
msgstr "Dr. Tros\nBasta con inscribir un\nequipo en la Federación\nde Batallas Zoid, pero..."

msgctxt "dialogue/301/0x87c"
msgid "dialogue/301/0x87c"
msgstr "Dr. Tros\nInscribir un equipo lleva\nbastante tiempo."

msgctxt "dialogue/301/0x8b4"
msgid "dialogue/301/0x8b4"
msgstr "Dr. Tros\nMientras tanto, puede que\nel Team Blood se escape."

msgctxt "dialogue/301/0x901"
msgid "dialogue/301/0x901"
msgstr "Regina\n¡No puede ser! ¿No hay\nninguna solución?"

msgctxt "dialogue/301/0x93f"
msgid "dialogue/301/0x93f"
msgstr "Leena\n¡Papá! ¡¿No hay nada que\nhacer?!"

msgctxt "dialogue/301/0x977"
msgid "dialogue/301/0x977"
msgstr "Dr. Tros\nEs fácil. Inscribíos como\nguerreros Zoid del Team\nBlitz."

msgctxt "dialogue/301/0x9d0"
msgid "dialogue/301/0x9d0"
msgstr "Dr. Tros\nAsí podréis participar\nen batallas Zoid desde\nmañana mismo."

msgctxt "dialogue/301/0xa11"
msgid "dialogue/301/0xa11"
msgstr "Dr. Tros\nLeena, claro que vas a\nayudarlos, ¿verdad?"

msgctxt "dialogue/301/0xa57"
msgid "dialogue/301/0xa57"
msgstr "Leena\n¡Pues claro! ¡Vamos a por\ntodas, Regina!"

msgctxt "dialogue/301/0xa97"
msgid "dialogue/301/0xa97"
msgstr "Regina\n¡Sí!"

msgctxt "dialogue/301/0xab2"
msgid "dialogue/301/0xab2"
msgstr "¡Leon, Leena y Jamie se\nhan unido al grupo!"

msgctxt "dialogue/302/0xc"
msgid "dialogue/302/0xc"
msgstr "Dr. Tros\n¡Qué Zoids tan curiosos\ntenéis!"

msgctxt "dialogue/303/0xc"
msgid "dialogue/303/0xc"
msgstr "Regina\nLeena, ¿y qué hay que\nhacer para disputar el\ncombate por el título\nde campeón del distrito?"

msgctxt "dialogue/303/0x63"
msgid "dialogue/303/0x63"
msgstr "Leena\n¡Muy fácil! ¡Solo tienes\nque seguir ganando!"

msgctxt "dialogue/303/0xa6"
msgid "dialogue/303/0xa6"
msgstr "Jamie\nAsí no se explica\nnada..."

msgctxt "dialogue/303/0xe4"
msgid "dialogue/303/0xe4"
msgstr "Dr. Tros\nEn este distrito del\ncoliseo hay tres arenas."

msgctxt "dialogue/303/0x11e"
msgid "dialogue/303/0x11e"
msgstr "Dr. Tros\nQuien gane el torneo de\nla tercera arena luchará\ncontra el campeón del\ndistrito por el título."

msgctxt "dialogue/303/0x171"
msgid "dialogue/303/0x171"
msgstr "Dr. Tros\nPero para participar en\nel torneo de la tercera\narena hay un requisito."

msgctxt "dialogue/303/0x1ce"
msgid "dialogue/303/0x1ce"
msgstr "Arth\n¿Un requisito?"

msgctxt "dialogue/303/0x1ee"
msgid "dialogue/303/0x1ee"
msgstr "Dr. Tros\nAsí es. Hay que ganar los\ntorneos de la primera y\nla segunda arena."

msgctxt "dialogue/303/0x247"
msgid "dialogue/303/0x247"
msgstr "Dr. Tros\nPodéis empezar por la\nprimera o la segunda.\nElegid la que queráis."

msgctxt "dialogue/303/0x2ae"
msgid "dialogue/303/0x2ae"
msgstr "Leena\nPues eso. ¿Lo pilláis?"

msgctxt "dialogue/303/0x2e0"
msgid "dialogue/303/0x2e0"
msgstr "Jamie\nY eso que no lo ha\nexplicado ella..."

msgctxt "dialogue/303/0x320"
msgid "dialogue/303/0x320"
msgstr "Dr. Tros\nAh, sí. Por esta zona hay\nvarias ruinas antiguas."

msgctxt "dialogue/303/0x365"
msgid "dialogue/303/0x365"
