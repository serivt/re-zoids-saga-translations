msgctxt "dialogue/619/0xa3"
msgid "dialogue/619/0xa3"
msgstr "Thomas\nCurrent output: 5.47\nteravolts."

msgctxt "dialogue/619/0xd9"
msgid "dialogue/619/0xd9"
msgstr "Thomas\nGenerator output:\n8.05 teravolts! It won't\ngo any higher, brother!"

msgctxt "dialogue/619/0x146"
msgid "dialogue/619/0x146"
