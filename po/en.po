msgid "dialogue/353/0xc"
msgstr "Leena\nTeam Champ!"

msgctxt "dialogue/353/0x36"
msgid "dialogue/353/0x36"
msgstr "Leena\nWe'll win this one without\nbreaking a sweat, right?"

msgctxt "dialogue/353/0x60"
msgid "dialogue/353/0x60"
msgstr "Arth\nYou know them?"

msgctxt "dialogue/353/0x8a"
msgid "dialogue/353/0x8a"
msgstr "Jamie\nThey say he's a man born to be\na champion, but..."

msgctxt "dialogue/353/0xdc"
msgid "dialogue/353/0xdc"
msgstr "Leena\nHe's the only one who says so."

msgctxt "dialogue/353/0x102"
msgid "dialogue/353/0x102"
msgstr "Harry\nWe'll see about that..."

msgctxt "dialogue/354/0xc"
msgid "dialogue/354/0xc"
msgstr "Harry\nI'm the champion! Whoever\ncrosses my path, no matter who,\nI won't let them get away..."

msgctxt "dialogue/354/0x6d"
msgid "dialogue/354/0x6d"
msgstr "Harry\nEven if it's you, Leena!"

msgctxt "dialogue/355/0xc"
msgid "dialogue/355/0xc"
msgstr "Leena\nH-hey, Benjamin!\nWhat's up with him?"

msgctxt "dialogue/355/0x5b"
msgid "dialogue/355/0x5b"
msgstr "Benjamin\nI really couldn't say, my dear.\nHe's been like this for two or\nthree days."

msgctxt "dialogue/355/0xa8"
msgid "dialogue/355/0xa8"
msgstr "Benjamin\nPerhaps he ate something\nfunny?"

msgctxt "dialogue/355/0xea"
msgid "dialogue/355/0xea"
msgstr "Sebastian\nIt means Harry finally feels\nlike a champion."

msgctxt "dialogue/355/0x137"
msgid "dialogue/355/0x137"
msgstr "Sebastian\nHarry's a different man this\ntime. Brace yourselves!"

msgctxt "dialogue/355/0x17f"
msgid "dialogue/355/0x17f"
msgstr "Benjamin\nFarewell for now..."

msgctxt "dialogue/356/0xc"
msgid "dialogue/356/0xc"
msgstr "Jamie\nWhat's gotten into him?"

msgctxt "dialogue/356/0x42"
msgid "dialogue/356/0x42"
msgstr "Leena\nMaybe he ate something funny?\nCome on, let's go too!"

msgctxt "dialogue/357/0xc"
msgid "dialogue/357/0xc"
msgstr "Judgeman\nPrepare the battlefield!"

msgctxt "dialogue/357/0x3e"
msgid "dialogue/357/0x3e"
msgstr "Judgeman\nTeam Blitz versus\nTeam Champ."

msgctxt "dialogue/357/0x7a"
msgid "dialogue/357/0x7a"
