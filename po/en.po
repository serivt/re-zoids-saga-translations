msgctxt "dialogue/684/0xb2"
msgid "dialogue/684/0xb2"
msgstr "Fran\n...Yes."

msgctxt "dialogue/685/0xc"
msgid "dialogue/685/0xc"
msgstr "Jack\nInstructor Gale..."

msgctxt "dialogue/685/0x38"
msgid "dialogue/685/0x38"
msgstr "Gale\nI'm no longer your\ninstructor. I want to\nfight you as a simple\nsoldier."

msgctxt "dialogue/685/0x8d"
msgid "dialogue/685/0x8d"
msgstr "Gale\nWill you grant me\nthis duel?"

msgctxt "dialogue/685/0xb5"
msgid "dialogue/685/0xb5"
msgstr "Jack\nInstructor Gale... No,\nGale."

msgctxt "dialogue/685/0xef"
msgid "dialogue/685/0xef"
msgstr "Jack\nNothing would please me\nmore!"

msgctxt "dialogue/686/0xc"
msgid "dialogue/686/0xc"
msgstr "Opis\n......"

msgctxt "dialogue/686/0x3a"
msgid "dialogue/686/0x3a"
msgstr "Regina\n......Why so quiet?"

msgctxt "dialogue/686/0x7c"
msgid "dialogue/686/0x7c"
msgstr "Opis\nOh, nothing. I was just\nwondering if the two of\nus have anything to say\nto each other."

msgctxt "dialogue/686/0xcd"
msgid "dialogue/686/0xcd"
msgstr "Regina\nOf course we don't!"

msgctxt "dialogue/686/0xfd"
msgid "dialogue/686/0xfd"
msgstr "Opis\nFair enough.\nHeh heh heh!"

msgctxt "dialogue/687/0xc"
msgid "dialogue/687/0xc"
msgstr "Blood\nHere I come! {name}!!"

msgctxt "dialogue/687/0x39"
msgid "dialogue/687/0x39"
msgstr "{name}\n......"

msgctxt "dialogue/688/0xc"
msgid "dialogue/688/0xc"
msgstr "Blood\nWhat?!"

msgctxt "dialogue/688/0x32"
msgid "dialogue/688/0x32"
msgstr "Jack\nThe space-time transfer\ndevice!"

msgctxt "dialogue/689/0xc"
msgid "dialogue/689/0xc"
msgstr "Emperor\nI am the Emperor! I do\nnot know defeat!"

msgctxt "dialogue/689/0x3a"
msgid "dialogue/689/0x3a"
msgstr "Emperor\nHeh heh heh heh...\nHa ha ha ha haaa!!"

msgctxt "dialogue/689/0x6a"
msgid "dialogue/689/0x6a"
msgstr "Emperor\nPerish with me in the\nhour of destruction!!"

msgctxt "dialogue/690/0xc"
msgid "dialogue/690/0xc"
msgstr "Opis\nHe's sent the space-time\ntransfer device out of\ncontrol!"

msgctxt "dialogue/690/0x48"
msgid "dialogue/690/0x48"
msgstr "Regina\nWhat's going to happen?!"

msgctxt "dialogue/690/0x74"
msgid "dialogue/690/0x74"
msgstr "Opis\nThe space-time transfer\ndevice creates a kind of\nblack hole to cross\nspace-time!"

msgctxt "dialogue/690/0xc3"
msgid "dialogue/690/0xc3"
msgstr "Opis\nIf that black hole goes\nout of control..."

msgctxt "dialogue/690/0x110"
msgid "dialogue/690/0x110"
msgstr "Regina\nW-what'll happen?!"

msgctxt "dialogue/690/0x142"
msgid "dialogue/690/0x142"
msgstr "Opis\nThe whole planet will\nvanish."

msgctxt "dialogue/690/0x172"
msgid "dialogue/690/0x172"
msgstr "Emperor\nHeh heh heh heh...\nHa ha ha ha haaa!!"

msgctxt "dialogue/690/0x1ae"
msgid "dialogue/690/0x1ae"
msgstr "Jack\nIs there no way to\nstop it?!"

msgctxt "dialogue/690/0x1e6"
msgid "dialogue/690/0x1e6"
msgstr "Opis\nThe black hole is\nconnected to a white\nhole."

msgctxt "dialogue/690/0x225"
msgid "dialogue/690/0x225"
msgstr "Opis\nAn entrance and an exit.\nWith both, you can cross\nspace-time safely."

msgctxt "dialogue/690/0x286"
msgid "dialogue/690/0x286"
msgstr "Jack\nThen if we destroy\nthe exit...?"

msgctxt "dialogue/690/0x2c0"
msgid "dialogue/690/0x2c0"
msgstr "Opis\nWith no exit, the black\nhole will vanish."

msgctxt "dialogue/690/0x2f4"
msgid "dialogue/690/0x2f4"
msgstr "Opis\nBut to destroy the exit,\nyou'd have to cross\nspace-time."

msgctxt "dialogue/690/0x335"
msgid "dialogue/690/0x335"
msgstr "Opis\nAnd you could never come\nback to this world!"

msgctxt "dialogue/690/0x375"
msgid "dialogue/690/0x375"
msgstr "Regina\nBut if we use the\nspace-time transfer\ndevice in the ruins..."

msgctxt "dialogue/690/0x3b7"
msgid "dialogue/690/0x3b7"
msgstr "Opis\nWith it out of control,\nthere's no telling\nwhere it leads!"

msgctxt "dialogue/690/0x40e"
msgid "dialogue/690/0x40e"
msgstr "Emperor\nVanish!!...\nHa ha ha haaa!!"

msgctxt "dialogue/691/0xc"
msgid "dialogue/691/0xc"
