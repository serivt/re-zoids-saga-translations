msgctxt "dialogue/357/0xa6"
msgid "dialogue/357/0xa6"
msgstr "Judgeman\nReady... Fight!"

msgctxt "dialogue/358/0xc"
msgid "dialogue/358/0xc"
msgstr "Judgeman\nThe battle is over!"

msgctxt "dialogue/358/0x38"
msgid "dialogue/358/0x38"
msgstr "Judgeman\nWinner! Team Blitz!"

msgctxt "dialogue/359/0xc"
msgid "dialogue/359/0xc"
msgstr "Harry\n......... (dazed)"

msgctxt "dialogue/359/0x3c"
msgid "dialogue/359/0x3c"
msgstr "Sebastian\nHey, Harry, wake up!\nThe battle's already over!"

msgctxt "dialogue/359/0x93"
msgid "dialogue/359/0x93"
msgstr "Benjamin\nWhat's the matter with him? Did\nhe take a bad knock?"

msgctxt "dialogue/360/0xc"
msgid "dialogue/360/0xc"
msgstr "Leena\nWhat's going on? What's wrong\nwith him?"

msgctxt "dialogue/360/0x3e"
msgid "dialogue/360/0x3e"
msgstr "Benjamin\nThat's just it, we don't know..."

msgctxt "dialogue/360/0x74"
msgid "dialogue/360/0x74"
msgstr "Harry\nAh!\nWhere am I?"

msgctxt "dialogue/360/0x93"
msgid "dialogue/360/0x93"
msgstr "Harry\n...!? Leena!\nWhat are you doing here?"

msgctxt "dialogue/360/0xce"
msgid "dialogue/360/0xce"
msgstr "Harry\nWait a minute, where am I?"

msgctxt "dialogue/360/0xf0"
msgid "dialogue/360/0xf0"
msgstr "Harry\nSebastian, Benjamin!\nWhat am I doing in a place like\nthis?"

msgctxt "dialogue/360/0x151"
msgid "dialogue/360/0x151"
msgstr "Leena\nHe's back to the same old\nHarry."

msgctxt "dialogue/360/0x181"
msgid "dialogue/360/0x181"
msgstr "Sebastian\nSnap out of it, Harry! We just\nfought Team Blitz!"

msgctxt "dialogue/360/0x1de"
msgid "dialogue/360/0x1de"
msgstr "Harry\nWhaaat!? I'd never fight Leena!"

msgctxt "dialogue/360/0x225"
msgid "dialogue/360/0x225"
msgstr "Benjamin\nOh, Harry, honestly. Is your\nmemory all in a muddle?"

msgctxt "dialogue/361/0xc"
msgid "dialogue/361/0xc"
msgstr "Sebastian\nSo it seems. Let's take him to\nthe hospital, Benjamin."

msgctxt "dialogue/361/0x59"
msgid "dialogue/361/0x59"
msgstr "Benjamin\nYes, let's."

msgctxt "dialogue/361/0x91"
msgid "dialogue/361/0x91"
msgstr "Harry\nHey, you two! What are you\ndoing? Aaah, Leenaaa!"

msgctxt "dialogue/362/0xc"
msgid "dialogue/362/0xc"
msgstr "Leena\nWhat on earth was that?"

msgctxt "dialogue/362/0x38"
msgid "dialogue/362/0x38"
msgstr "Jamie\n...No idea."

msgctxt "dialogue/363/0xc"
msgid "dialogue/363/0xc"
msgstr "Jack\n...Muddled memories?"

msgctxt "dialogue/363/0x2e"
msgid "dialogue/363/0x2e"
msgstr "Jack\nExcuse me, have you seen any\nstrange man lately?"

msgctxt "dialogue/363/0x75"
msgid "dialogue/363/0x75"
msgstr "Harry\nAnd who are you?"

msgctxt "dialogue/363/0x9d"
msgid "dialogue/363/0x9d"
msgstr "Leena\nAnswer him, Harry!"

msgctxt "dialogue/363/0xcd"
msgid "dialogue/363/0xcd"
msgstr "Harry\nIf Leena asks, I've got no\nchoice! A weird guy... One with\nstrange glasses?"

msgctxt "dialogue/363/0x132"
msgid "dialogue/363/0x132"
msgstr "Regina\nStrange glasses...\nIt can't be!"

msgctxt "dialogue/363/0x16a"
msgid "dialogue/363/0x16a"
msgstr "Arth\nOpis."

msgctxt "dialogue/363/0x18c"
msgid "dialogue/363/0x18c"
msgstr "Jack\nMost likely. Dr. Opis\nbrainwashed him."

msgctxt "dialogue/363/0x1dd"
msgid "dialogue/363/0x1dd"
msgstr "Leena\nBrainwashed?\nWho is this guy?"

msgctxt "dialogue/363/0x215"
msgid "dialogue/363/0x215"
msgstr "Regina\nOur enemy. One of Blood's\ncronies!"

msgctxt "dialogue/363/0x24f"
msgid "dialogue/363/0x24f"
msgstr "Harry\nUnforgivable! How dare he\nbrainwash me!"

msgctxt "dialogue/363/0x28c"
msgid "dialogue/363/0x28c"
msgstr "Harry\nHey! From today on, I'm one of\nyou! Those creeps who made a\nfool of me, I'll pound them to a\npulp..."

msgctxt "dialogue/363/0x2f1"
msgid "dialogue/363/0x2f1"
msgstr "Leena\nWon't you be the one who gets\npounded to a pulp?"

msgctxt "dialogue/363/0x327"
msgid "dialogue/363/0x327"
msgstr "Sebastian\nWe can't rule it out."

msgctxt "dialogue/363/0x35d"
msgid "dialogue/363/0x35d"
msgstr "Benjamin\nQuite so..."

msgctxt "dialogue/363/0x385"
msgid "dialogue/363/0x385"
msgstr "Harry\nShut up!\nI said I'm fighting, and that's\nthat!"

msgctxt "dialogue/363/0x3bf"
msgid "dialogue/363/0x3bf"
msgstr "Harry has joined the party."

msgctxt "dialogue/364/0x9"
msgid "dialogue/364/0x9"
msgstr "Federation Ultrasaurus\nAttention, unidentified Zoid!"

msgctxt "dialogue/364/0x47"
msgid "dialogue/364/0x47"
msgstr "Federation Ultrasaurus\nThis is a restricted area.\nLeave immediately."

msgctxt "dialogue/364/0xb2"
msgid "dialogue/364/0xb2"
msgstr "Federation Ultrasaurus\nI repeat: leave the area\nimmediately. If you do not\ncomply, you will be destroyed.\nLeave the area immediately."

