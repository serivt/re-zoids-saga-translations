msgid "dialogue/41/0x8c\n"
msgstr "{name}\n.......\n"

msgctxt "dialogue/41/0xb0"
msgid "dialogue/41/0xb0"
msgstr "Regina\nOh, but one thing!"

msgctxt "dialogue/41/0xd4"
msgid "dialogue/41/0xd4"
msgstr "{name}\n......"

msgctxt "dialogue/41/0xf5"
msgid "dialogue/41/0xf5"
msgstr "Regina\nDon't you leave this room!\nUnderstood, {name}?"

msgctxt "dialogue/44/0xc"
msgid "dialogue/44/0xc"
msgstr "Regina\nPrince! I told you not to\nleave the room! You're not\ntrying to sneak off, are you?\nDon't even think about it!"

msgctxt "dialogue/235/0xc"
msgid "dialogue/235/0xc"
msgstr "Dr. D\nThis is our last resort.\nI'm counting on you."

msgctxt "dialogue/703/0xc"
msgid "dialogue/703/0xc"
msgstr "Regina\nThis is the Trinity Liger?!"

msgctxt "dialogue/703/0x44"
msgid "dialogue/703/0x44"
msgstr "Jack\nTrinity Liger?\nI've never heard of it."

msgctxt "dialogue/703/0x8f"
msgid "dialogue/703/0x8f"
msgstr "Regina\nThey say it was made to\nprotect Arcadia's legacy."

msgctxt "dialogue/703/0xe8"
msgid "dialogue/703/0xe8"
msgstr "Arth\nBut in this state..."

msgctxt "dialogue/703/0x11c"
msgid "dialogue/703/0x11c"
msgstr "{name}\n......"

msgctxt "dialogue/703/0x13d"
msgid "dialogue/703/0x13d"
msgstr "Regina\nIts Zoid core is dead...\nBut its Zi data is usable."

msgctxt "dialogue/703/0x196"
msgid "dialogue/703/0x196"
msgstr "Jack\nZi data?"

msgctxt "dialogue/703/0x1be"
msgid "dialogue/703/0x1be"
msgstr "Regina\nIt's like a blueprint for\nbuilding a Zoid from a Zoid\ncore."

msgctxt "dialogue/703/0x207"
msgid "dialogue/703/0x207"
msgstr "Regina\nIt's an Arcadian invention.\nThis way you don't need a\nmilitary base:"

msgctxt "dialogue/703/0x266"
msgid "dialogue/703/0x266"
msgstr "Regina\na civilian Zoid lab can build\nthe Zoid."

msgctxt "dialogue/703/0x2a9"
msgid "dialogue/703/0x2a9"
msgstr "Regina\nOf course, you also need a\ncore, parts... and money."

msgctxt "dialogue/703/0x305"
msgid "dialogue/703/0x305"
msgstr "You got the Trinity Liger's\nZi data!"

msgctxt "dialogue/717/0xc"
msgid "dialogue/717/0xc"
msgstr "Regina\nHonestly, {name}, wanting\nto go off on a journey again!\nYou have no sense of being\na king at all!"

msgctxt "dialogue/717/0x66"
msgid "dialogue/717/0x66"
msgstr "Arth\nIf it bothers you so much,\nwhy are you coming? A girl\nin love can't help it?"

msgctxt "dialogue/717/0xb5"
msgid "dialogue/717/0xb5"
msgstr "Regina\nI-I-I'm only doing my duty\nas one of the Three\nWarriors!"

msgctxt "dialogue/717/0x104"
msgid "dialogue/717/0x104"
msgstr "Jack\nStill, that newly discovered\nspace-time is fascinating."

msgctxt "dialogue/717/0x141"
msgid "dialogue/717/0x141"
msgstr "Jack\nIt seems to lie somewhere\nquite unlike any before.\nIt needs investigating."

msgctxt "dialogue/717/0x19e"
msgid "dialogue/717/0x19e"
msgstr "Arth\nI was getting tired of\nlife in the castle anyway.\nAnd traveling with the others\nagain doesn't sound bad."

msgctxt "dialogue/717/0x201"
msgid "dialogue/717/0x201"
msgstr "{name}\n......"

msgctxt "dialogue/718/0xc"
msgid "dialogue/718/0xc"
msgstr "Regina\nAh, King {name}, when\nyou're ready to set out,\ncome and speak to me."

msgctxt "dialogue/718/0x5c"
msgid "dialogue/718/0x5c"
msgstr "Jack\nArth and I will call the\ncompanions coming with us."

msgctxt "dialogue/719/0xc"
msgid "dialogue/719/0xc"
msgstr "Regina\nPrince, is everything\nready?"

msgctxt "dialogue/719/0x51"
msgid "dialogue/719/0x51"
msgstr "Regina\nThen let's set out on\na new journey!"

msgctxt "dialogue/720/0xc"
msgid "dialogue/720/0xc"
msgstr "Vega\nHuh? I think I came out\nsomewhere really weird..."

msgctxt "dialogue/720/0x3c"
msgid "dialogue/720/0x3c"
msgstr "Vega\n...Oh, who cares! Hey, you\nguys, come play with my\nFury!"

msgctxt "dialogue/721/0xc"
msgid "dialogue/721/0xc"
msgstr "Vega\nWaaah, that's impossible!\nThis has to be a dream!"

msgctxt "dialogue/722/0xc"
msgid "dialogue/722/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/722/0x2d"
msgid "dialogue/722/0x2d"
msgstr "Arth\n...He's gone."

msgctxt "dialogue/722/0x53"
msgid "dialogue/722/0x53"
msgstr "Regina\nLooks like a space-time\nwarp swept him away."

msgctxt "dialogue/722/0x91"
msgid "dialogue/722/0x91"
msgstr "Jack\nIt seems he was collecting\nZi data and Zoid cores\ntoo..."

msgctxt "dialogue/722/0xe4"
msgid "dialogue/722/0xe4"
msgstr "Jack\nHe's left us something\nvery interesting."

msgctxt "dialogue/723/0x3"
msgid "dialogue/723/0x3"
msgstr "Researcher\nWe've found the Zi data of\nthe Zoids the Emperor's\narmy used!"

msgctxt "dialogue/724/0x3"
msgid "dialogue/724/0x3"
msgstr "Researcher\nWe've found the Zi data of\nthe Zoids the Emperor's\narmy gathered!"

msgctxt "dialogue/725/0x3"
msgid "dialogue/725/0x3"
msgstr "Researcher\nI hope our country can\ndevelop Zoids from\nthis data."

msgctxt "dialogue/735/0x3"
msgid "dialogue/735/0x3"
msgstr "Royal Guard\nThe Three Warriors come from\nour kingdom, the Empire and\nthe Republic. The one from\nthe Empire is Sir Arth."

msgctxt "dialogue/736/0x3"
msgid "dialogue/736/0x3"
msgstr "Royal Guard\nThe Republic has always stood\nup to the Empire with its wits.\nSir Jack's lessons on tactics\nare very instructive."

msgctxt "dialogue/737/0x3"
msgid "dialogue/737/0x3"
msgstr "Royal Guard\nThe Three Warriors come from\nour kingdom, the Empire and\nthe Republic. The one from\nthe Republic is Sir Jack."

msgctxt "dialogue/738/0x3"
msgid "dialogue/738/0x3"
msgstr "Queen of Arcadia\n{name}... what are you\ndoing here? Shouldn't you\nbe studying?"

msgctxt "dialogue/739/0x3"
msgid "dialogue/739/0x3"
msgstr "Royal Guard\nThe conflicts on the Central\nContinent have died down.\nIf only the whole planet\ncould live in peace..."

msgctxt "dialogue/739/0x78"
msgid "dialogue/739/0x78"
msgstr "Royal Guard\nArcadia is a small kingdom\nsurrounded by untrustworthy\nneighbors. His Majesty must\nbe very worried."

msgctxt "dialogue/741/0x3"
msgid "dialogue/741/0x3"
msgstr "Royal Guard\nHis Majesty is making the\nrounds of the castle right now."

