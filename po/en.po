msgctxt "dialogue/655/0x144"
msgid "dialogue/655/0x144"
msgstr "Jack\nLet's leave freeing the\ncastle to the Kingdom's\narmy."

msgctxt "dialogue/655/0x196"
msgid "dialogue/655/0x196"
msgstr "{name}\n......"

msgctxt "dialogue/655/0x1b7"
msgid "dialogue/655/0x1b7"
msgstr "Jack\nLet's go!"

msgctxt "dialogue/655/0x1e1"
msgid "dialogue/655/0x1e1"
msgstr "Regina\nGot it!"

msgctxt "dialogue/655/0x203"
msgid "dialogue/655/0x203"
msgstr "Arth\nUnderstood."

msgctxt "dialogue/656/0xc"
msgid "dialogue/656/0xc"
msgstr "Fran\n......So you've come."

msgctxt "dialogue/656/0x3a"
msgid "dialogue/656/0x3a"
msgstr "Arth\nFran. ...Are you going\nto fight?"

msgctxt "dialogue/656/0x6c"
msgid "dialogue/656/0x6c"
msgstr "Fran\nHeh heh, what a question.\nOf course I'll fight. But\nnot to defeat you."

msgctxt "dialogue/656/0xbd"
msgid "dialogue/656/0xbd"
msgstr "Arth\n...For Blood?"

msgctxt "dialogue/656/0xef"
msgid "dialogue/656/0xef"
msgstr "Fran\nYes, I fight for him. It's\nall I can do now."

msgctxt "dialogue/656/0x142"
msgid "dialogue/656/0x142"
msgstr "Arth\nI see."

msgctxt "dialogue/656/0x162"
msgid "dialogue/656/0x162"
msgstr "Fran\nThe only way I can serve\nsomeone is by fighting...\nDo you think I'm a fool?"

msgctxt "dialogue/656/0x1bb"
msgid "dialogue/656/0x1bb"
msgstr "Arth\nWhat a question. Don't ask\na man who only knows how\nto fight."

msgctxt "dialogue/656/0x208"
msgid "dialogue/656/0x208"
msgstr "Fran\n......Heh heh."

msgctxt "dialogue/656/0x232"
msgid "dialogue/656/0x232"
msgstr "Fran\nLet's begin."

msgctxt "dialogue/657/0xc"
msgid "dialogue/657/0xc"
msgstr "Fran\nAaah!"

msgctxt "dialogue/657/0x30"
msgid "dialogue/657/0x30"
msgstr "Fran\n...I've lost. Blood, I\ncouldn't be of use to\nyou..."

msgctxt "dialogue/657/0x8b"
msgid "dialogue/657/0x8b"
msgstr "Arth\n......Let's go."

msgctxt "dialogue/657/0xb8"
msgid "dialogue/657/0xb8"
msgstr "{name}\n......"

msgctxt "dialogue/657/0xd9"
msgid "dialogue/657/0xd9"
msgstr "Regina\n......"

msgctxt "dialogue/657/0x101"
msgid "dialogue/657/0x101"
msgstr "Jack\n......Right."

msgctxt "dialogue/658/0xc"
msgid "dialogue/658/0xc"
msgstr "Emperor\nFran... What a foolish\nwoman..."

msgctxt "dialogue/658/0x44"
msgid "dialogue/658/0x44"
msgstr "Emperor\nBegone, covered in\ndisgrace!"

msgctxt "dialogue/658/0x64"
msgid "dialogue/658/0x64"
msgstr "Emperor\nI will tolerate no\nuseless fools around me!"

msgctxt "dialogue/659/0xc"
msgid "dialogue/659/0xc"
msgstr "Fran\n......This is as far as\nI go... Farewell,\nBlood..."

msgctxt "dialogue/660/0xc"
msgid "dialogue/660/0xc"
msgstr "Blood\nDon't go deciding that\non your own!"

msgctxt "dialogue/660/0x3e"
msgid "dialogue/660/0x3e"
msgstr "Fran\nB-Blood..."

msgctxt "dialogue/660/0x6a"
msgid "dialogue/660/0x6a"
msgstr "Blood\nCome on, Fran!\nYou're coming with me!"

msgctxt "dialogue/660/0xad"
msgid "dialogue/660/0xad"
msgstr "Fran\nBlood...!"

msgctxt "dialogue/661/0xc"
msgid "dialogue/661/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/661/0x2d"
msgid "dialogue/661/0x2d"
msgstr "Regina\nWhat? An explosion?!\nWhat about Fran?!"

msgctxt "dialogue/661/0x69"
msgid "dialogue/661/0x69"
msgstr "Jack\nLet's go back!"

msgctxt "dialogue/661/0x95"
msgid "dialogue/661/0x95"
msgstr "Arth\nDon't forget our\nobjective!"

msgctxt "dialogue/661/0xcb"
msgid "dialogue/661/0xcb"
msgstr "Regina\n......"

msgctxt "dialogue/661/0xf4"
msgid "dialogue/661/0xf4"
msgstr "{name}\n......"

msgctxt "dialogue/661/0x115"
msgid "dialogue/661/0x115"
msgstr "Jack\n...You're right."

msgctxt "dialogue/661/0x141"
msgid "dialogue/661/0x141"
msgstr "Jack\nArth, tell the Kingdom's\narmy that we've made it\nthrough the gate."

msgctxt "dialogue/661/0x177"
msgid "dialogue/661/0x177"
msgstr "Jack\nWe'll keep going all the\nway down."

msgctxt "dialogue/661/0x1b3"
msgid "dialogue/661/0x1b3"
msgstr "Arth\nYeah, that works...\nLet's go."

msgctxt "dialogue/662/0xc"
msgid "dialogue/662/0xc"
msgstr "Gale\n...So you're here. Sooner\nthan I expected."

msgctxt "dialogue/662/0x44"
msgid "dialogue/662/0x44"
msgstr "Jack\nGale, it's over for you.\nPlease, surrender."

msgctxt "dialogue/662/0x91"
msgid "dialogue/662/0x91"
msgstr "Gale\nHeh heh heh. You talk as\nif you could beat me."

msgctxt "dialogue/662/0xd3"
msgid "dialogue/662/0xd3"
msgstr "Jack\nWe will. We won't lose to\nsomeone with no\nconvictions, like you."

msgctxt "dialogue/662/0x122"
msgid "dialogue/662/0x122"
msgstr "Gale\nConvictions... It's been\na long time since I heard\nthat word."

msgctxt "dialogue/662/0x164"
msgid "dialogue/662/0x164"
msgstr "Jack\nTell me! Why are you\nworking with the\nEmperor?"

msgctxt "dialogue/662/0x1b7"
msgid "dialogue/662/0x1b7"
msgstr "Gale\nAnd what will you do if\nyou know? Forgive me?\nDon't be presumptuous!"

msgctxt "dialogue/662/0x20c"
msgid "dialogue/662/0x20c"
msgstr "Jack\n...!"

msgctxt "dialogue/662/0x22a"
msgid "dialogue/662/0x22a"
msgstr "Gale\nWhat good is pitying your\nenemy in combat?"

msgctxt "dialogue/662/0x252"
msgid "dialogue/662/0x252"
msgstr "Gale\nCan you fight like that?\nCan you protect what\nmatters to you like that?"

msgctxt "dialogue/662/0x29d"
msgid "dialogue/662/0x29d"
msgstr "Gale\nCan you fulfill your great\nambition like that?"

msgctxt "dialogue/662/0x2d5"
msgid "dialogue/662/0x2d5"
msgstr "Gale\nAre those the\nconvictions you speak of?"

msgctxt "dialogue/662/0x30d"
msgid "dialogue/662/0x30d"
msgstr "Gale\nSave your dreams for\nwhen you're asleep!"

msgctxt "dialogue/662/0x343"
msgid "dialogue/662/0x343"
msgstr "Jack\n.........Gale."

msgctxt "dialogue/662/0x36b"
msgid "dialogue/662/0x36b"
msgstr "Jack\nUnderstood. I won't ask\nabout your reasons\nagain."

msgctxt "dialogue/662/0x3a3"
msgid "dialogue/662/0x3a3"
msgstr "Jack\nI'll defeat you as an\nenemy."

msgctxt "dialogue/662/0x3d5"
msgid "dialogue/662/0x3d5"
msgstr "Gale\nThat's it. In battle,\nthere's no room for\nsoftness. Someday it\nwould cost you your life."

msgctxt "dialogue/662/0x434"
msgid "dialogue/662/0x434"
msgstr "Gale\nCome, show me your\nconvictions!"

msgctxt "dialogue/662/0x472"
msgid "dialogue/662/0x472"
msgstr "Jack\nHere I come!"

msgctxt "dialogue/663/0xc"
msgid "dialogue/663/0xc"
msgstr "Gale\nGwaaaaah!"

msgctxt "dialogue/663/0x2c"
msgid "dialogue/663/0x2c"
msgstr "Gale\nHeh heh heh. I've seen\nyour convictions..."

msgctxt "dialogue/663/0x73"
msgid "dialogue/663/0x73"
msgstr "Jack\nInstructor Gale..."

msgctxt "dialogue/663/0x9f"
msgid "dialogue/663/0x9f"
msgstr "Gale\nInstructor... You still\ncall me that?"

msgctxt "dialogue/663/0xd6"
msgid "dialogue/663/0xd6"
msgstr "Gale\nBut I have nothing left\nto teach you."

msgctxt "dialogue/663/0x10a"
msgid "dialogue/663/0x10a"
msgstr "Gale\nNow, go. The Emperor\nmust be in the\nunderground factory."

msgctxt "dialogue/663/0x151"
msgid "dialogue/663/0x151"
msgstr "Gale\nDo your duty...\nAnd all of you, fulfill\nyour great ambition."

msgctxt "dialogue/663/0x1a8"
msgid "dialogue/663/0x1a8"
msgstr "Jack\nInstructor Gale...\nThank you for all your\nteachings."

msgctxt "dialogue/663/0x1f5"
msgid "dialogue/663/0x1f5"
msgstr "Jack\nPrince, let's go."

msgctxt "dialogue/663/0x224"
msgid "dialogue/663/0x224"
msgstr "{name}\n......"

msgctxt "dialogue/664/0xc"
msgid "dialogue/664/0xc"
msgstr "Gale\nJack, I'd have liked to\ntalk with you much more...\nbut there's no time left."

msgctxt "dialogue/664/0x67"
msgid "dialogue/664/0x67"
msgstr "Gale\nJulia, Daddy has lost."

msgctxt "dialogue/664/0x95"
msgid "dialogue/664/0x95"
msgstr "Gale\nForgive Daddy for not\nbeing able to save you."

msgctxt "dialogue/664/0xd4"
msgid "dialogue/664/0xd4"
msgstr "Gale\nBut you won't be alone.\nDaddy will go first and\nwait for you there."

msgctxt "dialogue/665/0xc"
msgid "dialogue/665/0xc"
msgstr "Fran\nWait, Gale!"

msgctxt "dialogue/665/0x34"
msgid "dialogue/665/0x34"
msgstr "Gale\nFran? So you were\nsafe after all..."

msgctxt "dialogue/665/0x6c"
msgid "dialogue/665/0x6c"
msgstr "Gale\nBlood...\nHeh heh. I see now..."

msgctxt "dialogue/665/0xb1"
msgid "dialogue/665/0xb1"
msgstr "Blood\nGale, your life is in\nmy hands now."

msgctxt "dialogue/665/0xf3"
msgid "dialogue/665/0xf3"
msgstr "Gale\nOh? And on what grounds?"

msgctxt "dialogue/665/0x123"
msgid "dialogue/665/0x123"
msgstr "Blood\nYour daughter is with me.\nThose are my grounds."

msgctxt "dialogue/665/0x167"
msgid "dialogue/665/0x167"
msgstr "Gale\nJulia?"

msgctxt "dialogue/665/0x18d"
msgid "dialogue/665/0x18d"
msgstr "Gale\nI see. I owe you enough\nto trust you with my life."

msgctxt "dialogue/665/0x1d4"
msgid "dialogue/665/0x1d4"
msgstr "Blood\nI'll decide where you\ndie. Follow me!"

msgctxt "dialogue/666/0xc"
msgid "dialogue/666/0xc"
msgstr "Gale\nI thought your style was\nstabbing people in the\nback."

msgctxt "dialogue/666/0x53"
msgid "dialogue/666/0x53"
msgstr "Blood\nThe brave I face head-on.\nThat's my conviction."

msgctxt "dialogue/667/0xc"
msgid "dialogue/667/0xc"
msgstr "Opis\nHeh heh heh. So you've\nfinally deigned to show up."

msgctxt "dialogue/667/0x42"
msgid "dialogue/667/0x42"
msgstr "Opis\nI won't be as easy as\nGale or Fran!\nHeh heh heh!"

msgctxt "dialogue/667/0x8d"
msgid "dialogue/667/0x8d"
msgstr "Regina\nShut up! We're not losing\nto someone who only uses\ndirty tricks!"

msgctxt "dialogue/667/0xf2"
msgid "dialogue/667/0xf2"
msgstr "Opis\nDirty tricks?\nYou wound me."

msgctxt "dialogue/667/0x124"
msgid "dialogue/667/0x124"
msgstr "Opis\nMy, what a foul mouth.\nYou'll never get a\nboyfriend like that."

msgctxt "dialogue/667/0x17b"
msgid "dialogue/667/0x17b"
msgstr "Regina\nS-shut up! That's none\nof your business!"

msgctxt "dialogue/667/0x1c0"
msgid "dialogue/667/0x1c0"
msgstr "Opis\nThen my methods are none\nof your business either,\nhmm?"

msgctxt "dialogue/667/0x21f"
msgid "dialogue/667/0x21f"
msgstr "Regina\nW-well, that's...!"

msgctxt "dialogue/667/0x24f"
msgid "dialogue/667/0x24f"
msgstr "Opis\nAh well. Teasing young\nladies is such a joy.\nHeh heh heh!"

msgctxt "dialogue/667/0x29c"
msgid "dialogue/667/0x29c"
msgstr "Regina\nD-don't mock me!"

msgctxt "dialogue/667/0x2cc"
msgid "dialogue/667/0x2cc"
msgstr "Opis\nI'm always serious.\nEspecially when it comes\nto finishing you off\nright here and now!"

msgctxt "dialogue/668/0xc"
msgid "dialogue/668/0xc"
msgstr "Opis\nGrrr! Have you no\nrespect for your elders?"

msgctxt "dialogue/668/0x57"
msgid "dialogue/668/0x57"
msgstr "Regina\nLook who's talking! Time\nyou made way for the\nyoung!"

msgctxt "dialogue/668/0xa4"
msgid "dialogue/668/0xa4"
msgstr "Opis\nWhat a mouthy brat!\nDie with me! Then I'll\nforgive you!\nHeh heh heh!"

msgctxt "dialogue/669/0xc"
msgid "dialogue/669/0xc"
msgstr "Opis\nGrrraaah...!\n...Ugh!"

msgctxt "dialogue/670/0xc"
msgid "dialogue/670/0xc"
msgstr "Regina\nHe's going to self-destruct?!"

msgctxt "dialogue/670/0x38"
msgid "dialogue/670/0x38"
msgstr "Arth\nWhat a sore loser."

msgctxt "dialogue/670/0x64"
msgid "dialogue/670/0x64"
msgstr "Jack\nWhat are you saying?!\nLet's get out of here!"

msgctxt "dialogue/671/0xc"
msgid "dialogue/671/0xc"
msgstr "Opis\n............Are they gone?"

msgctxt "dialogue/671/0x4a"
msgid "dialogue/671/0x4a"
msgstr "Opis\nHeh heh heh. I'm a\ngenius! Foreseeing this,\nI prepared all sorts of\nmeasures—"

msgctxt "dialogue/671/0xa9"
msgid "dialogue/671/0xa9"
msgstr "Blood\nSome two-bit genius."

msgctxt "dialogue/672/0xc"
msgid "dialogue/672/0xc"
msgstr "Opis\nHeh heh heh. Blood. And\nwith Gale and Fran, no\nless..."

msgctxt "dialogue/672/0x51"
msgid "dialogue/672/0x51"
msgstr "Opis\nHave you betrayed the\nEmperor too?"

msgctxt "dialogue/672/0x8b"
msgid "dialogue/672/0x8b"
msgstr "Gale\nI was never loyal to him.\nAnd neither were you,\nwere you?"

msgctxt "dialogue/672/0xde"
msgid "dialogue/672/0xde"
msgstr "Opis\nHeh heh heh. I'm a\nscientist. For my research\nI'd sell my soul to\nthe devil!"

msgctxt "dialogue/672/0x13d"
msgid "dialogue/672/0x13d"
msgstr "Fran\nSome conviction."

msgctxt "dialogue/672/0x165"
msgid "dialogue/672/0x165"
msgstr "Opis\nHeh heh heh. And what\nwill you do now?"

msgctxt "dialogue/672/0x19f"
msgid "dialogue/672/0x19f"
msgstr "Blood\nOur last duty as the Four\nKings: to see the\nEmperor's end."

msgctxt "dialogue/672/0x1ea"
msgid "dialogue/672/0x1ea"
msgstr "Opis\nI see. Well, good\nluck with that."

msgctxt "dialogue/673/0xc"
msgid "dialogue/673/0xc"
msgstr "Blood\nNo way. As one of the\nFour Kings, you're coming\nwith us, Opis."

msgctxt "dialogue/674/0xc"
msgid "dialogue/674/0xc"
msgstr "Emperor\nSo you've made it\nthis far."

msgctxt "dialogue/674/0x3e"
msgid "dialogue/674/0x3e"
msgstr "Emperor\nThe Four Kings are\nnothing but useless fools!"

msgctxt "dialogue/675/0xc"
msgid "dialogue/675/0xc"
msgstr "Regina\nCome on, you're finished!\nAdmit defeat!"

msgctxt "dialogue/675/0x59"
msgid "dialogue/675/0x59"
msgstr "Emperor\nMy defeat...?\nHeh heh heh heh heh..."

msgctxt "dialogue/675/0x9c"
msgid "dialogue/675/0x9c"
msgstr "Regina\nWhat's so funny?!"

msgctxt "dialogue/675/0xca"
msgid "dialogue/675/0xca"
msgstr "Emperor\nNot while I still have\nthe mightiest Zoid!"

msgctxt "dialogue/675/0xf6"
msgid "dialogue/675/0xf6"
msgstr "Emperor\nThe ruler of this land!\nNo, of all planet Zi...\nis me!"

msgctxt "dialogue/676/0xc"
msgid "dialogue/676/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/676/0x2d"
msgid "dialogue/676/0x2d"
msgstr "Regina\nWh-what...? What is this\nsinister Zoid...?"

msgctxt "dialogue/676/0x76"
msgid "dialogue/676/0x76"
msgstr "Arth\nTch. The star of the\nshow finally appears."

msgctxt "dialogue/676/0xa2"
msgid "dialogue/676/0xa2"
msgstr "Jack\nSo this is the symbol\nof that man's power...!"

msgctxt "dialogue/676/0xe0"
msgid "dialogue/676/0xe0"
msgstr "Emperor\nWhat do you think? This\nis my power!"

msgctxt "dialogue/676/0x116"
msgid "dialogue/676/0x116"
msgstr "Emperor\nThat is the difference\nbetween the one who clung\nto this moldy kingdom\nand me!"

msgctxt "dialogue/676/0x15b"
msgid "dialogue/676/0x15b"
msgstr "Emperor\n{name}... And the\ndifference between you,\nhis son, and me!"

msgctxt "dialogue/676/0x1ac"
msgid "dialogue/676/0x1ac"
msgstr "{name}\n......"

msgctxt "dialogue/676/0x1cd"
msgid "dialogue/676/0x1cd"
msgstr "Jack\nWhat do you mean?"

msgctxt "dialogue/676/0x1fb"
msgid "dialogue/676/0x1fb"
msgstr "Emperor\n......"

msgctxt "dialogue/676/0x220"
msgid "dialogue/676/0x220"
msgstr "{name}\n......"

msgctxt "dialogue/676/0x241"
msgid "dialogue/676/0x241"
msgstr "Regina\n......It can't be..."

msgctxt "dialogue/676/0x275"
msgid "dialogue/676/0x275"
msgstr "Arth\nWh-what does this mean?!"

msgctxt "dialogue/676/0x2a3"
msgid "dialogue/676/0x2a3"
msgstr "Jack\nY-Your Majesty..."

msgctxt "dialogue/676/0x2cd"
msgid "dialogue/676/0x2cd"
msgstr "Emperor\nHeh heh heh heh. Surprised,\nworms?"

msgctxt "dialogue/676/0x307"
msgid "dialogue/676/0x307"
msgstr "Jack\nWh-who are you, really...?"

msgctxt "dialogue/676/0x343"
msgid "dialogue/676/0x343"
msgstr "Emperor\nHis younger brother..."

msgctxt "dialogue/676/0x367"
msgid "dialogue/676/0x367"
msgstr "Arth\n...Younger brother?"

msgctxt "dialogue/676/0x38b"
msgid "dialogue/676/0x38b"
msgstr "Regina\nB-but I've never heard\nthat His Majesty had\na brother..."

msgctxt "dialogue/676/0x3de"
msgid "dialogue/676/0x3de"
msgstr "Emperor\nNo wonder you don't\nknow."

msgctxt "dialogue/676/0x406"
msgid "dialogue/676/0x406"
msgstr "Emperor\nIn this moldy kingdom,\nwhen twins are born to\nthe royal family, the\nyounger is killed at once."

msgctxt "dialogue/676/0x465"
msgid "dialogue/676/0x465"
msgstr "Jack\nY-yes, I've heard of\nthat custom."

msgctxt "dialogue/676/0x49d"
msgid "dialogue/676/0x49d"
msgstr "Jack\nBut no one ever said\nthat twins were born..."

msgctxt "dialogue/676/0x4e6"
msgid "dialogue/676/0x4e6"
msgstr "Emperor\nYou think they'd announce\nthat twins were born and\nthe younger was killed?"

msgctxt "dialogue/676/0x53d"
msgid "dialogue/676/0x53d"
msgstr "Jack\n........."

msgctxt "dialogue/676/0x56b"
msgid "dialogue/676/0x56b"
msgstr "Emperor\nThis scar on my face\nis from that day..."

msgctxt "dialogue/676/0x5a3"
msgid "dialogue/676/0x5a3"
msgstr "{name}\n......"

msgctxt "dialogue/676/0x5c4"
msgid "dialogue/676/0x5c4"
msgstr "Arth\nAnd that's why... you\nwant revenge on the\nKingdom of Arcadia?"

msgctxt "dialogue/676/0x619"
msgid "dialogue/676/0x619"
msgstr "Emperor\nRevenge? No."

msgctxt "dialogue/676/0x633"
msgid "dialogue/676/0x633"
msgstr "Emperor\nI, who should have died,\nstill live. Don't you\nfind that strange?"

msgctxt "dialogue/676/0x684"
msgid "dialogue/676/0x684"
msgstr "Emperor\nIt's very simple. I was\nchosen... by God.\nI had His blessing!"

msgctxt "dialogue/676/0x6cf"
msgid "dialogue/676/0x6cf"
msgstr "Emperor\nNo one but me can rule\nthe Kingdom of Arcadia."

msgctxt "dialogue/676/0x714"
msgid "dialogue/676/0x714"
msgstr "Emperor\nMy useless brother is a\nvillain who obstructs the\nmission God entrusted\nto me!"

msgctxt "dialogue/676/0x769"
msgid "dialogue/676/0x769"
msgstr "Emperor\nAnd the people who\nserved him are just as\nguilty!"

msgctxt "dialogue/676/0x7a2"
msgid "dialogue/676/0x7a2"
msgstr "Emperor\nSo is this land that\nbore his rule, and planet\nZi that let him live!"

msgctxt "dialogue/676/0x7f1"
msgid "dialogue/676/0x7f1"
msgstr "Emperor\nI will punish all that\nbetrayed me! This is\nGod's punishment!"

msgctxt "dialogue/677/0xc"
msgid "dialogue/677/0xc"
msgstr "Emperor\nFor a start, my brother\nhas already received\nhis punishment."

msgctxt "dialogue/677/0x34"
msgid "dialogue/677/0x34"
msgstr "Emperor\nBy now he must be nothing\nbut particles drifting\nabout."

msgctxt "dialogue/677/0x73"
msgid "dialogue/677/0x73"
msgstr "Emperor\nHa ha ha ha ha!!"

msgctxt "dialogue/677/0x97"
msgid "dialogue/677/0x97"
msgstr "Emperor\nIf only you could have\nseen his face twisted\nwith terror!"

msgctxt "dialogue/677/0xd2"
msgid "dialogue/677/0xd2"
msgstr "Emperor\nYou above all,\n{name}... Heh heh heh."

msgctxt "dialogue/677/0x10c"
msgid "dialogue/677/0x10c"
msgstr "{name}\n......"

msgctxt "dialogue/677/0x12d"
msgid "dialogue/677/0x12d"
msgstr "Regina\nY-you... you killed\nHis Majesty...?"

msgctxt "dialogue/678/0xc"
msgid "dialogue/678/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/678/0x2d"
msgid "dialogue/678/0x2d"
msgstr "Emperor\n...What is that look?"

msgctxt "dialogue/678/0x4f"
msgid "dialogue/678/0x4f"
msgstr "Emperor\nWhat a hateful look!\nYou glare at me just\nlike my brother did!"

msgctxt "dialogue/678/0x88"
msgid "dialogue/678/0x88"
msgstr "Emperor\nI will not let you look\nat me with those eyes.\nNever!! {name}!!"

msgctxt "dialogue/679/0xc"
msgid "dialogue/679/0xc"
msgstr "Emperor\nOoooooh!! Why?!"

msgctxt "dialogue/679/0x38"
msgid "dialogue/679/0x38"
msgstr "Emperor\nAm I going to lose?!\nAm I to be defeated?!"

msgctxt "dialogue/679/0x79"
msgid "dialogue/679/0x79"
msgstr "Emperor\nWhy?! Why?!\nWhyyyyyy?!!"

msgctxt "dialogue/680/0xc"
msgid "dialogue/680/0xc"
msgstr "Regina\n...Is it over?"

msgctxt "dialogue/680/0x3a"
msgid "dialogue/680/0x3a"
msgstr "Arth\nProbably..."

msgctxt "dialogue/680/0x64"
msgid "dialogue/680/0x64"
msgstr "{name}\n......"

msgctxt "dialogue/680/0x85"
msgid "dialogue/680/0x85"
msgstr "Jack\nYour Highness... Let us\nkeep our spirits up."

msgctxt "dialogue/680/0xb3"
msgid "dialogue/680/0xb3"
msgstr "Jack\nYour Highness, a great many\npeople need you."

msgctxt "dialogue/680/0xee"
msgid "dialogue/680/0xee"
msgstr "Jack\nThere is still much\nfor you to do."

msgctxt "dialogue/680/0x13f"
msgid "dialogue/680/0x13f"
msgstr "{name}\n......"

msgctxt "dialogue/680/0x160"
msgid "dialogue/680/0x160"
msgstr "Opis\nEeeeek! Th-the strongest\nZoid I ever created...!"

msgctxt "dialogue/681/0xc"
msgid "dialogue/681/0xc"
