msgctxt "dialogue/329/0x9e"
msgid "dialogue/329/0x9e"
msgstr "Regina\nThank you."

msgctxt "dialogue/330/0xc"
msgid "dialogue/330/0xc"
msgstr "Harry\nHey, hey! Don't forget about the\ngreat Harry!"

msgctxt "dialogue/330/0x4e"
msgid "dialogue/330/0x4e"
msgstr "Naomi\nOh, you were here?"

msgctxt "dialogue/330/0x70"
msgid "dialogue/330/0x70"
msgstr "Leena\nYou shut up, Harry!"

msgctxt "dialogue/330/0xb2"
msgid "dialogue/330/0xb2"
msgstr "Harry\nL-Leena, don't do this to me..."

msgctxt "dialogue/330/0xec"
msgid "dialogue/330/0xec"
msgstr "Naomi\nHeh heh heh. Well, I'm off. See\nyou around."

msgctxt "dialogue/331/0xc"
msgid "dialogue/331/0xc"
msgstr "Harry\nWhat am I even doing here...?"

msgctxt "dialogue/332/0xc"
msgid "dialogue/332/0xc"
msgstr "Naomi\nBy the way, Leon. You promised\nto tell me those reasons."

msgctxt "dialogue/332/0x61"
msgid "dialogue/332/0x61"
msgstr "Leon\nYes. Naomi, have you heard\nabout the Zoid\ndisappearances?"

msgctxt "dialogue/332/0xb2"
msgid "dialogue/332/0xb2"
msgstr "Naomi\nYes. Ranked pilots vanishing\none after another. Is that the\nreason?"

msgctxt "dialogue/332/0x107"
msgid "dialogue/332/0x107"
msgstr "Leon\nIt seems Team Blood is\ninvolved."

msgctxt "dialogue/332/0x14c"
msgid "dialogue/332/0x14c"
msgstr "Naomi\nTeam Blood? The district\nchampions? This is getting\ninteresting."

msgctxt "dialogue/332/0x1a3"
msgid "dialogue/332/0x1a3"
msgstr "Leon\nApparently, these folks have a\nscore to settle with Team\nBlood's leader."

msgctxt "dialogue/332/0x1f0"
msgid "dialogue/332/0x1f0"
msgstr "Leon\nThat's why we're fighting\ntogether as a team, until we\nget to face Team Blood."

msgctxt "dialogue/332/0x251"
msgid "dialogue/332/0x251"
msgstr "Leena\nSo there you go. Now you know\nthe reason, so go on home."

msgctxt "dialogue/332/0x29c"
msgid "dialogue/332/0x29c"
msgstr "Naomi\nOh, with a story this\ninteresting, I'm not leaving\nthat easily."

msgctxt "dialogue/332/0x2dd"
msgid "dialogue/332/0x2dd"
msgstr "Naomi\n...It's decided. I'm joining you."

msgctxt "dialogue/332/0x315"
msgid "dialogue/332/0x315"
msgstr "Leena\nHey! What are you talking\nabout?"

msgctxt "dialogue/332/0x34d"
msgid "dialogue/332/0x34d"
msgstr "Naomi\nWhat does it matter? The more,\nthe merrier. As long as they're\nof some use, of course."

msgctxt "dialogue/332/0x39a"
msgid "dialogue/332/0x39a"
msgstr "Leena\nWhat?! Are you saying I'm\nuseless?"

msgctxt "dialogue/332/0x3d3"
msgid "dialogue/332/0x3d3"
msgstr "Leena\nFine! I'll show you I'm good for\nsomething!"

msgctxt "dialogue/332/0x426"
msgid "dialogue/332/0x426"
msgstr "Regina\nLeena, calm down."

msgctxt "dialogue/332/0x455"
msgid "dialogue/332/0x455"
