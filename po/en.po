msgctxt "dialogue/697/0x119"
msgid "dialogue/697/0x119"
msgstr "Queen\nFrom now on, your duties\nas king of the Kingdom\nof Arcadia await you."

msgctxt "dialogue/697/0x174"
msgid "dialogue/697/0x174"
msgstr "{name}\n......"

msgctxt "dialogue/698/0xc"
msgid "dialogue/698/0xc"
