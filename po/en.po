msgctxt "dialogue/682/0xc"
msgid "dialogue/682/0xc"
msgstr "Blood\nWe meet again,\n{name}..."

msgctxt "dialogue/682/0x3b"
msgid "dialogue/682/0x3b"
msgstr "Blood\nCome on...\nFight me!!"

msgctxt "dialogue/683/0xc"
msgid "dialogue/683/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/683/0x2d"
msgid "dialogue/683/0x2d"
msgstr "Blood\nI'll beat you and\nrule this country!"

msgctxt "dialogue/683/0x61"
msgid "dialogue/683/0x61"
msgstr "Blood\nCome on, show me\nwhat you've got!"

msgctxt "dialogue/683/0x93"
msgid "dialogue/683/0x93"
