msgctxt "dialogue/699/0x8a"
msgid "dialogue/699/0x8a"
msgstr "Regina\n......So much has happened,\nbut... it feels like it\nwent by in a heartbeat..."

msgctxt "dialogue/699/0xeb"
msgid "dialogue/699/0xeb"
msgstr "Regina\n......{name} was a boy\ntoo, after all......"

msgctxt "dialogue/699/0x12b"
msgid "dialogue/699/0x12b"
