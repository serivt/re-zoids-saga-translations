msgctxt "dialogue/695/0x3e"
msgid "dialogue/695/0x3e"
msgstr "Opis\nMy, my. They don't even\nknow how to destroy the\ngate, and still they\ncharge in blindly."

msgctxt "dialogue/695/0x91"
msgid "dialogue/695/0x91"
