msgctxt "dialogue/698/0x5d"
msgid "dialogue/698/0x5d"
msgstr "Queen\n...Very well. Then I'll\ngo on ahead. Regina,\nI leave {name} to you."

msgctxt "dialogue/698/0xb9"
msgid "dialogue/698/0xb9"
