msgctxt "dialogue/619/0x1cf"
msgid "dialogue/619/0x1cf"
msgstr "Schwarz\nTarget! S54, W180!"

msgctxt "dialogue/619/0x207"
msgid "dialogue/619/0x207"
msgstr "Irvine\nHey, Moonbay! Fly\nstraight, we're drifting!"

msgctxt "dialogue/619/0x25a"
msgid "dialogue/619/0x25a"
msgstr "Moonbay\nI'm working my tail off\nhere too!"

msgctxt "dialogue/619/0x28e"
msgid "dialogue/619/0x28e"
msgstr "Moonbay\nCome on, you old heap,\nshow me what you've got!"

msgctxt "dialogue/619/0x2c6"
msgid "dialogue/619/0x2c6"
msgstr "Thomas\nBrother!"

msgctxt "dialogue/619/0x2ee"
msgid "dialogue/619/0x2ee"
msgstr "Schwarz\nTarget locked!"

msgctxt "dialogue/619/0x324"
msgid "dialogue/619/0x324"
msgstr "Herman\nFiiire!"

msgctxt "dialogue/619/0x350"
msgid "dialogue/619/0x350"
msgstr "Thomas\nGo, Van!"

msgctxt "dialogue/619/0x37c"
msgid "dialogue/619/0x37c"
msgstr "Irvine\nGo, go!"

msgctxt "dialogue/619/0x3aa"
msgid "dialogue/619/0x3aa"
msgstr "Schwarz\nGo, Van\nFlyheight!"

msgctxt "dialogue/619/0x3e8"
msgid "dialogue/619/0x3e8"
msgstr "Dr. D\nGo on! Go, my boy!"

msgctxt "dialogue/619/0x420"
msgid "dialogue/619/0x420"
msgstr "Moonbay\nGo get 'em, Vaaan!"

msgctxt "dialogue/619/0x44e"
msgid "dialogue/619/0x44e"
msgstr "Fiona\nVan...!"

msgctxt "dialogue/619/0x476"
msgid "dialogue/619/0x476"
msgstr "Van\nUooooooaaaaaaah!"

msgctxt "dialogue/619/0x4aa"
msgid "dialogue/619/0x4aa"
msgstr "Hiltz\nDie!"

msgctxt "dialogue/619/0x4d0"
msgid "dialogue/619/0x4d0"
msgstr "Van\nHeeeere I cooooome!"

msgctxt "dialogue/619/0x519"
msgid "dialogue/619/0x519"
msgstr "Hiltz\nAaaaaaaaaargh!"

msgctxt "dialogue/620/0xc"
msgid "dialogue/620/0xc"
msgstr "Regina\n...Did we win?"

msgctxt "dialogue/620/0x38"
msgid "dialogue/620/0x38"
msgstr "Arth\n......"

msgctxt "dialogue/620/0x5e"
msgid "dialogue/620/0x5e"
msgstr "Regina\nHey, did we win?"

msgctxt "dialogue/620/0x90"
msgid "dialogue/620/0x90"
msgstr "Jack\n......It would seem so."

msgctxt "dialogue/620/0xc6"
msgid "dialogue/620/0xc6"
msgstr "Regina\n{name}......?"

msgctxt "dialogue/620/0xf2"
msgid "dialogue/620/0xf2"
msgstr "{name}\n......"

msgctxt "dialogue/620/0x113"
msgid "dialogue/620/0x113"
msgstr "Regina\n...Yes! You did it,\n{name}!"

msgctxt "dialogue/620/0x140"
msgid "dialogue/620/0x140"
msgstr "Regina\n{name}!"

msgctxt "dialogue/621/0xc"
msgid "dialogue/621/0xc"
msgstr "Van\nHey! You're still alive,\nhuh? Not bad at all!"

msgctxt "dialogue/621/0x4c"
msgid "dialogue/621/0x4c"
msgstr "Jack\nYou're one to talk...\nPulling a crazy stunt\nlike that..."

msgctxt "dialogue/621/0x8a"
msgid "dialogue/621/0x8a"
msgstr "Van\nI knew it was crazy!"

msgctxt "dialogue/621/0xb6"
msgid "dialogue/621/0xb6"
msgstr "Van\nBut you guys aren't\nexactly timid either!"

msgctxt "dialogue/621/0xf6"
msgid "dialogue/621/0xf6"
msgstr "Van\nBut thanks. I pulled it\noff because of you."

msgctxt "dialogue/621/0x132"
msgid "dialogue/621/0x132"
msgstr "Jack\nNo, all we did was trust\nin you. That's all."

msgctxt "dialogue/621/0x18f"
msgid "dialogue/621/0x18f"
msgstr "Van\nHeh heh heh."

msgctxt "dialogue/621/0x1ad"
msgid "dialogue/621/0x1ad"
msgstr "Fiona\nNow it's your turn,\n{name}."

msgctxt "dialogue/621/0x1df"
msgid "dialogue/621/0x1df"
msgstr "{name}\n......"

msgctxt "dialogue/621/0x200"
msgid "dialogue/621/0x200"
msgstr "Fiona\nFree the Zoids of your\nworld from war soon,\ntoo."

msgctxt "dialogue/621/0x254"
msgid "dialogue/621/0x254"
msgstr "{name}\n......"

msgctxt "dialogue/621/0x275"
msgid "dialogue/621/0x275"
msgstr "Van\nIf we get the chance,\nwe'll meet again. Later!"

msgctxt "dialogue/621/0x2b4"
msgid "dialogue/621/0x2b4"
msgstr "Fiona\nGood luck!"

msgctxt "dialogue/621/0x2dc"
msgid "dialogue/621/0x2dc"
msgstr "Fiona\nAnd you help {name}\ntoo, okay?"

msgctxt "dialogue/621/0x315"
msgid "dialogue/621/0x315"
msgstr "Regina\nI will!"

msgctxt "dialogue/621/0x337"
msgid "dialogue/621/0x337"
msgstr "Regina\nLet's go back to our\nworld."

msgctxt "dialogue/621/0x36e"
msgid "dialogue/621/0x36e"
msgstr "{name}\n......"

msgctxt "dialogue/622/0xc"
msgid "dialogue/622/0xc"
msgstr "Opis\nWho'd have thought you'd\nfinish off the\nDeath Saurer?"

msgctxt "dialogue/622/0x50"
msgid "dialogue/622/0x50"
msgstr "Opis\nHeh heh heh! Prince\n{name}, you're a most\nintriguing specimen\nyourself."

msgctxt "dialogue/622/0x98"
msgid "dialogue/622/0x98"
msgstr "Regina\nOpis! Where have you been\nhiding all this time?"

msgctxt "dialogue/622/0xdc"
msgid "dialogue/622/0xdc"
msgstr "Opis\nHow rude. My goal isn't\nto fight, but to\nresearch Zoids."

msgctxt "dialogue/622/0x127"
msgid "dialogue/622/0x127"
msgstr "Opis\nEven so, this operation\nhas been most fruitful."

msgctxt "dialogue/622/0x169"
msgid "dialogue/622/0x169"
msgstr "Opis\nWell, Blood got in the\nway, but I've nearly\nachieved my goal."

msgctxt "dialogue/622/0x1b4"
msgid "dialogue/622/0x1b4"
msgstr "Opis\nNone other than the\nDeath Saurer's Zoid\nfactor! And the original\none, mind you!"

msgctxt "dialogue/622/0x219"
msgid "dialogue/622/0x219"
msgstr "Jack\nThe Death Saurer's\nZ-Zoid factor!?"

msgctxt "dialogue/622/0x255"
msgid "dialogue/622/0x255"
msgstr "Arth\nLeave it here."

msgctxt "dialogue/622/0x279"
msgid "dialogue/622/0x279"
msgstr "Opis\nLeave it here!? You\nthink I'd do something\nlike that!?"

msgctxt "dialogue/622/0x2d4"
msgid "dialogue/622/0x2d4"
msgstr "Arth\nI see. Then by force."

msgctxt "dialogue/623/0xc"
msgid "dialogue/623/0xc"
msgstr "Opis\nEeek! Such savages!"

msgctxt "dialogue/623/0x44"
msgid "dialogue/623/0x44"
msgstr "Regina\nQuiet! Come on, hand\nover the Zoid factor!"

msgctxt "dialogue/623/0x8f"
msgid "dialogue/623/0x8f"
msgstr "Opis\nZoid factor? What are\nyou talking about?"

msgctxt "dialogue/623/0xc7"
msgid "dialogue/623/0xc7"
msgstr "Regina\nDon't play dumb! The\nDeath Saurer's Zoid\nfactor!"

msgctxt "dialogue/623/0x110"
msgid "dialogue/623/0x110"
msgstr "Opis\nHeh heh heh. That's been\nin His Majesty's hands\nfor a long time now."

msgctxt "dialogue/623/0x163"
msgid "dialogue/623/0x163"
msgstr "Regina\nWhat did you say!?"

msgctxt "dialogue/623/0x18d"
msgid "dialogue/623/0x18d"
msgstr "Opis\nHeh heh heh. We now have\nall the data we needed.\nAt last..."

msgctxt "dialogue/623/0x1e8"
msgid "dialogue/623/0x1e8"
msgstr "Arth\nAt last what?"

msgctxt "dialogue/623/0x212"
msgid "dialogue/623/0x212"
msgstr "Opis\nAt last our most\npowerful Zoid will be\ncomplete!"

msgctxt "dialogue/623/0x246"
msgid "dialogue/623/0x246"
msgstr "Opis\nNaturally, next to it the\nDeath Saurer is nothing.\nHeh heh heh!"

msgctxt "dialogue/623/0x293"
msgid "dialogue/623/0x293"
msgstr "Jack\nThe most powerful Zoid...!"

msgctxt "dialogue/623/0x2c1"
msgid "dialogue/623/0x2c1"
msgstr "Opis\nIts awakening is only a\nmatter of time! When the\nmoment comes, do be sure\nto attend..."

msgctxt "dialogue/623/0x31a"
msgid "dialogue/623/0x31a"
msgstr "Opis\nAs its first victims!\nHeh heh heh, heh heh heh\nheh!"

msgctxt "dialogue/624/0xc"
msgid "dialogue/624/0xc"
msgstr "Regina\nThe strongest Zoid?!"

msgctxt "dialogue/624/0x36"
msgid "dialogue/624/0x36"
msgstr "Regina\nThey still... they still\nwant to toy with the\nlives of Zoids...?"

msgctxt "dialogue/624/0x8d"
msgid "dialogue/624/0x8d"
msgstr "Regina\n......"

msgctxt "dialogue/624/0xb5"
msgid "dialogue/624/0xb5"
msgstr "Regina\n{name}...... Right...\nThis is no time to\nmope."

msgctxt "dialogue/624/0x107"
msgid "dialogue/624/0x107"
msgstr "Regina\nI won't let them do as\nthey please any longer.\nLet's hurry back!"

msgctxt "dialogue/624/0x164"
msgid "dialogue/624/0x164"
msgstr "{name}\n......"

msgctxt "dialogue/625/0xc"
msgid "dialogue/625/0xc"
msgstr "Emperor\nWell, Opis?"

msgctxt "dialogue/626/0xc"
msgid "dialogue/626/0xc"
msgstr "Emperor\nAnswer me at once!"

msgctxt "dialogue/627/0xc"
msgid "dialogue/627/0xc"
msgstr "Gale\nYour Majesty. I have\nbrought Fran."

msgctxt "dialogue/627/0x46"
msgid "dialogue/627/0x46"
msgstr "Emperor\nWell done!\nFran..."

msgctxt "dialogue/627/0x75"
msgid "dialogue/627/0x75"
msgstr "Fran\n...Yes."

msgctxt "dialogue/627/0x97"
msgid "dialogue/627/0x97"
msgstr "Emperor\nExecute Blood."

msgctxt "dialogue/627/0xc1"
msgid "dialogue/627/0xc1"
msgstr "Fran\nWhat?"

msgctxt "dialogue/627/0xe1"
msgid "dialogue/627/0xe1"
msgstr "Gale\n...!"

msgctxt "dialogue/627/0xfd"
msgid "dialogue/627/0xfd"
msgstr "Emperor\nHe has betrayed me. He\nhas forgotten that I\nraised him."

msgctxt "dialogue/627/0x144"
msgid "dialogue/627/0x144"
msgstr "Emperor\nEven if he is my son, I\ncan no longer forgive\nhim."

msgctxt "dialogue/627/0x182"
msgid "dialogue/627/0x182"
msgstr "Fran\nIt can't be......\nBlood...?"

msgctxt "dialogue/627/0x1c7"
msgid "dialogue/627/0x1c7"
msgstr "Emperor\nFran, I shall give you\ntwo paths to choose from."

msgctxt "dialogue/627/0x1f9"
msgid "dialogue/627/0x1f9"
msgstr "Emperor\nEither you obey me... or\nyou become the flesh and\nblood of this Zoid, the\nmightiest of all."

msgctxt "dialogue/627/0x242"
msgid "dialogue/627/0x242"
msgstr "Emperor\nChoose, Fran!"

msgctxt "dialogue/627/0x270"
msgid "dialogue/627/0x270"
msgstr "Fran\n.........Blood..."

msgctxt "dialogue/627/0x2aa"
msgid "dialogue/627/0x2aa"
msgstr "Emperor\nCome on! Choose!\nFran!!"

msgctxt "dialogue/627/0x2e4"
msgid "dialogue/627/0x2e4"
msgstr "Fran\n...F-flesh and blood..."

msgctxt "dialogue/627/0x310"
msgid "dialogue/627/0x310"
msgstr "Gale\nOne moment, Your Majesty."

msgctxt "dialogue/627/0x33e"
msgid "dialogue/627/0x33e"
msgstr "Emperor\nWhat is it, Gale?\nDo you mean to save this\nfoolish girl?"

msgctxt "dialogue/627/0x381"
msgid "dialogue/627/0x381"
msgstr "Gale\nNo. But we need time."

msgctxt "dialogue/627/0x3b5"
msgid "dialogue/627/0x3b5"
msgstr "Gale\nFrom what I see, the\nmightiest Zoid still\nneeds time before its\nfull awakening,\ndoes it not?"

msgctxt "dialogue/627/0x418"
msgid "dialogue/627/0x418"
msgstr "Emperor\nOpis!!"

msgctxt "dialogue/628/0xc"
msgid "dialogue/628/0xc"
msgstr "Opis\nThe Zoid core is about\nto awaken. But until it\ncan move......"

msgctxt "dialogue/628/0x73"
msgid "dialogue/628/0x73"
msgstr "Emperor\n...Will it take long?"

msgctxt "dialogue/628/0xa1"
msgid "dialogue/628/0xa1"
msgstr "Opis\nYes. Five hours... no,\nfour should be enough..."

msgctxt "dialogue/628/0xe5"
msgid "dialogue/628/0xe5"
msgstr "Gale\nFran will defend the main\ngate of Arcadia Castle to\nthe death. That will buy\nus some time."

msgctxt "dialogue/628/0x148"
msgid "dialogue/628/0x148"
msgstr "Emperor\nSo if she must die, she\nmay as well be of some\nuse?"

msgctxt "dialogue/628/0x18f"
msgid "dialogue/628/0x18f"
msgstr "Gale\nYes."

msgctxt "dialogue/628/0x1ab"
msgid "dialogue/628/0x1ab"
msgstr "Fran\n......"

msgctxt "dialogue/628/0x1d1"
msgid "dialogue/628/0x1d1"
msgstr "Emperor\nHmph. Very well!"

msgctxt "dialogue/628/0x1f9"
msgid "dialogue/628/0x1f9"
msgstr "Emperor\nFran, I'm counting on\nyou! Die for me!"

msgctxt "dialogue/628/0x23c"
msgid "dialogue/628/0x23c"
msgstr "Fran\n......Yes."

msgctxt "dialogue/628/0x264"
msgid "dialogue/628/0x264"
msgstr "Gale\n......"

msgctxt "dialogue/629/0xc"
msgid "dialogue/629/0xc"
msgstr "Emperor\nIt has awakened!"

msgctxt "dialogue/629/0x32"
msgid "dialogue/629/0x32"
msgstr "Fran\n...!"

msgctxt "dialogue/629/0x4e"
msgid "dialogue/629/0x4e"
msgstr "Gale\n...!"

msgctxt "dialogue/629/0x6a"
msgid "dialogue/629/0x6a"
msgstr "Opis\nHeh heh heh! Come now,\nopen your eyes slowly..."

msgctxt "dialogue/629/0xa9"
msgid "dialogue/629/0xa9"
msgstr "Opis\nDo you see the world...?\nThe world you'll lay\nwaste until nothing is\nleft! Heh heh heh heeeh!"

msgctxt "dialogue/629/0x110"
msgid "dialogue/629/0x110"
msgstr "Emperor\nHeh heh heh heh heh...\nHa ha ha, haaa!!!"

msgctxt "dialogue/629/0x14b"
msgid "dialogue/629/0x14b"
msgstr "Emperor\nAt last you've awakened!"

msgctxt "dialogue/629/0x16b"
msgid "dialogue/629/0x16b"
msgstr "Emperor\nI am your father! Come,\ngreet your father!"

msgctxt "dialogue/629/0x1a4"
msgid "dialogue/629/0x1a4"
msgstr "Emperor\nShow your father your\npower!!!"

msgctxt "dialogue/630/0xc"
msgid "dialogue/630/0xc"
msgstr "Fran\nWhat?!"

msgctxt "dialogue/630/0x2e"
msgid "dialogue/630/0x2e"
msgstr "Gale\n...It's a monster!"

msgctxt "dialogue/631/0xc"
msgid "dialogue/631/0xc"
msgstr "Emperor\nHa ha ha, haaa!!!"

msgctxt "dialogue/631/0x3e"
msgid "dialogue/631/0x3e"
msgstr "Emperor\nMagnificent!\nMagnificent!!\nThat's my son!!!"

msgctxt "dialogue/632/0x3"
msgid "dialogue/632/0x3"
msgstr "Kingdom Soldier\nWe're detecting extreme\nhigh-voltage energy at\nArcadia Castle!\nCome at once!!"

msgctxt "dialogue/632/0x6e"
msgid "dialogue/632/0x6e"
msgstr "{name}\n......"

msgctxt "dialogue/632/0x8f"
msgid "dialogue/632/0x8f"
msgstr "Jack\nWhat's causing it?!"

msgctxt "dialogue/632/0xb4"
msgid "dialogue/632/0xb4"
msgstr "Kingdom Soldier 1\nWe don't know! Anyway,\nplease come to the\ncommand room!"

msgctxt "dialogue/633/0x3"
msgid "dialogue/633/0x3"
msgstr "Kingdom Soldier 2\nTh-this is terrible! The\ncastle! Arcadia Castle!!"

msgctxt "dialogue/633/0x54"
msgid "dialogue/633/0x54"
msgstr "Arth\nWhat's going on?!"

msgctxt "dialogue/634/0xc"
msgid "dialogue/634/0xc"
msgstr "Regina\n{name}! Wait!!"

msgctxt "dialogue/635/0xc"
msgid "dialogue/635/0xc"
msgstr "Jack\nA ch-charged particle\ncannon...?!"

msgctxt "dialogue/635/0x40"
msgid "dialogue/635/0x40"
msgstr "Regina\nWh-what is this?! What a\nsinister feeling!"

msgctxt "dialogue/635/0x8b"
msgid "dialogue/635/0x8b"
msgstr "Arth\nNo idea. But there's\nclearly something huge\nin that castle."

msgctxt "dialogue/635/0xdf"
msgid "dialogue/635/0xdf"
msgstr "{name}\n......"

msgctxt "dialogue/636/0xc"
msgid "dialogue/636/0xc"
msgstr "Emperor\nHear me well, you\nfoolish worms!"

msgctxt "dialogue/637/0xc"
msgid "dialogue/637/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/637/0x2d"
msgid "dialogue/637/0x2d"
msgstr "Regina\nThat man is...?!"

msgctxt "dialogue/637/0x57"
msgid "dialogue/637/0x57"
msgstr "Emperor\nI am the Emperor of the\nnew Arcadian Empire!"

msgctxt "dialogue/637/0x81"
msgid "dialogue/637/0x81"
msgstr "Emperor\nI am the new ruler of\nthis land... no, of all\nplanet Zi!"

msgctxt "dialogue/637/0xce"
msgid "dialogue/637/0xce"
msgstr "Emperor\nBehold the gleam of the\ncharged particle\ncannon!! This is my\npower!!"

msgctxt "dialogue/637/0x10f"
msgid "dialogue/637/0x10f"
msgstr "Emperor\nBefore me you are nothing\nbut flickers of particles\ndoomed to return to the\nearth!!"

msgctxt "dialogue/637/0x164"
msgid "dialogue/637/0x164"
msgstr "Emperor\nI am ready to fill this\nplanet with the gleam of\ncharged particles!!"

msgctxt "dialogue/637/0x1a3"
msgid "dialogue/637/0x1a3"
msgstr "Emperor\nAccept my rule!!\nAccept that you are\nnothing but worms!!"

msgctxt "dialogue/637/0x1fa"
msgid "dialogue/637/0x1fa"
msgstr "Emperor\nI am the Emperor of the\nnew Arcadian Empire!!"

msgctxt "dialogue/637/0x23a"
msgid "dialogue/637/0x23a"
msgstr "Emperor\nHeh heh heh heh...\nHa ha ha, haaa!!!!"

msgctxt "dialogue/638/0xc"
msgid "dialogue/638/0xc"
msgstr "Regina\nWhat is he saying?! I\nwon't stand for such a\nselfish whim!!"

msgctxt "dialogue/638/0x4f"
msgid "dialogue/638/0x4f"
msgstr "Regina\nThis planet belongs to\nno one... No one at all!"

msgctxt "dialogue/638/0xa0"
msgid "dialogue/638/0xa0"
msgstr "Jack\nAn ultimatum, hm? So\ntheir mightiest Zoid is\nalready complete?"

msgctxt "dialogue/638/0xf5"
msgid "dialogue/638/0xf5"
msgstr "Arth\nLooks like it."

msgctxt "dialogue/638/0x11b"
msgid "dialogue/638/0x11b"
msgstr "Regina\nYou two! Can't you see\nthis concerns us too?!"

msgctxt "dialogue/638/0x15d"
msgid "dialogue/638/0x15d"
msgstr "Jack\nWhat are you saying,\nRegina?"

msgctxt "dialogue/638/0x18b"
msgid "dialogue/638/0x18b"
msgstr "Jack\nWe are the Three\nWarriors. We shall always\nwalk beside the prince,\nwhatever may happen."

msgctxt "dialogue/638/0x1de"
msgid "dialogue/638/0x1de"
msgstr "Arth\nIf the prince has made\nhis decision, we've got\nno objections."

msgctxt "dialogue/638/0x231"
msgid "dialogue/638/0x231"
msgstr "Regina\n......{name}...?"

msgctxt "dialogue/639/0xc"
msgid "dialogue/639/0xc"
msgstr "{name}\n......"

msgctxt "dialogue/639/0x2d"
msgid "dialogue/639/0x2d"
msgstr "Regina\n{name}... Since when\ndo you make that face?"

msgctxt "dialogue/639/0x79"
msgid "dialogue/639/0x79"
msgstr "Regina\nYou've got some nerve,\n{name}..."

msgctxt "dialogue/639/0xae"
msgid "dialogue/639/0xae"
msgstr "Regina\nWhat matters in these\nthings is the spirit!"

msgctxt "dialogue/639/0xea"
msgid "dialogue/639/0xea"
msgstr "Jack\n...Regina may well\nbe right."

msgctxt "dialogue/639/0x131"
msgid "dialogue/639/0x131"
msgstr "Arth\nSeems so.\nRight, Prince?"

msgctxt "dialogue/639/0x160"
msgid "dialogue/639/0x160"
msgstr "{name}\n......"

msgctxt "dialogue/639/0x181"
msgid "dialogue/639/0x181"
msgstr "Regina\nCome on, the final\nbattle's here!"

msgctxt "dialogue/639/0x1b8"
msgid "dialogue/639/0x1b8"
msgstr "Arth\nYeah!"

msgctxt "dialogue/639/0x1d7"
msgid "dialogue/639/0x1d7"
msgstr "Arth\nLet's go!!"

msgctxt "dialogue/639/0x1fc"
msgid "dialogue/639/0x1fc"
msgstr "{name}\n......"

msgctxt "dialogue/640/0xc"
msgid "dialogue/640/0xc"
msgstr "Jack\nVery well, Prince. I will\nexplain what we know so\nfar about Arcadia Castle."

msgctxt "dialogue/640/0x5d"
msgid "dialogue/640/0x5d"
msgstr "Jack\nSince seizing our Arcadia\nCastle, the enemy has\nbeen building to reinforce\nits defenses."

msgctxt "dialogue/640/0xb4"
msgid "dialogue/640/0xb4"
msgstr "Jack\nSo the inside must be\nquite different from the\none we know."

msgctxt "dialogue/640/0x107"
msgid "dialogue/640/0x107"
msgstr "Jack\nAlso, of the two great\ngates, north and south,\nthe north gate collapsed\nunder the charged\nparticle cannon."

msgctxt "dialogue/640/0x15a"
msgid "dialogue/640/0x15a"
msgstr "Jack\nThe underground passage\nwe used to escape has\ncaved in as well, and\ncan't be used."

msgctxt "dialogue/640/0x1b1"
msgid "dialogue/640/0x1b1"
msgstr "Regina\nThen all we have left\nis the south gate?"

msgctxt "dialogue/640/0x1e9"
msgid "dialogue/640/0x1e9"
msgstr "Jack\nYes. The south gate was\nsealed tight, but now\nit stands open."

msgctxt "dialogue/640/0x246"
msgid "dialogue/640/0x246"
msgstr "Regina\nOpen?\nPretty confident, huh?"

msgctxt "dialogue/640/0x28b"
msgid "dialogue/640/0x28b"
msgstr "Arth\nOr it's a trap."

msgctxt "dialogue/640/0x2b5"
msgid "dialogue/640/0x2b5"
msgstr "Jack\nIt could be either one.\nIn any case, we can't\nget in without going\nthrough it."

msgctxt "dialogue/640/0x317"
msgid "dialogue/640/0x317"
msgstr "{name}\n......"

msgctxt "dialogue/640/0x338"
msgid "dialogue/640/0x338"
msgstr "Regina\nA frontal attack, huh?\nBut on our own, it's\ngoing to be tough."

msgctxt "dialogue/640/0x389"
msgid "dialogue/640/0x389"
msgstr "Jack\nFor our lack of forces,\nwe have a solution.\nRight, Arth?"

msgctxt "dialogue/640/0x3e2"
msgid "dialogue/640/0x3e2"
msgstr "Arth\nYeah. We've crossed many\ntimes and places, and\nhelped a lot of people."

msgctxt "dialogue/640/0x437"
msgid "dialogue/640/0x437"
msgstr "Arth\nHigh time they returned\nthe favor."

msgctxt "dialogue/640/0x47e"
msgid "dialogue/640/0x47e"
msgstr "Regina\n?? You don't mean...?!"

msgctxt "dialogue/640/0x4a8"
msgid "dialogue/640/0x4a8"
msgstr "Jack\nIndeed. This time we'll\nask them to come to this\nworld and lend us a hand."

msgctxt "dialogue/640/0x4ff"
msgid "dialogue/640/0x4ff"
msgstr "Jack\nHowever, due to a problem\nwith the space-time\ntransfer device, we can't\nbring several people from\ndifferent times at once."

msgctxt "dialogue/640/0x55a"
msgid "dialogue/640/0x55a"
msgstr "Jack\nAnd no more than two\npeople can help us."

msgctxt "dialogue/640/0x595"
msgid "dialogue/640/0x595"
msgstr "Jack\nIs that all right, Prince?\nThat is all I had to say."

msgctxt "dialogue/640/0x5d6"
msgid "dialogue/640/0x5d6"
msgstr "Jack\nPrince, Arth and I will\narrange for the\nreinforcements to arrive."

msgctxt "dialogue/640/0x61f"
msgid "dialogue/640/0x61f"
msgstr "Jack\nIf you wish to call the\nreinforcements, speak\nto Arth or to me."

msgctxt "dialogue/640/0x672"
msgid "dialogue/640/0x672"
msgstr "Arth\nSee you."

msgctxt "dialogue/640/0x690"
msgid "dialogue/640/0x690"
msgstr "Regina\nI'll finish getting\nready with the\nKingdom's army."

msgctxt "dialogue/640/0x6c6"
msgid "dialogue/640/0x6c6"
msgstr "Regina\nPrince, when you're\nready to set out,\nlet me know."

msgctxt "dialogue/640/0x703"
msgid "dialogue/640/0x703"
msgstr "Regina\n...We're winning this no\nmatter what, {name}."

msgctxt "dialogue/641/0xc"
msgid "dialogue/641/0xc"
msgstr "Jack\nWe have managed to reach\nthese people."

